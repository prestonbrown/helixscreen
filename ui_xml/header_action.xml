<!-- One button in a screen's header: the only element header_bar's actions slot
     takes (<header_bar-actions>, <overlay_panel-actions>; scripts/check_header_actions.py).
     It owns the whole look, so every header button is the same height, shape and
     color scheme:
       - icon only: a circle, as wide as it is tall
       - text, with or without an icon: a pill
       - role: primary (the screen's one main action), neutral (default), danger
       - collapse="auto" (default): icon + text where the header has room, the icon
         alone on micro and tiny and in portrait below the large breakpoint (a 480px
         wide header); a text-only action keeps its text. "never" keeps it.
     Callers give it a name, content, role and callback, never a size or color.
     Bindings written as its children (bind_flag_if*, bind_state_if*) act on the
     button itself, so a Save that greys out while nothing is dirty is one
     header_action with role primary, its callback, and a bind_state_if_eq child. -->
<component>
  <api>
    <prop name="icon" type="string" default=""/>
    <prop name="text" type="string" default=""/>
    <!-- Implied from text (text="Save" reads as text_tag="Save"); pass it only
         when the translation key differs from the English text. -->
    <prop name="text_tag" type="string" default=""/>
    <prop name="role" type="string" default="neutral"/>
    <prop name="collapse" type="string" default="auto"/>
    <prop name="callback" type="string" default=""/>
  </api>
  <consts>
    <!-- Touch reach past the button's edge, taking a #header_button_height button
         to the header's own height where that is under 44px. Twice the reach
         stays under the gap between actions, so neighbors never share a tap. -->
    <px name="header_action_hit_micro" value="4"/>
    <px name="header_action_hit_tiny" value="3"/>
    <px name="header_action_hit_small" value="3"/>
    <px name="header_action_hit_medium" value="0"/>
    <px name="header_action_hit_large" value="0"/>
    <!-- The glyph, a size under #header_button_height so it never reaches the
         circle's edge (a 24px glyph fills tiny's 26px button). -->
    <string name="icon_font_header_micro" value="mdi_icons_16"/>
    <string name="icon_font_header_tiny" value="mdi_icons_16"/>
    <string name="icon_font_header_small" value="mdi_icons_24"/>
    <string name="icon_font_header_medium" value="mdi_icons_24"/>
    <string name="icon_font_header_large" value="mdi_icons_24"/>
    <string name="icon_font_header_xlarge" value="mdi_icons_32"/>
    <string name="icon_font_header_xxlarge" value="mdi_icons_32"/>
  </consts>
  <subjects>
    <!-- The label-hiding rule each collapse value names; ui_button binds it only
         when the action has an icon to collapse to. -->
    <subject_expr name="header_action_collapse_auto"
                  expr="ui_breakpoint le 1 or ui_is_portrait eq 1 and ui_breakpoint lt 4"/>
    <subject name="header_action_collapse_never" type="int" value="0"/>
  </subjects>
  <styles>
    <!-- A pill: radius past half the height, padded so the text clears the curve. -->
    <style name="shape" radius="9999" pad_left="#space_lg" pad_right="#space_lg" pad_top="0" pad_bottom="0"/>
    <!-- ui_button sets user_4 while it shows only its icon: then a circle. -->
    <style name="icon_only" width="#header_button_height" pad_left="0" pad_right="0"/>
    <style name="role_primary" bg_color="#primary"/>
    <style name="role_neutral" bg_color="#elevated_bg"/>
    <style name="role_danger" bg_color="#danger"/>
  </styles>
  <view extends="ui_button"
        width="content" height="#header_button_height" style_min_width="#header_button_height" icon="$icon"
        icon_size="header" text="$text" translation_tag="$text_tag"
        label_hidden_subject="header_action_collapse_${collapse}" label_hidden_if_eq="1"
        ext_click_area="#header_action_hit">
    <style name="shape"/>
    <style name="icon_only" selector="user_4"/>
    <style name="role_${role}"/>
    <event_cb trigger="clicked" callback="$callback"/>
  </view>
</component>
