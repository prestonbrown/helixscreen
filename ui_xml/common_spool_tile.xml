<!-- A spool tile a new spool starts from: a starred product (a star and its
     name) or a common spool (its color and material). A tap fills the form;
     the tile's name ends in its slot in AmsEditOverlay's spool_tiles_. -->
<component>
  <api>
    <prop name="tile_name" type="string" default="spool_tile_0"/>
    <prop name="color_subject" type="string" default=""/>
    <prop name="label_subject" type="string" default=""/>
    <prop name="favorite_subject" type="string" default=""/>
  </api>
  <view name="$tile_name"
        extends="lv_obj" width="24%" height="#assign_tile_h" style_pad_all="#space_xs" style_pad_gap="#space_xs"
        style_radius="#border_radius" style_bg_color="#elevated_bg" style_bg_opa="255" style_border_width="1"
        style_border_color="#border" flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center"
        scrollable="false" clickable="true">
    <style name="styles.press_wash" selector="pressed"/>
    <event_cb trigger="clicked" callback="ams_edit_spool_tile_cb"/>
    <color_dot color_subject="$color_subject" size="#space_lg">
      <bind_flag_if_eq subject="$favorite_subject" flag="hidden" ref_value="1"/>
    </color_dot>
    <icon src="star" size="xs" variant="warning" clickable="false" event_bubble="true" hidden="true">
      <bind_flag_if_eq subject="$favorite_subject" flag="hidden" ref_value="0"/>
    </icon>
    <text_small bind_text="$label_subject" flex_grow="1" long_mode="dots" clickable="false" event_bubble="true"/>
  </view>
</component>
