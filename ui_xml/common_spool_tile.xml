<!-- A common spool to start from on a fresh install ("PLA Black"). A tap fills
     the describe form; the tile's name ends in its index into
     helix::spool_assign::common_spools(). -->
<component>
  <api>
    <prop name="tile_name" type="string" default="common_spool_0"/>
    <prop name="label" type="string" default=""/>
    <prop name="color_subject" type="string" default=""/>
  </api>
  <view name="$tile_name"
        extends="lv_obj" width="32%" height="content" style_pad_all="#space_xs" style_pad_gap="#space_xs"
        style_radius="#border_radius" style_bg_color="#elevated_bg" style_bg_opa="255" style_border_width="1"
        style_border_color="#border" flex_flow="row" style_flex_cross_place="center" scrollable="false" clickable="true">
    <style name="styles.press_wash" selector="pressed"/>
    <event_cb trigger="clicked" callback="ams_edit_common_spool_cb"/>
    <color_dot color_subject="$color_subject" size="#space_lg"/>
    <text_small text="$label" flex_grow="1" long_mode="dots" clickable="false" event_bubble="true"/>
  </view>
</component>
