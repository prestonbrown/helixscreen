<!-- AMS Management Overlay Panel -->
<!-- Quick Actions, system info, and progressive disclosure sections -->
<component>
  <view name="ams_device_operations"
        extends="overlay_panel" title="Multi-Filament System Management" bg_color="#screen_bg">
    <!-- Content Area (scrollable) -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="#space_md" scrollable="true" flex_flow="column"
            style_pad_gap="#space_md">
      <!-- System info line (e.g. "System: AFC · v1.2.3") -->
      <text_muted name="system_info_label" width="100%" bind_text="ams_device_ops_system_info"/>
      <!-- ================================================================== -->
      <!-- Card 1: Quick Actions & Behavior                                    -->
      <!-- ================================================================== -->
      <ui_card name="quick_actions_card"
               width="100%" height="content" style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column"
               style_pad_gap="#space_md">
        <!-- Quick Actions Header -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_sm" scrollable="false">
          <icon src="flash" size="sm" variant="primary"/>
          <text_body text="Quick Actions"/>
        </lv_obj>
        <!-- Action Buttons Row: Home | Recover | Abort -->
        <lv_obj name="action_buttons_row"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm"
                scrollable="false">
          <!-- Home Button -->
          <ui_button name="btn_home" icon="home" text="Home" flex_grow="1">
            <bind_state_if_eq subject="ams_device_ops_can_home" state="disabled" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_ams_device_ops_home"/>
          </ui_button>
          <!-- Recover Button -->
          <ui_button name="btn_recover" icon="refresh" text="Recover" flex_grow="1">
            <bind_state_if_eq subject="ams_device_ops_can_recover" state="disabled" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_ams_device_ops_recover"/>
          </ui_button>
          <!-- Abort Button -->
          <ui_button name="btn_abort" icon="stop" text="Abort" flex_grow="1">
            <bind_state_if_eq subject="ams_device_ops_can_abort" state="disabled" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_ams_device_ops_abort"/>
          </ui_button>
        </lv_obj>
        <!-- Divider -->
        <lv_obj width="100%" height="1" style_bg_color="#text_muted" style_bg_opa="30"/>
        <!-- Bypass Mode Container (hidden when bypass not supported) -->
        <lv_obj name="bypass_container"
                width="100%" height="content" style_pad_all="0" style_layout="flex" style_flex_flow="column"
                scrollable="false">
          <bind_flag_if_eq subject="ams_device_ops_supports_bypass" flag="hidden" ref_value="0"/>
          <!-- Virtual toggle (no hardware sensor). Checked state follows the
               live ams_bypass_active subject (the one AmsState publishes from the
               backends), not an overlay-local snapshot: the enable can complete
               asynchronously behind an unload-first chain, and a snapshot written
               optimistically on "success" reports a fire-and-forget gcode as done.
               Dims while a job owns the toolhead, same binding as
               panel_widget_bypass.xml; the shared controller still enforces that
               guard on every tap. -->
          <setting_toggle_row name="bypass_virtual_row"
                              label="Bypass Mode" icon="arrow_left_right"
                              description="Feed filament directly to extruder" subject="ams_bypass_active"
                              callback="on_ams_device_ops_bypass_toggled" moves_machine="true">
            <bind_flag_if_eq subject="ams_device_ops_hw_bypass_sensor" flag="hidden" ref_value="1"/>
          </setting_toggle_row>
          <!-- Hardware sensor indicator (read-only) -->
          <lv_obj name="bypass_hw_row"
                  width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center">
            <bind_flag_if_eq subject="ams_device_ops_hw_bypass_sensor" flag="hidden" ref_value="0"/>
            <lv_obj height="content"
                    style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                    scrollable="false" flex_grow="1">
              <icon src="arrow_left_right" size="sm" variant="secondary"/>
              <lv_obj height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
                <text_body text="Bypass Mode"/>
                <text_small text="Controlled by hardware sensor"/>
              </lv_obj>
            </lv_obj>
            <status_pill name="bypass_status_pill" text="Inactive" variant="muted"/>
          </lv_obj>
        </lv_obj>
        <!-- Auto-Heat Info Row (shown when supported) -->
        <setting_info_row name="auto_heat_row" label="Auto-Heat on Load" icon="fire" value="On">
          <bind_flag_if_eq subject="ams_device_ops_supports_auto_heat" flag="hidden" ref_value="0"/>
        </setting_info_row>
        <!-- Keep the bypass spool on the Multi-Filament panel even when bypass
             is disengaged. AFC publishes a virtual bypass whether or not one is
             wired, so the node is hidden by default (AFC backends only). -->
        <setting_toggle_row name="row_ams_always_show_bypass_spool"
                            label="Always Show Bypass Spool" icon="filament"
                            description="Keep the bypass spool visible when bypass is off"
                            subject="ams_always_show_bypass_spool" callback="on_ams_always_show_bypass_spool_toggled">
          <bind_flag_if_eq subject="ams_device_ops_bypass_is_virtual" flag="hidden" ref_value="0"/>
        </setting_toggle_row>
        <!-- Retention across eject: keep the previously assigned spool details
             so reloading the same spool after maintenance needs no re-selection.
             Meaningful on systems whose firmware reports spool ids per lane;
             other systems clear on a detected spool swap regardless. Firmware
             with its own per-lane setting for this owns it: the switch then
             shows and writes the firmware's setting, so every client of the
             printer agrees. Otherwise it is HelixScreen's setting (default on). -->
        <setting_toggle_row name="row_ams_keep_spool_info_on_eject"
                            label="Keep Spool Info on Eject" icon="filament"
                            description="Remember slot spool details across an eject"
                            subject="ams_keep_spool_info_on_eject" callback="on_ams_keep_spool_info_toggled">
          <bind_flag_if cond="ams_device_ops_reports_spool_ids and not ams_device_ops_firmware_owns_spool_retention"
                        flag="hidden" invert="true"/>
        </setting_toggle_row>
        <setting_toggle_row name="row_ams_firmware_keeps_spool_info"
                            label="Keep Spool Info on Eject" icon="filament"
                            description="Remember slot spool details across an eject"
                            subject="ams_device_ops_printer_retains_spool_info"
                            callback="on_ams_firmware_keep_spool_info_toggled">
          <bind_flag_if_eq subject="ams_device_ops_firmware_owns_spool_retention" flag="hidden" ref_value="0"/>
        </setting_toggle_row>
        <!-- Link a lane to the Spoolman spool its tag names when the spool is
             seated (default on). Shown where a tag can name a spool and
             Spoolman is configured. -->
        <setting_toggle_row name="row_ams_tag_links_spoolman"
                            label="Link Spools from Tags" icon="filament"
                            description="Link a slot to the Spoolman spool its tag names"
                            subject="ams_tag_links_spoolman" callback="on_ams_tag_links_spoolman_toggled">
          <bind_flag_if cond="ams_device_ops_tags_name_spools and printer_has_spoolman" flag="hidden" invert="true"/>
        </setting_toggle_row>
        <!-- Offer the bypass controls on a machine whose firmware reports none.
             Shown only while the firmware says no, so it stays available for the
             user to switch back off. Happy Hare defaults [mmu_machine] has_bypass
             to 0 for mmu_vendor "Other" (a Qidi Box reports exactly that), yet
             its select_bypass() never checks the flag — MMU_SELECT_BYPASS
             deselects the gear steppers and reports gate -2 either way. -->
        <setting_toggle_row name="row_ams_force_bypass_controls"
                            label="Enable Bypass Controls" icon="source_branch"
                            description="Firmware reports no bypass. Enable if you feed filament straight to the extruder"
                            subject="ams_force_bypass_controls" callback="on_ams_force_bypass_controls_toggled">
          <bind_flag_if_eq subject="ams_device_ops_fw_supports_bypass" flag="hidden" ref_value="1"/>
        </setting_toggle_row>
        <!-- Endless Spool on/off, for every backend whose firmware takes the
             switch. Checked follows the backend's reported state, not the tap. -->
        <setting_toggle_row name="row_endless_spool"
                            label="Endless Spool" icon="infinity"
                            description="Switch to a matching spool when one runs out" subject="ams_endless_spool_on"
                            callback="on_ams_endless_spool_toggled">
          <bind_flag_if_eq subject="ams_endless_spool_switchable" flag="hidden" ref_value="0"/>
        </setting_toggle_row>
        <!-- Reset Endless Spool failover (shown only on backends whose
             endless-spool mapping the UI may write — AFC per-slot edges,
             single-unit Happy Hare groups, and the mock. Read-only systems
             like CFS and AD5X IFS hide the row). The base reset_endless_spool()
             loops set_endless_spool_backup(slot, -1) over every slot; Happy
             Hare overrides it with MMU_ENDLESS_SPOOL RESET=1. Wipes ALL endless-spool
             config, so the tap opens a confirmation modal rather than firing
             immediately. -->
        <setting_action_row name="row_reset_endless_spool"
                            label="Reset Endless Spool" icon="restart" description="Clear every Endless Spool backup"
                            callback="on_ams_reset_endless_spool_clicked">
          <bind_flag_if_eq subject="ams_device_ops_can_reset_endless_spool" flag="hidden" ref_value="0"/>
        </setting_action_row>
        <!-- Status Row: the live AMS narration, the same line the AMS panel shows -->
        <lv_obj name="status_row"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="start"
                style_flex_cross_place="center" style_pad_gap="#space_sm">
          <icon src="info" size="sm" variant="secondary"/>
          <lv_obj height="content"
                  style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false" flex_grow="1">
            <text_body text="Status"/>
            <text_small name="status_label" bind_text="ams_action_detail"/>
          </lv_obj>
        </lv_obj>
        <!-- Read-only facts the system publishes (firmware, serial, purge volume,
             Spoolman mode, pending spool). Hidden when it publishes none. -->
        <lv_obj name="details_row"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="start"
                style_flex_cross_place="start" style_pad_gap="#space_sm">
          <bind_flag_if_eq subject="ams_device_ops_has_details" flag="hidden" ref_value="0"/>
          <icon src="view_list" size="sm" variant="secondary"/>
          <lv_obj height="content"
                  style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false" flex_grow="1">
            <text_body text="Details"/>
            <text_small name="details_label" width="100%" bind_text="ams_device_ops_details" long_mode="wrap"/>
          </lv_obj>
        </lv_obj>
      </ui_card>
      <!-- ================================================================== -->
      <!-- Section List (progressive disclosure — rows push detail overlays) -->
      <!-- ================================================================== -->
      <ui_card name="sections_card"
               width="100%" height="content" style_radius="#border_radius" style_pad_all="#space_sm" flex_flow="column"
               style_pad_gap="0">
        <bind_flag_if_eq subject="ams_device_ops_has_backend" flag="hidden" ref_value="0"/>
        <!-- Dynamic section rows container (populated in C++) -->
        <lv_obj name="section_list_container"
                width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="0" scrollable="false">
          <!-- Section rows added dynamically: icon + label + chevron -->
        </lv_obj>
      </ui_card>
      <!-- ================================================================== -->
      <!-- No Backend Message (shown when no AMS connected)                   -->
      <!-- ================================================================== -->
      <ui_card name="no_backend_card"
               width="100%" height="content" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="column"
               style_flex_cross_place="center" style_pad_gap="#space_sm">
        <bind_flag_if_eq subject="ams_device_ops_has_backend" flag="hidden" ref_value="1"/>
        <icon src="info" size="lg" variant="secondary"/>
        <text_muted name="no_backend_text"
                    width="100%" text="No Multi-Filament System connected." style_text_align="center"/>
      </ui_card>
    </lv_obj>
  </view>
</component>
