<!-- AMS Management Overlay Panel -->
<!-- Quick Actions, system info, and progressive disclosure sections -->
<component>
  <view name="ams_device_operations"
        extends="overlay_panel" title="Multi-Filament System Management" title_tag="Multi-Filament System Management"
        bg_color="#screen_bg">
    <!-- Content Area (scrollable) -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="#space_md" scrollable="true" flex_flow="column"
            style_pad_gap="#space_md">

      <!-- System info line (e.g. "System: AFC · v1.2.3") -->
      <text_muted name="system_info_label" width="100%" bind_text="ams_device_ops_system_info"/>

      <!-- ================================================================== -->
      <!-- Card 1: Quick Actions & Behavior                                    -->
      <!-- ================================================================== -->
      <ui_card name="quick_actions_card"
               width="100%" height="content" style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column"
               style_pad_gap="#space_md">

        <!-- Quick Actions Header -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_sm" scrollable="false">
          <icon src="flash" size="sm" variant="primary"/>
          <text_body text="Quick Actions" translation_tag="Quick Actions"/>
        </lv_obj>

        <!-- Action Buttons Row: Home | Recover | Abort -->
        <lv_obj name="action_buttons_row"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm"
                scrollable="false">
          <!-- Home Button -->
          <ui_button name="btn_home" height="44" icon="home" text="Home" translation_tag="Home" flex_grow="1">
            <event_cb trigger="clicked" callback="on_ams_device_ops_home"/>
          </ui_button>
          <!-- Recover Button -->
          <ui_button name="btn_recover"
                     height="44" icon="refresh" text="Recover" translation_tag="Recover" flex_grow="1">
            <event_cb trigger="clicked" callback="on_ams_device_ops_recover"/>
          </ui_button>
          <!-- Abort Button -->
          <ui_button name="btn_abort" height="44" icon="stop" text="Abort" translation_tag="Abort" flex_grow="1">
            <event_cb trigger="clicked" callback="on_ams_device_ops_abort"/>
          </ui_button>
        </lv_obj>

        <!-- Divider -->
        <lv_obj width="100%" height="1" style_bg_color="#text_muted" style_bg_opa="30"/>

        <!-- Bypass Mode Container (hidden when bypass not supported) -->
        <lv_obj name="bypass_container"
                width="100%" height="content" style_pad_all="0" style_layout="flex" style_flex_flow="column"
                scrollable="false">
          <bind_flag_if_eq subject="ams_device_ops_supports_bypass" flag="hidden" ref_value="0"/>

          <!-- Virtual toggle (no hardware sensor) -->
          <lv_obj name="bypass_virtual_row"
                  width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center">
            <bind_flag_if_eq subject="ams_device_ops_hw_bypass_sensor" flag="hidden" ref_value="1"/>
            <lv_obj height="content"
                    style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                    scrollable="false" flex_grow="1">
              <icon src="arrow_left_right" size="sm" variant="secondary"/>
              <lv_obj height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
                <text_body text="Bypass Mode" translation_tag="Bypass Mode"/>
                <text_small text="Feed filament directly to extruder"
                            translation_tag="Feed filament directly to extruder"/>
              </lv_obj>
            </lv_obj>
            <!-- Checked state follows the live ams_bypass_active subject (the
                 one AmsState publishes from the backends), not an overlay-local
                 snapshot: the enable can complete asynchronously behind an
                 unload-first chain, and a snapshot written optimistically on
                 "success" reports a fire-and-forget gcode as done. Dims while a
                 job owns the toolhead, same binding as panel_widget_bypass.xml;
                 the shared controller still enforces that guard on every tap. -->
            <ui_switch name="bypass_toggle" size="small">
              <bind_state_if_eq subject="ams_bypass_active" state="checked" ref_value="1"/>
              <bind_state_if_eq subject="job_holds_machine" state="disabled" ref_value="1"/>
              <event_cb trigger="value_changed" callback="on_ams_device_ops_bypass_toggled"/>
            </ui_switch>
          </lv_obj>

          <!-- Hardware sensor indicator (read-only) -->
          <lv_obj name="bypass_hw_row"
                  width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center">
            <bind_flag_if_eq subject="ams_device_ops_hw_bypass_sensor" flag="hidden" ref_value="0"/>
            <lv_obj height="content"
                    style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                    scrollable="false" flex_grow="1">
              <icon src="arrow_left_right" size="sm" variant="secondary"/>
              <lv_obj height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
                <text_body text="Bypass Mode" translation_tag="Bypass Mode"/>
                <text_small text="Controlled by hardware sensor" translation_tag="Controlled by hardware sensor"/>
              </lv_obj>
            </lv_obj>
            <status_pill name="bypass_status_pill" text="Inactive" translation_tag="Inactive" variant="muted"/>
          </lv_obj>
        </lv_obj>

        <!-- Auto-Heat Info Row (shown when supported) -->
        <lv_obj name="auto_heat_row"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="start"
                style_flex_cross_place="center" style_pad_gap="#space_sm">
          <bind_flag_if_eq subject="ams_device_ops_supports_auto_heat" flag="hidden" ref_value="0"/>
          <!-- Left side: Icon -->
          <icon src="fire" size="sm" variant="secondary"/>
          <!-- Middle: Label/Description -->
          <lv_obj height="content"
                  style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false" flex_grow="1">
            <text_body text="Auto-Heat on Load" translation_tag="Auto-Heat on Load"/>
            <text_small text="Extruder heats automatically based on material"
                        translation_tag="Extruder heats automatically based on material"/>
          </lv_obj>
          <!-- Right side: Status indicator -->
          <icon src="check_circle" size="sm" variant="primary"/>
        </lv_obj>

        <!-- AFC Unload-After-Print toggle (AFC backends only) -->
        <setting_toggle_row name="row_afc_unload_after_print"
                            label="Unloads After Print" label_tag="Unloads After Print" icon="filament"
                            description="AFC retracts filament from the toolhead at end of print"
                            description_tag="AFC retracts filament from the toolhead at end of print"
                            subject="afc_unload_after_print" callback="on_ams_afc_unload_after_print_toggled">
          <bind_flag_if_eq subject="ams_device_ops_is_afc" flag="hidden" ref_value="0"/>
        </setting_toggle_row>

        <!-- Keep the bypass spool on the Multi-Filament panel even when bypass
             is disengaged. AFC publishes a virtual bypass whether or not one is
             wired, so the node is hidden by default (AFC backends only). -->
        <setting_toggle_row name="row_ams_always_show_bypass_spool"
                            label="Always Show Bypass Spool" label_tag="Always Show Bypass Spool" icon="filament"
                            description="Keep the bypass spool visible when bypass is off"
                            description_tag="Keep the bypass spool visible when bypass is off"
                            subject="ams_always_show_bypass_spool" callback="on_ams_always_show_bypass_spool_toggled">
          <bind_flag_if_eq subject="ams_device_ops_is_afc" flag="hidden" ref_value="0"/>
        </setting_toggle_row>

        <!-- Retention across eject: keep the previously assigned spool details
             so reloading the same spool after maintenance needs no re-selection
             (default on). Turn off to start fresh whenever a lane empties.
             Meaningful on systems whose firmware reports spool ids per lane
             (AFC, Happy Hare); other systems clear on a detected spool swap
             regardless of this toggle. When the firmware retains spools itself
             (AFC's per-lane remember_spool = true everywhere) it keeps
             reporting the spool id across ejects, so this toggle has no
             observable effect — it is shown disabled with the note below
             instead of silently lying. -->
        <setting_toggle_row name="row_ams_keep_spool_info_on_eject"
                            label="Keep Spool Info on Eject" label_tag="Keep Spool Info on Eject" icon="filament"
                            description="Remember lane spool details across an eject"
                            description_tag="Remember lane spool details across an eject"
                            subject="ams_keep_spool_info_on_eject" callback="on_ams_keep_spool_info_toggled"
                            disabled="ams_device_ops_printer_retains_spool_info">
          <bind_flag_if_eq subject="ams_device_ops_reports_spool_ids" flag="hidden" ref_value="0"/>
        </setting_toggle_row>
        <text_small name="label_printer_retains_note"
                    text="AFC's remember_spool is retaining spool info in firmware; that takes precedence over this toggle"
                    translation_tag="AFC's remember_spool is retaining spool info in firmware; that takes precedence over this toggle"
                    style_text_color="#text_subtle">
          <bind_flag_if_eq subject="ams_device_ops_printer_retains_spool_info" flag="hidden" ref_value="0"/>
          <bind_flag_if_eq subject="ams_device_ops_reports_spool_ids" flag="hidden" ref_value="0"/>
        </text_small>

        <!-- Offer the bypass controls on a machine whose firmware reports none.
             Shown only while the firmware says no, so it stays available for the
             user to switch back off. Happy Hare defaults [mmu_machine] has_bypass
             to 0 for mmu_vendor "Other" (a Qidi Box reports exactly that), yet
             its select_bypass() never checks the flag — MMU_SELECT_BYPASS
             deselects the gear steppers and reports gate -2 either way. -->
        <setting_toggle_row name="row_ams_force_bypass_controls"
                            label="Enable Bypass Controls" label_tag="Enable Bypass Controls" icon="source_branch"
                            description="Firmware reports no bypass. Enable if you feed filament straight to the extruder"
                            description_tag="Firmware reports no bypass. Enable if you feed filament straight to the extruder"
                            subject="ams_force_bypass_controls" callback="on_ams_force_bypass_controls_toggled">
          <bind_flag_if_eq subject="ams_device_ops_fw_supports_bypass" flag="hidden" ref_value="1"/>
        </setting_toggle_row>

        <!-- QIDI Box eject distance (QIDI backends only) -->
        <lv_obj name="row_qidi_eject_distance"
                width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm"
                scrollable="false">
          <bind_flag_if_eq subject="ams_device_ops_is_qidi" flag="hidden" ref_value="0"/>
          <!-- Header: icon + label/description + current value -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
            <lv_obj height="content"
                    style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                    scrollable="false" flex_grow="1">
              <icon src="filament" size="sm" variant="secondary"/>
              <lv_obj height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
                <text_body text="Eject Distance" translation_tag="Eject Distance"/>
                <text_small text="How far filament is pushed back into the box on eject (mm)"
                            translation_tag="How far filament is pushed back into the box on eject (mm)"/>
              </lv_obj>
            </lv_obj>
            <text_body name="qidi_eject_distance_label" bind_text="ams_device_ops_qidi_eject_distance_display"/>
          </lv_obj>
          <!-- Slider -->
          <lv_obj width="100%"
                  height="#input_height" style_pad_left="#space_md" style_pad_right="#space_md" scrollable="false"
                  flex_flow="row" style_flex_cross_place="center">
            <text_small width="40" text="100"/>
            <lv_slider name="qidi_eject_distance_slider"
                       flex_grow="1" min_value="100" max_value="2000" value="878" style_margin_left="#space_sm"
                       style_margin_right="#space_sm">
              <event_cb trigger="released" callback="on_ams_qidi_eject_distance_changed"/>
            </lv_slider>
            <text_small width="40" text="2000"/>
          </lv_obj>
        </lv_obj>

        <!-- QIDI Box eject velocity (QIDI backends only) -->
        <lv_obj name="row_qidi_eject_velocity"
                width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm"
                scrollable="false">
          <bind_flag_if_eq subject="ams_device_ops_is_qidi" flag="hidden" ref_value="0"/>
          <!-- Header: icon + label/description + current value -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
            <lv_obj height="content"
                    style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                    scrollable="false" flex_grow="1">
              <icon src="filament" size="sm" variant="secondary"/>
              <lv_obj height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
                <text_body text="Eject Velocity" translation_tag="Eject Velocity"/>
                <text_small text="Speed used to push filament out of the box (mm/s)"
                            translation_tag="Speed used to push filament out of the box (mm/s)"/>
              </lv_obj>
            </lv_obj>
            <text_body name="qidi_eject_velocity_label" bind_text="ams_device_ops_qidi_eject_velocity_display"/>
          </lv_obj>
          <!-- Slider -->
          <lv_obj width="100%"
                  height="#input_height" style_pad_left="#space_md" style_pad_right="#space_md" scrollable="false"
                  flex_flow="row" style_flex_cross_place="center">
            <text_small width="40" text="10"/>
            <lv_slider name="qidi_eject_velocity_slider"
                       flex_grow="1" min_value="10" max_value="300" value="100" style_margin_left="#space_sm"
                       style_margin_right="#space_sm">
              <event_cb trigger="released" callback="on_ams_qidi_eject_velocity_changed"/>
            </lv_slider>
            <text_small width="40" text="300"/>
          </lv_obj>
        </lv_obj>

        <!-- Reset Endless Spool failover (shown only on backends whose
             endless-spool mapping the UI may write — AFC per-slot edges,
             single-unit Happy Hare groups, and the mock. Read-only systems
             like CFS and AD5X IFS hide the row). The base reset_endless_spool()
             loops set_endless_spool_backup(slot, -1) over every slot; Happy
             Hare overrides it with MMU_ENDLESS_SPOOL RESET=1. Wipes ALL failover
             config, so the tap opens a confirmation modal rather than firing
             immediately. -->
        <setting_action_row name="row_reset_endless_spool"
                            label="Reset Endless Spool" label_tag="Reset Endless Spool" icon="restart"
                            description="Clear all spool failover assignments"
                            description_tag="Clear all spool failover assignments"
                            callback="on_ams_reset_endless_spool_clicked">
          <bind_flag_if_eq subject="ams_device_ops_can_reset_endless_spool" flag="hidden" ref_value="0"/>
        </setting_action_row>

        <!-- Status Row -->
        <lv_obj name="status_row"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="start"
                style_flex_cross_place="center" style_pad_gap="#space_sm">
          <icon src="info" size="sm" variant="secondary"/>
          <lv_obj height="content"
                  style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false" flex_grow="1">
            <text_body text="Status" translation_tag="Status"/>
            <text_small name="status_label" bind_text="ams_device_ops_status"/>
          </lv_obj>
        </lv_obj>
      </ui_card>

      <!-- ================================================================== -->
      <!-- Section List (progressive disclosure — rows push detail overlays) -->
      <!-- ================================================================== -->
      <ui_card name="sections_card"
               width="100%" height="content" style_radius="#border_radius" style_pad_all="#space_sm" flex_flow="column"
               style_pad_gap="0">
        <bind_flag_if_eq subject="ams_device_ops_has_backend" flag="hidden" ref_value="0"/>
        <!-- Dynamic section rows container (populated in C++) -->
        <lv_obj name="section_list_container"
                width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="0" scrollable="false">
          <!-- Section rows added dynamically: icon + label + chevron -->
        </lv_obj>
      </ui_card>

      <!-- ================================================================== -->
      <!-- No Backend Message (shown when no AMS connected)                   -->
      <!-- ================================================================== -->
      <ui_card name="no_backend_card"
               width="100%" height="content" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="column"
               style_flex_cross_place="center" style_pad_gap="#space_sm">
        <bind_flag_if_eq subject="ams_device_ops_has_backend" flag="hidden" ref_value="1"/>
        <icon src="info" size="lg" variant="secondary"/>
        <text_muted name="no_backend_text"
                    width="100%" text="No Multi-Filament System connected."
                    translation_tag="No Multi-Filament System connected." style_text_align="center"/>
      </ui_card>

    </lv_obj>
  </view>
</component>
