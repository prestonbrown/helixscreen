<!-- Modal for adding / editing a user filament product (config/user_filaments.json). -->
<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <view name="filament_product_edit_modal"
        extends="ui_dialog" width="85%" height="content" style_min_width="380" style_max_width="560" align="center"
        flex_flow="column" style_flex_main_place="start" style_pad_gap="0">
    <!-- Header: title (Add / Edit, from filament_product_title) + close (X). -->
    <modal_header title="Edit Filament"
                  title_subject="filament_product_title" hide_icon="true" hide_close="false"
                  close_callback="filament_product_close_cb"/>
    <divider_horizontal/>

    <!-- Form -->
    <lv_obj width="100%"
            height="content" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_md"
            style_pad_bottom="#space_sm" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">

      <!-- Row: Brand | Name -->
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_md" scrollable="false">
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Brand" style_text_color="#text_muted"/>
          <text_input name="field_brand" width="100%" placeholder="Polymaker" max_length="48"/>
        </lv_obj>
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Name" style_text_color="#text_muted"/>
          <text_input name="field_name" width="100%" placeholder="PolyTerra PLA" max_length="64"/>
        </lv_obj>
      </lv_obj>

      <!-- Row: ID | Type -->
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_md" style_flex_cross_place="end"
              scrollable="false">
        <lv_obj height="content"
                flex_grow="2" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="ID (optional)" style_text_color="#text_muted"/>
          <text_input name="field_id" width="100%" placeholder="auto from brand + name" max_length="64"/>
        </lv_obj>
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Type" style_text_color="#text_muted"/>
          <lv_dropdown name="type_dropdown" width="100%" height="content" style_radius="#border_radius" options="PLA"/>
        </lv_obj>
      </lv_obj>

      <!-- Row: temperatures + density -->
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Noz min" style_text_color="#text_muted"/>
          <text_input name="field_nozzle_min" width="100%" keyboard_hint="numeric" placeholder="190" max_length="4"/>
        </lv_obj>
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Noz max" style_text_color="#text_muted"/>
          <text_input name="field_nozzle_max" width="100%" keyboard_hint="numeric" placeholder="220" max_length="4"/>
        </lv_obj>
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Noz rec" style_text_color="#text_muted"/>
          <text_input name="field_nozzle" width="100%" keyboard_hint="numeric" placeholder="210" max_length="4"/>
        </lv_obj>
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Bed" style_text_color="#text_muted"/>
          <text_input name="field_bed" width="100%" keyboard_hint="numeric" placeholder="60" max_length="4"/>
        </lv_obj>
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Density" style_text_color="#text_muted"/>
          <text_input name="field_density" width="100%" keyboard_hint="numeric" placeholder="1.24" max_length="6"/>
        </lv_obj>
      </lv_obj>
    </lv_obj>

    <!-- Actions: secondary = Delete / Restore Defaults (hidden in Add mode), primary = Save -->
    <modal_button_row secondary_text="@filament_product_secondary_text"
                      secondary_show_subject="filament_product_show_secondary" secondary_variant="primary"
                      secondary_callback="filament_product_secondary_cb" primary_text="Save"
                      primary_callback="filament_product_save_cb"/>
  </view>
</component>
