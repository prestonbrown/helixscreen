<!-- The message dialog behind modal_confirm(): a dialog_frame with one wrapped
     message and a button row. helix::ui::ModalDialogAttrs fills the props,
     mapping the severity to icon and icon_variant. -->
<component>
  <api>
    <prop name="title" type="string"/>
    <prop name="title_tag" type="string" default=""/>
    <prop name="message" type="string"/>
    <prop name="message_tag" type="string" default=""/>
    <prop name="icon" type="string" default="info"/>
    <prop name="icon_variant" type="string" default="primary"/>
    <prop name="primary_text" type="string" default="OK"/>
    <prop name="secondary_text" type="string" default="Cancel"/>
    <prop name="hide_secondary" type="string" default="true"/>
    <prop name="primary_variant" type="string" default="primary"/>
  </api>
  <view name="modal_dialog"
        extends="dialog_frame" title="$title" title_tag="$title_tag" icon="$icon" icon_variant="$icon_variant">
    <dialog_frame-body style_min_height="60">
      <text_body name="dialog_message"
                 width="100%" text="$message" translation_tag="$message_tag" style_text_align="left" long_mode="wrap"/>
    </dialog_frame-body>
    <!-- Callbacks are wired per instance from C++ (btn_primary / btn_secondary). -->
    <dialog_frame-footer>
      <modal_button_row hide_secondary="$hide_secondary"
                        primary_text="$primary_text" secondary_text="$secondary_text" primary_variant="$primary_variant"/>
    </dialog_frame-footer>
  </view>
</component>
