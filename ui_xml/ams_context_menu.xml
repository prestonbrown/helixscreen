<component>
  <api>
    <prop name="slot_index" type="int" default="0"/>
  </api>
  <consts>
    <!-- The plugin column is a fixed width so long plugin labels ellipsize
         instead of widening the side-by-side card off a small screen. -->
    <px name="ams_context_plugin_col_w_micro" value="110"/>
    <px name="ams_context_plugin_col_w_tiny" value="120"/>
    <px name="ams_context_plugin_col_w_small" value="160"/>
    <px name="ams_context_plugin_col_w_medium" value="200"/>
    <px name="ams_context_plugin_col_w_large" value="220"/>
  </consts>
  <!-- Full-screen backdrop overlay - tap to dismiss -->
  <view name="context_backdrop" extends="context_menu_backdrop">
    <!-- Context menu card - positioned by C++. Header reads "Slot N", rewritten
         from C++ through slot_header. -->
    <context_menu_card title="Slot 1" title_name="slot_header" pad_gap="#space_md">
      <!-- Action columns. Stacked (flex_flow="column") by default so a short menu
           reads as one list; ContextMenu::fit_card_to_screen() flips this to a row
           when the stacked card would not fit the screen, at which point the two
           groups sit side by side. Same widget tree either way - only this
           container's flow changes - so nothing is rebuilt to switch layouts. -->
      <lv_obj name="menu_columns"
              width="content" height="content" style_pad_all="0" style_pad_gap="#space_md" flex_flow="column"
              style_flex_main_place="start" scrollable="false">
        <!-- Lane/filament motion actions -->
        <lv_obj name="col_filament"
                width="content" height="content" style_pad_all="0" style_pad_gap="#space_md" flex_flow="column"
                style_flex_main_place="start" scrollable="false">
          <!-- Group heading. ContextMenu hides this when only one group survives:
               with no sibling group to tell it apart from, the heading just repeats
               what the card header already said. -->
          <!-- DUPLICATE_NAME_OK: ContextMenu searches per column, lv_obj_find_by_name(col, ...) — the base class iterates arbitrary columns and cannot know per-column names -->
          <context_menu_column_heading name="col_heading" text="Actions"/>
          <!-- Bypass toggle (external spool only; hidden for lanes). Text is set
               from C++ because it names the action, not the state. -->
          <ui_button name="btn_bypass_toggle"
                     height="#button_height_sm" icon="arrow_left_right" text="Enable Bypass" variant="ghost"
                     clickable="true" style_flex_main_place="start" hidden="true">
            <event_cb trigger="clicked" callback="ams_context_bypass_toggle_cb"/>
          </ui_button>
          <!-- Load Button -->
          <ui_button name="btn_load"
                     height="#button_height_sm" icon="z_closer" text="Load" variant="ghost" clickable="true"
                     style_flex_main_place="start">
            <bind_state_if_eq subject="ams_slot_can_load" state="disabled" ref_value="0"/>
            <event_cb trigger="clicked" callback="ams_context_load_cb"/>
          </ui_button>
          <!-- Unload Button (disabled when slot is not loaded) -->
          <ui_button name="btn_unload"
                     height="#button_height_sm" icon="z_farther" text="Unload" variant="ghost" clickable="true"
                     style_flex_main_place="start">
            <bind_state_if_eq subject="ams_slot_is_loaded" state="disabled" ref_value="0"/>
            <event_cb trigger="clicked" callback="ams_context_unload_cb"/>
          </ui_button>
          <!-- Why this head's Load (and Unload, when the reason is the same) is
               unavailable. Text and visibility come from decide_slot_actions(). -->
          <text_small name="load_blocked_hint"
                      width="100%" long_mode="wrap" bind_text="ams_slot_load_hint" style_text_color="#text_muted">
            <bind_flag_if_eq subject="ams_slot_load_hint_visible" flag="hidden" ref_value="0"/>
          </text_small>
          <!-- Purge (external spool only; hidden for lanes). The lane menu has no
               purge action - purging is about what is at the nozzle, not a lane. -->
          <ui_button name="btn_purge"
                     height="#button_height_sm" icon="water" text="Purge" variant="ghost" clickable="true"
                     style_flex_main_place="start" hidden="true">
            <bind_state_if_eq subject="ams_slot_can_purge" state="disabled" ref_value="0"/>
            <event_cb trigger="clicked" callback="ams_context_purge_cb"/>
          </ui_button>
          <!-- Eject refusal the user can act on. Text and visibility both come from
               AmsBackend::eject_unavailable_reason(). -->
          <text_small name="eject_force_move_hint"
                      width="100%" long_mode="wrap" bind_text="ams_slot_eject_hint" style_text_color="#text_muted">
            <bind_flag_if_eq subject="ams_slot_eject_hint_visible" flag="hidden" ref_value="0"/>
          </text_small>
          <!-- Unload refusal the user can act on: the head's reason from
               decide_slot_actions(), else AmsBackend::unload_blocked_reason(). -->
          <text_small name="unload_blocked_hint"
                      width="100%" long_mode="wrap" bind_text="ams_slot_unload_hint" style_text_color="#text_muted">
            <bind_flag_if_eq subject="ams_slot_unload_hint_visible" flag="hidden" ref_value="0"/>
          </text_small>
          <!-- Calibrate PA: the slot feeding the nozzle, on a printer that measures
               pressure advance itself (decide_offers_pa_calibration()). -->
          <ui_button name="btn_pa_calibrate"
                     height="#button_height_sm" icon="gauge" text="Calibrate PA" variant="ghost" clickable="true"
                     style_flex_main_place="start">
            <bind_flag_if_eq subject="ams_slot_pa_cal" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="ams_context_pa_cal_cb"/>
          </ui_button>
          <!-- Check Slot Button (hidden unless backend supports slot check, e.g. Happy Hare MMU_CHECK_GATE) -->
          <ui_button name="btn_gate_check"
                     height="#button_height_sm" icon="refresh" text="Check Slot" variant="ghost" clickable="true"
                     style_flex_main_place="start" hidden="true">
            <event_cb trigger="clicked" callback="ams_context_gate_check_cb"/>
          </ui_button>
          <!-- Preload Button (hidden unless the backend supports lane preload) -->
          <ui_button name="btn_preload"
                     height="#button_height_sm" icon="download" text="Preload" variant="ghost" clickable="true"
                     style_flex_main_place="start">
            <bind_flag_if_eq subject="ams_slot_preload" flag="hidden" ref_value="0"/>
            <bind_state_if_eq subject="ams_slot_preload" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="ams_context_preload_cb"/>
          </ui_button>
          <!-- Mount the tool this slot feeds, and Park the mounted one: a tool
               action set apart under its own rule, offered where the head's
               filament is all by hand (decide_slot_actions()). -->
          <lv_obj name="tool_actions_divider"
                  width="100%" height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0"
                  scrollable="false" clickable="false">
            <bind_flag_if cond="ams_slot_mount eq 0 and ams_slot_park eq 0" flag="hidden"/>
          </lv_obj>
          <ui_button name="btn_mount"
                     height="#button_height_sm" icon="swap_horizontal" text="Mount" variant="ghost" clickable="true"
                     style_flex_main_place="start">
            <bind_flag_if_eq subject="ams_slot_mount" flag="hidden" ref_value="0"/>
            <bind_state_if_eq subject="ams_slot_mount" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="ams_context_mount_cb"/>
          </ui_button>
          <ui_button name="btn_park"
                     height="#button_height_sm" icon="eject" text="Park" variant="ghost" clickable="true"
                     style_flex_main_place="start">
            <bind_flag_if_eq subject="ams_slot_park" flag="hidden" ref_value="0"/>
            <bind_state_if_eq subject="ams_slot_park" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="ams_context_park_cb"/>
          </ui_button>
        </lv_obj>
        <!-- Spool identity / Spoolman actions -->
        <lv_obj name="col_spool"
                width="content" height="content" style_pad_all="0" style_pad_gap="#space_md" flex_flow="column"
                style_flex_main_place="start" scrollable="false">
          <!-- Group heading — see col_filament's. -->
          <!-- DUPLICATE_NAME_OK: ContextMenu searches per column, lv_obj_find_by_name(col, ...) — the base class iterates arbitrary columns and cannot know per-column names -->
          <context_menu_column_heading name="col_heading" text="Spool Info"/>
          <!-- Select Spool Button (Spoolman quick-assign, hidden by default) -->
          <ui_button name="btn_spoolman"
                     height="#button_height_sm" icon="spoolman" text="Select Spool" variant="ghost" clickable="true"
                     style_flex_main_place="start" hidden="true">
            <event_cb trigger="clicked" callback="ams_context_spoolman_cb"/>
          </ui_button>
          <!-- Scan QR Code Button (hidden by default, shown when Spoolman enabled) -->
          <ui_button name="btn_scan_qr"
                     height="#button_height_sm" icon="qrcode_scan" text="Scan QR Code" variant="ghost" clickable="true"
                     style_flex_main_place="start" hidden="true">
            <event_cb trigger="clicked" callback="ams_context_scan_qr_cb"/>
          </ui_button>
          <!-- Edit Spool Button — always opens the spool editor -->
          <ui_button name="btn_edit"
                     height="#button_height_sm" icon="tune" text="Edit Spool" variant="ghost" clickable="true"
                     style_flex_main_place="start">
            <event_cb trigger="clicked" callback="ams_context_edit_cb"/>
          </ui_button>
          <!-- Clear Spool Button — shown only when the slot has a Spoolman assignment -->
          <ui_button name="btn_clear_spool"
                     height="#button_height_sm" icon="close" text="Clear Spool" variant="ghost" clickable="true"
                     style_flex_main_place="start" hidden="true">
            <bind_state_if_eq subject="ams_slot_can_clear" state="disabled" ref_value="0"/>
            <event_cb trigger="clicked" callback="ams_context_clear_spool_cb"/>
          </ui_button>
          <!-- Clear Spool refusal the user can act on: this lane is what the
               current print is drawing from. Text and visibility come from the
               same update that disables the button. -->
          <text_small name="clear_blocked_hint"
                      width="100%" long_mode="wrap" bind_text="ams_slot_clear_hint" style_text_color="#text_muted"
                      hidden="true">
            <bind_flag_if_eq subject="ams_slot_clear_hint_visible" flag="hidden" ref_value="0"/>
          </text_small>
        </lv_obj>
        <!-- Plugin items for this slot: each plugin's name, then its rows, filled
             by C++. ContextMenu hides the column while it holds no tappable row,
             so a menu without plugin items is unchanged. -->
        <lv_obj name="col_plugins"
                width="#ams_context_plugin_col_w" height="content" style_pad_all="0" style_pad_gap="#space_md"
                flex_flow="column" style_flex_main_place="start" scrollable="false" hidden="true"/>
      </lv_obj>
    </context_menu_card>
  </view>
</component>
