<!-- Hardware Issue Row - Displays a single hardware validation issue -->
<!-- A flat row inside a setting_group card: the group draws the card, the row only its content -->
<!-- After creating, call ui_severity_card_finalize(row) to show correct icon -->
<component>
  <api>
    <prop name="severity" type="string"/>
    <!-- "error", "warning", "info" -->
    <prop name="hardware_name" type="string" default="Hardware Name"/>
    <!-- A translation key: the row shows it in the current language -->
    <prop name="message" type="string" default=""/>
  </api>
  <!-- severity_card selects the per-severity icon; the enclosing group supplies the card -->
  <view name="hardware_issue_row"
        extends="severity_card" width="100%" height="content" severity="$severity" style_pad_left="#space_md"
        style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm" style_bg_opa="0"
        style_border_width="0" scrollable="false" flex_flow="row" style_flex_main_place="start"
        style_flex_cross_place="start" style_pad_gap="#space_md">
    <!-- Icon column (fixed width for severity icon) -->
    <lv_obj width="28" style_pad_all="0" style_pad_top="#space_xxs" scrollable="false">
      <!-- Severity icons - all hidden by default, finalize() shows the correct one -->
      <lv_label name="icon_info"
                text="#icon_info_circle" hidden="true" style_text_font="mdi_icons_24" style_text_color="#info"/>
      <lv_label name="icon_success"
                text="#icon_check" hidden="true" style_text_font="mdi_icons_24" style_text_color="#success"/>
      <lv_label name="icon_warning"
                text="#icon_triangle_exclamation" hidden="true" style_text_font="mdi_icons_24"
                style_text_color="#warning"/>
      <lv_label name="icon_error"
                text="#icon_alert_octagon" hidden="true" style_text_font="mdi_icons_24" style_text_color="#danger"/>
    </lv_obj>
    <!-- Content column -->
    <lv_obj flex_grow="1"
            style_pad_all="0" style_pad_right="#space_md" scrollable="false" flex_flow="column"
            style_pad_gap="#space_xxs">
      <text_body name="hardware_name" width="100%" text="$hardware_name" long_mode="wrap"/>
      <text_small name="issue_message" width="100%" text="Issue description" translation_tag="$message" long_mode="wrap"/>
    </lv_obj>
    <!-- Action buttons: every issue can be ignored -->
    <lv_obj name="action_buttons"
            width="content" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs"
            scrollable="false" style_flex_cross_place="center">
      <!-- Ignore button (mark as optional) -->
      <ui_button name="ignore_btn"
                 width="content" height="#button_height" style_min_width="64" variant="ghost" text="Ignore"/>
      <!-- Save button (add to expected list): only newly discovered (info) hardware -->
      <ui_button name="save_btn"
                 width="content" height="#button_height" hidden_if_prop_not_eq="$severity|info" style_min_width="64"
                 variant="primary" text="Save"/>
    </lv_obj>
  </view>
</component>
