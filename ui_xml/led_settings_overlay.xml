<!-- LED Settings Overlay Panel -->
<!-- Configures LED startup preference, auto state, and macro devices -->
<!-- Uses setting_* components for consistency with main settings panel -->
<component>
  <view name="led_settings_overlay" extends="overlay_panel" title="LED Settings" bg_color="#screen_bg">
    <!-- Content Area -->
    <overlay_panel-overlay_content style_pad_top="0"
                                   style_pad_left="0" style_pad_right="0" style_pad_bottom="#space_lg" scrollable="true"
                                   flex_flow="column">
      <!-- ================================================================== -->
      <!-- STARTUP SECTION -->
      <!-- ================================================================== -->
      <setting_group name="group_startup">
        <setting_group_header title="STARTUP" icon="power" hide_icon="false"/>
        <setting_toggle_row name="row_led_on_at_start"
                            label="LED on at Start" icon="light"
                            description="Turn on the lights your light buttons control"
                            subject="led_on_at_start_enabled" callback="on_led_on_at_start_changed"/>
        <setting_slider_row name="row_startup_brightness"
                            label="Startup Brightness" icon="lightbulb_on_50"
                            description="Brightness level when LEDs turn on at startup" min="1" max="100" value="80"
                            value_subject="led_startup_brightness" value_format="%d%%" min_icon="lightbulb_on_10"
                            max_icon="lightbulb_on" callback="on_startup_brightness_changed"
                            commit_callback="on_startup_brightness_commit">
          <bind_flag_if_eq subject="led_on_at_start_enabled" flag="hidden" ref_value="0"/>
        </setting_slider_row>
      </setting_group>
      <!-- ================================================================== -->
      <!-- AUTO STATE SECTION -->
      <!-- ================================================================== -->
      <setting_group name="group_auto_state">
        <setting_group_header title="AUTO STATE" icon="tune" hide_icon="false"/>
        <setting_toggle_row name="row_auto_state_enabled"
                            label="Automatic LED Control" icon="tune_variant"
                            description="Change LED color based on printer state" subject="led_auto_state_enabled"
                            callback="on_auto_state_changed"/>
        <info_note name="auto_state_macro_conflict_note"
                   icon="alert" icon_variant="warning"
                   text="Your print start or end macro also sets LEDs. It and Automatic LED Control may override each other.">
          <bind_flag_if_eq subject="led_print_macros_drive_leds" flag="hidden" ref_value="0"/>
        </info_note>
        <setting_led_chip_row name="row_auto_state_strips"
                              label="Applies to" icon="lightbulb_outline"
                              description="Lights that follow the printer's state">
          <bind_flag_if_eq subject="led_auto_state_enabled" flag="hidden" ref_value="0"/>
        </setting_led_chip_row>
        <!-- One row per printer state, in LedSettingsOverlay's kStateRows order -->
        <lv_obj name="auto_state_rows_container"
                width="100%" height="content" flex_flow="column" style_pad_gap="0" style_bg_opa="0"
                style_border_width="0" style_pad_left="0" style_pad_right="0" style_pad_top="#space_sm"
                style_pad_bottom="0" scrollable="false">
          <bind_flag_if_eq subject="led_auto_state_enabled" flag="hidden" ref_value="0"/>
          <led_auto_state_row index="0" key="idle" label="Idle" icon="sleep"/>
          <led_auto_state_row index="1" key="heating" label="Heating" icon="fire"/>
          <led_auto_state_row index="2" key="printing" label="Printing" icon="printer_3d"/>
          <led_auto_state_row index="3" key="paused" label="Paused" icon="pause"/>
          <led_auto_state_row index="4" key="error" label="Error" icon="alert_circle"/>
          <led_auto_state_row index="5" key="complete" label="Complete" icon="check_circle"/>
        </lv_obj>
      </setting_group>
      <!-- ================================================================== -->
      <!-- MACRO DEVICES SECTION (kept on setting_section_header: uses Add action button) -->
      <!-- ================================================================== -->
      <setting_section_header title="MACRO DEVICES"
                              icon="code_braces" action_button_text="Add" action_button_icon="plus"
                              action_button_callback="on_add_macro_device" hide_action_button="false"
                              hide_action_button_icon="false"/>
      <setting_info_row name="macro_devices_empty"
                        label="No macro devices configured" icon="code_braces" value="Tap + to add">
        <bind_flag_if_not_eq subject="led_macro_count" flag="hidden" ref_value="0"/>
      </setting_info_row>
      <text_body name="macro_devices_none_detected"
                 width="100%" text="No LED macros detected on your printer. Add Klipper macros for LED control first."
                 long_mode="wrap" style_text_color="#text_subtle" style_pad_left="#space_xl" style_pad_right="#space_xl">
        <bind_flag_if cond="led_macro_count gt 0 or led_macro_discovered_count gt 0" flag="hidden"/>
      </text_body>
      <!-- One setting_macro_card per configured device, created by C++ -->
      <lv_obj name="macro_devices_container"
              width="100%" height="content" flex_flow="column" style_pad_gap="#space_sm" style_bg_opa="0"
              style_border_width="0" style_pad_all="0" scrollable="false"/>
      <!-- Info note about macro devices -->
      <lv_obj width="100%"
              height="content" scrollable="false" style_pad_left="#space_lg" style_pad_right="#space_lg"
              style_pad_top="#space_md" style_pad_bottom="#space_lg" flex_flow="row" style_flex_cross_place="center"
              style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0">
        <icon src="info" size="xs" variant="secondary"/>
        <text_small text="Assign Klipper macros to control LEDs via on/off, toggle, or presets"/>
      </lv_obj>
    </overlay_panel-overlay_content>
  </view>
</component>
