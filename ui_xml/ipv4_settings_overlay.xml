<!-- IPv4 settings for one interface: static address or DHCP. Subjects are C++
     (Ipv4SettingsOverlay::init_subjects); the title names the interface. Each
     field is typed on the numeric keypad in its IPv4 mode, opened by a tap. -->
<component>
  <view name="ipv4_settings_overlay"
        extends="overlay_panel" title="IPv4" title_subject="ipv4_title" title_transform="none" bg_color="#screen_bg">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="#space_md" style_pad_top="0" flex_flow="column"
            style_pad_gap="#space_sm" scrollable="true" scroll_dir="ver">
      <text_small name="ipv4_current_label" width="100%" bind_text="ipv4_current" long_mode="wrap"/>
      <!-- Two fields per row; each field keeps half the width -->
      <lv_obj name="ipv4_fields"
              width="100%" height="content" style_pad_all="0" flex_flow="row_wrap" style_pad_row="#space_sm"
              style_pad_column="#space_md" scrollable="false">
        <lv_obj width="0"
                height="content" flex_grow="1" style_min_width="40%" style_pad_all="0" flex_flow="column"
                style_pad_gap="#space_xs" scrollable="false">
          <text_small text="IP address"/>
          <text_input name="ipv4_address_input"
                      width="100%" bind_text="ipv4_address" max_length="15" placeholder_text="192.168.1.50">
            <bind_state_if_eq subject="ipv4_busy" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_ipv4_edit_address"/>
          </text_input>
        </lv_obj>
        <lv_obj width="0"
                height="content" flex_grow="1" style_min_width="40%" style_pad_all="0" flex_flow="column"
                style_pad_gap="#space_xs" scrollable="false">
          <text_small text="Subnet mask"/>
          <text_input name="ipv4_netmask_input"
                      width="100%" bind_text="ipv4_netmask" max_length="15" placeholder_text="255.255.255.0">
            <bind_state_if_eq subject="ipv4_busy" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_ipv4_edit_netmask"/>
          </text_input>
        </lv_obj>
        <lv_obj width="0"
                height="content" flex_grow="1" style_min_width="40%" style_pad_all="0" flex_flow="column"
                style_pad_gap="#space_xs" scrollable="false">
          <text_small text="Gateway"/>
          <text_input name="ipv4_gateway_input"
                      width="100%" bind_text="ipv4_gateway" max_length="15" placeholder_text="192.168.1.1">
            <bind_state_if_eq subject="ipv4_busy" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_ipv4_edit_gateway"/>
          </text_input>
        </lv_obj>
        <lv_obj width="0"
                height="content" flex_grow="1" style_min_width="40%" style_pad_all="0" flex_flow="column"
                style_pad_gap="#space_xs" scrollable="false">
          <text_small text="DNS server"/>
          <text_input name="ipv4_dns_input"
                      width="100%" bind_text="ipv4_dns" max_length="15" placeholder_text="192.168.1.1">
            <bind_state_if_eq subject="ipv4_busy" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_ipv4_edit_dns"/>
          </text_input>
        </lv_obj>
      </lv_obj>
      <text_small name="ipv4_error_label"
                  width="100%" bind_text="ipv4_error" long_mode="wrap" style_text_color="#danger"/>
      <lv_obj name="ipv4_buttons"
              width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_md"
              scrollable="false">
        <ui_button name="ipv4_dhcp_btn" width="0" flex_grow="1" variant="secondary" text="Use DHCP">
          <bind_state_if_eq subject="ipv4_busy" state="disabled" ref_value="1"/>
          <event_cb trigger="clicked" callback="on_ipv4_use_dhcp"/>
        </ui_button>
        <ui_button name="ipv4_apply_btn" width="0" flex_grow="1" text="Apply">
          <bind_state_if_eq subject="ipv4_busy" state="disabled" ref_value="1"/>
          <event_cb trigger="clicked" callback="on_ipv4_apply"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
  </view>
</component>
