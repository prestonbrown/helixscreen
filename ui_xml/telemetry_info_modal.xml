<!-- Telemetry Info Modal - Explains what we collect and why -->
<!-- Used from wizard summary step "Learn more" link -->
<component>
  <view name="telemetry_info_modal"
        extends="dialog_frame" width="75%" height="80%" style_max_height="80%" clickable="true" title="What We Collect"
        title_tag="What We Collect" icon="chart_line">
    <!-- The markdown scrolls in the body, which fills the space between header and button -->
    <dialog_frame-body height="0" flex_grow="1" style_max_height="100%" style_pad_bottom="#space_md">
      <ui_markdown name="info_text" width="100%" bind_text="telemetry_info_text"/>
    </dialog_frame-body>
    <dialog_frame-footer>
      <modal_button_row hide_secondary="true" primary_text="Got it"/>
    </dialog_frame-footer>
  </view>
</component>
