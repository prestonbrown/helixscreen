<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <!-- Button handlers belong to whichever screen shows the modal -->
  <api>
    <prop name="cancel_callback" type="string" default=""/>
    <prop name="connect_callback" type="string" default=""/>
    <!-- The error line: a string subject for its text and an int subject that
         shows it while non-zero. Empty leaves it to the caller. -->
    <prop name="status_subject" type="string" default=""/>
    <prop name="status_shown_subject" type="string" default=""/>
  </api>
  <!-- Dialog card (backdrop created programmatically) -->
  <view name="wifi_password_modal"
        extends="ui_dialog" width="70%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <!-- ============================================================ -->
    <!-- STATE: IDLE - Password entry form (hidden when connecting) -->
    <!-- ============================================================ -->
    <lv_obj name="password_form_container"
            width="100%" height="content" style_min_height="200" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center"
            style_pad_gap="#space_md">
      <!-- Hide form when wifi_connecting == 1 -->
      <bind_flag_if_eq subject="wifi_connecting" flag="hidden" ref_value="1"/>
      <!-- Title -->
      <text_heading name="modal_title" width="100%" text="Enter WiFi Password" style_text_align="center"/>
      <!-- Network SSID -->
      <text_small name="modal_ssid"
                  width="100%" bind_text="wifi_password_modal_ssid" style_text_align="center"
                  style_text_color="#text_muted"/>
      <!-- Password input with visibility toggle -->
      <lv_obj width="100%"
              height="#input_height" flex_flow="row" style_pad_all="0" style_pad_gap="0" style_margin_top="#space_sm">
        <text_input name="password_input"
                    height="100%" flex_grow="1" placeholder_text="Password" placeholder_tag="Password"
                    translation_tag="Password" password_mode="true"/>
        <ui_button name="eye_toggle"
                   width="#input_height" height="100%" variant="ghost" icon="eye_off" click_focusable="false">
          <event_cb trigger="clicked" callback="on_toggle_password_visibility"/>
        </ui_button>
      </lv_obj>
      <!-- Status message (hidden by default, shown on error) -->
      <text_small name="modal_status"
                  width="100%" text="" bind_text="$status_subject" style_text_align="center" style_text_color="#danger"
                  hidden="true">
        <bind_flag_if_eq subject="$status_shown_subject" flag="hidden" ref_value="0"/>
      </text_small>
    </lv_obj>
    <!-- ============================================================ -->
    <!-- STATE: CONNECTING - Spinner and status (shown when connecting) -->
    <!-- ============================================================ -->
    <lv_obj name="connecting_container"
            width="100%" height="200" style_pad_all="#space_lg" hidden="true" flex_flow="column"
            style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
      <!-- Show spinner when wifi_connecting == 1 -->
      <bind_flag_if_eq subject="wifi_connecting" flag="hidden" ref_value="0"/>
      <spinner size="lg" align="center"/>
      <text_muted text="Connecting..." style_margin_top="#space_md" align="center"/>
    </lv_obj>
    <!-- Connect is withdrawn while a connection attempt runs; Cancel stays. -->
    <modal_button_row secondary_name="modal_cancel_btn"
                      secondary_text="Cancel" secondary_callback="$cancel_callback" primary_name="modal_connect_btn"
                      primary_text="Connect" primary_callback="$connect_callback" primary_hide_subject="wifi_connecting"/>
  </view>
</component>
