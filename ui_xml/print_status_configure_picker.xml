<component>
  <!-- Full-screen backdrop overlay - tap to dismiss -->
  <view name="print_status_configure_picker" extends="context_menu_backdrop">
    <!-- Card positioned and height-capped by ContextMenu. The controls apply
         live, so the header offers Done rather than an X, and the rule is
         suppressed here - the Show Sections group carries its own. -->
    <context_menu_card title="Layout"
                       title_tag="Layout" close_icon="check" close_text="Done" close_text_tag="Done" hide_divider="true">
      <lv_obj width="100%"
              height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xs" scrollable="false">
        <ui_button name="layout_btn_library"
                   height="#button_height_sm" flex_grow="1" variant="outline" text="Library" translation_tag="Library">
          <event_cb trigger="clicked" callback="print_status_layout_library_cb"/>
        </ui_button>
        <ui_button name="layout_btn_detailed"
                   height="#button_height_sm" flex_grow="1" variant="outline" text="Detailed" translation_tag="Detailed">
          <event_cb trigger="clicked" callback="print_status_layout_detailed_cb"/>
        </ui_button>
      </lv_obj>
      <!-- Show Sections group — only relevant for Library layout; C++ hides this when Detailed is active -->
      <lv_obj name="show_sections_group"
              width="100%" height="content" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="column"
              scrollable="false" clickable="false" event_bubble="true">
        <lv_obj width="100%"
                height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"
                clickable="false" event_bubble="true"/>
        <text_small text="Show Sections"
                    translation_tag="Show Sections" style_pad_bottom="#space_xxs" clickable="false" event_bubble="true"/>
        <lv_obj width="100%"
                height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"
                clickable="false" event_bubble="true"/>
        <!-- Option rows populated dynamically by C++ -->
        <lv_obj name="option_list"
                width="100%" height="content" flex_flow="column" style_pad_all="#space_xs" style_pad_gap="0"
                scrollable="false"/>
      </lv_obj>
    </context_menu_card>
  </view>
</component>
