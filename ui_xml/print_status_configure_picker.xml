<component>
  <styles>
    <!-- The chosen layout's button: a primary fill over its outline. -->
    <style name="layout_chosen" bg_color="#primary" bg_opa="255"/>
  </styles>
  <!-- Full-screen backdrop overlay - tap to dismiss -->
  <view name="print_status_configure_picker" extends="context_menu_backdrop">
    <!-- Card positioned and height-capped by ContextMenu. The controls apply
         live, so the header offers Done rather than an X, and the rule is
         suppressed here - the Show Sections group carries its own. -->
    <context_menu_card title="Layout" close_icon="check" close_text="Done" hide_divider="true">
      <lv_obj width="100%"
              height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xs" scrollable="false">
        <ui_button name="layout_btn_library" height="#button_height_sm" flex_grow="1" variant="outline" text="Library">
          <bind_style_if_eq name="layout_chosen" subject="print_status_picker_detailed" ref_value="0"/>
          <event_cb trigger="clicked" callback="print_status_layout_library_cb"/>
        </ui_button>
        <ui_button name="layout_btn_detailed" height="#button_height_sm" flex_grow="1" variant="outline" text="Detailed">
          <bind_style_if_eq name="layout_chosen" subject="print_status_picker_detailed" ref_value="1"/>
          <event_cb trigger="clicked" callback="print_status_layout_detailed_cb"/>
        </ui_button>
      </lv_obj>
      <!-- Show Sections group, only relevant for the Library layout -->
      <lv_obj name="show_sections_group"
              width="100%" height="content" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="column"
              scrollable="false" clickable="false" event_bubble="true">
        <bind_flag_if_eq subject="print_status_picker_detailed" flag="hidden" ref_value="1"/>
        <lv_obj width="100%"
                height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"
                clickable="false" event_bubble="true"/>
        <text_small text="Show Sections" style_pad_bottom="#space_xxs" clickable="false" event_bubble="true"/>
        <lv_obj width="100%"
                height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"
                clickable="false" event_bubble="true"/>
        <lv_obj name="option_list"
                width="100%" height="content" flex_flow="column" style_pad_all="#space_xs" style_pad_gap="0"
                scrollable="false">
          <check_option_row name="opt_title"
                            label="Title" checked_subject="print_status_picker_opt_0" callback="print_status_option_cb"
                            user_data="0"/>
          <check_option_row name="opt_print_files"
                            label="Print Files" checked_subject="print_status_picker_opt_1"
                            callback="print_status_option_cb" user_data="1"/>
          <check_option_row name="opt_reprint_last"
                            label="Reprint Last" checked_subject="print_status_picker_opt_2"
                            callback="print_status_option_cb" user_data="2"/>
          <check_option_row name="opt_recent_prints"
                            label="Recent Prints" checked_subject="print_status_picker_opt_3"
                            callback="print_status_option_cb" user_data="3"/>
          <check_option_row name="opt_job_queue"
                            label="Job Queue" checked_subject="print_status_picker_opt_4"
                            callback="print_status_option_cb" user_data="4"/>
        </lv_obj>
      </lv_obj>
    </context_menu_card>
  </view>
</component>
