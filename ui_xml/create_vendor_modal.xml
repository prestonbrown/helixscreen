<!-- Modal dialog for creating a new vendor in the spool wizard -->
<component>
  <view name="create_vendor_modal"
        extends="dialog_frame" width="80%" title="Create New Vendor" title_tag="Create New Vendor" icon="inventory">
    <dialog_frame-body>
      <!-- Vendor name input -->
      <lv_obj width="100%"
              height="content" flex_flow="column" style_pad_all="0" style_pad_gap="#space_xs" scrollable="false">
        <text_small text="Vendor Name" style_text_color="#text_muted"/>
        <text_input name="new_vendor_name"
                    width="100%" placeholder_text="e.g. Polymaker" placeholder_tag="e.g. Polymaker">
          <event_cb trigger="value_changed" callback="on_wizard_new_vendor_name_changed"/>
        </text_input>
      </lv_obj>
      <!-- Vendor URL input (optional) -->
      <lv_obj width="100%"
              height="content" flex_flow="column" style_pad_all="0" style_pad_gap="#space_xs" scrollable="false">
        <text_small text="Website (optional)" style_text_color="#text_muted"/>
        <text_input name="new_vendor_url" width="100%" placeholder_text="https://..." placeholder_tag="https://...">
          <event_cb trigger="value_changed" callback="on_wizard_new_vendor_url_changed"/>
        </text_input>
      </lv_obj>
    </dialog_frame-body>
    <dialog_frame-footer>
      <modal_button_row primary_text="Add Vendor"
                        primary_callback="on_wizard_confirm_create_vendor" secondary_text="Cancel"
                        secondary_callback="on_wizard_cancel_create_vendor"/>
    </dialog_frame-footer>
  </view>
</component>
