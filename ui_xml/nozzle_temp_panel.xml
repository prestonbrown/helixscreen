<component>
  <!-- Nozzle Temperature Sub-Screen -->
  <!-- Temperature control with presets and custom input -->
  <!-- Component-local constants for theme-aware colors -->
  <consts>
    <!-- Nozzle temperature graph series color (red) -->
    <const name="temp_graph_nozzle_light" value="#FF4444"/>
    <const name="temp_graph_nozzle_dark" value="#FF6666"/>
  </consts>
  <!-- Uses shared backdrop from navigation system -->
  <view name="nozzle_temp_panel" extends="overlay_panel" title="Nozzle Temperature" title_tag="Nozzle Temperature">
    <!-- Extruder selector (shown when multiple extruders detected, populated in C++) -->
    <lv_obj name="extruder_selector"
            width="100%" height="content" style_pad_hor="#space_md" style_pad_top="#space_sm" style_pad_bottom="0"
            style_border_opa="0" scrollable="false" hidden="true"/>
    <!-- Content Area: Two Columns -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="#space_lg" scrollable="false" style_border_opa="0" flex_flow="row"
            style_flex_main_place="space_between">
      <!-- Disable content when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- Left Column (66%): Temperature Graph with Y-axis labels + X-axis time labels -->
      <lv_obj name="graph_outer_container"
              width="66%" height="100%" style_pad_all="0" scrollable="false" style_border_opa="0" flex_flow="column"
              style_pad_gap="0">
        <!-- Chart area (Y-axis labels and X-axis time labels rendered directly on canvas) -->
        <lv_obj name="chart_area" width="100%" flex_grow="1" style_pad_all="0" scrollable="false" style_border_opa="0">
          <!-- Temperature graph widget created programmatically in C++ -->
        </lv_obj>
        <!-- X-axis time labels are now rendered directly on the graph canvas via draw callback -->
      </lv_obj>
      <!-- Right Column (33%): Controls - simple top-to-bottom flow -->
      <lv_obj name="right_column"
              width="33%" height="100%" style_pad_all="0" scrollable="false" style_border_opa="0" flex_flow="column"
              style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_sm">
        <!-- Current/Target Temperature Display Card with Icon and Status -->
        <ui_card name="temp_display_card"
                 width="100%" height="content" style_radius="0" flex_flow="column" style_flex_main_place="center"
                 style_pad_gap="#space_xs" style_pad_all="#space_sm">
          <!-- Horizontal centering row with flex spacers -->
          <lv_obj width="100%" flex_flow="row" style_pad_all="0" scrollable="false">
            <!-- Left spacer -->
            <lv_obj height="1" flex_grow="1" style_pad_all="0" scrollable="false"/>
            <!-- Content column: left-aligned children -->
            <lv_obj height="content"
                    flex_flow="column" style_flex_cross_place="start" style_pad_all="0" style_pad_gap="#space_xs"
                    scrollable="false">
              <nozzle_icon name="heater_icon_container" size="xl"/>
              <lv_obj style_pad_all="0"
                      scrollable="false" flex_flow="column" style_flex_main_place="center"
                      style_flex_cross_place="start" style_pad_gap="#space_xxs">
                <text_small style_border_width="0" text="Current / Target" translation_tag="Current / Target"/>
                <temp_display name="nozzle_temp_display"
                              size="lg" show_target="true" bind_current="extruder_temp" bind_target="extruder_target"/>
              </lv_obj>
              <!-- Status Message -->
              <text_small name="status_message" style_border_width="0" bind_text="nozzle_status" style_text_align="left"/>
            </lv_obj>
            <!-- Right spacer -->
            <lv_obj height="1" flex_grow="1" style_pad_all="0" scrollable="false"/>
          </lv_obj>
        </ui_card>
        <!-- Spacer to push buttons to bottom -->
        <lv_obj width="1" flex_grow="1" style_pad_all="0" scrollable="false"/>
        <!-- Buttons: all together at bottom -->
        <lv_obj name="preset_grid"
                width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row_wrap"
                style_flex_main_place="space_between" style_pad_gap="#space_xs">
          <ui_button name="preset_off"
                     width="48%" text="Off" translation_tag="Off" variant="ghost" style_border_width="#border_width"
                     style_border_color="#border" style_border_opa="255">
            <event_cb trigger="clicked" callback="on_heater_preset_clicked"/>
          </ui_button>
          <ui_button name="preset_m0" width="48%" bind_text="preset_material_0_name">
            <event_cb trigger="clicked" callback="on_heater_preset_clicked"/>
          </ui_button>
          <ui_button name="preset_m1" width="48%" bind_text="preset_material_1_name">
            <event_cb trigger="clicked" callback="on_heater_preset_clicked"/>
          </ui_button>
          <ui_button name="preset_m2" width="48%" bind_text="preset_material_2_name">
            <event_cb trigger="clicked" callback="on_heater_preset_clicked"/>
          </ui_button>
          <!-- ============================================================
               ONLY THREE MATERIAL SLOTS ARE SHOWN HERE (slots 0-2), even
               though helix::presets::PRESET_COUNT is 4. This is a LAYOUT
               CONSTRAINT, NOT AN OVERSIGHT.

               These buttons are width="48%" in a row_wrap grid, so "Off" + 3
               slots fills exactly two rows. Adding slot 3 pushes the grid to a
               third row, which does not fit in right_column at the smaller
               breakpoints — it eats the flex spacer above and overflows.

               Slot 3 is NOT disabled: it remains fully functional in the
               filament panel, in the PID calibration panel, and in the
               underlying preset data (TemperatureController still computes a
               target for all 4 slots). This is display truncation in the three
               temp panels only.

               Yes, the visible count is inconsistent across screens on purpose:
                 - temp graph overlay  -> 3 slots (TEMP_GRAPH_VISIBLE_PRESETS)
                 - nozzle/bed/chamber  -> 3 slots (here)
                 - filament panel      -> 4 slots
                 - PID panel           -> 4 slots
               Each screen shows as many as it has room for. If you want a 4th
               slot visible here, FIND THE SPACE FIRST — do not just add the
               button back, and do not "fix" the inconsistency by trimming the
               filament or PID panels to match.

               The C++ side is safe either way: temperature_service.cpp iterates
               PRESETS_PER_HEATER and skips any button lv_obj_find_by_name()
               cannot resolve, so a missing preset_m3 is a no-op there.
               ============================================================ -->
          <!-- Dynamic spool preset (hidden by default, shown when active spool has novel material) -->
          <ui_button name="preset_spool" width="100%" text="" hidden="true">
            <event_cb trigger="clicked" callback="on_heater_preset_clicked"/>
            <lv_label name="spool_preset_label" text=""/>
          </ui_button>
        </lv_obj>
        <ui_button name="btn_custom" width="100%" text="Custom..." translation_tag="Custom..." variant="secondary">
          <event_cb trigger="clicked" callback="on_nozzle_custom_clicked"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
  </view>
</component>
