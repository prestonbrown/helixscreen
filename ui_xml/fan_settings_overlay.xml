<!-- Fan Settings Overlay -->
<!-- Shows all discovered fans grouped by controllable vs auto, with display names -->
<!-- XML-First Design: Layout/styling here; C++ populates fan lists dynamically -->
<component>
  <view name="fan_settings_overlay" extends="overlay_panel" title="Fans" title_tag="Fans" bg_color="#screen_bg">
    <!-- Content Area (cards own the horizontal inset via their side margins) -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
            style_pad_bottom="#space_md" scrollable="true" scroll_elastic="false" flex_flow="column"
            style_pad_gap="#space_sm">

      <!-- ================================================================== -->
      <!-- CONTROLLABLE FANS SECTION (part cooling, fan_generic, output_pin) -->
      <!-- ================================================================== -->
      <setting_group name="controllable_section">
        <setting_group_header title="CONTROLLABLE FANS"
                              title_tag="Controllable Fans" icon="fan" badge_name="controllable_fan_count"
                              badge_text="0" hide_badge="false"/>
        <lv_obj name="controllable_fans_list"
                width="100%" height="content" style_pad_left="#space_lg" style_pad_right="#space_lg"
                style_pad_top="#space_sm" style_pad_bottom="#space_md" scrollable="false" flex_flow="column"
                style_pad_gap="0"/>
      </setting_group>

      <!-- ================================================================== -->
      <!-- AUTO FANS SECTION (heater_fan, controller_fan, temperature_fan) -->
      <!-- ================================================================== -->
      <setting_group name="auto_section">
        <setting_group_header title="AUTO FANS"
                              title_tag="Auto Fans" icon="fan" badge_name="auto_fan_count" badge_text="0"
                              hide_badge="false"/>
        <lv_obj name="auto_fans_list"
                width="100%" height="content" style_pad_left="#space_lg" style_pad_right="#space_lg"
                style_pad_top="#space_sm" style_pad_bottom="#space_md" scrollable="false" flex_flow="column"
                style_pad_gap="0"/>
      </setting_group>

      <!-- Empty state (no fans detected) -->
      <lv_obj name="no_fans_placeholder"
              width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_bg_opa="0" style_border_width="0" scrollable="false" hidden="true">
        <icon name="no_fans_icon" src="fan" size="xl" variant="secondary" style_opa="80"/>
        <text_body text="No fans detected" style_text_color="#text_muted"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
