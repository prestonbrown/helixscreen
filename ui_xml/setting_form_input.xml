<!-- Compact form row: label (60px, muted) + text_input (flex_grow), the input
     two-way bound to text_subject. -->
<component>
  <api>
    <prop name="label" type="string" default="Field:"/>
    <prop name="placeholder" type="string" default=""/>
    <prop name="input_name" type="string" default="input"/>
    <prop name="text_subject" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
        style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false">
    <text_muted name="label" width="60" text="$label"/>
    <text_input name="$input_name"
                placeholder_text="$placeholder" one_line="true" flex_grow="1" bind_text="$text_subject"/>
  </view>
</component>
