<component>
  <api>
    <!-- Per-instance subject names, supplied by the widget at creation. They
         must exist before this component is parsed: a binding whose subject is
         missing at parse time is dropped permanently and silently. -->
    <prop name="tile_icon_subject" type="string" default=""/>
    <prop name="tile_label_subject" type="string" default=""/>
    <prop name="tile_dir_subject" type="string" default=""/>
    <prop name="tile_target_subject" type="string" default=""/>
    <!-- FullPageState: 0 a tile, 1 a full page, 2 a full page holding its view. -->
    <prop name="full_page_subject" type="string" default=""/>
  </api>
  <view name="panel_widget_bed_temperature"
        extends="lv_obj" height="100%" flex_grow="1" style_pad_all="0" style_pad_left="#space_xxs"
        style_pad_right="#space_xxs" scrollable="false">
    <ui_button name="bed_temp_btn"
               width="100%" height="100%" style_pad_ver="0" variant="ghost" style_border_width="0" focusable="false">
      <style name="styles.tile_column"/>
      <bind_flag_if_not_eq subject="$full_page_subject" flag="hidden" ref_value="0"/>
      <bind_style_if_eq name="styles.tile_row" subject="$tile_dir_subject" ref_value="1"/>
      <bind_state_if_not_eq subject="printer_connection_state" state="disabled" ref_value="2"/>
      <event_cb trigger="clicked" callback="bed_temp_clicked_cb"/>
      <heater_icon src="radiator" glyph_name="bed_icon_glyph" size="#icon_size" rung_subject="$tile_icon_subject"/>
      <temp_display name="bed_temp_text_label"
                    size_target_subject="$tile_target_subject" rung_subject="$tile_icon_subject" size="sm"
                    show_target="true" hide_target_when_off="true" hide_target_below_bp="small" bind_current="bed_temp"
                    bind_target="bed_target" align="center"/>
    </ui_button>
    <full_page_frame name="bed_temp_full_page"
                     state_subject="$full_page_subject" icon="radiator" label="Bed Temperature">
      <bind_flag_if_eq subject="$full_page_subject" flag="hidden" ref_value="0"/>
    </full_page_frame>
  </view>
</component>
