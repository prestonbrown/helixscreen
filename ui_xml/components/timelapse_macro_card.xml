<!-- Gets moonraker-timelapse's Klipper macros loaded: the line to add to printer.cfg,
     or the Klipper restart that loads the include HelixScreen added to helix_macros.cfg.
     Shared by the timelapse install wizard and the timelapse settings screen. -->
<component>
  <view name="timelapse_macro_card"
        extends="lv_obj" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0"
        scrollable="false" flex_flow="column" style_pad_row="#space_md">
    <bind_flag_if_eq subject="timelapse_macro_card_state" flag="hidden" ref_value="0"/>

    <!-- Nothing HelixScreen owns is loaded: the user adds the line -->
    <lv_obj name="include_line_container"
            width="100%" height="content" style_pad_all="#space_md" style_bg_color="#card_bg"
            style_radius="#border_radius" style_bg_opa="255">
      <bind_flag_if_not_eq subject="timelapse_macro_card_state" flag="hidden" ref_value="1"/>
      <lv_obj width="100%" height="content" flex_flow="column" style_pad_row="#space_sm" style_bg_opa="0">
        <text_body width="100%"
                   text="Klipper has not loaded the timelapse macros, so no frames are captured. Add this line to printer.cfg and restart Klipper:"
                   style_text_color="#text_muted" long_mode="wrap"/>
        <lv_obj width="100%"
                height="content" style_bg_color="#overlay_bg" style_radius="#border_radius" style_pad_all="#space_sm"
                style_bg_opa="255">
          <text_small name="include_line"
                      width="100%" bind_text="timelapse_macro_include_line" style_text_color="#text" long_mode="wrap"/>
        </lv_obj>
      </lv_obj>
    </lv_obj>

    <!-- helix_macros.cfg now includes the timelapse macros: Klipper loads them at a restart -->
    <lv_obj name="restart_klipper_container"
            width="100%" height="content" style_pad_all="#space_md" style_bg_color="#card_bg"
            style_radius="#border_radius" style_bg_opa="255">
      <bind_flag_if_not_eq subject="timelapse_macro_card_state" flag="hidden" ref_value="2"/>
      <lv_obj width="100%" height="content" flex_flow="column" style_pad_row="#space_sm" style_bg_opa="0">
        <text_body width="100%"
                   text="Timelapse frames start after Klipper restarts." style_text_color="#text_muted" long_mode="wrap"/>
        <ui_button name="restart_klipper_button"
                   width="100%" text="Restart Klipper" variant="secondary" moves_machine="true">
          <event_cb trigger="clicked" callback="on_timelapse_macro_restart_klipper"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
  </view>
</component>
