<!-- One vendor in the wizard's printer browse grid. WizardPrinterIdentifyStep
     creates one per vendor and sets its name (user text). Vendor names are
     single unbreakable words at this tile width ("PrintersForAnts"), so the
     name is one dotted line rather than a wrap that would clip. -->
<component>
  <api>
    <prop name="index" type="int" default="0"/>
  </api>
  <view name="vendor_tile_${index}"
        extends="lv_obj" width="48%" height="content" style_pad_all="#space_md" style_radius="#border_radius"
        style_bg_color="#card_bg" style_bg_opa="255" scrollable="false">
    <text_body name="vendor_label" width="100%" text="" long_mode="dots" max_lines="1"/>
    <event_cb trigger="clicked" callback="on_wizard_vendor_tile_clicked" user_data="$index"/>
  </view>
</component>
