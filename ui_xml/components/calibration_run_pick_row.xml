<!-- One step on the guided run's Pick page: a tick box (a lock on a required
     step), its name with a REQUIRED or OPTIONAL badge, what it needs, and what it
     last measured in the corner. At 480x272 it is one line: box, name, a short
     detail. CalibrationRunOverlay publishes, per step id:
       cal_run_shown_<step>       1 when the run offers the step
       cal_run_picked_<step>      1 when it is ticked
       cal_run_locked_<step>      1 when the printer requires it, so it stays ticked
       cal_run_optional_<step>    1 when its tier is Optional
       cal_run_meta_<step>        "4 min · needs you · paper test"
       cal_run_meta_short_<step>  "4 min · needs you"
       cal_run_last_<step>        what it last measured, or "never" -->
<component>
  <api>
    <prop name="step" type="string" default=""/>
    <prop name="label" type="string" default=""/>
    <prop name="label_tag" type="string" default=""/>
  </api>
  <consts>
    <px name="tile_radius" value="10"/>
    <px name="tile_radius_tight" value="8"/>
    <px name="box_radius" value="6"/>
  </consts>
  <styles>
    <style name="tile_off" bg_color="#card_bg" bg_opa="255" border_color="#border"/>
    <style name="tile_on" bg_color="#primary" bg_opa="38" border_color="#primary"/>
    <style name="tile_roomy"
           height="#cal_tile_h" pad_left="#space_lg" pad_right="#space_lg" pad_column="#space_lg" radius="#tile_radius"/>
    <style name="tile_micro"
           height="#cal_tile_h" pad_left="#space_lg" pad_right="#space_lg" pad_column="#space_md"
           radius="#tile_radius_tight"/>
    <style name="box_locked" bg_color="#elevated_bg" bg_opa="255" border_width="0"/>
    <style name="box_on" bg_color="#primary" bg_opa="255" border_width="0"/>
    <style name="box_off" bg_opa="0" border_width="2" border_color="#text_subtle"/>
  </styles>
  <view extends="lv_button"
        style_pad_top="0" style_pad_bottom="0" style_border_width="2" style_border_opa="255" style_shadow_width="0"
        scrollable="false" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
        style_flex_track_place="center">
    <bind_flag_if_eq subject="cal_run_shown_${step}" flag="hidden" ref_value="0"/>
    <bind_style name="tile_off" subject="cal_run_picked_${step}" ref_value="0"/>
    <bind_style name="tile_on" subject="cal_run_picked_${step}" ref_value="1"/>
    <bind_style_if_ge name="tile_roomy" subject="ui_breakpoint" ref_value="1"/>
    <bind_style_if_eq name="tile_micro" subject="ui_breakpoint" ref_value="0"/>
    <style name="styles.press_wash" selector="pressed"/>
    <lv_obj name="pick_box"
            width="#cal_box" height="#cal_box" style_radius="#box_radius" style_pad_all="0" scrollable="false"
            clickable="false" event_bubble="true">
      <bind_style_if name="box_locked" cond="cal_run_locked_${step} eq 1"/>
      <bind_style_if name="box_on" cond="cal_run_locked_${step} eq 0 and cal_run_picked_${step} eq 1"/>
      <bind_style_if name="box_off" cond="cal_run_picked_${step} eq 0"/>
      <icon name="pick_check"
            src="check_bold" size="xs" contrast="true" align="center" clickable="false" event_bubble="true">
        <bind_flag_if cond="cal_run_locked_${step} eq 1 or cal_run_picked_${step} eq 0" flag="hidden"/>
      </icon>
      <icon name="pick_lock" src="lock" size="xs" contrast="true" align="center" clickable="false" event_bubble="true">
        <bind_flag_if_eq subject="cal_run_locked_${step}" flag="hidden" ref_value="0"/>
      </icon>
    </lv_obj>
    <lv_obj width="0"
            height="content" flex_grow="1" style_pad_all="0" style_pad_gap="#space_xxs" flex_flow="column"
            style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false" event_bubble="true">
      <lv_obj width="100%"
              height="content" style_pad_all="0" style_pad_gap="#space_md" flex_flow="row"
              style_flex_cross_place="center" style_bg_opa="0" style_border_width="0" scrollable="false"
              clickable="false" event_bubble="true">
        <text_body name="pick_name"
                   text="$label" translation_tag="$label_tag" long_mode="dots" style_text_font="#cal_font_name"
                   style_text_color="#text" clickable="false" event_bubble="true"/>
        <text_small name="pick_required"
                    text="Required" text_transform="uppercase" style_text_font="#cal_font_badge"
                    style_text_color="#warning" clickable="false" event_bubble="true">
          <bind_flag_if cond="cal_run_locked_${step} eq 0 or ui_breakpoint eq 0" flag="hidden"/>
        </text_small>
        <text_small name="pick_optional"
                    text="Optional" text_transform="uppercase" style_text_font="#cal_font_badge"
                    style_text_color="#text_muted" style_text_opa="204" clickable="false" event_bubble="true">
          <bind_flag_if cond="cal_run_optional_${step} eq 0 or ui_breakpoint eq 0" flag="hidden"/>
        </text_small>
        <text_small name="pick_meta_short"
                    width="0" flex_grow="1" bind_text="cal_run_meta_short_${step}" long_mode="dots"
                    style_text_align="right" style_text_font="#cal_font_detail" style_text_color="#text_muted"
                    clickable="false" event_bubble="true">
          <bind_flag_if_ge subject="ui_breakpoint" flag="hidden" ref_value="1"/>
        </text_small>
      </lv_obj>
      <text_small name="pick_meta"
                  width="100%" bind_text="cal_run_meta_${step}" long_mode="dots" style_text_font="#cal_font_detail"
                  style_text_color="#text_muted" clickable="false" event_bubble="true">
        <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
      </text_small>
    </lv_obj>
    <text_small name="pick_last"
                bind_text="cal_run_last_${step}" style_text_font="#cal_font_detail" style_text_color="#text_muted"
                style_text_opa="204" clickable="false" event_bubble="true">
      <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
    </text_small>
    <event_cb trigger="clicked" callback="on_cal_run_pick_toggle" user_data="$step"/>
  </view>
</component>
