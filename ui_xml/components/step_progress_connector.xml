<component>
  <!-- The line between two step dots. It stands outside the flex layout: C++
       sizes and places it from the measured dots. It turns success once the step
       it leaves is done, bound from that step's state subject (2 done). -->
  <api>
    <prop name="state_subject" type="string" default=""/>
  </api>
  <view name="step_connector"
        extends="lv_obj" ignore_layout="true" clickable="false" style_bg_opa="255" style_border_width="0"
        style_pad_all="0" style_radius="0" style_bg_color="#text_subtle" style_bg_color-checked="#success">
    <bind_state_if_eq subject="$state_subject" state="checked" ref_value="2"/>
  </view>
</component>
