<!-- One choice on a calibration intro (a material and its temperature, an axis):
     an outlined tile, filled with the primary color while `choice` equals
     `index`. The label sits at the left and the detail (static, or the string
     subject `bind_detail`) at the right; with no
     detail, `place="center"` centers the label. The tap calls `callback` with
     `index` as user data. Sizes: calibration_intro_tokens.xml. -->
<component>
  <api>
    <prop name="label" type="string" default=""/>
    <prop name="detail" type="string" default=""/>
    <prop name="bind_detail" type="string" default=""/>
    <prop name="choice" type="string" default=""/>
    <prop name="index" type="int" default="0"/>
    <prop name="callback" type="string" default=""/>
    <prop name="place" type="string" default="space_between"/>
    <prop name="label_font" type="string" default="#cal_intro_font_row_bold"/>
  </api>
  <view extends="lv_obj"
        width="0" height="#cal_intro_chip_h" flex_grow="1" style_radius="#border_radius" style_border_width="2"
        style_border_color="#elevated_bg" style_bg_opa="0" style_bg_color="#primary" style_bg_opa-checked="255"
        style_border_opa-checked="0" style_pad_hor="#space_md" style_pad_ver="0" flex_flow="row"
        style_flex_main_place="$place" style_flex_cross_place="center" style_flex_track_place="center"
        ext_click_area="#space_xs" scrollable="false" clickable="true">
    <style name="styles.press_wash" selector="pressed"/>
    <bind_state_if_eq subject="$choice" state="checked" ref_value="$index"/>
    <event_cb trigger="clicked" callback="$callback" user_data="$index"/>
    <text_small name="chip_label"
                text="$label" style_text_font="$label_font" style_text_font-checked="#cal_intro_font_row_bold"
                style_text_color="#text" style_text_color-checked="#text_on_primary" long_mode="dots" clickable="false"
                event_bubble="true">
      <bind_state_if_eq subject="$choice" state="checked" ref_value="$index"/>
    </text_small>
    <text_small name="chip_detail"
                text="$detail" bind_text="$bind_detail" style_text_font="#cal_intro_font_desc"
                style_text_color="#text_muted" style_text_color-checked="#text_on_primary" clickable="false"
                event_bubble="true">
      <bind_state_if_eq subject="$choice" state="checked" ref_value="$index"/>
    </text_small>
  </view>
</component>
