<component>
  <!-- Shared full-screen dimmed backdrop for every context menu. Tapping it
       dismisses the menu. Context menus extend this and nest their own card:
       <view name="my_menu" extends="context_menu_backdrop"> ... </view>
       The C++ side is helix::ui::ContextMenu, which owns context_menu_backdrop_cb. -->
  <view extends="lv_obj"
        width="100%" height="100%" style_bg_opa="128" style_bg_color="0x000000" style_border_width="0" style_pad_all="0"
        style_radius="0" clickable="true">
    <event_cb trigger="clicked" callback="context_menu_backdrop_cb"/>
  </view>
</component>
