<component>
  <!-- One row of the MDI Icons debug panel: the glyph in the 48px face and the
       name it has in ui_icon_codepoints.h. GlyphsPanel creates one per icon map
       entry and sets both labels after creation. -->
  <consts>
    <!-- One glyph column width, so every name starts at the same x. -->
    <px name="glyph_item_glyph_width" value="56"/>
  </consts>
  <view extends="lv_obj"
        width="100%" height="content" style_bg_color="#card_bg" style_bg_opa="255" style_pad_all="#space_sm"
        style_radius="#border_radius" style_border_width="1" style_border_color="#text_muted" style_border_opa="50%"
        flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center" style_pad_column="#space_lg"
        scrollable="false" clickable="false">
    <lv_label name="glyph_label"
              width="#glyph_item_glyph_width" text="" style_text_font="mdi_icons_48" style_text_color="#text"/>
    <text_body name="glyph_name" text="" flex_grow="1"/>
  </view>
</component>
