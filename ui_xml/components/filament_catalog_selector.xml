<!-- Embeddable branded-filament selector fragment: Vendor -> Type dropdowns
     driving a product list. No dialog/overlay chrome — hosts embed this and
     drive it via a FilamentCatalogSelector controller (attach/populate). -->
<component>
  <!-- height=100%, NOT flex_grow: the fragment fills the height its host gives it.
       A flex_grow root collapses to 0 in any host whose parent is height=content,
       since a content-sized flex parent has no free space to distribute. Hosts are
       responsible for supplying a bounded height. -->
  <view name="filament_catalog_selector"
        extends="lv_obj" width="100%" height="100%" style_pad_all="0" flex_flow="column" style_pad_gap="#space_md"
        scrollable="false">
    <!-- Vendor + Type on one row to reclaim vertical space (the "+ Add custom
         filament" row's cost). Wraps to stacked on narrow widths, where two
         dropdowns can't fit side by side, via flex_flow row_wrap + per-group
         min-width. -->
    <lv_obj width="100%"
            height="content" style_pad_all="0" flex_flow="row_wrap" style_pad_gap="#space_md" scrollable="false">
      <lv_obj height="content"
              flex_grow="1" style_min_width="180" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
              style_pad_gap="#space_sm" scrollable="false">
        <text_small text="Vendor" translation_tag="Vendor"/>
        <lv_dropdown name="vendor_dropdown" height="content" flex_grow="1" style_radius="#border_radius">
          <event_cb trigger="value_changed" callback="catalog_select_vendor_changed_cb"/>
        </lv_dropdown>
      </lv_obj>
      <lv_obj height="content"
              flex_grow="1" style_min_width="180" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
              style_pad_gap="#space_sm" scrollable="false">
        <text_small text="Type" translation_tag="Type"/>
        <lv_dropdown name="type_dropdown" height="content" flex_grow="1" style_radius="#border_radius">
          <event_cb trigger="value_changed" callback="catalog_select_type_changed_cb"/>
        </lv_dropdown>
      </lv_obj>
    </lv_obj>
    <!-- Product list (rows built in C++ by the controller). Elevated surface
         so the tappable pick-area reads as interactive against the panel bg. -->
    <!-- Sole scroll region: flex_grow fills the space left by the fixed vendor/
         type dropdowns (and, in the picker, the button row); the whole dialog no
         longer scrolls. style_max_height caps it in content-height hosts (the AMS
         slot editor), where flex_grow has no bounded parent to fill. -->
    <lv_obj name="product_list"
            width="100%" height="content" flex_grow="1" style_min_height="72" style_max_height="#dialog_content_max"
            style_bg_color="#screen_bg" style_bg_opa="255" style_border_width="1" style_border_color="#text_muted"
            style_border_opa="30" style_radius="#border_radius" style_pad_all="#space_xs" flex_flow="column"
            style_pad_gap="#space_xxs" scrollable="true" scrollbar_mode="auto"/>
  </view>
</component>
