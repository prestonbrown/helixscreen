<!-- The Filament panel's Temperature card on a one-head printer: the shared
     heater rows (heater_rows.xml), each opening the temperature graph, and in
     landscape from the small breakpoint up the panel's status line. A printer
     with several heads shows the Tool card instead. -->
<component>
  <view name="temp_status_card"
        extends="ui_card" width="100%" height="content" flex_flow="column" style_radius="#border_radius"
        style_pad_all="#space_sm" style_pad_gap="#space_xs" scrollable="false">
    <bind_flag_if_eq subject="target_tool_multi_head" flag="hidden" ref_value="1"/>
    <lv_obj width="100%"
            height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_sm"
            scrollable="false" clickable="false">
      <bind_flag_if_eq subject="ui_is_portrait" flag="hidden" ref_value="1"/>
      <icon src="thermometer" size="sm" variant="primary"/>
      <text_small text="Temperature" text_transform="uppercase" style_translate_y="2" style_text_color="#text"/>
    </lv_obj>
    <!-- Portrait has the height for one line of readings only. -->
    <heater_rows status_lines="false" across="ui_is_portrait"/>
    <lv_obj width="100%"
            height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center"
            style_pad_gap="#space_xs">
      <bind_flag_if cond="ui_breakpoint lt 2 or ui_is_portrait eq 1" flag="hidden"/>
      <icon name="status_icon" src="info" size="xs" variant="secondary"/>
      <text_small name="status_text" width="0" flex_grow="1" long_mode="wrap" bind_text="filament_status"/>
    </lv_obj>
  </view>
</component>
