<component>
  <!-- One unit's block in the AMS mini strip's grid view: the strip moves that
       unit's pooled spool cells into unit_group_lanes, which wraps them into
       the rows the strip measured. A titled group (a rig with several units)
       sits on its own box under the unit's name; an untitled one (a single
       unit) is a bare wrap. The strip sets the lanes' width; the group is as
       wide as they are. Taps bubble to the strip root. -->
  <api>
    <prop name="titled" type="int" default="0"/>
    <prop name="title" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="content" height="content" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false"
        event_bubble="true">
    <if cond="$titled eq 1">
      <lv_obj name="unit_group_box"
              width="content" height="content" style_bg_color="#elevated_bg" style_bg_opa="255" style_border_width="0"
              style_radius="#border_radius_sm" style_pad_all="#space_xxs" style_pad_row="#space_xxs" scrollable="false"
              event_bubble="true" flex_flow="column" style_flex_cross_place="start">
        <text_xs name="unit_group_title"
                 width="100%" text="$title" style_text_color="#text_muted" long_mode="dots" event_bubble="true"/>
        <lv_obj name="unit_group_lanes"
                height="content" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_pad_column="#space_xxs"
                style_pad_row="#space_xxs" scrollable="false" event_bubble="true" flex_flow="row_wrap"
                style_flex_main_place="center" style_flex_cross_place="start"/>
      </lv_obj>
      <else/>
      <lv_obj name="unit_group_lanes"
              height="content" style_bg_opa="0" style_border_width="0" style_pad_all="0" style_pad_column="#space_xxs"
              style_pad_row="#space_xxs" scrollable="false" event_bubble="true" flex_flow="row_wrap"
              style_flex_main_place="center" style_flex_cross_place="start"/>
    </if>
  </view>
</component>
