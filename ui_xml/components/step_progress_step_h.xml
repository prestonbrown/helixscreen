<component>
  <!-- One step of a horizontal step progress bar: the numbered dot over a
       wrapped, centered label. Steps share the row's width equally, and the one
       column track is centered in its step, so the dot sits in the middle of its
       slot. The step binds its state from state_subject (0 pending, 1 active,
       2 done, 3 failed) and trickles it to the dot and label: LV_STATE_USER_1
       active, LV_STATE_CHECKED done, LV_STATE_USER_2 failed. The label is the
       string subject label_subject, since it can be printer text. The state
       binds come last, so the state they set trickles to children that already
       exist. -->
  <api>
    <prop name="state_subject" type="string" default=""/>
    <prop name="label_subject" type="string" default=""/>
    <prop name="number" type="string" default="1"/>
    <prop name="number_pending_color" type="color" default="0xFFFFFF"/>
    <prop name="number_active_color" type="color" default="0xFFFFFF"/>
  </api>
  <view name="step_item"
        extends="lv_obj" width="content" height="content" state_trickle="true" flex_grow="1" style_bg_opa="0"
        style_border_width="0" style_pad_all="0" style_pad_gap="0" scrollable="false" scrollbar_mode="off"
        flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center">
    <step_progress_dot number="$number"
                       number_pending_color="$number_pending_color" number_active_color="$number_active_color"/>
    <lv_label name="step_label"
              width="content" bind_text="$label_subject" long_mode="wrap" style_max_width="#step_label_max_width"
              style_pad_top="#step_label_gap" style_text_align="center" style_text_font="#font_small"
              style_text_color="#text_subtle" style_text_font-user_1="#font_body" style_text_color-user_1="#text"/>
    <bind_state_if_eq subject="$state_subject" state="user_1" ref_value="1"/>
    <bind_state_if_eq subject="$state_subject" state="checked" ref_value="2"/>
    <bind_state_if_eq subject="$state_subject" state="user_2" ref_value="3"/>
  </view>
</component>
