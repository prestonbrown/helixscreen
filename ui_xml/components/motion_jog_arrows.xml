<component>
  <!-- Arrows layout: an XY cross of arrow keys with a Z pair beside it, the
       home and leveling keys beside them in landscape or under them in
       portrait, and one step selector at the bottom. Every arrow moves the
       selected step. The Z arrows carry the kinematics-aware icons and limit
       states the pad layout's Z column does.
       MotionPanel::fit_jog_layout() sizes arrows_xy, arrows_z, arrows_home and
       arrows_steps from one near-square key size whenever this view resizes;
       the keys fill those blocks, and the blocks sit centred in the view. -->
  <view name="motion_jog_arrows"
        extends="lv_obj" width="100%" height="100%" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
        scrollable="false" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center"
        style_flex_track_place="center" style_pad_gap="#space_xs">
    <event_cb trigger="size_changed" callback="on_motion_jog_layout_resized"/>
    <lv_obj name="arrows_body"
            width="content" height="content" style_pad_all="0" style_border_opa="0" style_bg_opa="0" scrollable="false"
            style_pad_gap="#space_xs">
      <bind_style_if_eq name="styles.jog_flow_row" subject="ui_is_portrait" ref_value="0"/>
      <bind_style_if_eq name="styles.jog_flow_column" subject="ui_is_portrait" ref_value="1"/>
      <lv_obj name="arrows_pad"
              width="content" height="content" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
              scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
        <!-- XY cross, three columns: Y+ over Y- in the centre one, X- and X+
             one row tall and centred between them in the outer ones. -->
        <lv_obj name="arrows_xy"
                width="content" height="content" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
                scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
          <lv_obj width="0"
                  height="100%" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0" scrollable="false"
                  flex_flow="column" style_pad_gap="#space_xs">
            <lv_obj width="100%"
                    height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0" scrollable="false"
                    clickable="false"/>
            <motion_jog_button name="arrows_x_minus"
                               width="100%" height="0" icon_size="jog_key" jog="x_minus_step" flex_grow="2"
                               icon="arrow_left" variant="secondary"/>
            <lv_obj width="100%"
                    height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0" scrollable="false"
                    clickable="false"/>
          </lv_obj>
          <lv_obj width="0"
                  height="100%" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0" scrollable="false"
                  flex_flow="column" style_pad_gap="#space_xs">
            <motion_jog_button name="arrows_y_plus"
                               width="100%" height="0" icon_size="jog_key" jog="y_plus_step" flex_grow="1"
                               icon="arrow_up" variant="secondary"/>
            <motion_jog_button name="arrows_y_minus"
                               width="100%" height="0" icon_size="jog_key" jog="y_minus_step" flex_grow="1"
                               icon="arrow_down" variant="secondary"/>
          </lv_obj>
          <lv_obj width="0"
                  height="100%" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0" scrollable="false"
                  flex_flow="column" style_pad_gap="#space_xs">
            <lv_obj width="100%"
                    height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0" scrollable="false"
                    clickable="false"/>
            <motion_jog_button name="arrows_x_plus"
                               width="100%" height="0" icon_size="jog_key" jog="x_plus_step" flex_grow="2"
                               icon="arrow_right" variant="secondary"/>
            <lv_obj width="100%"
                    height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0" scrollable="false"
                    clickable="false"/>
          </lv_obj>
        </lv_obj>
        <!-- Z pair: same icon, label and limit bindings as the pad layout's Z
             column. -->
        <lv_obj name="arrows_z"
                width="content" height="content" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
                scrollable="false" flex_flow="column" style_pad_gap="#space_xs" style_flex_cross_place="center">
          <motion_jog_button name="arrows_z_up"
                             width="100%" height="0" icon_size="jog_key" jog="z_up_step" flex_grow="1" icon="arrow_up"
                             bind_icon="motion_z_up_icon" icon_position="top" label="motion_z_up_tag"
                             variant="secondary">
            <bind_state_if_eq subject="motion_z_up_blocked" state="disabled" ref_value="1"/>
          </motion_jog_button>
          <text_small name="arrows_z_label" width="100%" bind_text="motion_z_axis_label" style_text_align="center"/>
          <motion_jog_button name="arrows_z_down"
                             width="100%" height="0" icon_size="jog_key" jog="z_down_step" flex_grow="1"
                             icon="arrow_down" bind_icon="motion_z_down_icon" icon_position="top"
                             label="motion_z_down_tag" variant="secondary">
            <bind_state_if_eq subject="motion_z_down_blocked" state="disabled" ref_value="1"/>
          </motion_jog_button>
        </lv_obj>
      </lv_obj>
      <!-- Home and leveling: a column beside the keys in landscape, a row under
           them in portrait. A home button is solid while its axis (any axis,
           for All) still needs homing. -->
      <lv_obj name="arrows_home"
              width="content" height="content" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
              scrollable="false" style_pad_gap="#space_xs">
        <bind_style_if_eq name="styles.jog_flow_column" subject="ui_is_portrait" ref_value="0"/>
        <bind_style_if_eq name="styles.jog_flow_row" subject="ui_is_portrait" ref_value="1"/>
        <motion_home_button name="arrows_home_all"
                            width="100%" height="100%" flex_grow="1" text="All" axis="all"
                            needs_home="motion_x_homed eq 0 or motion_y_homed eq 0 or motion_z_homed eq 0"/>
        <lv_obj width="100%"
                height="100%" style_pad_all="0" style_border_opa="0" style_bg_opa="0" scrollable="false" flex_flow="row"
                style_pad_gap="#space_xs">
          <bind_style_if_eq name="styles.jog_grow_1" subject="ui_is_portrait" ref_value="0"/>
          <bind_style_if_eq name="styles.jog_grow_3" subject="ui_is_portrait" ref_value="1"/>
          <motion_home_button name="arrows_home_x"
                              width="0" height="100%" flex_grow="1" text="X" icon="" axis="X"
                              needs_home="motion_x_homed eq 0"/>
          <motion_home_button name="arrows_home_y"
                              width="0" height="100%" flex_grow="1" text="Y" icon="" axis="Y"
                              needs_home="motion_y_homed eq 0"/>
          <motion_home_button name="arrows_home_z"
                              width="0" height="100%" flex_grow="1" text="Z" icon="" axis="Z"
                              needs_home="motion_z_homed eq 0"/>
        </lv_obj>
        <motion_leveling_row name="arrows_leveling" width="100%" height="100%"/>
      </lv_obj>
    </lv_obj>
    <motion_step_bar name="arrows_steps"/>
  </view>
</component>
