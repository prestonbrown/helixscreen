<component>
  <api>
    <!-- Per-instance subjects the widget publishes before this component is
         parsed (a binding to a missing subject is dropped silently). -->
    <prop name="columns_subject" type="string" default=""/>
    <prop name="stacked_subject" type="string" default=""/>
    <prop name="captions_subject" type="string" default=""/>
  </api>
  <!-- The captions under each value show only when the widget lays its heaters out
       side by side (TempStackWidget::on_size_changed). -->
  <view name="panel_widget_temp_stack"
        extends="lv_obj" height="100%" flex_grow="1" style_pad_all="0" style_pad_left="#space_xs"
        style_pad_right="#space_xs" scrollable="false" style_pad_gap="#space_xs">
    <bind_style_if_eq name="styles.flow_column" subject="$columns_subject" ref_value="0"/>
    <bind_style_if_eq name="styles.flow_row" subject="$columns_subject" ref_value="1"/>
    <bind_state_if_not_eq subject="printer_connection_state" state="disabled" ref_value="2"/>

    <!-- Nozzle row -->
    <lv_obj name="temp_stack_nozzle_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" clickable="true" event_bubble="false">
      <bind_style_if_eq name="styles.flow_row" subject="$stacked_subject" ref_value="0"/>
      <bind_style_if_eq name="styles.flow_column" subject="$stacked_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.stack_gap_beside" subject="$stacked_subject" ref_value="0"/>
      <bind_style_if_eq name="styles.stack_gap_stacked" subject="$stacked_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.grow_1" subject="$columns_subject" ref_value="1"/>
      <style name="styles.press_dim" selector="pressed"/>
      <event_cb trigger="clicked" callback="temp_stack_nozzle_cb"/>
      <nozzle_icon name="temp_stack_nozzle_icon" size="xs" badge_subject="" clickable="false" event_bubble="true"/>
      <temp_display name="temp_stack_nozzle_temp"
                    size="xs" show_target="false" bind_current="extruder_temp" bind_target="extruder_target"
                    clickable="false" event_bubble="true"/>
      <text_muted name="temp_stack_nozzle_label"
                  text="Nozzle" style_text_font="#font_xs" hidden="true" clickable="false" event_bubble="true">
        <bind_flag_if_eq subject="$captions_subject" flag="hidden" ref_value="0"/>
      </text_muted>
    </lv_obj>

    <!-- Bed row -->
    <lv_obj name="temp_stack_bed_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" clickable="true" event_bubble="false">
      <bind_style_if_eq name="styles.flow_row" subject="$stacked_subject" ref_value="0"/>
      <bind_style_if_eq name="styles.flow_column" subject="$stacked_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.stack_gap_beside" subject="$stacked_subject" ref_value="0"/>
      <bind_style_if_eq name="styles.stack_gap_stacked" subject="$stacked_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.grow_1" subject="$columns_subject" ref_value="1"/>
      <style name="styles.press_dim" selector="pressed"/>
      <event_cb trigger="clicked" callback="temp_stack_bed_cb"/>
      <heater_icon src="radiator" glyph_name="bed_icon_glyph" size="xs"/>
      <temp_display name="temp_stack_bed_temp"
                    size="xs" show_target="false" bind_current="bed_temp" bind_target="bed_target" clickable="false"
                    event_bubble="true"/>
      <text_muted name="temp_stack_bed_label"
                  text="Bed" style_text_font="#font_xs" hidden="true" clickable="false" event_bubble="true">
        <bind_flag_if_eq subject="$captions_subject" flag="hidden" ref_value="0"/>
      </text_muted>
    </lv_obj>

    <!-- Chamber row (hidden when no sensor) -->
    <lv_obj name="temp_stack_chamber_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" clickable="true" event_bubble="false">
      <bind_style_if_eq name="styles.flow_row" subject="$stacked_subject" ref_value="0"/>
      <bind_style_if_eq name="styles.flow_column" subject="$stacked_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.stack_gap_beside" subject="$stacked_subject" ref_value="0"/>
      <bind_style_if_eq name="styles.stack_gap_stacked" subject="$stacked_subject" ref_value="1"/>
      <bind_style_if_eq name="styles.grow_1" subject="$columns_subject" ref_value="1"/>
      <style name="styles.press_dim" selector="pressed"/>
      <bind_flag_if_eq subject="printer_has_chamber" flag="hidden" ref_value="0"/>
      <event_cb trigger="clicked" callback="temp_stack_chamber_cb"/>
      <heater_icon src="fridge_industrial" glyph_name="chamber_icon_glyph" size="xs"/>
      <temp_display name="temp_stack_chamber_temp"
                    size="xs" show_target="false" bind_current="chamber_temp" bind_target="chamber_effective_target"
                    bind_mode="chamber_mode" clickable="false" event_bubble="true"/>
      <text_muted name="temp_stack_chamber_label"
                  text="Chamber" style_text_font="#font_xs" hidden="true" clickable="false" event_bubble="true">
        <bind_flag_if_eq subject="$captions_subject" flag="hidden" ref_value="0"/>
      </text_muted>
    </lv_obj>
  </view>
</component>
