<component>
  <view name="panel_widget_temp_stack"
        extends="lv_obj" height="100%" flex_grow="1" style_pad_all="0" style_pad_left="#space_xs"
        style_pad_right="#space_xs" scrollable="false" flex_flow="column" style_pad_gap="#space_xs"
        style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
    <bind_state_if_not_eq subject="printer_connection_state" state="disabled" ref_value="2"/>

    <!-- Nozzle row -->
    <lv_obj name="temp_stack_nozzle_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
            style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
            style_pad_gap="#space_xs" clickable="true" event_bubble="false">
      <event_cb trigger="clicked" callback="temp_stack_nozzle_cb"/>
      <nozzle_icon name="temp_stack_nozzle_icon" size="xs" badge_subject="" clickable="false" event_bubble="true"/>
      <temp_display name="temp_stack_nozzle_temp"
                    size="xs" show_target="false" bind_current="extruder_temp" bind_target="extruder_target"
                    clickable="false" event_bubble="true"/>
    </lv_obj>

    <!-- Bed row -->
    <lv_obj name="temp_stack_bed_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
            style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
            style_pad_gap="#space_xs" clickable="true" event_bubble="false">
      <event_cb trigger="clicked" callback="temp_stack_bed_cb"/>
      <heater_icon src="radiator" glyph_name="bed_icon_glyph" size="xs"/>
      <temp_display name="temp_stack_bed_temp"
                    size="xs" show_target="false" bind_current="bed_temp" bind_target="bed_target" clickable="false"
                    event_bubble="true"/>
    </lv_obj>

    <!-- Chamber row (hidden when no sensor) -->
    <lv_obj name="temp_stack_chamber_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
            style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
            style_pad_gap="#space_xs" clickable="true" event_bubble="false">
      <bind_flag_if_eq subject="printer_has_chamber" flag="hidden" ref_value="0"/>
      <event_cb trigger="clicked" callback="temp_stack_chamber_cb"/>
      <heater_icon src="fridge_industrial" glyph_name="chamber_icon_glyph" size="xs"/>
      <temp_display name="temp_stack_chamber_temp"
                    size="xs" show_target="false" bind_current="chamber_temp" bind_target="chamber_effective_target"
                    bind_mode="chamber_mode" clickable="false" event_bubble="true"/>
    </lv_obj>
  </view>
</component>
