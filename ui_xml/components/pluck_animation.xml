<!-- Pluck Animation - shows the user which belt run to pluck and how. -->
<!-- Placeholder body: the animated illustration lands with the live tuner's -->
<!-- drawing task. The element and its name are stable, so the panel XML that -->
<!-- embeds it does not change when the body does. -->
<component>
  <api>
    <prop name="caption" type="string" default="Pluck the belt like a guitar string"/>
    <prop name="caption_tag" type="string" default="Pluck the belt like a guitar string"/>
  </api>
  <view name="pluck_animation"
        extends="lv_obj" width="100%" height="content" style_bg_color="#screen_bg" style_bg_opa="255"
        style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="column" style_pad_gap="#space_sm"
        style_flex_cross_place="center" scrollable="false">
    <icon src="waveform" size="lg" variant="primary"/>
    <text_body width="100%"
               text="$caption" translation_tag="$caption_tag" long_mode="wrap" style_text_align="center"
               style_text_color="#text_muted"/>
  </view>
</component>
