<component>
  <api>
    <!-- Per-instance subject names, supplied by the widget at creation. They
         must exist before this component is parsed: a binding whose subject is
         missing at parse time is dropped permanently and silently. -->
    <prop name="tile_icon_subject" type="string" default=""/>
    <prop name="tile_label_subject" type="string" default=""/>
    <prop name="tile_dir_subject" type="string" default=""/>
    <prop name="tile_target_subject" type="string" default=""/>
    <!-- The macro's display name, 1 while one is assigned, and the badge fill -->
    <prop name="name_subject" type="string" default=""/>
    <prop name="named_subject" type="string" default=""/>
    <prop name="badge_color_subject" type="string" default=""/>
  </api>
  <view name="panel_widget_favorite_macro"
        extends="lv_obj" height="100%" flex_grow="1" scrollable="false" style_pad_ver="0" style_pad_gap="#space_xxs"
        clickable="true">
    <bind_state_if_not_eq subject="printer_connection_state" state="disabled" ref_value="2"/>
    <event_cb trigger="clicked" callback="favorite_macro_clicked_cb"/>
    <style name="styles.tile_column"/>
    <bind_style_if_eq name="styles.tile_row" subject="$tile_dir_subject" ref_value="1"/>
    <tile_badge name="fav_macro_badge" icon="script_text" icon_name="fav_macro_icon" rung_subject="$tile_icon_subject">
      <bind_style_prop prop="bg_color" subject="$badge_color_subject"/>
    </tile_badge>
    <!-- Macro name: one dotted line, so a long user-configured name never
         wraps. Follows show_widget_labels. -->
    <text_tiny name="fav_macro_name"
               width="100%" bind_text="$name_subject" style_text_align="center" style_text_color="#text_muted"
               long_mode="dots" clickable="false" event_bubble="true">
      <bind_tile_rung ladder="label" subject="$tile_icon_subject" one_line="true"/>
      <bind_style_if_eq name="styles.tile_fill" subject="$tile_dir_subject" ref_value="1"/>
      <bind_flag_if_eq subject="show_widget_labels" flag="hidden" ref_value="0"/>
      <bind_flag_if_eq subject="$tile_label_subject" flag="hidden" ref_value="0"/>
      <bind_flag_if_eq subject="$named_subject" flag="hidden" ref_value="0"/>
    </text_tiny>
    <!-- Until a macro is assigned: a literal, so it re-translates itself -->
    <text_tiny name="fav_macro_name_prompt"
               width="100%" text="Configure" style_text_align="center" style_text_color="#text_muted" long_mode="dots"
               clickable="false" event_bubble="true">
      <bind_tile_rung ladder="label" subject="$tile_icon_subject" one_line="true"/>
      <bind_style_if_eq name="styles.tile_fill" subject="$tile_dir_subject" ref_value="1"/>
      <bind_flag_if_eq subject="show_widget_labels" flag="hidden" ref_value="0"/>
      <bind_flag_if_eq subject="$tile_label_subject" flag="hidden" ref_value="0"/>
      <bind_flag_if_eq subject="$named_subject" flag="hidden" ref_value="1"/>
    </text_tiny>
  </view>
</component>
