<!-- The slot editor's Multi-Color row, on the color page it opens (and only
     there): a switch that turns the spool into two to four colors, the colors
     as dots (tap one to edit it in the picker below, hold to remove it, "+" to
     add one), and how they run, Gradient or Coaxial. Subjects and callbacks:
     ui_ams_edit_overlay.cpp.

     Every target here reaches 44px inside the row's box (LVGL hit-tests a
     child only inside its parent): the dots through their padded boxes, the
     dropdown through its ext_click_area, spaced by that reach from the dots so
     the two never overlap. The dots' padding is also the gap after the
     switch. The dropdown takes what the line has left, up to its width, so
     four dots fit beside it where the page is narrow. -->
<component>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row_wrap" style_flex_cross_place="center" style_pad_all="0"
        style_pad_column="0" style_pad_row="#space_xs" style_bg_opa="0" style_border_width="0" scrollable="false"
        clickable="false">
    <lv_obj width="content"
            height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_sm"
            style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false">
      <text_body text="Multi-Color"/>
      <lv_switch name="multi_color_switch">
        <bind_state_if_eq subject="ams_edit_multi" state="checked" ref_value="1"/>
        <event_cb trigger="value_changed" callback="ams_edit_multi_switch_cb"/>
      </lv_switch>
    </lv_obj>
    <lv_obj width="1"
            height="content" flex_grow="1" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
            style_pad_gap="#ams_edit_tag_hit" style_bg_opa="0" style_border_width="0" scrollable="false"
            clickable="false" hidden="true">
      <bind_flag_if_eq subject="ams_edit_multi" flag="hidden" ref_value="0"/>
      <ams_edit_color_dots name="multi_color_dots"
                           size="#ams_edit_multi_dot_size" hit="#ams_edit_multi_dot_hit" gap="#ams_edit_multi_dot_gap"
                           reach_pad="#ams_edit_multi_dot_hit" join="0"/>
      <lv_dropdown name="multi_color_mode"
                   width="1" height="#button_height_sm" flex_grow="1" style_max_width="#ams_edit_mode_dd_w"
                   style_radius="#border_radius" style_pad_ver="0" ext_click_area="#ams_edit_tag_hit" scrollable="false"
                   options="Gradient&#10;Coaxial" options_tag="Gradient&#10;Coaxial" bind_value="ams_edit_color_mode">
        <event_cb trigger="value_changed" callback="ams_edit_color_mode_cb"/>
      </lv_dropdown>
    </lv_obj>
  </view>
</component>
