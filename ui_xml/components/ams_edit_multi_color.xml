<!-- The slot editor's color options, on the color page it opens (and only
     there): a Single / Gradient / Coaxial dropdown, where Gradient or Coaxial
     turns the spool into two to four colors that run that way; the colors as
     dots while it has several (tap one to edit it in the picker below, hold to
     remove it, "+" to add one); and a Translucent checkbox for a clear or
     see-through filament, disabled with a "from tag" pill where the spool's
     tag owns the record. Both are staged with the editor's other edits and
     committed by Save. Subjects and callbacks: ui_ams_edit_overlay.cpp.

     Every target here reaches 44px inside the row's box (LVGL hit-tests a
     child only inside its parent): the dropdown through its ext_click_area,
     spaced by that reach from the dots, the dots through their padded boxes,
     and the checkbox through its box's padding. The three share one line from
     480 wide up; a line too narrow for the checkbox wraps it rather than
     squeezing the dropdown. -->
<component>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row_wrap" style_flex_cross_place="center" style_pad_all="0"
        style_pad_column="#ams_edit_tag_hit" style_pad_row="#space_xs" style_bg_opa="0" style_border_width="0"
        scrollable="false" clickable="false">
    <lv_dropdown name="multi_color_mode"
                 width="#ams_edit_mode_dd_w" height="#button_height_sm" style_radius="#border_radius" style_pad_ver="0"
                 ext_click_area="#ams_edit_tag_hit" scrollable="false" options="Single&#10;Gradient&#10;Coaxial"
                 options_tag="Single&#10;Gradient&#10;Coaxial" bind_value="ams_edit_color_mode">
      <event_cb trigger="value_changed" callback="ams_edit_color_mode_cb"/>
    </lv_dropdown>
    <lv_obj width="content"
            height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
            clickable="false" hidden="true">
      <bind_flag_if_eq subject="ams_edit_color_mode" flag="hidden" ref_value="0"/>
      <ams_edit_color_dots name="multi_color_dots"
                           size="#ams_edit_multi_dot_size" hit="#ams_edit_multi_dot_hit" gap="#ams_edit_multi_dot_gap"
                           reach_pad="#ams_edit_multi_dot_hit" join="0"/>
    </lv_obj>
    <!-- Takes the rest of the line, the checkbox at its end. -->
    <lv_obj width="content"
            height="content" flex_grow="1" flex_flow="row" style_flex_main_place="end" style_flex_cross_place="center"
            style_pad_hor="0" style_pad_ver="#ams_edit_check_hit" style_pad_gap="#space_xs" style_bg_opa="0"
            style_border_width="0" scrollable="false" clickable="false">
      <lv_checkbox name="translucent_check" text="Translucent" ext_click_area="#ams_edit_check_hit">
        <bind_state_if_eq subject="ams_edit_translucent" state="checked" ref_value="1"/>
        <bind_state_if_eq subject="ams_edit_translucent_locked" state="disabled" ref_value="1"/>
        <event_cb trigger="value_changed" callback="ams_edit_translucent_cb"/>
      </lv_checkbox>
      <!-- A head whose record its RFID tag owns: the tag says it, no edit reaches it. -->
      <tag_badge subject="ams_edit_translucent_locked"/>
    </lv_obj>
  </view>
</component>
