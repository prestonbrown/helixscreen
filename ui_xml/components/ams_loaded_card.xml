<component>
  <!--
    AMS Currently Loaded Card - Shows current filament info + optional clog meter.

    Binds to AmsState subjects:
    - ams_current_material_text: Material name (e.g., "Red PLA")
    - ams_current_weight_text: Remaining weight (e.g., "750g")
    - ams_current_has_weight: Show/hide weight (0 = hidden)
    - clog_meter_mode: 0=hidden, 1=encoder, 2=flowguard, 3=afc_buffer
    - clog_meter_center_text: the reading (headroom mm, +/-%, distance mm)
    - clog_meter_mode_text: which source is measuring
    - buffer_present / buffer_slider / buffer_short_text / buffer_label: the
      filament buffer, drawn by UiBufferSlider into buffer_mini_slider

    The meter column is content-sized and capped, because it shares a flex row
    with the material name: an unbounded column grows to fit its longest string
    and clips "Polymaker" to "Polymak".

    Both meters drop their text label (mode name, FPS/Sync) below the medium
    breakpoint, so the material name keeps the width on a small card.

    Slot info is shown in the section header above (bound to ams_current_slot_text).
    Color swatch updated by C++ via lv_obj_find_by_name(sidebar, "loaded_swatch").
    Clog arc size/stroke/color dynamically set by UiClogMeter C++ class via
    SIZE_CHANGED callback — no fixed pixel sizes in XML.
  -->
  <styles>
    <style name="swatch_wide" width="15%"/>
    <style name="swatch_narrow" width="#loaded_swatch_narrow_w"/>
  </styles>
  <view name="ams_loaded_card"
        extends="ui_card" width="100%" height="content" style_radius="#border_radius" style_bg_color="#elevated_bg"
        style_pad_all="#space_md" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
        style_pad_gap="#space_sm">
    <!-- Color swatch (left side, stretches to row height) -->
    <lv_obj name="loaded_swatch"
            height="100%" style_radius="#border_radius" style_bg_color="#text_muted" style_bg_opa="255"
            style_border_width="#space_xxs" style_border_color="#text_muted" style_border_opa="80" scrollable="false"
            clickable="false">
      <bind_style_if_lt name="swatch_narrow" subject="ui_breakpoint" ref_value="3"/>
      <bind_style_if_ge name="swatch_wide" subject="ui_breakpoint" ref_value="3"/>
    </lv_obj>
    <!-- Details column (center, flex-grows to fill) -->
    <lv_obj width="1"
            height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="center"
            style_flex_cross_place="start" style_pad_gap="0" scrollable="false" flex_grow="1">
      <!-- Material name -->
      <!-- Wrapped, not marquee'd: the whole name is readable at once instead of
           on a delay, and a card that animates forever never settles for a
           screenshot. The card is height="content", so it grows to fit. -->
      <text_small name="loaded_material" width="100%" bind_text="ams_current_material_text" long_mode="wrap"/>
      <!-- Weight (hidden when not available) -->
      <text_tiny name="loaded_weight" bind_text="ams_current_weight_text" style_text_color="#text_muted">
        <bind_flag_if_eq subject="ams_current_has_weight" flag="hidden" ref_value="0"/>
      </text_tiny>
    </lv_obj>
    <!-- Clog detection mini-meter (right side, auto-hides when mode=0).
         Arc size set dynamically by UiClogMeter C++ SIZE_CHANGED callback. -->
    <lv_obj name="clog_meter"
            width="content" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
            style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="0">
      <bind_flag_if_eq subject="clog_meter_mode" flag="hidden" ref_value="0"/>
      <!-- Mini arc (sized by C++) -->
      <lv_obj name="clog_arc_container" style_pad_all="0" scrollable="false">
        <!-- Main arc: helix_progress_arc handles common styling and the
             diameter-driven stroke tier. UiClogMeter syncs the danger/peak
             overlay arcs (created in C++) to match. -->
        <helix_progress_arc name="clog_arc" align="center"/>
        <!-- Stands in for the arc when there is nothing to report. UiClogMeter
             swaps the two, finding this by name under its parent. -->
        <lv_label name="clog_safe_icon"
                  hidden="true" align="center" text="#icon_check_circle" style_text_font="mdi_icons_16"
                  style_text_color="#primary" clickable="false"/>
      </lv_obj>
      <!-- The reading sits under the arc rather than inside it: this arc is
           sized off the card width and lands around 36px, which "11.8mm" does
           not fit in — it drew clipped to "1.8mm", a wrong number rather than
           an ugly one. -->
      <text_tiny name="clog_value_text" bind_text="clog_meter_center_text" style_text_align="center"/>
      <!-- Mode label below arc -->
      <text_tiny name="clog_mode_text"
                 width="100%" bind_text="clog_meter_mode_text" style_text_color="#text_muted" style_text_align="center"
                 long_mode="wrap">
        <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="3"/>
      </text_tiny>
    </lv_obj>
    <!-- Filament buffer mini slider (right side, hidden without a reading). The
         slider shows only with a set point to centre on; the number always. The
         number is the short form, so the column stays as narrow as the slider
         and never squeezes the material name. -->
    <lv_obj name="buffer_mini"
            width="content" height="content" style_max_width="22%" style_pad_all="0" scrollable="false"
            flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="0">
      <bind_flag_if_eq subject="buffer_present" flag="hidden" ref_value="0"/>
      <lv_obj name="buffer_mini_slider"
              width="#buffer_slider_w" height="#buffer_mini_h" style_pad_all="0" scrollable="false" clickable="false">
        <bind_flag_if_eq subject="buffer_slider" flag="hidden" ref_value="0"/>
      </lv_obj>
      <text_tiny name="buffer_mini_value"
                 width="content" bind_text="buffer_short_text" style_text_align="center" long_mode="wrap">
        <bind_style_if_eq name="styles.buffer_ok" subject="buffer_status" ref_value="0"/>
        <bind_style_if_eq name="styles.buffer_warning" subject="buffer_status" ref_value="1"/>
        <bind_style_if_eq name="styles.buffer_danger" subject="buffer_status" ref_value="2"/>
      </text_tiny>
      <text_tiny name="buffer_mini_label"
                 width="content" bind_text="buffer_label" style_text_color="#text_muted" style_text_align="center">
        <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="3"/>
      </text_tiny>
    </lv_obj>
  </view>
</component>
