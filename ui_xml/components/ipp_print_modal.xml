<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <view name="ipp_print_modal"
        extends="dialog_frame" style_min_width="320" style_max_width="420" title="Sheet Label Print"
        title_tag="Sheet Label Print" icon="printer" icon_variant="accent">
    <!-- Template name -->
    <lv_obj width="100%"
            height="content" flex_flow="row" style_pad_all="0" style_bg_opa="0" style_border_width="0"
            scrollable="false" style_flex_cross_place="center" style_pad_gap="#space_md">
      <text_body width="content" text="Template"/>
      <text_body name="template_name" flex_grow="1" style_text_align="right" text=""/>
    </lv_obj>

    <!-- Label count -->
    <lv_obj width="100%"
            height="content" flex_flow="row" style_pad_all="0" style_bg_opa="0" style_border_width="0"
            scrollable="false" style_flex_cross_place="center" style_pad_gap="#space_md">
      <text_body width="content" text="Labels"/>
      <lv_dropdown name="dropdown_count" flex_grow="1"/>
    </lv_obj>

    <!-- Start position -->
    <lv_obj width="100%"
            height="content" flex_flow="row" style_pad_all="0" style_bg_opa="0" style_border_width="0"
            scrollable="false" style_flex_cross_place="center" style_pad_gap="#space_md">
      <text_body width="content" text="Start at"/>
      <lv_dropdown name="dropdown_start" flex_grow="1"/>
    </lv_obj>

    <dialog_frame-footer>
      <modal_button_row primary_text="Print" secondary_text="Cancel"/>
    </dialog_frame-footer>
  </view>
</component>
