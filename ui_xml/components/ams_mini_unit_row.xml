<component>
  <!-- One unit's row of lane bars in the AMS mini strip's stacked multi-unit
       view. The strip moves its pooled bars in and out of it. -->
  <api>
    <!-- Where the bars sit along the row: the strip's bars_align ("center" or "start") -->
    <prop name="main_place" type="string" default="center"/>
  </api>
  <view extends="lv_obj"
        width="content" flex_grow="1" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false"
        event_bubble="true" flex_flow="row" style_flex_main_place="$main_place" style_flex_cross_place="end"
        style_flex_track_place="center" style_pad_column="#space_xxs"/>
</component>
