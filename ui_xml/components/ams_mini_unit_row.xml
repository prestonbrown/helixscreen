<component>
  <!-- One line of unit boxes in the AMS mini strip's bar view. The strip
       moves each unit's box (ams_mini_unit_group) in and out of it. -->
  <api>
    <!-- Where the boxes sit along the line: the strip's bars_align ("center" or "start") -->
    <prop name="main_place" type="string" default="center"/>
  </api>
  <view extends="lv_obj"
        width="content" height="content" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false"
        event_bubble="true" flex_flow="row" style_flex_main_place="$main_place" style_flex_cross_place="end"
        style_flex_track_place="center" style_pad_column="#space_xs"/>
</component>
