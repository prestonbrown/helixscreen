<!-- One row of a Before / After results table: its name, the value before,
     an arrow, and what was measured. A row with nothing to save dims, its after
     struck through. A long value (a shaper per axis) wraps once, then ends in
     dots, and the row grows to hold it. The columns line up with the table's
     heads (calibration_run_overlay.xml, components/calibration_result.xml).
     Its subjects are <prefix>_<field>_<step>; the guided run's prefix is
     cal_run (CalibrationRunOverlay publishes them per step id):
       <prefix>_in_run_<step>  1 when the row shows
       <prefix>_keep_<step>    1 when its result goes into the save
       <prefix>_before_<step>  the value before
       <prefix>_after_<step>   the measured value, or why there is none
     label_subject names a string subject for a name that changes at run time. -->
<component>
  <api>
    <prop name="prefix" type="string" default="cal_run"/>
    <prop name="step" type="string" default=""/>
    <prop name="label" type="string" default=""/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="label_subject" type="string" default=""/>
  </api>
  <consts>
    <px name="row_radius" value="8"/>
  </consts>
  <styles>
    <style name="row_kept" bg_color="#card_bg" bg_opa="255" opa="255"/>
    <style name="row_dropped" bg_opa="0" opa="140"/>
  </styles>
  <view extends="lv_obj"
        width="100%" height="#cal_button_h" style_border_width="0" style_radius="#row_radius" style_pad_left="#space_md"
        style_pad_right="#space_md" style_pad_top="#space_xxs" style_pad_bottom="#space_xxs" style_pad_gap="#space_md"
        scrollable="false" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
        style_flex_track_place="center">
    <bind_flag_if_eq subject="${prefix}_in_run_${step}" flag="hidden" ref_value="0"/>
    <bind_style name="row_kept" subject="${prefix}_keep_${step}" ref_value="1"/>
    <bind_style name="row_dropped" subject="${prefix}_keep_${step}" ref_value="0"/>
    <text_body name="result_name"
               width="0" flex_grow="11" text="$label" translation_tag="$label_tag" bind_text="$label_subject"
               long_mode="dots" style_text_font="#cal_font_name" style_text_color="#text"/>
    <text_small name="result_before"
                width="0" style_max_height="#cal_detail_two_lines" flex_grow="10" bind_text="${prefix}_before_${step}"
                long_mode="dots" style_text_font="#cal_font_mono" style_text_color="#text_muted" style_text_opa="204"/>
    <lv_obj width="#cal_arrow_w"
            height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
      <icon name="result_arrow" src="arrow_right" size="xs" variant="muted" align="center"/>
    </lv_obj>
    <text_small name="result_after"
                width="0" style_max_height="#cal_detail_two_lines" flex_grow="13" bind_text="${prefix}_after_${step}"
                long_mode="dots" style_text_font="#cal_font_mono" style_text_color="#text">
      <bind_flag_if_eq subject="${prefix}_keep_${step}" flag="hidden" ref_value="0"/>
    </text_small>
    <text_small name="result_after_dropped"
                width="0" style_max_height="#cal_detail_two_lines" flex_grow="13" bind_text="${prefix}_after_${step}"
                long_mode="dots" style_text_font="#cal_font_mono" style_text_color="#text_muted"
                style_text_decor="strikethrough">
      <bind_flag_if_eq subject="${prefix}_keep_${step}" flag="hidden" ref_value="1"/>
    </text_small>
  </view>
</component>
