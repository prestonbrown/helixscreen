<!-- One step on the guided run's Results page: its name, what the printer had before and
     what the run measured. CalibrationRunOverlay publishes, per step id:
       cal_run_in_run_<step>  1 when the step was part of this run
       cal_run_state_<step>   2 finished; anything else did not finish
       cal_run_before_<step>  the value before the run
       cal_run_after_<step>   the measured value, or why there is none -->
<component>
  <api>
    <prop name="step" type="string" default=""/>
    <prop name="label" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" style_bg_color="#card_bg" style_bg_opa="100%" style_border_width="0"
        style_radius="#border_radius" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_xxs"
        style_pad_bottom="#space_xxs" style_pad_gap="#space_sm" scrollable="false" flex_flow="row"
        style_flex_main_place="start" style_flex_cross_place="center">
    <bind_flag_if_eq subject="cal_run_in_run_${step}" flag="hidden" ref_value="0"/>
    <text_body name="result_name" width="28%" text="$label" long_mode="dots"/>
    <text_small name="result_before"
                width="0" flex_grow="1" bind_text="cal_run_before_${step}" long_mode="dots"
                style_text_color="#text_muted"/>
    <icon name="result_arrow" src="chevron_right" size="xs" variant="secondary"/>
    <text_small name="result_after" width="0" flex_grow="1" bind_text="cal_run_after_${step}" long_mode="dots">
      <bind_flag_if_not_eq subject="cal_run_state_${step}" flag="hidden" ref_value="2"/>
    </text_small>
    <text_small name="result_unfinished"
                width="0" flex_grow="1" bind_text="cal_run_after_${step}" long_mode="dots" style_text_color="#warning">
      <bind_flag_if_eq subject="cal_run_state_${step}" flag="hidden" ref_value="2"/>
    </text_small>
  </view>
</component>
