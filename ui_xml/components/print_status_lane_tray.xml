<!-- Print status lane tray: the filament system's lanes on a card, live as
     the home grid's tray is. A tap opens the filament system's panel.
     PrintStatusLayoutFitter decides where it shows (ps_lane_tray) and gives
     the tray its width. -->
<component>
  <view extends="lv_obj"
        style_pad_all="#space_sm" style_bg_color="#card_bg" style_bg_opa="255" style_border_width="0"
        style_radius="#border_radius" scrollable="false">
    <ams_mini_status name="ps_lane_tray_status" width="100%" height="100%" card="false"/>
  </view>
</component>
