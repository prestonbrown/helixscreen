<!-- A soft glow of `color` over a part of the printer picture, shaped and
     positioned by the owner's CalloutPresenter. Strong while tone_subject is 1
     (Active: heating, spinning, on), soft otherwise; shown_subject 0 hides it. -->
<component>
  <api>
    <prop name="tone_subject" type="subject" default=""/>
    <prop name="shown_subject" type="subject" default=""/>
    <prop name="color" type="string" default="#info"/>
  </api>
  <styles>
    <style name="glow_soft" opa="70"/>
    <style name="glow_strong" opa="175"/>
  </styles>
  <view extends="plate_glow" style_image_recolor="$color" style_image_recolor_opa="255">
    <style name="glow_soft"/>
    <bind_style_if_eq name="glow_strong" subject="$tone_subject" ref_value="1"/>
    <bind_flag_if_eq subject="$shown_subject" flag="hidden" ref_value="0"/>
  </view>
</component>
