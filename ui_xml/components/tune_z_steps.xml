<component>
  <!-- The Z-offset step amounts, radio-style: one active at a time. Part of
       tune_z_offset, which places it beside the direction buttons in
       landscape and on a full-width row of its own in portrait. -->
  <api>
    <prop name="btn_h" type="string" default="#button_height_sm"/>
  </api>
  <view extends="lv_obj"
        height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row"
        style_pad_gap="#space_xxs" scrollable="false">
    <choice_button name="btn_z_step_0"
                   height="$btn_h" flex_grow="1" text="0.05" subject="z_step_selected_idx" value="0"
                   callback="on_tune_z_step" user_data="0"/>
    <choice_button name="btn_z_step_1"
                   height="$btn_h" flex_grow="1" text="0.025" subject="z_step_selected_idx" value="1"
                   callback="on_tune_z_step" user_data="1"/>
    <choice_button name="btn_z_step_2"
                   height="$btn_h" flex_grow="1" text="0.01" subject="z_step_selected_idx" value="2"
                   callback="on_tune_z_step" user_data="2"/>
    <choice_button name="btn_z_step_3"
                   height="$btn_h" flex_grow="1" text="0.005" subject="z_step_selected_idx" value="3"
                   callback="on_tune_z_step" user_data="3"/>
  </view>
</component>
