<!-- NOTE: 0x prefix for literal hex colors (# triggers constant lookup) -->
<!-- Flat 30-swatch preset color grid (row_wrap). Parameterized callback so
     multiple hosts can consume it. Colors mirror the ColorPicker presets. -->
<component>
  <api>
    <!-- Required: each host names its own click handler. No default on purpose —
         an implicit AMS-specific default (ams_edit_color_swatch_cb) would
         silently bind an unrelated screen's swatches to the AMS overlay's
         handler (get_ams_edit_overlay()), coupling instances across screens. -->
    <prop name="swatch_callback" type="string"/>
  </api>
  <consts>
    <!-- Fallback values. Overridden at runtime by
         register_swatch_grid_constants() (xml_registration.cpp):
         swatch 24/28/32 by screen height, width computed as 6 columns so the
         30 swatches always form 5 even rows at every breakpoint. -->
    <px name="grid_swatch_size" value="32"/>
    <px name="grid_gap" value="8"/>
    <px name="grid_width" value="232"/>
  </consts>
  <view name="color_swatch_grid"
        extends="lv_obj" width="#grid_width" height="content" style_pad_all="0" flex_flow="row_wrap"
        style_pad_gap="#grid_gap" style_flex_main_place="center" scrollable="false">
    <!-- Row 1: Grays -->
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x1A1A1A" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x4A4A4A" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x808080" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xB0B0B0" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xE8E8E8" style_bg_opa="255"
            style_border_width="1" style_border_color="#text_muted" clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xFFFFFF" style_bg_opa="255"
            style_border_width="1" style_border_color="#text_muted" clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <!-- Row 2: Warm colors -->
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xE53935" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xFF9800" style_bg_opa="255"
            clickable="true" scrollable="false">
