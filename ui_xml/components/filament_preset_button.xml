<!-- One material preset: its name over its nozzle and bed temperatures, from
     preset slot $slot. A tap heats; a hold reassigns the slot. Both
     orientations of filament_material_group.xml lay these out. -->
<component>
  <api>
    <prop name="slot" type="string" default="0"/>
    <prop name="callback" type="string" default=""/>
    <prop name="hold_callback" type="string" default=""/>
  </api>
  <view extends="ui_button"
        width="0" height="content" flex_grow="1" style_min_height="#touch_target_min" layout="column"
        state_trickle="true" style_pad_ver="#space_xxs" style_pad_hor="#space_xxs" style_pad_gap="0">
    <bind_style name="styles.heat_blocked" subject="ams_nozzle_heat_blocked" ref_value="1"/>
    <event_cb trigger="clicked" callback="$callback"/>
    <event_cb trigger="long_pressed" callback="$hold_callback"/>
    <text_body bind_text="preset_material_${slot}_name" long_mode="dots" style_max_width="100%"/>
    <text_small bind_text="preset_material_${slot}_temps"
                style_text_align="center" style_text_color="#text_muted" long_mode="dots" style_max_width="100%"/>
  </view>
</component>
