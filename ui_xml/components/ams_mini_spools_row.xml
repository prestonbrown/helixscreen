<component>
  <!-- The AMS mini strip's wide spool view, created the first time the strip
       is wide enough for it: the lanes' horizontal scroller, then the bypass
       pinned past it. Only the lanes scroll, so the bypass, often the node
       feeding the toolhead, stays in sight. The strip adds the card surface
       per its "card" attribute. -->
  <styles>
    <!-- The scrollbar runs on the scroller's bottom edge: the strip keeps the
         lanes above it, and every pixel it floats above the edge comes off them. -->
    <style name="scrollbar_flush" pad_bottom="0"/>
    <!-- Groups that all fit (LV_STATE_USER_1 on the scroller): the strip's
         unit groups wrap into lines, centered as a block, a little further
         apart than the lanes inside a group. -->
    <style name="lanes_row" layout="flex" flex_flow="row" flex_main_place="start" pad_column="#space_xxs"/>
    <style name="fill_rows" flex_flow="row_wrap" flex_main_place="center" pad_row="#space_xs" pad_column="#space_xs"/>
    <!-- Groups too many to fit (LV_STATE_USER_2): one line from the left that
         scrolls sideways, the box at the edge cut off to show there is more. -->
    <style name="scroll_line" flex_flow="row" flex_main_place="start" flex_cross_place="start" pad_column="#space_xs"/>
    <!-- Lines of groups that fit stand centered; a scrolling line tops its groups. -->
    <style name="groups_centered" flex_cross_place="center"/>
  </styles>
  <view name="ams_spools_row"
        extends="lv_obj" width="100%" height="100%" style_bg_opa="0" style_border_width="0" style_pad_all="0"
        scrollable="false" event_bubble="true" flex_flow="row" style_flex_main_place="start"
        style_flex_cross_place="center" style_flex_track_place="center" style_pad_column="#space_xxs">
    <lv_obj name="ams_spools_container"
            width="100%" height="100%" flex_grow="1" style_bg_opa="0" style_border_width="0" style_pad_all="0"
            event_bubble="true" style_flex_track_place="center" scrollable="true" scroll_dir="hor" scrollbar_mode="auto">
      <style name="scrollbar_flush" selector="scrollbar"/>
      <style name="lanes_row"/>
      <style name="groups_centered"/>
      <style name="fill_rows" selector="user_1"/>
      <style name="scroll_line" selector="user_2"/>
    </lv_obj>
  </view>
</component>
