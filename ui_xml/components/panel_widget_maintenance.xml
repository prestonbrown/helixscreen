<component>
  <!--
    Maintenance meters home tile. maintenance_model publishes the most-due meters as ranked
    rows (maintenance_r<k>_*) and the one closest to due (maintenance_worst_*);
    MaintenanceWidget publishes maintenance_rung (SizeRung), maintenance_show_total,
    maintenance_ring_d and maintenance_tile_rows (how many ranked rows fit). A tap opens the
    overview, where meters' tasks and reminder intervals are.

    Rungs: 0 glance (the ring with the hours left inside), 1 strip (the meter's short name
    and hours on one line), 2 column and 3 cell (the ring over the name), 4 wide (the ring
    beside a row per meter), 5 full (a title, then a row and a bar per meter, and the total
    print time where it fits).
  -->
  <styles>
    <style name="mt_column"
           layout="flex" flex_flow="column" flex_main_place="center" flex_cross_place="center" flex_track_place="center"/>
    <style name="mt_row"
           layout="flex" flex_flow="row" flex_main_place="center" flex_cross_place="center" flex_track_place="center"/>
    <style name="mt_font_body" text_font="#font_body"/>
  </styles>
  <view name="panel_widget_maintenance"
        extends="lv_obj" width="100%" height="100%" style_pad_hor="#space_sm" style_pad_ver="#space_xxs"
        style_pad_row="0" style_pad_column="0" scrollable="false" flex_flow="column" style_flex_main_place="center"
        style_flex_cross_place="center" style_flex_track_place="center">
    <event_cb trigger="clicked" callback="maintenance_clicked_cb"/>
    <style name="styles.press_wash" selector="pressed"/>

    <!-- Glance, Column, Cell and Wide: the ring, with the name under it or the rows beside it. -->
    <pass_through name="mt_main" width="100%" height="100%" style_pad_row="#space_xxs" style_pad_column="#space_sm">
      <bind_flag_if cond="maintenance_rung eq 1 or maintenance_rung eq 5" flag="hidden"/>
      <bind_style_if_eq name="mt_row" subject="maintenance_rung" ref_value="4"/>
      <bind_style_if_not_eq name="mt_column" subject="maintenance_rung" ref_value="4"/>
      <!-- An arc draws its circle from its top-left corner, so the dial is a square the
           widget sizes. -->
      <pass_through name="mt_dial">
        <bind_style_prop prop="width" subject="maintenance_ring_d"/>
        <bind_style_prop prop="height" subject="maintenance_ring_d"/>
        <helix_progress_arc name="mt_ring"
                            width="100%" height="100%" align="center" bind_value="maintenance_worst_pct"
                            bg_start_angle="270" bg_end_angle="269" start_angle="270" end_angle="270"
                            style_arc_width="#space_xs" style_arc_width-indicator="#space_xs">
          <bind_style_if_eq name="styles.maint_arc_warn"
                            subject="maintenance_worst_status" ref_value="1" selector="indicator"/>
          <bind_style_if_eq name="styles.maint_arc_danger"
                            subject="maintenance_worst_status" ref_value="2" selector="indicator"/>
        </helix_progress_arc>
        <text_small name="mt_ring_hours"
                    align="center" bind_text="maintenance_worst_left" clickable="false" event_bubble="true">
          <bind_style_if_ge name="mt_font_body" subject="maintenance_rung" ref_value="3"/>
          <bind_style_if_eq name="styles.maint_text_warn" subject="maintenance_worst_status" ref_value="1"/>
          <bind_style_if_eq name="styles.maint_text_danger" subject="maintenance_worst_status" ref_value="2"/>
        </text_small>
      </pass_through>
      <text_tiny name="mt_ring_name"
                 bind_text="maintenance_worst_name" style_text_color="#text_muted" clickable="false" event_bubble="true">
        <bind_flag_if cond="maintenance_rung eq 0 or maintenance_rung eq 4" flag="hidden"/>
      </text_tiny>
      <!-- Wide: the most-due meters beside the ring, as many as fit. -->
      <pass_through name="mt_list"
                    width="100%" height="content" flex_grow="1" flex_flow="column" style_flex_main_place="center"
                    style_pad_row="#space_xxs">
        <bind_flag_if_not_eq subject="maintenance_rung" flag="hidden" ref_value="4"/>
        <repeat count="4">
          <pass_through name="mt_list_row_${i}"
                        width="100%" height="content" flex_flow="row" style_flex_main_place="space_between"
                        style_flex_cross_place="center" style_pad_column="#space_xs">
            <bind_flag_if cond="maintenance_r${i}_on eq 0 or maintenance_tile_rows le ${i}" flag="hidden"/>
            <text_small name="mt_list_name_${i}"
                        bind_text="maintenance_r${i}_short" style_text_color="#text_muted" clickable="false"
                        event_bubble="true"/>
            <text_small name="mt_list_hours_${i}"
                        bind_text="maintenance_r${i}_left" clickable="false" event_bubble="true">
              <bind_style_if_eq name="styles.maint_text_warn" subject="maintenance_r${i}_status" ref_value="1"/>
              <bind_style_if_eq name="styles.maint_text_danger" subject="maintenance_r${i}_status" ref_value="2"/>
            </text_small>
          </pass_through>
        </repeat>
      </pass_through>
    </pass_through>

    <!-- Strip: the meter closest to due on one line. -->
    <pass_through name="mt_strip"
                  width="100%" height="content" flex_flow="row" style_flex_main_place="center"
                  style_flex_cross_place="center" style_pad_column="#space_xs">
      <bind_flag_if_not_eq subject="maintenance_rung" flag="hidden" ref_value="1"/>
      <text_small name="mt_strip_name"
                  bind_text="maintenance_worst_name" style_text_color="#text_muted" clickable="false"
                  event_bubble="true"/>
      <text_small name="mt_strip_hours" bind_text="maintenance_worst_left" clickable="false" event_bubble="true">
        <bind_style_if_eq name="styles.maint_text_warn" subject="maintenance_worst_status" ref_value="1"/>
        <bind_style_if_eq name="styles.maint_text_danger" subject="maintenance_worst_status" ref_value="2"/>
      </text_small>
    </pass_through>

    <!-- Full: a title, then a row and a bar per most-due meter, then the total. -->
    <pass_through name="mt_full"
                  width="100%" height="100%" flex_flow="column" style_flex_main_place="space_evenly"
                  style_flex_cross_place="start" style_pad_row="#space_xxs">
      <bind_flag_if_not_eq subject="maintenance_rung" flag="hidden" ref_value="5"/>
      <pass_through name="mt_title_row"
                    width="100%" height="content" flex_flow="row" style_flex_cross_place="center"
                    style_pad_column="#space_xs">
        <icon name="mt_title_icon" src="wrench" size="xs" variant="secondary" clickable="false" event_bubble="true"/>
        <text_small name="mt_title" text="Maintenance" clickable="false" event_bubble="true"/>
      </pass_through>
      <repeat count="4">
        <pass_through name="mt_row_${i}" width="100%" height="content" flex_flow="column" style_pad_row="#space_xxs">
          <bind_flag_if cond="maintenance_r${i}_on eq 0 or maintenance_tile_rows le ${i}" flag="hidden"/>
          <pass_through width="100%"
                        height="content" flex_flow="row" style_flex_main_place="space_between"
                        style_flex_cross_place="center" style_pad_column="#space_xs">
            <text_small name="mt_row_name_${i}"
                        bind_text="maintenance_r${i}_name" style_text_color="#text_muted" clickable="false"
                        event_bubble="true"/>
            <text_small name="mt_row_hours_${i}"
                        bind_text="maintenance_r${i}_left" clickable="false" event_bubble="true">
              <bind_style_if_eq name="styles.maint_text_warn" subject="maintenance_r${i}_status" ref_value="1"/>
              <bind_style_if_eq name="styles.maint_text_danger" subject="maintenance_r${i}_status" ref_value="2"/>
            </text_small>
          </pass_through>
          <lv_bar name="mt_row_bar_${i}"
                  width="100%" height="#space_xs" min_value="0" max_value="100" bind_value="maintenance_r${i}_pct"
                  style_bg_color="#border" style_bg_opa="255" style_radius="#border_radius" style_bg_opa-indicator="255"
                  style_radius-indicator="#border_radius" clickable="false" event_bubble="true">
            <style name="styles.maint_bar_normal" selector="indicator"/>
            <bind_style_if_eq name="styles.maint_bar_warn"
                              subject="maintenance_r${i}_status" ref_value="1" selector="indicator"/>
            <bind_style_if_eq name="styles.maint_bar_danger"
                              subject="maintenance_r${i}_status" ref_value="2" selector="indicator"/>
          </lv_bar>
        </pass_through>
      </repeat>
      <text_tiny name="mt_total"
                 bind_text="maintenance_total_text" style_text_color="#text_muted" clickable="false" event_bubble="true">
        <bind_flag_if_eq subject="maintenance_show_total" flag="hidden" ref_value="0"/>
      </text_tiny>
    </pass_through>
  </view>
</component>
