<component>
  <!-- One row of a vertical step list: the dot, then the step's name and an
       optional detail line under it, filling the rest of the row. The row binds
       its state from state_subject (0 pending, 1 active, 2 done, 3 failed) and
       trickles it to the dot and the name: LV_STATE_USER_1 active,
       LV_STATE_CHECKED done, LV_STATE_USER_2 failed. The name is the static
       label (translated through label_tag) or, for printer text, the string
       subject label_subject. The dot props pass through to step_progress_dot.
       The state binds come last, so the state they set trickles to children
       that already exist. -->
  <api>
    <prop name="state_subject" type="string" default=""/>
    <prop name="label" type="string" default=""/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="label_subject" type="string" default=""/>
    <prop name="detail_subject" type="string" default=""/>
    <prop name="label_font" type="string" default="#font_small"/>
    <prop name="label_font_active" type="string" default="#font_body"/>
    <prop name="label_color" type="color" default="#text_subtle"/>
    <prop name="label_color_active" type="color" default="#text"/>
    <prop name="label_pending_opa" type="string" default="255"/>
    <prop name="detail_font" type="string" default="#font_small"/>
    <prop name="number" type="string" default=""/>
    <prop name="dot_size" type="string" default="#step_indicator"/>
    <prop name="glyph_font" type="string" default="mdi_icons_16"/>
    <prop name="done_icon" type="string" default="check"/>
    <prop name="pending_fill" type="color" default="#text_subtle"/>
    <prop name="pending_fill_opa" type="string" default="255"/>
    <prop name="pending_border" type="color" default="#text_subtle"/>
    <prop name="number_pending_color" type="color" default="0xFFFFFF"/>
    <prop name="number_active_color" type="color" default="0xFFFFFF"/>
  </api>
  <view name="step_item"
        extends="lv_obj" width="100%" height="content" state_trickle="true" style_bg_opa="0" style_border_width="0"
        style_pad_all="0" style_pad_gap="#step_label_gap" scrollable="false" scrollbar_mode="off" flex_flow="row"
        style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="start">
    <step_progress_dot number="$number"
                       size="$dot_size" glyph_font="$glyph_font" done_icon="$done_icon" pending_fill="$pending_fill"
                       pending_fill_opa="$pending_fill_opa" pending_border="$pending_border"
                       number_pending_color="$number_pending_color" number_active_color="$number_active_color"/>
    <lv_obj name="step_text"
            width="0" height="content" flex_grow="1" state_trickle="true" style_pad_all="0" style_pad_gap="0"
            style_bg_opa="0" style_border_width="0" flex_flow="column" scrollable="false">
      <lv_label name="step_label"
                width="100%" text="$label" translation_tag="$label_tag" bind_text="$label_subject"
                style_text_font="$label_font" style_text_color="$label_color" style_text_opa="$label_pending_opa"
                style_text_font-user_1="$label_font_active" style_text_color-user_1="$label_color_active"
                style_text_opa-user_1="255" style_text_opa-checked="255" style_text_opa-user_2="255"/>
      <text_small name="step_detail"
                  width="100%" bind_text="$detail_subject" hidden_if_empty="$detail_subject" long_mode="dots"
                  style_text_font="$detail_font" style_text_color="#text_muted" style_text_opa="204"/>
    </lv_obj>
    <bind_state_if_eq subject="$state_subject" state="user_1" ref_value="1"/>
    <bind_state_if_eq subject="$state_subject" state="checked" ref_value="2"/>
    <bind_state_if_eq subject="$state_subject" state="user_2" ref_value="3"/>
  </view>
</component>
