<component>
  <!-- One product row of the filament catalog selector:
       [check_indicator] [name_label ....] [variant_chip] [temp_label] [edit_icon].
       All layout / sizes / fonts / padding / radii / colors live here via design
       tokens; C++ only sets label text, data-driven theme colors, and show/hide
       on the optional children. Non-interactive children carry event_bubble so a
       tap falls through to the clickable row; edit_icon intercepts its own tap
       (clickable, NO event_bubble) so editing never fires row-select. -->
  <view name="catalog_row"
        extends="lv_obj" width="100%" height="content" flex_flow="row" style_flex_cross_place="center"
        style_pad_hor="#space_md" style_pad_ver="#space_sm" style_pad_gap="#space_sm" style_radius="#border_radius"
        style_bg_opa="0" scrollable="false" clickable="true">
    <!-- Pressed wash from the shared style library (ui_xml/styles.xml).
         Row-level style_radius matches the wash radius token, no override. -->
    <style name="styles.press_wash" selector="pressed"/>
    <event_cb trigger="clicked" callback="catalog_row_clicked_cb"/>
    <!-- Selected-row checkmark. C++ sets the check codepoint + accent color on
         the highlighted row and clears it elsewhere. min_width reserves the
         column so every row's name aligns whether or not the check shows. -->
    <lv_label name="check_indicator"
              text="" style_text_font="#icon_font_xs" style_min_width="16" clickable="false" event_bubble="true"/>
    <!-- Product name. Flex-grows to push temps / edit to the trailing edge and
         ellipsizes on narrow screens. -->
    <lv_label name="name_label"
              text="" flex_grow="1" long_mode="dots" style_text_font="#font_body" style_text_color="#text"
              clickable="false" event_bubble="true"/>
    <!-- Variant-disambiguation chip (e.g. "ASA-CF" under the ASA heading).
         Hidden until C++ shows it for a variant row whose type differs from the
         family heading. -->
    <lv_label name="variant_chip"
              text="" hidden="true" style_text_font="#font_body" style_text_color="#text_muted" clickable="false"
              event_bubble="true"/>
    <!-- Recommended nozzle / bed temps ("210 / 60"), formatted by C++. -->
    <lv_label name="temp_label"
              text="" style_text_font="#font_body" style_text_color="#text" clickable="false" event_bubble="true"/>
    <!-- Trailing edit affordance. Unlike the other children it STAYS clickable
         with NO event_bubble, so a tap hit-tests to the icon (its own CLICKED
         target) and the row-select handler never fires — declarative
         stop-propagation. Hidden unless the host opts into edit affordances. -->
    <lv_label name="edit_icon"
              text="#icon_pencil" hidden="true" style_text_font="#icon_font_xs" style_text_color="#text_muted"
              style_min_width="20" style_text_align="center" clickable="true">
      <event_cb trigger="clicked" callback="catalog_row_edit_cb"/>
    </lv_label>
  </view>
</component>
