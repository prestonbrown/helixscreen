<component>
  <styles>
    <!-- Homing indicator styles for the position dots below. Scoped to this
         file (helix-xml styles do not cross component-file boundaries,
         lv_xml_get_style_by_name() falls back to "globals" only) so they
         must live here now, not in motion_panel.xml's <styles> block. -->
    <style name="indicator_homed" bg_color="#success"/>
    <style name="indicator_unhomed" bg_color="#text_muted"/>
  </styles>
  <view name="position_card"
        extends="lv_obj" height="content" style_min_height="#motion_card_min_h" style_pad_all="#space_sm"
        flex_flow="column" style_pad_gap="#space_xs" style_flex_main_place="start" style_bg_color="#elevated_bg"
        style_bg_opa="255" style_radius="#border_radius">
    <lv_obj style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs" style_flex_cross_place="center">
      <text_small text="X:"/>
      <text_small name="pos_x" bind_text="motion_pos_x"/>
      <lv_obj width="8" height="8" style_radius="9999">
        <bind_style name="indicator_homed" subject="motion_x_homed" ref_value="1"/>
        <bind_style name="indicator_unhomed" subject="motion_x_homed" ref_value="0"/>
      </lv_obj>
    </lv_obj>
    <lv_obj style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs" style_flex_cross_place="center">
      <text_small text="Y:"/>
      <text_small name="pos_y" bind_text="motion_pos_y"/>
      <lv_obj width="8" height="8" style_radius="9999">
        <bind_style name="indicator_homed" subject="motion_y_homed" ref_value="1"/>
        <bind_style name="indicator_unhomed" subject="motion_y_homed" ref_value="0"/>
      </lv_obj>
    </lv_obj>
    <lv_obj style_pad_all="0" flex_flow="column" style_pad_gap="0">
      <lv_obj style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs" style_flex_cross_place="center">
        <text_small text="Z:"/>
        <text_small name="pos_z" bind_text="motion_pos_z"/>
        <lv_obj width="8" height="8" style_radius="9999">
          <bind_style name="indicator_homed" subject="motion_z_homed" ref_value="1"/>
          <bind_style name="indicator_unhomed" subject="motion_z_homed" ref_value="0"/>
        </lv_obj>
      </lv_obj>
      <!-- Act: measured Z. Toggles freely mid-calibration: the card's size is
           pinned by the motion_card_min_* tokens (declared in
           motion_panel.xml), so this row appearing changes no other element's
           position - not the rows above, not the jog pad beside/below. -->
      <lv_obj style_pad_all="0"
              style_pad_left="#space_md" flex_flow="row" style_pad_gap="#space_xs" style_flex_cross_place="center">
        <bind_flag_if_eq subject="motion_z_actual_visible" flag="hidden" ref_value="0"/>
        <text_small text="Act:" style_text_color="#text_muted"/>
        <text_small name="pos_z_actual" bind_text="motion_pos_z_actual" style_text_color="#text_muted"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
