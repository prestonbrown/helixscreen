<!-- The wizard header's progress mark, one mark per step. count_subject and
     current_subject (0-based) are int subjects; at most 10 steps.
       mode="1"  dots: the current one a wide blue pill
       mode="2"  segments: the done and current ones lit (on_style: seg_on blue,
                 seg_on_warn amber for a step that needs you), the rest a dim track
     The wizard frame's header places it. -->
<component>
  <api>
    <prop name="count_subject" type="string" default=""/>
    <prop name="current_subject" type="string" default=""/>
    <prop name="mode" type="int" default="1"/>
    <prop name="on_style" type="string" default="seg_on"/>
  </api>
  <consts>
    <px name="dot" value="8"/>
    <px name="dot_wide" value="22"/>
    <px name="dot_gap" value="6"/>
    <px name="seg_w" value="34"/>
    <px name="seg_h" value="6"/>
    <px name="seg_gap" value="5"/>
  </consts>
  <styles>
    <!-- text_subtle: an off dot must read on both themes' header backgrounds. -->
    <style name="dot_off" width="#dot" height="#dot" bg_color="#text_subtle"/>
    <style name="dot_on" width="#dot_wide" bg_color="#primary"/>
    <style name="seg_off" bg_color="#elevated_bg"/>
    <style name="seg_on" bg_color="#primary"/>
    <style name="seg_on_warn" bg_color="#warning"/>
  </styles>
  <view extends="lv_obj"
        width="content" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
    <if cond="$mode eq 1">
      <lv_obj width="content"
              height="content" style_pad_all="0" style_pad_gap="#dot_gap" style_bg_opa="0" style_border_width="0"
              flex_flow="row" style_flex_cross_place="center" scrollable="false">
        <repeat count="10">
          <lv_obj style_radius="9999" style_bg_opa="255" style_border_width="0" scrollable="false">
            <style name="dot_off"/>
            <bind_flag_if cond="${count_subject} le ${i}" flag="hidden"/>
            <bind_style_if name="dot_on" cond="${current_subject} eq ${i}"/>
          </lv_obj>
        </repeat>
      </lv_obj>
    </if>
    <if cond="$mode eq 2">
      <lv_obj width="content"
              height="content" style_pad_all="0" style_pad_gap="#seg_gap" style_bg_opa="0" style_border_width="0"
              flex_flow="row" style_flex_cross_place="center" scrollable="false">
        <repeat count="10">
          <lv_obj width="#seg_w"
                  height="#seg_h" style_radius="9999" style_bg_opa="255" style_border_width="0" scrollable="false">
            <style name="seg_off"/>
            <bind_flag_if cond="${count_subject} le ${i}" flag="hidden"/>
            <bind_style_if name="$on_style" cond="${current_subject} ge ${i}"/>
          </lv_obj>
        </repeat>
      </lv_obj>
    </if>
  </view>
</component>
