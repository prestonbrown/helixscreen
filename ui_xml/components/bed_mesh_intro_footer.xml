<!-- The bed mesh intro's footer: Profiles opens the profiles view, Probe the
     bed starts a calibration at the chosen bed temperature. Hidden outside
     the intro (bed_mesh_view 0). Shared by both orientations of
     bed_mesh_panel.xml. -->
<component>
  <view extends="calibration_wizard_footer"
        back_name="btn_mesh_profiles" back_text="Profiles" back_callback="on_bed_mesh_show_profiles"
        primary_name="cal_intro_primary" primary_text="Probe the bed" primary_callback="on_bed_mesh_probe_intro"
        primary_moves_machine="true" divider="0">
    <bind_flag_if_eq subject="bed_mesh_view" flag="hidden" ref_value="1"/>
  </view>
</component>
