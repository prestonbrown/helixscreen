<component>
  <!-- Spool card — relevant with or without AMS. C++ swaps between
       Multi-Filament (AMS/multi-tool rows) and External Spool presentations,
       and hides the header row in portrait (FilamentPanel::
       update_multi_filament_card_visibility). Instantiated by both
       orientation branches of filament_panel.xml so the markup exists exactly
       once; the #filament_ams_row_h ladder it uses is declared in
       filament_panel.xml (top-level files only — see
       bed_mesh_profiles_card.xml for the scope rule). -->
  <view name="spool_card"
        extends="ui_card" width="100%" height="0" flex_grow="1" style_radius="#border_radius" style_pad_ver="#space_xs"
        style_pad_hor="#space_md" style_pad_gap="#space_xxs" flex_flow="column" style_flex_main_place="start"
        style_flex_cross_place="start">
    <!-- Header row with icon (hidden when external spool mode — no AMS —
         or in portrait, where the card is a bottom strip) -->
    <lv_obj name="spool_card_header_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
            style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_sm">
      <icon src="filament" size="sm" variant="secondary"/>
      <text_body bind_text="filament_card_title"
                 translation_tag="Multi-Filament" text_transform="uppercase" style_translate_y="2"/>
    </lv_obj>

    <!-- Strip content row: holds the portrait graph button plus whichever of
         the two mode rows (AMS manage / external spool) is visible. The
         button is the leftmost element in both modes; the
         filament_graph_spacer subject shows it only on portrait screens
         whose graph card collapsed to a spacer. -->
    <lv_obj name="spool_strip_row"
            width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
            style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_lg">
      <!-- Portrait-only stand-in for a temperature graph too short to draw -->
      <ui_button name="btn_temp_graph"
                 width="#button_height" height="#button_height" icon="chart_line" variant="secondary"
                 style_bg_color="#elevated_bg" style_margin_right="#space_lg">
        <bind_flag_if_eq subject="filament_graph_spacer" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="filament_temp_graph_cb"/>
      </ui_button>

      <!-- AMS mini status + action widget row. Fixed height so the row
           works when the parent card sizes to content (flex_grow has no
           parent slack to distribute in that mode). Using button_height_lg
           so the AMS slot indicators aren't pinched at MICRO (26px on
           button_height is below the mini-status 32px floor). -->
      <lv_obj name="ams_manage_row"
              width="0" height="#filament_ams_row_h" flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="row"
              style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_gap="#space_sm"
              hidden="true">
        <!-- AMS mini status (auto-binds to AmsState, fills width, stretches to row height) -->
        <ams_mini_status name="ams_mini_status" height="100%" flex_grow="1" bars_align="start"/>
        <!-- Manage Button (shown when single-tool AMS, hidden when multi-tool) -->
        <ui_button name="btn_manage_slots"
                   width="content" height="#button_height" text="Manage" style_pad_left="#space_md"
                   style_pad_right="#space_md">
          <event_cb trigger="clicked" callback="filament_manage_slots_cb"/>
        </ui_button>
        <!-- Extruder Dropdown (shown when multi-tool, replaces Manage button) -->
        <lv_obj name="extruder_selector_group"
                width="content" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                style_flex_cross_place="start" style_pad_gap="2" hidden="true">
          <text_small name="extruder_caption" bind_text="filament_tool_noun"/>
          <lv_dropdown name="extruder_dropdown"
                       width="content" height="content" style_min_width="80" style_radius="#border_radius_sm"
                       style_pad_all="#space_sm">
            <event_cb trigger="value_changed" callback="on_extruder_dropdown_changed"/>
          </lv_dropdown>
        </lv_obj>
        <!-- Pick up / Park the tool the selector aims at (hidden when neither applies) -->
        <ui_button name="btn_target_tool_action"
                   width="content" height="#button_height" variant="secondary"
                   bind_text="filament_target_tool_action_text" moves_machine="true" style_pad_left="#space_md"
                   style_pad_right="#space_md">
          <bind_flag_if_eq subject="filament_target_tool_action" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_filament_target_tool_action"/>
        </ui_button>
      </lv_obj>

      <!-- No endless-spool status row here, deliberately. The graph card is
           the flexible remainder of the panel's column in BOTH orientations
           (apply_left_column_sizing), so any row added to spool_card is paid
           for entirely by the graph. The status line lives on the AMS panel,
           next to the arrows it explains, and in the slot context menu, which
           is where the disabled-or-absent backup dropdown actually is. -->
      <!-- External spool row (visible when no AMS and no multi-tool, managed by C++) -->
      <lv_obj name="external_spool_row"
              width="0" height="content" flex_grow="1" style_pad_all="0" scrollable="false" clickable="true"
              flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_sm"
              hidden="true" style_radius="#border_radius">
        <!-- Pressed wash from the shared style library (ui_xml/styles.xml) -->
        <style name="styles.press_wash" selector="pressed"/>
        <event_cb trigger="clicked" callback="on_external_spool_edit"/>
        <!-- Spool canvas container (C++ creates 48x48 canvas inside) -->
        <lv_obj name="external_spool_container"
                width="48" height="48" style_pad_all="0" scrollable="false" clickable="false" event_bubble="true"/>
        <!-- Material info column -->
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="column" style_flex_main_place="center"
                style_flex_cross_place="start" style_pad_gap="2" clickable="false" event_bubble="true">
          <text_body name="external_spool_material_label" text="No spool assigned" clickable="false" event_bubble="true"/>
          <text_small name="external_spool_color_label" text="Tap to assign" clickable="false" event_bubble="true"/>
        </lv_obj>
      </lv_obj>
    </lv_obj>
  </view>
</component>
