<!-- One fact about a calibration step on its intro ("about 4 min", "loud",
     "heats to 210°"): a status_pill in the badges row of calibration_intro,
     sized for the calibration screens. Static text in `text`, or a string
     subject in `bind`. variant="warm" tints it amber for what makes noise or
     heat; the default is the quiet neutral pill. -->
<component>
  <api>
    <prop name="text" type="string" default=""/>
    <prop name="text_tag" type="string" default=""/>
    <prop name="bind" type="string" default=""/>
    <prop name="variant" type="string" default="neutral"/>
  </api>
  <view extends="status_pill"
        text="$text" text_tag="$text_tag" bind_text="$bind" variant="$variant" radius="9999" pad_hor="#space_md"
        pad_ver="#space_xs" style_text_font="#cal_font_detail" clickable="false"/>
</component>
