<!-- One fact about a calibration step on its intro ("about 4 min", "loud",
     "heats to 210°"): a pill in the badges row of calibration_intro. Static
     text in `text`, or a string subject in `bind`. `warm` tints it amber for
     what makes noise or heat; it maps to LV_STATE_CHECKED. -->
<component>
  <api>
    <prop name="text" type="string" default=""/>
    <prop name="bind" type="string" default=""/>
    <prop name="warm" type="boolean" default="false"/>
  </api>
  <styles>
    <style name="neutral" bg_color="#elevated_bg" bg_opa="24%"/>
    <style name="warm" bg_color="#warning" bg_opa="12%"/>
  </styles>
  <view extends="lv_obj"
        width="content" height="content" style_radius="9999" style_border_width="0" style_pad_hor="#space_md"
        style_pad_ver="#space_xs" checked="$warm" state_trickle="true" scrollable="false" clickable="false">
    <style name="neutral"/>
    <style name="warm" selector="checked"/>
    <text_small name="badge_text"
                text="$text" bind_text="$bind" style_text_font="#cal_intro_font_caption" style_text_color="#text_muted"
                style_text_color-checked="#warning" clickable="false"/>
  </view>
</component>
