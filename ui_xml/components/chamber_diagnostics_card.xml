<component>
  <!-- Chamber-heater diagnostics strip (issue #1290): the compact fallback
       for the sizes where the diagnostics cannot live in the right column's
       chamber card: portrait always, and micro landscape (480x272), where
       the right column has no room for the fault banner and the readout rows
       beside the presets. temp_graph_overlay.xml gates this instantiation
       with (ui_is_portrait or ui_breakpoint eq 0); everywhere else the
       diagnostics render inside chamber_display_card instead. At micro
       landscape the card's copy of this markup is bind-hidden, not unbuilt,
       so the inner widget names exist twice in the tree. Known and
       harmless: the card's copy is hidden and inert.

       One info row: element icon + value, filter-fan icon + percent, muted
       External marker, and the fan switch, sized so the tightest target
       (272x480 chamber mode: ~300px for chart + strip) keeps a usable chart
       with zero scroll. A fault replaces the info row with the one-row
       chamber_fault_banner: on a heater that is faulted, inhibited or
       offline, the reason and its Reset action are the whole story.

       Data arrives exclusively through global subjects; the switch and the
       banner's Reset fire TemperatureService XML callbacks that delegate to
       the globally registered TemperatureController. While the device drives
       the filter fan itself the percent readout gains a muted Device badge
       beside it and the switch disables: the pin is a request the device
       overrides. The caller owns outer visibility: instantiate inside
       <if cond="printer_has_chamber_heater_diagnostics and temp_graph_mode eq 3">. -->
  <view name="chamber_diagnostics_card"
        extends="ui_card" width="100%" height="content" style_radius="0" flex_flow="column" style_pad_all="#space_xxs"
        style_pad_gap="#space_xxs" style_margin_top="#space_sm">
    <chamber_fault_banner name="fault_banner"/>
    <lv_obj name="strip_info_row"
            width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm"
            style_flex_cross_place="center" scrollable="false">
      <bind_flag_if cond="chamber_heater_fault or chamber_heater_inhibited or chamber_heater_offline" flag="hidden"/>
      <lv_obj name="element_readout"
              height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xxs"
              style_flex_cross_place="center" scrollable="false">
        <bind_flag_if_eq subject="printer_has_chamber_element_temp" flag="hidden" ref_value="0"/>
        <icon src="radiator" size="xs"/>
        <text_small name="element_temp_label" bind_text="chamber_heater_element_temp_text" long_mode="dots"/>
      </lv_obj>
      <lv_obj name="filter_fan_readout"
              height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xxs"
              style_flex_cross_place="center" scrollable="false">
        <bind_flag_if_eq subject="printer_has_chamber_filter_fan" flag="hidden" ref_value="0"/>
        <icon src="fan" size="xs"/>
        <text_small name="fan_percent_label" bind_text="chamber_filter_fan_percent_text"/>
        <!-- Device badge: the fan runs on the device's own initiative
             (heater warmup / thermal purge), not on our pin request. -->
        <text_small name="fan_device_badge" text="Device" translation_tag="Device" style_text_color="#text_muted">
          <bind_flag_if cond="chamber_filter_fan_device_driven" flag="hidden" invert="true"/>
        </text_small>
      </lv_obj>
      <!-- Another controller is driving the heater: the device's own web UI,
           a button on the unit, or the appliance's own auto cycle holding a
           target of its own. Informational, not a fault. -->
      <text_small name="external_control_badge"
                  text="External" translation_tag="External" style_text_color="#text_muted">
        <bind_flag_if cond="chamber_heater_externally_controlled" flag="hidden" invert="true"/>
      </text_small>
      <lv_obj height="1" flex_grow="1" style_pad_all="0" scrollable="false"/>
      <!-- Filter fan switch: only when the backend wires a filter-fan pin.
           Disabled while the device drives the fan itself: the pin is a
           request the device overrides, so the switch cannot stop it. -->
      <ui_switch name="filter_fan_switch" size="small">
        <bind_flag_if_eq subject="printer_has_chamber_filter_fan" flag="hidden" ref_value="0"/>
        <bind_state_if_eq subject="chamber_filter_fan_on" state="checked" ref_value="1"/>
        <bind_state_if_eq subject="chamber_filter_fan_device_driven" state="disabled" ref_value="1"/>
        <event_cb trigger="value_changed" callback="on_chamber_filter_fan_clicked"/>
      </ui_switch>
    </lv_obj>
  </view>
</component>
