<?xml version="1.0"?>
<component>
  <view name="buffer_status_modal"
        extends="ui_dialog" width="70%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">

    <!-- Header row: icon + title + close button -->
    <lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_sm" style_pad_top="#space_lg"
            style_pad_bottom="#space_sm" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm">
      <icon name="header_icon" src="info" size="md" variant="info"/>
      <text_heading text="Buffer Status" translation_tag="Buffer Status" style_text_align="left" flex_grow="1"/>
      <ui_button name="btn_close" width="40" height="40" variant="ghost" icon="close" focusable="false">
        <event_cb trigger="clicked" callback="on_modal_cancel_clicked"/>
      </ui_button>
    </lv_obj>

    <!-- The clog reading, full width above the columns.

         This modal opens off the FlowGuard tile, and used to show strictly
         less than the tile that opened it: a "Clog detection" row naming the
         mode, with no value, no threshold and no peak. The bar carries all
         three. It wants width rather than height, so it spans both columns
         instead of sharing meter_col with the plunger — which measures a
         different sensor entirely.

         Gated on clog_meter_mode by clog_bar_body's own binding, not on the
         modal: this is the buffer modal, and it is reachable on a printer with
         no clog detection at all. -->
    <lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_xs"
            style_pad_bottom="0" scrollable="false">
      <clog_bar_body/>
    </lv_obj>

    <!-- Content area: info column (left) + meter column (right) -->
    <lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_sm"
            style_pad_bottom="#space_lg" flex_flow="row" style_pad_gap="#space_md" style_flex_cross_place="center">

      <!-- Info column -->
      <lv_obj name="info_col" width="1" height="content" flex_grow="1" flex_flow="column" style_pad_gap="#space_xs">

        <!-- ============ Unsupported system ============ -->
        <!-- buf_type 0 = no Happy Hare, AFC or pressure-sensor data. Without this the dialog is
             a header and a button row over an empty box. -->
        <lv_obj name="unsupported_section" width="100%" height="content" flex_flow="column" style_pad_gap="#space_xs">
          <bind_flag_if_not_eq subject="buf_type" flag="hidden" ref_value="0"/>
          <text_small name="unsupported_text" width="100%" bind_text="buf_unsupported" long_mode="wrap"/>
        </lv_obj>

        <!-- ============ Filament pressure sensor ============ -->
        <!-- buf_type 3 = a pressure sensor reporting compression only. -->
        <lv_obj name="pressure_section" width="100%" height="content" flex_flow="column" style_pad_gap="#space_xs">
          <bind_flag_if_not_eq subject="buf_type" flag="hidden" ref_value="3"/>
          <text_small name="pressure_description" width="100%" bind_text="buf_description" long_mode="wrap"/>
        </lv_obj>

        <!-- ============ Happy Hare section ============ -->
        <lv_obj name="hh_section" width="100%" height="content" flex_flow="column" style_pad_gap="#space_xs">
          <bind_flag_if_not_eq subject="buf_type" flag="hidden" ref_value="1"/>

          <!-- Description -->
          <text_small name="hh_description" width="100%" bind_text="buf_description" long_mode="wrap"/>

          <!-- Spool motor row -->
          <lv_obj name="espooler_row" width="100%" height="content" flex_flow="row" style_pad_gap="#space_sm">
            <bind_flag_if_eq subject="buf_show_espooler" flag="hidden" ref_value="0"/>
            <text_small name="lbl_espooler" width="110" text="Spool motor" translation_tag="Spool motor"/>
            <text_small bind_text="buf_espooler_value" flex_grow="1"/>
          </lv_obj>

          <!-- Gear sync row -->
          <lv_obj width="100%" height="content" flex_flow="row" style_pad_gap="#space_sm">
            <text_small name="lbl_gear_sync" width="110" text="Gear sync" translation_tag="Gear sync"/>
            <text_small bind_text="buf_gear_sync_value" flex_grow="1"/>
          </lv_obj>

          <!-- Flow row -->
          <lv_obj name="flow_row" width="100%" height="content" flex_flow="row" style_pad_gap="#space_sm">
            <bind_flag_if_eq subject="buf_show_flow" flag="hidden" ref_value="0"/>
            <text_small name="lbl_flow" width="110" text="Flow" translation_tag="Flow"/>
            <text_small bind_text="buf_flow_value" flex_grow="1"/>
          </lv_obj>
        </lv_obj>

        <!-- ============ AFC section ============ -->
        <lv_obj name="afc_section" width="100%" height="content" flex_flow="column" style_pad_gap="#space_xs">
          <bind_flag_if_not_eq subject="buf_type" flag="hidden" ref_value="2"/>

          <!-- State row -->
          <text_small name="afc_state_label" width="100%" bind_text="buf_afc_state" long_mode="wrap"/>

          <!-- Distance row -->
          <lv_obj name="distance_row" width="100%" height="content" flex_flow="row" style_pad_gap="#space_sm">
            <bind_flag_if_eq subject="buf_show_distance" flag="hidden" ref_value="0"/>
            <text_small name="afc_distance_label" width="100%" bind_text="buf_afc_distance" long_mode="wrap"/>
          </lv_obj>
        </lv_obj>

      </lv_obj>

      <!-- Meter column (programmatically populated with UiBufferMeter) -->
      <lv_obj name="meter_col" width="100" height="150" style_min_width="100">
        <bind_flag_if_eq subject="buf_show_meter" flag="hidden" ref_value="0"/>
      </lv_obj>

    </lv_obj>

    <divider_horizontal/>

    <modal_button_row secondary_text="Cancel"
                      secondary_callback="on_modal_cancel_clicked" primary_text="OK"
                      primary_callback="on_modal_ok_clicked"/>
  </view>
</component>
