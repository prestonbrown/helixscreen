<!-- One prerequisite on the guided run's "Before you start" page: a round tick the
     owner gives, what it is, the picked steps it is for, and DETECTED when the
     printer measured it. A ticked row turns green. CalibrationRunOverlay
     publishes, per prerequisite id:
       cal_prereq_shown_<prereq>     1 when a picked step needs it
       cal_prereq_checked_<prereq>   1 when ticked
       cal_prereq_detected_<prereq>  1 when the printer measured it, so it is ticked already
       cal_prereq_for_<prereq>       "For: Z offset, bed mesh" -->
<component>
  <api>
    <prop name="prereq" type="string" default=""/>
    <prop name="label" type="string" default=""/>
    <prop name="label_tag" type="string" default=""/>
  </api>
  <consts>
    <px name="row_radius" value="10"/>
  </consts>
  <styles>
    <style name="row_open" bg_color="#card_bg" bg_opa="255" border_color="#border" border_opa="255"/>
    <style name="row_done" bg_color="#success" bg_opa="26" border_color="#success" border_opa="153"/>
    <style name="tick_open" bg_opa="0" border_width="2" border_color="#text_subtle"/>
    <style name="tick_done" bg_color="#success" bg_opa="255" border_width="0"/>
  </styles>
  <view extends="lv_button"
        width="100%" height="content" style_min_height="#cal_tile_h" style_border_width="2" style_shadow_width="0"
        style_radius="#row_radius" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_sm"
        style_pad_bottom="#space_sm" style_pad_gap="#space_lg" scrollable="false" flex_flow="row"
        style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center">
    <bind_flag_if_eq subject="cal_prereq_shown_${prereq}" flag="hidden" ref_value="0"/>
    <bind_style name="row_open" subject="cal_prereq_checked_${prereq}" ref_value="0"/>
    <bind_style name="row_done" subject="cal_prereq_checked_${prereq}" ref_value="1"/>
    <style name="styles.press_wash" selector="pressed"/>
    <lv_obj name="prereq_tick"
            width="#cal_box" height="#cal_box" style_radius="9999" style_pad_all="0" scrollable="false"
            clickable="false" event_bubble="true">
      <bind_style name="tick_open" subject="cal_prereq_checked_${prereq}" ref_value="0"/>
      <bind_style name="tick_done" subject="cal_prereq_checked_${prereq}" ref_value="1"/>
      <icon src="check_bold" size="xs" contrast="true" align="center" clickable="false" event_bubble="true">
        <bind_flag_if_eq subject="cal_prereq_checked_${prereq}" flag="hidden" ref_value="0"/>
      </icon>
    </lv_obj>
    <lv_obj width="0"
            height="content" flex_grow="1" style_pad_all="0" style_pad_gap="#space_xxs" style_bg_opa="0"
            style_border_width="0" flex_flow="column" scrollable="false" clickable="false" event_bubble="true">
      <text_body name="prereq_name"
                 width="100%" text="$label" translation_tag="$label_tag" long_mode="wrap"
                 style_text_font="#cal_font_name" style_text_color="#text" clickable="false" event_bubble="true"/>
      <text_small name="prereq_for"
                  width="100%" bind_text="cal_prereq_for_${prereq}" long_mode="wrap" style_text_font="#cal_font_detail"
                  style_text_color="#text_muted" clickable="false" event_bubble="true"/>
    </lv_obj>
    <text_small name="prereq_detected"
                text="Detected" text_transform="uppercase" style_text_font="#cal_font_badge" style_text_color="#success"
                clickable="false" event_bubble="true">
      <bind_flag_if_eq subject="cal_prereq_detected_${prereq}" flag="hidden" ref_value="0"/>
    </text_small>
    <event_cb trigger="clicked" callback="on_cal_run_prereq_toggle" user_data="$prereq"/>
  </view>
</component>
