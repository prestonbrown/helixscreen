<!-- One row of a UiMultiselect list: its label, then a checkbox the row's tap
     toggles. UiMultiselect creates one per item, sets the label (user text),
     and decides the divider and the disabled look through the props. -->
<component>
  <api>
    <prop name="checked" type="boolean" default="false"/>
    <prop name="disabled" type="boolean" default="false"/>
    <prop name="clickable" type="boolean" default="true"/>
    <prop name="text_color" type="string" default="#text"/>
    <!-- "1" draws the hairline under the row, "0" leaves it off (the last row). -->
    <prop name="divider_width" type="string" default="0"/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
        style_flex_track_place="center" style_pad_all="#space_md" style_pad_gap="#space_md" style_bg_opa="0"
        style_border_side="bottom" style_border_width="$divider_width" style_border_color="#border" scrollable="false"
        clickable="$clickable">
    <text_body name="label" text="" flex_grow="1" style_text_color="$text_color"/>
    <lv_checkbox name="check" text="" clickable="false" checked="$checked" disabled="$disabled"/>
  </view>
</component>
