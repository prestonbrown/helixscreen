<component>
  <!-- Speed and Flow: each a readout (a tap swaps which units lead) over its
       step buttons, side by side in landscape and stacked in portrait or
       where `stacked` asks (a narrow column). PrintTuneOverlay owns the
       subjects and callbacks; the Print Tuning overlay and Print Status's
       inline Tune section both instantiate it. -->
  <api>
    <prop name="btn_h" type="string" default="#button_height_sm"/>
    <prop name="gap" type="string" default="#space_lg"/>
    <!-- When Flow stacks under Speed: portrait, unless a narrow column asks
         for it always ("ui_is_portrait ge 0") -->
    <prop name="stack_cond" type="string" default="ui_is_portrait eq 1"/>
  </api>
  <styles>
    <!-- Side by side is the base; the stacked pair is bound over it while
         stack_cond holds, and a style added later wins. Neither flex_flow nor
         flex_grow may appear inline: a local style outranks both. -->
    <style name="sf_side_by_side" flex_flow="row"/>
    <style name="sf_stacked" flex_flow="column"/>
    <!-- Side by side, each section takes half. Stacked they keep their
         content height: a grow item in a content-height column gets none. -->
    <style name="sf_half" flex_grow="1"/>
    <style name="sf_whole" flex_grow="0"/>
  </styles>
  <view name="speed_flow_row"
        extends="lv_obj" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0"
        scrollable="false" style_layout="flex" style_pad_gap="$gap" overflow_visible="true">
    <style name="sf_side_by_side"/>
    <bind_style_if name="sf_stacked" cond="$stack_cond"/>
    <!-- Speed Control (left) -->
    <lv_obj name="speed_section"
            width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm"
            overflow_visible="true" scrollable="false">
      <style name="sf_half"/>
      <bind_style_if name="sf_whole" cond="$stack_cond"/>
      <!-- Tap swaps which units lead, here and on Print Status -->
      <lv_obj name="speed_readout"
              width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
              style_flex_cross_place="center" style_pad_gap="#space_sm" clickable="true" style_radius="#border_radius">
        <style name="styles.press_wash" selector="pressed"/>
        <event_cb trigger="clicked" callback="on_tune_units_toggle"/>
        <text_small text="Print Speed" style_max_width="32%" long_mode="dots" clickable="false" event_bubble="true"/>
        <text_heading name="speed_display" bind_text="tune_speed_display" clickable="false" event_bubble="true"/>
        <lv_obj height="1" flex_grow="1" style_pad_all="0" scrollable="false" clickable="false" event_bubble="true"/>
        <text_small name="actual_speed_display"
                    bind_text="tune_actual_speed_display" style_text_color="#text_muted" clickable="false"
                    event_bubble="true"/>
        <icon src="swap_horizontal" size="xs" variant="secondary" clickable="false" event_bubble="true"/>
      </lv_obj>
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs" scrollable="false">
        <ui_button name="btn_speed_minus_10" height="$btn_h" flex_grow="1" text="-10">
          <event_cb trigger="clicked" callback="on_tune_speed_adjust" user_data="-10"/>
        </ui_button>
        <ui_button name="btn_speed_minus_5" height="$btn_h" flex_grow="1" text="-5">
          <event_cb trigger="clicked" callback="on_tune_speed_adjust" user_data="-5"/>
        </ui_button>
        <ui_button name="btn_speed_plus_5" height="$btn_h" flex_grow="1" text="+5">
          <event_cb trigger="clicked" callback="on_tune_speed_adjust" user_data="5"/>
        </ui_button>
        <ui_button name="btn_speed_plus_10" height="$btn_h" flex_grow="1" text="+10">
          <event_cb trigger="clicked" callback="on_tune_speed_adjust" user_data="10"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
    <!-- Flow Control (right) -->
    <lv_obj name="flow_section"
            width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm"
            overflow_visible="true" scrollable="false">
      <style name="sf_half"/>
      <bind_style_if name="sf_whole" cond="$stack_cond"/>
      <lv_obj name="flow_readout"
              width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
              style_flex_cross_place="center" style_pad_gap="#space_sm" clickable="true" style_radius="#border_radius">
        <style name="styles.press_wash" selector="pressed"/>
        <event_cb trigger="clicked" callback="on_tune_units_toggle"/>
        <text_small text="Flow Rate" style_max_width="32%" long_mode="dots" clickable="false" event_bubble="true"/>
        <text_heading name="flow_display" bind_text="tune_flow_display" clickable="false" event_bubble="true"/>
        <lv_obj height="1" flex_grow="1" style_pad_all="0" scrollable="false" clickable="false" event_bubble="true"/>
        <text_small name="actual_flow_display"
                    bind_text="tune_actual_flow_display" style_text_color="#text_muted" clickable="false"
                    event_bubble="true"/>
        <icon src="swap_horizontal" size="xs" variant="secondary" clickable="false" event_bubble="true"/>
      </lv_obj>
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs" scrollable="false">
        <ui_button name="btn_flow_minus_5" height="$btn_h" flex_grow="1" text="-5">
          <event_cb trigger="clicked" callback="on_tune_flow_adjust" user_data="-5"/>
        </ui_button>
        <ui_button name="btn_flow_minus_1" height="$btn_h" flex_grow="1" text="-1">
          <event_cb trigger="clicked" callback="on_tune_flow_adjust" user_data="-1"/>
        </ui_button>
        <ui_button name="btn_flow_plus_1" height="$btn_h" flex_grow="1" text="+1">
          <event_cb trigger="clicked" callback="on_tune_flow_adjust" user_data="1"/>
        </ui_button>
        <ui_button name="btn_flow_plus_5" height="$btn_h" flex_grow="1" text="+5">
          <event_cb trigger="clicked" callback="on_tune_flow_adjust" user_data="5"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
  </view>
</component>
