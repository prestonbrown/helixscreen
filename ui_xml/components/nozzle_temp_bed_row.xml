<?xml version="1.0"?>
<component name="nozzle_temp_bed_row">
  <styles>
    <style name="nozzle_compact_font" text_font="#font_xs"/>
    <!-- Single column: the divider spans the full width with its top padding.
         Two columns: rows sit side by side, so the divider goes and the row
         takes half the container. -->
    <style name="nozzle_bed_full" width="100%" border_width="1" pad_top="#space_xxs"/>
    <style name="nozzle_bed_half" width="48%" border_width="0" pad_top="0"/>
  </styles>
  <view name="bed_row_root"
        extends="lv_obj" height="content" flex_flow="column" style_pad_all="0" style_pad_row="0" style_pad_column="0"
        style_bg_opa="0" style_border_side="top" style_border_color="#text_muted" style_border_opa="50"
        scrollable="false" clickable="true">
    <event_cb trigger="clicked" callback="nozzle_temps_bed_clicked_cb"/>
    <bind_style_if_eq name="nozzle_bed_full" subject="nozzle_row_columns" ref_value="1"/>
    <bind_style_if_eq name="nozzle_bed_half" subject="nozzle_row_columns" ref_value="2"/>
    <pass_through width="100%"
                  height="content" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
                  style_pad_row="0" style_pad_column="#space_sm">
      <pass_through name="bed_left_group"
                    width="content" height="content" flex_flow="row" style_flex_cross_place="center"
                    style_pad_column="#space_xs">
        <!-- The radiator takes the bed's heat color off the same subject as the
             reading beside it (nozzle_bed_heat, HeatState's value: 0 off,
             1 heating, 2 at temperature, 3 cooling), so the two cannot disagree. -->
        <icon name="bed_icon" src="radiator" size="xs">
          <bind_style_if_eq name="styles.text_tone_muted" subject="nozzle_bed_heat" ref_value="0"/>
          <bind_style_if_eq name="styles.text_tone_danger" subject="nozzle_bed_heat" ref_value="1"/>
          <bind_style_if_eq name="styles.text_tone_success" subject="nozzle_bed_heat" ref_value="2"/>
          <bind_style_if_eq name="styles.text_tone_info" subject="nozzle_bed_heat" ref_value="3"/>
        </icon>
        <!-- The bed has no tool number, and its radiator glyph already
             identifies it, so the label shows for the text rungs only and the
             icon carries the row below them. -->
        <text_small name="bed_label" width="content" text="Bed" style_text_color="#primary" style_min_width="#space_xl">
          <bind_flag_if_lt subject="nozzle_row_label_mode" flag="hidden" ref_value="2"/>
          <bind_style_if_eq name="nozzle_compact_font" subject="nozzle_row_compact" ref_value="1"/>
        </text_small>
      </pass_through>
      <pass_through name="value_group"
                    width="content" height="content" flex_flow="row" style_flex_cross_place="center"
                    style_pad_column="#space_xs">
        <!-- The value is two subjects the widget formats: the current reading,
             and the target ("/ 60°") or "off". The reading's color follows the
             heat subject, the one the radiator above binds. -->
        <text_small name="bed_temp_label" bind_text="nozzle_bed_temp_text" style_text_align="right" long_mode="clip">
          <bind_style_if_eq name="nozzle_compact_font" subject="nozzle_row_compact" ref_value="1"/>
          <bind_style_if_eq name="styles.text_tone_muted" subject="nozzle_bed_heat" ref_value="0"/>
          <bind_style_if_eq name="styles.text_tone_danger" subject="nozzle_bed_heat" ref_value="1"/>
          <bind_style_if_eq name="styles.text_tone_success" subject="nozzle_bed_heat" ref_value="2"/>
          <bind_style_if_eq name="styles.text_tone_info" subject="nozzle_bed_heat" ref_value="3"/>
        </text_small>
        <text_small name="bed_target_label"
                    bind_text="nozzle_bed_target_text" style_text_color="#text_muted" long_mode="clip">
          <bind_style_if_eq name="nozzle_compact_font" subject="nozzle_row_compact" ref_value="1"/>
          <bind_flag_if_lt subject="nozzle_row_label_mode" flag="hidden" ref_value="2"/>
        </text_small>
      </pass_through>
    </pass_through>
  </view>
</component>
