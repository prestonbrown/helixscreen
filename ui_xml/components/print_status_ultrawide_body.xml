<!-- Print status panel content on ultrawide screens: one row of columns, each
     at a shape that suits it. Left to right: the preview as a square at the
     full height, the info column, the printer picture with its callouts, the
     readouts and the button stack. PrintStatusLayoutFitter measures
     overlay_content and publishes each column's width
     (decide_print_status_columns()); the info column takes the rest. The job
     tile is the preview card while printing; during pre-print the
     start-sequence checklist covers it. -->
<component>
  <view extends="lv_obj"
        width="100%" height="100%" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
    <lv_obj name="ps_tiles"
            width="100%" height="100%" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row"
            style_pad_gap="#space_md" scrollable="false">
      <lv_obj name="ps_job_tile"
              height="100%" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
        <bind_style_prop prop="width" subject="ps_uw_preview_w"/>
        <print_status_preview_card width="100%" height="100%"/>
        <print_status_job_checklist name="ps_job_checklist" ignore_layout="true">
          <bind_flag_if_eq subject="preparing_visible" flag="hidden" ref_value="0"/>
        </print_status_job_checklist>
      </lv_obj>
      <print_status_ultrawide_info name="ps_uw_info" height="100%" flex_grow="1"/>
      <print_status_printer_tile name="ps_printer_tile" height="100%">
        <bind_style_prop prop="width" subject="ps_uw_printer_w"/>
      </print_status_printer_tile>
      <print_status_readouts name="ps_uw_readouts" height="100%">
        <bind_style_prop prop="width" subject="ps_uw_readouts_w"/>
      </print_status_readouts>
      <print_status_actions name="ps_uw_actions" height="100%" flow="column" btn_w="100%" btn_h="content">
        <bind_style_prop prop="width" subject="ps_uw_actions_w"/>
      </print_status_actions>
    </lv_obj>
  </view>
</component>
