<component>
  <!-- Which z-offset the direction buttons drive. Only a tool changer has two:
       Klipper's machine-wide gcode_move offset, and the active tool's own.
       They are independent (the firmware applies both), so this picks a
       target rather than a mode. Part of tune_z_offset. -->
  <api>
    <prop name="btn_h" type="string" default="#button_height_sm"/>
  </api>
  <!-- L040: TWO bind_styles per button -->
  <styles>
    <style name="z_step_selected" bg_color="#primary" bg_opa="255"/>
    <style name="z_step_unselected" bg_color="#primary" bg_opa="40"/>
  </styles>
  <view name="z_target_row"
        extends="lv_obj" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0"
        flex_flow="row" style_pad_gap="#space_xxs" style_flex_cross_place="center" scrollable="false" hidden="true">
    <bind_flag_if_eq subject="per_tool_z_supported" flag="hidden" ref_value="0"/>
    <ui_button name="btn_z_target_global" height="$btn_h" flex_grow="1" text="Global">
      <bind_style_if name="z_step_selected" cond="z_tune_target eq 0"/>
      <bind_style_if name="z_step_unselected" cond="z_tune_target ne 0"/>
      <event_cb trigger="clicked" callback="on_tune_z_target" user_data="0"/>
    </ui_button>
    <ui_button name="btn_z_target_tool" height="$btn_h" flex_grow="1" bind_text="tune_z_tool_label">
      <bind_style_if name="z_step_selected" cond="z_tune_target eq 1"/>
      <bind_style_if name="z_step_unselected" cond="z_tune_target ne 1"/>
      <event_cb trigger="clicked" callback="on_tune_z_target" user_data="1"/>
    </ui_button>
    <!-- The target you are NOT on, so both numbers are visible without a
         second row. Muted: it is context, not the value the buttons act on. -->
    <text_small name="z_target_other" width="content" bind_text="tune_z_other_display" style_text_color="#text_muted"/>
  </view>
</component>
