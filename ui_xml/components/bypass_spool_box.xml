<component>
  <!-- The card behind the bypass spool on the AMS path views. bypass_spool_create()
       creates it floating on the path container, sized from the lane spools
       beside it, and places the spool canvas inside it and the card itself on
       the merge line; ams_draw::set_active_ring() rings it while bypass feeds. -->
  <api>
    <prop name="size" type="string" default="0"/>
  </api>
  <view name="bypass_spool_box"
        extends="lv_obj" width="$size" height="$size" style_pad_all="0" style_bg_color="#card_bg" style_bg_opa="0"
        style_radius="#border_radius" style_border_width="0" scrollable="false" floating="true"/>
</component>
