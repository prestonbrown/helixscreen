<component>
  <!-- The Operations card (heading with the extrude speed, the filament
       change buttons under the cold-extrusion warning, then the lengths with
       Extrude/Retract, the toolhead drawing beside the rows). On a printer
       with several heads it
       also holds the panel's only tool chooser: a row of heads
       (tool_target_row.xml) that aims every operation at the chosen tool and
       never changes tools, and Pick up / Park beside the heads, which does.
       Instantiated by both orientation branches of filament_panel.xml so the
       markup exists exactly once. The action rows share the card's height. -->
  <consts>
    <!-- The width of the Pick up / Park button beside the tool cells. Both
         labels hold it, so the cells keep their size when the button flips. -->
    <px name="tool_action_btn_min_w" value="112"/>
  </consts>
  <styles>
    <!-- The cold-extrusion warning covers the buttons it disables -->
    <style name="safety_warning_cover" bg_color="#card_bg" bg_opa="255" radius="#border_radius"/>
    <!-- ui_card sets its row gap locally, which outranks any plain style, so
         the gap is an attribute here and the page style (filament_on_page)
         selects on state user_3 to outrank it: on a home full page the stacked
         Load/Unload/Purge labels need the height at the smallest screens. -->
    <style name="operations_group_on_page" pad_row="#space_xs"/>
    <!-- Landscape sizes the card to its column, and the action rows take what
         it leaves; a portrait card sizes to its rows, where growing would
         leave the rows no height at all. -->
    <style name="operations_body_fill" flex_grow="1"/>
  </styles>
  <api>
    <!-- The action rows' least height, and the extrude speed's height: one
         touch target, less where a column has no height to spare. -->
    <prop name="row_height" type="string" default="#touch_target_min"/>
    <prop name="length_height" type="string" default="#touch_target_min"/>
  </api>
  <subjects>
    <!-- A landscape row 480 wide is too short for an icon above a label, so
         the action buttons show their labels alone there. -->
    <subject_expr name="filament_ops_icons_hidden" expr="ui_is_portrait eq 0 and ui_breakpoint le 1"/>
  </subjects>
  <view name="operations_group"
        extends="ui_card" width="100%" height="content" style_radius="#border_radius" style_pad_all="#space_sm"
        scrollable="false" flex_flow="column" style_pad_gap="#space_sm">
    <bind_state_if_eq subject="filament_on_page" state="user_3" ref_value="1"/>
    <style name="operations_group_on_page" selector="user_3"/>
    <!-- Heading row, with the extrude speed at its right. Landscape with
         several heads drops it: Pick up / Park and the speed sit beside the
         heads instead, and the column has no height to spare. -->
    <lv_obj name="operations_heading_row"
            width="100%" height="content" style_min_height="#icon_size" style_pad_all="0" scrollable="false">
      <bind_flag_if cond="ui_is_portrait eq 0 and target_tool_multi_head eq 1" flag="hidden"/>
      <lv_obj name="operations_heading"
              width="content" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
              style_pad_gap="#space_sm" scrollable="false" clickable="false" align="left_mid">
        <!-- Portrait with several heads gives the heading's width to the lane
             bars, Clean and the speed. -->
        <bind_flag_if cond="ui_is_portrait eq 1 and target_tool_multi_head eq 1" flag="hidden"/>
        <icon src="swap_vertical" size="sm" variant="primary"/>
        <text_small text="Operations" text_transform="uppercase" style_translate_y="2" style_text_color="#text"/>
      </lv_obj>
      <!-- The heading's right end: the lane bars (portrait, several heads)
           and the extrude speed. -->
      <lv_obj width="content"
              height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
              style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false" align="right_mid">
        <!-- Portrait has no room for a Multi-Filament card under several
             heads, so their lane bars sit here (they open the AMS panel). -->
        <!-- The lane bars and a chevron, one tap target that opens the AMS
             panel: the card that carries Manage in landscape has no room in
             this column. The row carries the binding, because the bars show
             and hide themselves with the filament system. -->
        <lv_obj name="operations_lanes_row"
                width="content" height="#touch_target_min" flex_flow="row" style_flex_cross_place="center"
                style_pad_all="0" style_pad_gap="#space_xxs" style_bg_opa="0" style_border_width="0"
                style_radius="#border_radius" scrollable="false" clickable="true" hidden="true">
          <style name="styles.press_wash" selector="pressed"/>
          <bind_flag_if cond="ui_is_portrait eq 0 or target_tool_multi_head eq 0" flag="hidden"/>
          <event_cb trigger="clicked" callback="filament_manage_slots_cb"/>
          <ams_mini_status name="operations_lanes"
                           width="#filament_header_lanes_w" height="100%" bars_align="end" clickable="false"
                           event_bubble="true"/>
          <icon src="chevron_right" size="xs" variant="secondary" clickable="false" event_bubble="true"/>
        </lv_obj>
        <!-- Clean where its row is gone (480x272 and portrait): beside the
             speed. Its own container keeps it ahead of the speed when the
             <if> rebuilds. -->
        <lv_obj width="content"
                height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
                flex_flow="row" hidden="true">
          <bind_flag_if cond="not (ui_is_portrait eq 1 or (ui_breakpoint eq 0 and target_tool_multi_head eq 0))"
                        flag="hidden"/>
          <if cond="ui_is_portrait eq 1 or (ui_breakpoint eq 0 and target_tool_multi_head eq 0)">
            <!-- DUPLICATE_NAME_OK: its <if> excludes the other placements, so one exists -->
            <ui_button name="btn_clean_nozzle"
                       width="content" height="$length_height" style_pad_hor="#space_sm" icon="nozzle" text="Clean"
                       style_text_font="#font_small" hidden="true">
              <bind_flag_if_eq subject="filament_clean_nozzle_shown" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_filament_clean_nozzle"/>
            </ui_button>
          </if>
        </lv_obj>
        <!-- Extrude/retract speed: presets of the extrude_speed setting that
             Machine Limits also edits. C++ fills the options and the shown
             speed. It sits here unless the heading is hidden, and then at the
             end of the heads row; exactly one exists. -->
        <if cond="ui_is_portrait eq 1 or target_tool_multi_head eq 0">
          <lv_dropdown name="extrude_speed_dropdown"
                       width="content" height="$length_height" style_radius="#border_radius_sm" style_pad_ver="0"
                       style_pad_hor="#space_sm" style_text_font="#font_small">
            <event_cb trigger="value_changed" callback="on_filament_extrude_speed_changed"/>
          </lv_dropdown>
        </if>
      </lv_obj>
    </lv_obj>
    <!-- The heads, where there are several: choosing one aims every operation
         below at it -->
    <lv_obj name="tool_card_row"
            width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
            style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false" hidden="true">
      <bind_flag_if_eq subject="target_tool_multi_head" flag="hidden" ref_value="0"/>
      <tool_target_row name="tool_target_cells" width="0" labels="_row" flex_grow="1"/>
      <!-- Pick up / Park the tool the row aims at (hidden when neither
           applies). Park carries the Home tool switcher's Park glyph. -->
      <ui_button name="btn_target_tool_pickup"
                 width="content" height="#touch_target_min" style_min_width="#tool_action_btn_min_w"
                 style_pad_hor="#space_sm" icon="swap_horizontal" text="Pick up" style_text_font="#font_small"
                 moves_machine="true" hidden="true">
        <bind_flag_if_not_eq subject="filament_target_tool_action" flag="hidden" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_filament_target_tool_action"/>
      </ui_button>
      <ui_button name="btn_target_tool_park"
                 width="content" height="#touch_target_min" style_min_width="#tool_action_btn_min_w"
                 style_pad_hor="#space_sm" icon="eject" text="Park" style_text_font="#font_small" moves_machine="true"
                 hidden="true">
        <bind_flag_if_not_eq subject="filament_target_tool_action" flag="hidden" ref_value="2"/>
        <event_cb trigger="clicked" callback="on_filament_target_tool_action"/>
      </ui_button>
      <if cond="ui_is_portrait eq 0 and target_tool_multi_head eq 1">
        <!-- DUPLICATE_NAME_OK: the heading's <if> has the opposite condition, so one exists -->
        <lv_dropdown name="extrude_speed_dropdown"
                     width="content" height="$length_height" style_radius="#border_radius_sm" style_pad_ver="0"
                     style_pad_hor="#space_sm" style_text_font="#font_small">
          <event_cb trigger="value_changed" callback="on_filament_extrude_speed_changed"/>
        </lv_dropdown>
      </if>
    </lv_obj>
    <!-- The action rows, with the toolhead drawing in a column of its own
         beside them. Where the card has the height (landscape from 480x320 up)
         there are three: Load/Unload, Purge/Clean, then the lengths with
         Extrude/Retract. At 480x272 and in portrait Purge joins the first row
         and Clean moves up beside the speed; a 480x272 toolchanger, whose
         heading is gone, keeps Clean at the end of the first row. Each button
         has one declaration per place, under <if>s that exclude each other.
         The rows share the card's height, so a column with height to spare
         gives them bigger targets. -->
    <lv_obj name="operations_body"
            width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_pad_gap="#space_sm">
      <bind_style name="operations_body_fill" subject="ui_is_portrait" ref_value="0"/>
      <lv_obj name="operations_rows"
              width="0" height="content" style_min_height="100%" flex_grow="1" style_pad_all="0" scrollable="false"
              flex_flow="column" style_pad_gap="#space_sm">
        <lv_obj name="filament_change_row"
                width="100%" height="$row_height" style_min_height="$row_height" flex_grow="1" style_pad_all="0"
                scrollable="false" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
                style_pad_gap="#space_sm">
          <!-- Load, Unload and (where it is in this row) Purge, under the
               cold-extrusion cover. Clean stays outside it: cleaning a cold
               nozzle is valid, and the macro heats as it needs. -->
          <lv_obj name="filament_change_group"
                  width="0" height="100%" flex_grow="3" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                  scrollable="false" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center" style_pad_gap="#space_sm">
            <ui_button name="btn_load"
                       height="100%" style_min_width="content" style_pad_hor="#space_xxs" icon_position="top"
                       icon_hidden_subject="filament_ops_icons_hidden" icon_hidden_if_eq="1" flex_grow="1"
                       icon="arrow_down" text="Load" style_text_font="#font_small"
                       bind_op_state="filament_op_load_state">
              <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="filament_load_disabled" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_filament_load"/>
            </ui_button>
            <ui_button name="btn_unload"
                       height="100%" style_min_width="content" style_pad_hor="#space_xxs" icon_position="top"
                       icon_hidden_subject="filament_ops_icons_hidden" icon_hidden_if_eq="1" flex_grow="1"
                       icon="arrow_up" text="Unload" style_text_font="#font_small"
                       bind_op_state="filament_op_unload_state">
              <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="filament_unload_disabled" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_filament_unload"/>
            </ui_button>
            <lv_obj name="purge_slot_first_row"
                    width="0" height="100%" flex_grow="1" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    scrollable="false" hidden="true">
              <bind_flag_if cond="not (ui_breakpoint eq 0 or ui_is_portrait eq 1)" flag="hidden"/>
              <if cond="ui_breakpoint eq 0 or ui_is_portrait eq 1">
                <ui_button name="btn_purge"
                           width="100%" height="100%" style_min_width="content" style_pad_hor="#space_xxs"
                           icon_position="top" icon_hidden_subject="filament_ops_icons_hidden" icon_hidden_if_eq="1"
                           icon="trash_can_outline" text="Purge" style_text_font="#font_small"
                           bind_op_state="filament_op_purge_state">
                  <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
                  <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
                  <bind_state_if_eq subject="filament_unload_disabled" state="disabled" ref_value="1"/>
                  <event_cb trigger="clicked" callback="on_filament_purge"/>
                </ui_button>
              </if>
            </lv_obj>
            <!-- Floats over the buttons it disables, so no layout gives it
                 height; the text wraps rather than ending in an ellipsis. -->
            <lv_obj name="safety_warning"
                    width="100%" height="100%" style_pad_hor="#space_sm" scrollable="false" floating="true"
                    align="center" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center"
                    style_pad_gap="#space_xs" style_border_width="0">
              <style name="safety_warning_cover"/>
              <bind_flag_if_eq subject="filament_safety_warning_visible" flag="hidden" ref_value="0"/>
              <icon src="alert" size="xs" variant="warning"/>
              <text_small width="0" flex_grow="1" bind_text="filament_safety_warning_text" long_mode="wrap"/>
            </lv_obj>
          </lv_obj>
          <lv_obj name="clean_slot_first_row"
                  width="0" height="100%" flex_grow="1" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                  scrollable="false" hidden="true">
            <bind_flag_if cond="not (ui_is_portrait eq 0 and ui_breakpoint eq 0 and target_tool_multi_head eq 1)"
                          flag="hidden"/>
            <if cond="ui_is_portrait eq 0 and ui_breakpoint eq 0 and target_tool_multi_head eq 1">
              <!-- DUPLICATE_NAME_OK: its <if> excludes the other placements, so one exists -->
              <ui_button name="btn_clean_nozzle"
                         width="100%" height="100%" style_min_width="content" style_pad_hor="#space_xxs"
                         icon_position="top" icon_hidden_subject="filament_ops_icons_hidden" icon_hidden_if_eq="1"
                         icon="nozzle" text="Clean" style_text_font="#font_small" hidden="true">
                <bind_flag_if_eq subject="filament_clean_nozzle_shown" flag="hidden" ref_value="0"/>
                <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
                <event_cb trigger="clicked" callback="on_filament_clean_nozzle"/>
              </ui_button>
            </if>
          </lv_obj>
        </lv_obj>
        <lv_obj name="purge_clean_row"
                width="100%" height="$row_height" style_min_height="$row_height" flex_grow="1" style_pad_all="0"
                scrollable="false" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
                style_pad_gap="#space_sm">
          <bind_flag_if cond="ui_breakpoint eq 0 or ui_is_portrait eq 1" flag="hidden"/>
          <if cond="ui_breakpoint ge 1 and ui_is_portrait eq 0">
            <!-- DUPLICATE_NAME_OK: the first row's Purge has the opposite condition -->
            <ui_button name="btn_purge"
                       height="100%" flex_grow="1" style_min_width="content" style_pad_hor="#space_xxs"
                       icon_position="top" icon_hidden_subject="filament_ops_icons_hidden" icon_hidden_if_eq="1"
                       icon="trash_can_outline" text="Purge" style_text_font="#font_small"
                       bind_op_state="filament_op_purge_state">
              <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="filament_unload_disabled" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_filament_purge"/>
            </ui_button>
            <!-- Runs the CleanNozzle macro slot, as a Quick Actions button would. -->
            <ui_button name="btn_clean_nozzle"
                       height="100%" flex_grow="1" style_min_width="content" style_pad_hor="#space_xxs"
                       icon_position="top" icon_hidden_subject="filament_ops_icons_hidden" icon_hidden_if_eq="1"
                       icon="nozzle" text="Clean" style_text_font="#font_small" hidden="true">
              <bind_flag_if_eq subject="filament_clean_nozzle_shown" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_filament_clean_nozzle"/>
            </ui_button>
          </if>
        </lv_obj>
        <!-- Manual move: the length (tap picks one, hold edits it), then Extrude
             and Retract by that length. A landscape column 480 wide has no
             width for their labels beside the lengths, so there they show their
             arrows alone. -->
        <lv_obj name="extrude_block"
                width="100%" height="$row_height" style_min_height="$row_height" flex_grow="1" style_pad_all="0"
                scrollable="false" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm">
          <!-- Where there is room the label carries the unit and the choices are
               bare numbers; a narrow row has no room for the label, so each choice
               carries its unit. The <if> has a container of its own because a
               rebuilt body lands after its siblings. -->
          <lv_obj name="extrude_length_choices"
                  width="0" height="100%" flex_grow="3" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                  scrollable="false" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs">
            <if cond="ui_breakpoint ge 2">
              <choice_button name="extrude_length_0"
                             height="100%" flex_grow="1" bind_text="settings_extrude_length_0" bind_text-fmt="%d"
                             style_text_font="#font_small" subject="filament_extrude_length_index" value="0"
                             callback="on_filament_extrude_length_0">
                <event_cb trigger="long_pressed" callback="on_filament_extrude_length_0_hold"/>
              </choice_button>
              <choice_button name="extrude_length_1"
                             height="100%" flex_grow="1" bind_text="settings_extrude_length_1" bind_text-fmt="%d"
                             style_text_font="#font_small" subject="filament_extrude_length_index" value="1"
                             callback="on_filament_extrude_length_1">
                <event_cb trigger="long_pressed" callback="on_filament_extrude_length_1_hold"/>
              </choice_button>
              <choice_button name="extrude_length_2"
                             height="100%" flex_grow="1" bind_text="settings_extrude_length_2" bind_text-fmt="%d"
                             style_text_font="#font_small" subject="filament_extrude_length_index" value="2"
                             callback="on_filament_extrude_length_2">
                <event_cb trigger="long_pressed" callback="on_filament_extrude_length_2_hold"/>
              </choice_button>
              <text_small text="mm"/>
              <else/>
              <choice_button name="extrude_length_0"
                             height="100%" flex_grow="1" bind_text="settings_extrude_length_0" bind_text-fmt="%dmm"
                             style_text_font="#font_small" subject="filament_extrude_length_index" value="0"
                             callback="on_filament_extrude_length_0">
                <event_cb trigger="long_pressed" callback="on_filament_extrude_length_0_hold"/>
              </choice_button>
              <choice_button name="extrude_length_1"
                             height="100%" flex_grow="1" bind_text="settings_extrude_length_1" bind_text-fmt="%dmm"
                             style_text_font="#font_small" subject="filament_extrude_length_index" value="1"
                             callback="on_filament_extrude_length_1">
                <event_cb trigger="long_pressed" callback="on_filament_extrude_length_1_hold"/>
              </choice_button>
              <choice_button name="extrude_length_2"
                             height="100%" flex_grow="1" bind_text="settings_extrude_length_2" bind_text-fmt="%dmm"
                             style_text_font="#font_small" subject="filament_extrude_length_index" value="2"
                             callback="on_filament_extrude_length_2">
                <event_cb trigger="long_pressed" callback="on_filament_extrude_length_2_hold"/>
              </choice_button>
            </if>
          </lv_obj>
          <ui_button name="btn_extrude"
                     width="0" height="100%" flex_grow="1" style_min_width="content" style_pad_hor="#space_sm"
                     icon_position="top" label_hidden_cond="ui_is_portrait eq 0 and ui_breakpoint le 1"
                     icon="arrow_down" text="Extrude" style_text_font="#font_small"
                     bind_op_state="filament_op_extrude_state">
            <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
            <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_filament_extrude"/>
          </ui_button>
          <ui_button name="btn_retract"
                     width="0" height="100%" flex_grow="1" style_min_width="content" style_pad_hor="#space_sm"
                     icon_position="top" label_hidden_cond="ui_is_portrait eq 0 and ui_breakpoint le 1" icon="arrow_up"
                     text="Retract" style_text_font="#font_small" bind_op_state="filament_op_retract_state">
            <bind_state_if_eq subject="filament_safety_warning_visible" state="disabled" ref_value="1"/>
            <bind_state_if_eq subject="filament_operation_in_progress" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_filament_retract"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <!-- Chevrons stream down the column while extruding, up while retracting -->
      <filament_motion_glyph name="filament_motion_glyph"
                             width="#filament_motion_glyph_w" height="100%" bind_motion="filament_manual_motion"
                             bind_color="current_color" style_line_color="#info" style_border_color="#text_muted"
                             style_bg_color="#text_muted"/>
    </lv_obj>
  </view>
</component>
