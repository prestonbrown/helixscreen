<!-- One tickable option in a picker card: a checkbox showing checked_subject
     (an int, 1 = ticked) and its label. The whole row is the touch target;
     its tap goes to callback with user_data, which flips the subject. -->
<component>
  <api>
    <prop name="label" type="string" default=""/>
    <prop name="checked_subject" type="string" default=""/>
    <prop name="callback" type="string" default=""/>
    <prop name="user_data" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
        style_flex_track_place="center" style_pad_all="#space_sm" style_pad_gap="#space_xs" scrollable="false"
        clickable="true">
    <lv_checkbox name="option_check" text="" style_pad_all="0" clickable="false">
      <bind_state_if_eq subject="$checked_subject" state="checked" ref_value="1"/>
    </lv_checkbox>
    <text_body name="option_label"
               text="$label" flex_grow="1" style_text_font="noto_sans_14" clickable="false" event_bubble="true"/>
    <event_cb trigger="clicked" callback="$callback" user_data="$user_data"/>
  </view>
</component>
