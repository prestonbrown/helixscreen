<!-- NOTE: 0x prefix for literal hex colors (# triggers constant lookup) -->
<!-- Theme-editor preset palette (row_wrap, 6 columns x 5 rows).

     Structured for the 16 role tokens the theme editor edits, not for filament
     colors — see components/color_swatch_grid.xml for the general-purpose grid.

       rows 1-2  12-step surface ramp, dark -> light, alternating cool/warm/
                 neutral tint. Covers screen_bg / overlay_bg / card_bg /
                 elevated_bg / border / text_subtle / text_muted / text.
       rows 3-5  6 hue families x 3 tones. COLUMN IS THE HUE FAMILY
                 (red, amber, green, teal, blue, violet); row is the tone
                 (muted for dark mode, mid, deep for light mode).

     Values are drawn from the tones the 17 shipped themes actually occupy, so
     a preset click lands near a real theme value rather than a Material 500.
     tests/unit/test_theme_swatch_grid.cpp pins the ordering — the ramp must
     stay monotonic and each accent column must stay in its hue family. -->
<component>
  <api>
    <!-- Required: each host names its own click handler. Same contract as
         color_swatch_grid — no default, so a screen cannot silently bind its
         swatches to another screen's handler. -->
    <prop name="swatch_callback" type="string"/>
  </api>
  <consts>
    <!-- Fallback values. Overridden at runtime by
         register_theme_swatch_grid_constants() (xml_registration.cpp) so the
         30 swatches form 5 even rows at every breakpoint. -->
    <px name="grid_swatch_size" value="32"/>
    <px name="grid_gap" value="8"/>
    <px name="grid_width" value="232"/>
  </consts>
  <view name="theme_swatch_grid"
        extends="lv_obj" width="#grid_width" height="content" style_pad_all="0" flex_flow="row_wrap"
        style_pad_gap="#grid_gap" style_flex_main_place="center" scrollable="false">
    <!-- Row 1: surfaces, dark half — screen_bg / overlay_bg / card_bg / elevated_bg -->
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x0B0D14" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x1E1E2E" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x282828" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x2E3440" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x3D484D" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x565F89" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <!-- Row 2: surfaces, light half — border / text_subtle / text_muted / text / light-mode bg -->
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x6C6F85" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x8A8980" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xA9B1D6" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xD3C6AA" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xE5E5E5" style_bg_opa="255"
            style_border_width="1" style_border_color="#text_muted" clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xFFFFFF" style_bg_opa="255"
            style_border_width="1" style_border_color="#text_muted" clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <!-- Row 3: accents, muted — dark-mode primary/secondary/info/success/warning/danger -->
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xE06C75" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xE0AF68" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x9ECE6A" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x7FBBB3" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x7AA2F7" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xBB9AF7" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <!-- Row 4: accents, mid — readable in either mode -->
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xD9455F" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xD79921" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x689D6A" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x2AA198" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x268BD2" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x8839EF" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <!-- Row 5: accents, deep — light-mode accents, contrast against white -->
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0xA02030" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x8F6A0A" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x40A02B" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x0F7B78" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x1E4FA8" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
    <lv_obj width="#grid_swatch_size"
            height="#grid_swatch_size" style_radius="#border_radius_small" style_bg_color="0x5B3FBF" style_bg_opa="255"
            clickable="true" scrollable="false">
      <event_cb trigger="clicked" callback="$swatch_callback"/>
    </lv_obj>
  </view>
</component>
