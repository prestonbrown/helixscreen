<!-- A cold pull tip drawn from boxes, so no image asset ships: a stepped cone with the
     nozzle's imprint, and dark specks on a dirty one. -->
<component>
  <api>
    <prop name="caption" type="string" default=""/>
    <!-- "true" hides the specks -->
    <prop name="clean" type="string" default="true"/>
  </api>
  <view extends="lv_obj"
        width="45%" height="content" style_pad_all="#space_sm" style_bg_color="#section_bg_color" style_bg_opa="255"
        style_radius="#border_radius" style_border_width="0" flex_flow="column" style_flex_cross_place="center"
        style_pad_gap="0" scrollable="false">
    <lv_obj width="70%"
            height="#space_lg" style_pad_all="0" style_border_width="0" style_radius="0" style_bg_color="#primary"
            style_bg_opa="255" scrollable="false" flex_flow="row" style_flex_main_place="space_evenly"
            style_flex_cross_place="center">
      <lv_obj width="#space_xs"
              height="#space_xs" style_pad_all="0" style_border_width="0" style_bg_color="#text" style_bg_opa="255"
              style_radius="#border_radius" hidden="$clean"/>
      <lv_obj width="#space_xs"
              height="#space_xs" style_pad_all="0" style_border_width="0" style_bg_color="#text" style_bg_opa="255"
              style_radius="#border_radius" hidden="$clean"/>
    </lv_obj>
    <lv_obj width="55%"
            height="#space_lg" style_pad_all="0" style_border_width="0" style_radius="0" style_bg_color="#primary"
            style_bg_opa="255" scrollable="false" flex_flow="row" style_flex_main_place="center"
            style_flex_cross_place="center">
      <lv_obj width="#space_xs"
              height="#space_xs" style_pad_all="0" style_border_width="0" style_bg_color="#text" style_bg_opa="255"
              style_radius="#border_radius" hidden="$clean"/>
    </lv_obj>
    <lv_obj width="40%"
            height="#space_md" style_pad_all="0" style_border_width="0" style_radius="0" style_bg_color="#primary"
            style_bg_opa="255" scrollable="false"/>
    <lv_obj width="25%"
            height="#space_md" style_pad_all="0" style_border_width="0" style_radius="0" style_bg_color="#primary"
            style_bg_opa="255" scrollable="false"/>
    <lv_obj width="10%"
            height="#space_sm" style_pad_all="0" style_border_width="0" style_radius="0" style_bg_color="#primary"
            style_bg_opa="255" scrollable="false"/>
    <text_small width="100%" text="$caption" long_mode="wrap" style_text_align="center" style_pad_top="#space_xs"/>
  </view>
</component>
