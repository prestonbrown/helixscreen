<!-- The Filament panel's Tool card, on a printer with several heads: the
     target tool's nozzle reading in the header ("NOZZLE 4  142°C / 205°",
     colored by its heating state; a tap opens the temperature graph on it),
     Pick up or Park at the right, and one cell per head below
     (tool_target_row.xml), the panel's only tool chooser. Choosing a head
     aims the panel at it and never changes tools. Portrait has no room for a
     Multi-Filament card, so the lane bars move into this header there. Where
     the header is narrower than the large breakpoint's, the nozzle's name
     gives way to its number beside the glyph. -->
<component>
  <view name="filament_tool_card"
        extends="ui_card" width="100%" height="content" flex_flow="column" style_radius="#border_radius"
        style_pad_all="#space_sm" style_pad_gap="#space_xs" scrollable="false" hidden="true">
    <bind_flag_if_eq subject="target_tool_multi_head" flag="hidden" ref_value="0"/>
    <lv_obj width="100%"
            height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_sm"
            scrollable="false" clickable="false">
      <lv_obj name="tool_card_reading"
              width="content" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
              style_pad_gap="#space_sm" style_min_height="#touch_target_min" style_radius="#border_radius"
              scrollable="false" clickable="true">
        <style name="styles.press_wash" selector="pressed"/>
        <event_cb trigger="clicked" callback="on_heater_row_nozzle"/>
        <icon src="heater" size="sm" variant="primary" clickable="false" event_bubble="true"/>
        <text_small bind_text="target_nozzle_label"
                    text_transform="uppercase" style_translate_y="2" style_text_color="#text" clickable="false"
                    event_bubble="true">
          <bind_flag_if cond="ui_is_portrait eq 1 or ui_breakpoint le 3" flag="hidden"/>
        </text_small>
        <text_small bind_text="target_tool_number"
                    style_translate_y="2" style_text_color="#text_muted" clickable="false" event_bubble="true"
                    hidden="true">
          <bind_flag_if cond="ui_is_portrait eq 0 and ui_breakpoint gt 3" flag="hidden"/>
        </text_small>
        <temp_display name="tool_card_temp"
                      size="sm" show_target="true" trailing_target="true" bind_current="target_nozzle_temp"
                      bind_target="target_nozzle_target" clickable="false" event_bubble="true">
          <bind_style name="styles.heat_blocked" subject="ams_nozzle_heat_blocked" ref_value="1"/>
        </temp_display>
      </lv_obj>
      <!-- The lane bars in portrait, an empty spacer in landscape: either way
           the reading sits at the left and Pick up at the right. -->
      <lv_obj width="0" height="1" flex_grow="1" style_pad_all="0" scrollable="false">
        <bind_flag_if_eq subject="ui_is_portrait" flag="hidden" ref_value="1"/>
      </lv_obj>
      <ams_mini_status name="tool_card_lanes"
                       width="0" height="#touch_target_min" flex_grow="1" bars_align="end" hidden="true">
        <bind_flag_if_eq subject="ui_is_portrait" flag="hidden" ref_value="0"/>
      </ams_mini_status>
      <!-- Pick up / Park the target tool (hidden when neither applies) -->
      <ui_button name="btn_target_tool_action"
                 width="content" height="#touch_target_min" variant="secondary"
                 bind_text="filament_target_tool_action_text" moves_machine="true" style_pad_hor="#space_sm">
        <bind_flag_if_eq subject="filament_target_tool_action" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_filament_target_tool_action"/>
      </ui_button>
    </lv_obj>
    <tool_target_row name="tool_card_row" labels="_row"/>
  </view>
</component>
