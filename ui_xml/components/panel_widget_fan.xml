<component>
  <api>
    <!-- Per-instance subject names, supplied by the widget at creation. Two fan
         tiles size independently, so these cannot be type-global. -->
    <prop name="tile_icon_subject" type="string" default=""/>
    <prop name="tile_label_subject" type="string" default=""/>
    <prop name="tile_dir_subject" type="string" default=""/>
    <prop name="tile_target_subject" type="string" default=""/>
    <!-- The reading, the fan's name, and 1 while a fan is selected -->
    <prop name="speed_subject" type="string" default=""/>
    <prop name="name_subject" type="string" default=""/>
    <prop name="named_subject" type="string" default=""/>
  </api>
  <view name="panel_widget_fan"
        extends="lv_obj" height="100%" flex_grow="1" style_pad_ver="0" style_pad_gap="#space_xxs" scrollable="false"
        clickable="true" style_radius="#border_radius">
    <style name="styles.press_wash" selector="pressed"/>
    <bind_state_if_not_eq subject="printer_connection_state" state="disabled" ref_value="2"/>
    <event_cb trigger="clicked" callback="fan_widget_clicked_cb"/>
    <!-- The glyph over its reading and name, or beside them when the box is
         too short to stack: the same two shapes TileSizing measures. -->
    <style name="styles.tile_column"/>
    <bind_style_if_eq name="styles.tile_row" subject="$tile_dir_subject" ref_value="1"/>
    <icon name="fan_widget_icon" src="fan" size="#icon_size" variant="secondary" clickable="false" event_bubble="true">
      <bind_tile_rung ladder="icon" subject="$tile_icon_subject"/>
    </icon>
    <lv_obj name="fan_text_col"
            width="100%" height="content" style_pad_all="0" style_pad_gap="#space_xxs" scrollable="false"
            clickable="false" event_bubble="true">
      <style name="styles.tile_column"/>
      <bind_style_if_eq name="styles.tile_fill" subject="$tile_dir_subject" ref_value="1"/>
      <text_body name="fan_speed" bind_text="$speed_subject" clickable="false" event_bubble="true">
        <bind_tile_rung ladder="value" subject="$tile_icon_subject"/>
      </text_body>
      <text_tiny name="fan_name"
                 width="100%" bind_text="$name_subject" style_text_align="center" long_mode="dots" clickable="false"
                 event_bubble="true">
        <bind_tile_rung ladder="label" subject="$tile_icon_subject" one_line="true"/>
        <bind_flag_if_eq subject="$tile_label_subject" flag="hidden" ref_value="0"/>
        <bind_flag_if_eq subject="$named_subject" flag="hidden" ref_value="0"/>
      </text_tiny>
      <!-- Until a fan is picked: a literal, so it re-translates itself -->
      <text_tiny name="fan_name_prompt"
                 width="100%" text="Select fan" style_text_align="center" long_mode="dots" clickable="false"
                 event_bubble="true">
        <bind_tile_rung ladder="label" subject="$tile_icon_subject" one_line="true"/>
        <bind_flag_if_eq subject="$tile_label_subject" flag="hidden" ref_value="0"/>
        <bind_flag_if_eq subject="$named_subject" flag="hidden" ref_value="1"/>
      </text_tiny>
    </lv_obj>
  </view>
</component>
