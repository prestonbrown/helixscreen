<component>
  <!-- "from tag" pill beside a value read from the spool's RFID/NFC tag: a
       round info status_pill in the xs font. Shown while the int subject is
       non-zero; subject="" leaves visibility to a binding on the instance. -->
  <api>
    <prop name="subject" type="subject" default="ams_edit_tag_badge_visible"/>
  </api>
  <view name="tag_badge"
        extends="status_pill" text="from tag" variant="info" radius="9999" pad_ver="0" style_text_font="#font_xs"
        clickable="false" hidden="true">
    <bind_flag_if_eq subject="$subject" flag="hidden" ref_value="0"/>
  </view>
</component>
