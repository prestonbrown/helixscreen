<!-- The wizard header's step segments: one bar per step, the done and current ones
     lit (on_style: seg_on blue, seg_on_warn amber for a step that needs you), the
     rest a dim track. count_subject and current_subject (0-based) are int
     subjects; at most 10 steps. calibration_wizard_header places it. -->
<component>
  <api>
    <prop name="count_subject" type="string" default=""/>
    <prop name="current_subject" type="string" default=""/>
    <prop name="on_style" type="string" default="seg_on"/>
  </api>
  <consts>
    <px name="seg_w" value="34"/>
    <px name="seg_h" value="6"/>
    <px name="seg_gap" value="5"/>
  </consts>
  <styles>
    <style name="seg_off" bg_color="#elevated_bg"/>
    <style name="seg_on" bg_color="#primary"/>
    <style name="seg_on_warn" bg_color="#warning"/>
  </styles>
  <view extends="lv_obj"
        width="content" height="content" style_pad_all="0" style_pad_gap="#seg_gap" style_bg_opa="0"
        style_border_width="0" flex_flow="row" style_flex_cross_place="center" scrollable="false">
    <repeat count="10">
      <lv_obj width="#seg_w"
              height="#seg_h" style_radius="9999" style_bg_opa="255" style_border_width="0" scrollable="false">
        <style name="seg_off"/>
        <bind_flag_if cond="${count_subject} le ${i}" flag="hidden"/>
        <bind_style_if name="$on_style" cond="${current_subject} ge ${i}"/>
      </lv_obj>
    </repeat>
  </view>
</component>
