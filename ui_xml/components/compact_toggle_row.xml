<!-- Compact label-plus-switch row. Bare-bones sibling of setting_toggle_row —
     no icon, no description, no info button, zero padding. Matches the
     minimal row styling used by PrePrintOptionsRenderer::make_row() so a
     single-purpose toggle can sit flush against neighbouring rows instead
     of paying setting_toggle_row's 20px touch-target padding. Use
     setting_toggle_row instead when the row lives in a scrollable settings
     list where the larger touch target and optional icon/description are
     wanted. -->
<component>
  <api>
    <prop name="label" type="string" default="Setting"/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="subject" type="string" default=""/>
    <prop name="callback" type="string" default=""/>
  </api>
  <view name="compact_row"
        extends="lv_obj" width="100%" height="content" flex_flow="row" style_flex_main_place="space_between"
        style_flex_cross_place="center" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
    <text_body name="label" text="$label" translation_tag="$label_tag"/>
    <ui_switch name="toggle" size="small">
      <bind_state_if_eq subject="$subject" state="checked" ref_value="1"/>
      <event_cb trigger="value_changed" callback="$callback"/>
    </ui_switch>
  </view>
</component>
