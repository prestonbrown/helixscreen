<!-- Unified temperature card: nozzle + bed + optional chamber rows -->
<component>
  <styles>
    <!-- Icon-to-label gap: wider on tiny breakpoint (labels hidden/cramped, icons
         too close), tighter once the layout has room. Duplicated verbatim in
         controls_panel.xml rather than shared via globals.xml: globals.xml is
         registered before theme_manager_init publishes the space_* consts, so a
         style defined there resolves #space_xs to nothing. -->
    <style name="temp_row_gap_standard" pad_column="#space_xs"/>
    <style name="temp_row_gap_tiny" pad_column="#space_md"/>
  </styles>
  <view name="temp_card_unified"
        extends="ui_card" width="100%" height="content" style_radius="#border_radius" flex_flow="column"
        style_pad_top="#space_sm" style_pad_bottom="#space_sm" style_pad_left="#space_md" style_pad_right="#space_md"
        style_pad_gap="#space_md" clickable="true">
    <event_cb trigger="clicked" callback="on_temp_card_clicked"/>

    <!-- Nozzle row -->
    <lv_obj name="nozzle_row"
            width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
            clickable="false" event_bubble="true">
      <bind_style_if_eq name="temp_row_gap_tiny" subject="ui_breakpoint" ref_value="1"/>
      <bind_style_if_ge name="temp_row_gap_standard" subject="ui_breakpoint" ref_value="2"/>
      <!-- Icon is always shown; the text label joins it at MEDIUM+ breakpoints -->
      <nozzle_icon size="sm" badge_size="#badge_size_on_sm_icon" badge_font="#font_badge_compact"/>
      <!-- Text label for MEDIUM+ breakpoints -->
      <text_small text="Nozzle" translation_tag="Nozzle" clickable="false" event_bubble="true">
        <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="3"/>
      </text_small>
      <temp_display name="nozzle_temp"
                    size="md" show_target="true" bind_current="extruder_temp" bind_target="extruder_target"
                    flex_grow="1" clickable="false" event_bubble="true"/>
      <text_small name="nozzle_status"
                  bind_text="print_nozzle_status" style_text_align="right" style_min_width="50" clickable="false"
                  event_bubble="true"/>
    </lv_obj>

    <!-- Bed row -->
    <lv_obj name="bed_row"
            width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
            clickable="false" event_bubble="true">
      <bind_style_if_eq name="temp_row_gap_tiny" subject="ui_breakpoint" ref_value="1"/>
      <bind_style_if_ge name="temp_row_gap_standard" subject="ui_breakpoint" ref_value="2"/>
      <!-- Icon is always shown; the text label joins it at MEDIUM+ breakpoints -->
      <heater_icon src="radiator" glyph_name="bed_icon_glyph" size="sm"/>
      <!-- Text label for MEDIUM+ breakpoints -->
      <text_small text="Bed" translation_tag="Bed" clickable="false" event_bubble="true">
        <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="3"/>
      </text_small>
      <temp_display name="bed_temp"
                    size="md" show_target="true" bind_current="bed_temp" bind_target="bed_target" flex_grow="1"
                    clickable="false" event_bubble="true"/>
      <text_small name="bed_status"
                  bind_text="print_bed_status" style_text_align="right" style_min_width="50" clickable="false"
                  event_bubble="true"/>
    </lv_obj>

    <!-- Chamber row (hidden when no chamber sensor/heater) -->
    <lv_obj name="chamber_row"
            width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
            clickable="false" event_bubble="true" hidden="true">
      <bind_flag_if_eq subject="printer_has_chamber" flag="hidden" ref_value="0"/>
      <bind_style_if_eq name="temp_row_gap_tiny" subject="ui_breakpoint" ref_value="1"/>
      <bind_style_if_ge name="temp_row_gap_standard" subject="ui_breakpoint" ref_value="2"/>
      <!-- Icon is always shown; the text label joins it at MEDIUM+ breakpoints -->
      <heater_icon src="fridge_industrial" glyph_name="chamber_icon_glyph" size="sm"/>
      <!-- Text label for MEDIUM+ breakpoints -->
      <text_small text="Chamber" translation_tag="Chamber" clickable="false" event_bubble="true">
        <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="3"/>
      </text_small>
      <temp_display name="chamber_temp_display"
                    size="md" show_target="true" bind_current="chamber_temp" bind_target="chamber_effective_target"
                    bind_mode="chamber_mode" flex_grow="1" clickable="false" event_bubble="true"/>
      <text_small name="chamber_status"
                  bind_text="print_chamber_status" style_text_align="right" style_min_width="50" clickable="false"
                  event_bubble="true"/>
    </lv_obj>

  </view>
</component>
