<!-- One row of the pressure advance tuners' values column: the label muted at
     the left, the value bold at the right, so a stack of rows reads as two
     aligned columns. The label is static (`label`) or a string subject
     (`bind_label`); the value is always a subject (`bind_value`). The row
     highlights while the int subject `hl_subject` equals `hl_value`: the value
     a pass sweeps, or the band picked. -->
<component>
  <api>
    <prop name="label" type="string" default=""/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="bind_label" type="string" default=""/>
    <prop name="bind_value" type="string" default=""/>
    <prop name="hl_subject" type="string" default=""/>
    <prop name="hl_value" type="int" default="-1"/>
  </api>
  <styles>
    <!-- Styles, not inline attributes, so the bound highlight can outrank the plain row. -->
    <style name="row_plain" bg_opa="0"/>
    <style name="row_hl" bg_color="#primary" bg_opa="40"/>
  </styles>
  <view extends="lv_obj"
        width="100%" height="content" style_pad_hor="#space_xs" style_pad_ver="#space_xxs" style_border_width="0"
        style_radius="#border_radius_small" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
        scrollable="false" clickable="false">
    <style name="row_plain"/>
    <bind_style_if_eq name="row_hl" subject="$hl_subject" ref_value="$hl_value"/>
    <text_body name="pa_value_label"
               width="0" flex_grow="1" text="$label" translation_tag="$label_tag" bind_text="$bind_label"
               long_mode="dots" style_text_color="#text_muted"/>
    <text_body name="pa_value_value" bind_text="$bind_value" style_text_font="#font_body_bold" style_text_align="right"/>
  </view>
</component>
