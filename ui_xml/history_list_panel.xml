<component>
  <styles>
    <!-- Funnel accent: primary when a status/search/sort filter is active,
         normal text colour otherwise. Driven by the history_filter_active
         subject so the appearance lives in XML (not C++). -->
    <style name="filter_active" text_color="#primary"/>
    <style name="filter_inactive" text_color="#text"/>
  </styles>
  <!-- Overlay panel structure - leaves room for navbar -->
  <view name="history_list_panel"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" flex_flow="column"
        style_pad_all="0" style_bg_opa="255" style_bg_color="#card_bg" style_radius="0" style_border_width="0">
    <!-- Header bar with back button and title -->
    <header_bar name="overlay_header" title="Print History"/>
    <!-- Filter/Search Row -->
    <lv_obj name="filter_row"
            width="100%" height="content" flex_flow="column" style_flex_cross_place="center" scrollable="false"
            style_pad_row="#space_sm" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_sm"
            style_pad_bottom="#space_sm">
      <!-- Disable content when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- Row 1: search box + filter toggle -->
      <lv_obj name="search_row"
              width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
              style_pad_all="0" scrollable="false">
        <!-- Search box - fills remaining space -->
        <text_input name="search_box"
                    placeholder_text="Search filename..." placeholder_tag="Search filename..."
                    translation_tag="Search filename..." flex_grow="1" style_max_height="#input_height"
                    show_clear_button="true" clear_callback="history_search_clear">
          <event_cb trigger="value_changed" callback="history_search_changed"/>
        </text_input>
        <!-- Collapse/expand the filter dropdowns -->
        <ui_button name="filter_toggle"
                   width="#input_height" height="100%" variant="secondary" style_pad_all="0" clickable="true"
                   flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
          <event_cb trigger="clicked" callback="history_filters_toggle"/>
          <!-- Icon as a child (not the icon= attr) so ui_button's contrast pass
               leaves its colour alone; the accent is driven reactively by the
               history_filter_active subject via the bind_style rules below. -->
          <icon name="filter_icon" src="filter" size="sm" clickable="false" event_bubble="true">
            <bind_style name="filter_active" subject="history_filter_active" ref_value="1"/>
            <bind_style name="filter_inactive" subject="history_filter_active" ref_value="0"/>
          </icon>
        </ui_button>
      </lv_obj>
      <!-- Row 2: filter + sort dropdowns (collapsed by default; toggled by the funnel button) -->
      <lv_obj name="filter_dropdowns"
              width="100%" height="content" flex_flow="row" style_pad_gap="#space_md" style_pad_all="0"
              scrollable="false">
        <bind_flag_if_eq subject="history_filters_expanded" flag="hidden" ref_value="0"/>
        <!-- Status filter dropdown -->
        <lv_dropdown name="filter_status"
                     options="All&#10;Completed&#10;Failed&#10;Canceled"
                     options_tag="All&#10;Completed&#10;Failed&#10;Canceled" flex_grow="1">
          <event_cb trigger="value_changed" callback="history_filter_status_changed"/>
        </lv_dropdown>
        <!-- Sort dropdown -->
        <lv_dropdown name="sort_dropdown"
                     options="Date (newest)&#10;Date (oldest)&#10;Duration&#10;Filename"
                     options_tag="Date (newest)&#10;Date (oldest)&#10;Duration&#10;Filename" flex_grow="1">
          <event_cb trigger="value_changed" callback="history_sort_changed"/>
        </lv_dropdown>
      </lv_obj>
    </lv_obj>
    <!-- Content area - scrollable container with three state-based views -->
    <lv_obj name="overlay_content"
            width="100%" height="content" flex_grow="1" flex_flow="column" style_pad_top="#space_sm"
            style_pad_bottom="#space_md" style_pad_left="#space_md" style_pad_right="#space_md"
            style_pad_row="#space_sm" scrollable="true">
      <!-- Disable content when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- ================================================================== -->
      <!-- STATE: LOADING (state=0) -->
      <!-- ================================================================== -->
      <lv_obj name="loading_state"
              width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_row="#space_md" style_pad_all="#space_xl">
        <bind_flag_if_not_eq subject="history_list_panel_state" flag="hidden" ref_value="0"/>
        <!-- Loading spinner -->
        <lv_spinner name="loading_spinner" width="#spinner_lg" height="#spinner_lg"/>
        <text_muted text="Loading history..." style_text_align="center"/>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: EMPTY (state=1) -->
      <!-- ================================================================== -->
      <empty_state name="empty_state"
                   flex_grow="1" style_pad_all="#space_xl" icon="clock" icon_variant="muted" text=""
                   text_subject="history_empty_message" hint_subject="history_empty_hint"
                   shown_subject="history_list_panel_state" shown_value="1"/>
      <!-- ================================================================== -->
      <!-- STATE: HAS_JOBS (state=2) - List rows container -->
      <!-- ================================================================== -->
      <!-- clickable="false" ensures clicks pass through to row children -->
      <lv_obj name="list_rows"
              width="100%" height="content" flex_flow="column" style_pad_row="#space_sm" style_pad_all="0"
              clickable="false">
        <bind_flag_if_not_eq subject="history_list_panel_state" flag="hidden" ref_value="2"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
