<!-- Change Printer Host Modal - Allows changing Moonraker connection -->
<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <!-- Subjects managed in C++ (init_subjects registers change_host_testing, change_host_validated) -->
  <!-- Dialog card (backdrop created programmatically) -->
  <view name="change_host_modal"
        extends="ui_dialog" width="70%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <!-- Form container -->
    <lv_obj name="form_container"
            width="100%" height="content" style_min_height="200" style_pad_left="#space_lg" style_pad_right="#space_lg"
            style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center"
            style_pad_gap="#space_md">
      <!-- Title -->
      <text_heading name="title_change_host" width="100%" text="Change Printer Host" style_text_align="center">
        <bind_flag_if_eq subject="change_host_adding" flag="hidden" ref_value="1"/>
      </text_heading>
      <text_heading name="title_add_printer" width="100%" text="Add Printer" style_text_align="center">
        <bind_flag_if_eq subject="change_host_adding" flag="hidden" ref_value="0"/>
      </text_heading>
      <!-- Printers found on the network (mDNS and the LAN sweep); shown while discovery runs -->
      <lv_obj name="discovery_section"
              width="100%" height="content" style_pad_all="0" style_pad_gap="#space_xs" flex_flow="column">
        <bind_flag_if_eq subject="change_host_discovery_active" flag="hidden" ref_value="0"/>
        <text_body width="100%" text="Discovered Printers"/>
        <lv_dropdown name="printer_dropdown" width="100%">
          <event_cb trigger="value_changed" callback="on_change_host_printer_picked"/>
        </lv_dropdown>
      </lv_obj>
      <!-- Input row: Host (75%) + Port (25%) -->
      <lv_obj width="100%"
              height="content" scrollable="false" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="row">
        <!-- Left: Host -->
        <lv_obj flex_grow="3"
                style_pad_all="0" style_pad_gap="#space_xs" flex_flow="column" style_flex_main_place="start"
                style_flex_cross_place="start">
          <text_body width="100%" text="Host"/>
          <text_input name="host_input"
                      width="100%" bind_text="change_host_ip" placeholder_text="192.168.1.100"
                      placeholder_tag="192.168.1.100"/>
        </lv_obj>
        <!-- Right: Port -->
        <lv_obj flex_grow="1"
                style_pad_all="0" style_pad_gap="#space_xs" flex_flow="column" style_flex_main_place="start"
                style_flex_cross_place="start">
          <text_body width="100%" text="Port"/>
          <text_input name="port_input"
                      width="100%" bind_text="change_host_port" placeholder_text="7125" keyboard_hint="numeric"/>
        </lv_obj>
      </lv_obj>
      <!-- API key for a Moonraker that requires a login: the active printer's only, so not when adding -->
      <lv_obj name="api_key_section"
              width="100%" height="content" scrollable="false" style_pad_all="0" style_pad_gap="#space_xs"
              flex_flow="column">
        <bind_flag_if_eq subject="change_host_adding" flag="hidden" ref_value="1"/>
        <text_body width="100%" text="API Key (if Moonraker requires a login)"/>
        <lv_obj width="100%"
                height="#input_height" scrollable="false" flex_flow="row" style_pad_all="0" style_pad_gap="0">
          <text_input name="password_input"
                      height="100%" flex_grow="1" bind_text="change_host_api_key" placeholder_text="None"
                      placeholder_tag="None" password_mode="true"/>
          <ui_button name="eye_toggle"
                     width="#input_height" height="100%" variant="ghost" icon="eye_off" click_focusable="false">
            <event_cb trigger="clicked" callback="on_toggle_password_visibility"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <!-- Test Connection button + Status row -->
      <lv_obj width="100%"
              height="content" style_pad_all="0" style_pad_gap="#space_md" flex_flow="row" style_flex_main_place="start"
              style_flex_cross_place="center">
        <ui_button name="btn_test_connection" width="200" text="Test Connection">
          <bind_state_if_eq subject="change_host_testing" state="disabled" ref_value="1"/>
          <event_cb trigger="clicked" callback="on_change_host_test"/>
        </ui_button>
        <!-- Status display -->
        <lv_obj style_pad_left="#space_sm"
                flex_grow="1" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
                style_pad_column="#space_sm">
          <lv_label name="status_icon" text="" style_text_font="mdi_icons_16"/>
          <text_body name="status_text" width="0" text="" flex_grow="1" long_mode="wrap"/>
        </lv_obj>
      </lv_obj>
    </lv_obj>
    <modal_button_row secondary_name="modal_cancel_btn"
                      secondary_text="Cancel" secondary_callback="on_change_host_cancel" primary_name="modal_save_btn"
                      primary_text="Save" primary_callback="on_change_host_save"
                      primary_disable_subject="change_host_save_locked"/>
  </view>
</component>
