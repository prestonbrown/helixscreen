<component>
  <!-- First-Run Wizard: Connection Screen -->
  <!-- User enters Moonraker IP/hostname and port, tests connection -->
  <consts>
    <!-- Step metadata (read by wizard orchestrator) -->
    <str name="step_title" value="Printer Setup: Connection" value_tag="Printer Setup: Connection"/>
    <str name="step_subtitle"
         value="If Moonraker is local or your screen is attached to the printer directly, we'll connect automatically"
         value_tag="If Moonraker is local or your screen is attached to the printer directly, we'll connect automatically"/>
    <int name="step_order" value="2"/>
  </consts>
  <view name="wizard_connection_root"
        extends="lv_obj" width="100%" height="100%" scrollable="false" style_bg_opa="0" style_border_width="0"
        style_pad_all="0" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start">
    <!-- Card container for inputs and button -->
    <ui_card width="100%"
             flex_grow="1" style_pad_gap="#space_md" flex_flow="column" style_flex_main_place="start"
             style_flex_cross_place="center">
      <!-- Printers found on the network (mDNS and the LAN sweep); shown while discovery runs -->
      <lv_obj name="discovery_section" width="100%" style_pad_all="0" flex_flow="column">
        <bind_flag_if_eq subject="connection_discovery_active" flag="hidden" ref_value="0"/>
        <lv_obj width="100%" flex_flow="row" style_flex_cross_place="center" style_pad_all="0">
          <text_body text="Discovered Printers" style_flex_grow="1"/>
          <text_small name="discovery_status" bind_text="mdns_status"/>
        </lv_obj>
        <lv_dropdown name="printer_dropdown" width="100%">
          <event_cb trigger="value_changed" callback="on_printer_selected"/>
        </lv_dropdown>
      </lv_obj>

      <!-- Separator, shown with the discovery section -->
      <text_muted text="Or Enter Manually" style_pad_all="0" style_pad_gap="0">
        <bind_flag_if_eq subject="connection_discovery_active" flag="hidden" ref_value="0"/>
      </text_muted>

      <!-- Horizontal input row: Network Address (left) and Port (right) -->
      <lv_obj width="100%"
              height="content" scrollable="false" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="row">
        <!-- Left -->
        <lv_obj flex_grow="3"
                style_pad_all="0" style_pad_gap="#space_xs" flex_flow="column" style_flex_main_place="start"
                style_flex_cross_place="start">
          <text_body width="100%" text="Network Address"/>
          <text_input name="ip_input"
                      width="100%" bind_text="connection_ip" placeholder_text="127.0.0.1" placeholder_tag="127.0.0.1"/>
        </lv_obj>
        <!-- Right -->
        <lv_obj flex_grow="1"
                style_pad_all="0" style_pad_gap="#space_xs" flex_flow="column" style_flex_main_place="start"
                style_flex_cross_place="start">
          <text_body width="100%" text="Port"/>
          <text_input name="port_input"
                      width="100%" bind_text="connection_port" placeholder_text="7125" keyboard_hint="numeric"/>
        </lv_obj>
      </lv_obj>
      <!-- network address and port -->
      <!-- API key: shown once the printer's Moonraker asks for a login, or when one is saved -->
      <lv_obj name="api_key_section"
              width="100%" height="content" scrollable="false" style_pad_all="0" style_pad_gap="#space_xs"
              flex_flow="column">
        <bind_flag_if_eq subject="connection_login_required" flag="hidden" ref_value="0"/>
        <text_body width="100%" text="API Key"/>
        <lv_obj width="100%"
                height="#input_height" scrollable="false" flex_flow="row" style_pad_all="0" style_pad_gap="0">
          <text_input name="password_input"
                      height="100%" flex_grow="1" bind_text="connection_api_key"
                      placeholder_text="32 characters, 0-9 and a-f" placeholder_tag="32 characters, 0-9 and a-f"
                      password_mode="true">
            <event_cb trigger="value_changed" callback="on_wizard_api_key_changed"/>
          </text_input>
          <ui_button name="eye_toggle"
                     width="#input_height" height="100%" variant="ghost" icon="eye_off" click_focusable="false">
            <event_cb trigger="clicked" callback="on_toggle_password_visibility"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <!-- Test connection button and status row -->
      <lv_obj width="100%"
              height="content" scrollable="false" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="column"
              style_flex_main_place="start" style_flex_cross_place="start">
        <!-- Button + Status row -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" style_pad_gap="#space_md" flex_flow="row"
                style_flex_main_place="start" style_flex_cross_place="center">
          <!-- Test Connection Button -->
          <ui_button name="btn_test_connection" width="200" text="Test Connection">
            <!-- Disable button while connection test is in progress -->
            <bind_state_if_eq subject="connection_testing" state="disabled" ref_value="1"/>
            <!-- Remove clickable flag when connection test is in progress -->
            <bind_flag_if_eq subject="connection_testing" flag="clickable" ref_value="0"/>
          </ui_button>
          <!-- Connection Status (icon + text) -->
          <lv_obj style_pad_left="#space_sm"
                  flex_grow="1" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
                  style_pad_column="#space_sm">
            <!-- Status Spinner (visible ONLY when discovering) -->
            <spinner name="connection_spinner" size="sm">
              <bind_flag_if_eq subject="connection_discovering" flag="hidden" ref_value="0"/>
            </spinner>
            <!-- Status Icon - MDI (hidden when discovering) -->
            <lv_label name="connection_status_icon" bind_text="connection_status_icon" style_text_font="mdi_icons_16">
              <bind_flag_if_eq subject="connection_discovering" flag="hidden" ref_value="1"/>
            </lv_label>
            <!-- Status Text (wrapping enabled to prevent overflow) -->
            <text_body name="connection_status_text"
                       width="0" bind_text="connection_status_text" flex_grow="1" long_mode="wrap"/>
          </lv_obj>
        </lv_obj>
      </lv_obj>
    </ui_card>
  </view>
</component>
