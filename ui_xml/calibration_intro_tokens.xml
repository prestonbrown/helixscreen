<!--
  Calibration intro tokens: the type sizes and proportions of the intro page
  every calibration step opens on (components/calibration_intro.xml). The
  medium tier is the 800x480 design: a 12px section label, 16px rows, 14px
  description, 12px captions and badges, a 300px left column, 52px choice
  chips and a 48px footer. The page is denser than the theme's body text on
  purpose: it carries two columns of facts above a footer at 480 tall.

  Own file because the five intro screens (heaters, bed mesh, input shaper,
  pressure advance, belt tension) and the shared frame all read them.
-->
<component>
  <consts>
    <!-- Section label above each column ("NOW", "CALIBRATE AT"). -->
    <string name="cal_intro_font_label_micro" value="noto_sans_light_10"/>
    <string name="cal_intro_font_label_tiny" value="noto_sans_light_10"/>
    <string name="cal_intro_font_label_small" value="noto_sans_light_11"/>
    <string name="cal_intro_font_label_medium" value="noto_sans_12"/>
    <string name="cal_intro_font_label_large" value="noto_sans_14"/>

    <!-- Rows of current values and chip names. -->
    <string name="cal_intro_font_row_micro" value="noto_sans_12"/>
    <string name="cal_intro_font_row_tiny" value="noto_sans_12"/>
    <string name="cal_intro_font_row_small" value="noto_sans_14"/>
    <string name="cal_intro_font_row_medium" value="noto_sans_16"/>
    <string name="cal_intro_font_row_large" value="noto_sans_18"/>

    <!-- Bold row text: selected chips, the left card's title. -->
    <string name="cal_intro_font_row_bold_micro" value="noto_sans_12"/>
    <string name="cal_intro_font_row_bold_tiny" value="noto_sans_bold_14"/>
    <string name="cal_intro_font_row_bold_small" value="noto_sans_bold_14"/>
    <string name="cal_intro_font_row_bold_medium" value="noto_sans_bold_16"/>
    <string name="cal_intro_font_row_bold_large" value="noto_sans_bold_18"/>

    <!-- Measured values (shaper frequencies, K). -->
    <string name="cal_intro_font_mono_micro" value="source_code_pro_12"/>
    <string name="cal_intro_font_mono_tiny" value="source_code_pro_12"/>
    <string name="cal_intro_font_mono_small" value="source_code_pro_14"/>
    <string name="cal_intro_font_mono_medium" value="source_code_pro_16"/>
    <string name="cal_intro_font_mono_large" value="source_code_pro_18"/>

    <!-- What the step does, under the settings. -->
    <string name="cal_intro_font_desc_micro" value="noto_sans_light_11"/>
    <string name="cal_intro_font_desc_tiny" value="noto_sans_12"/>
    <string name="cal_intro_font_desc_small" value="noto_sans_12"/>
    <string name="cal_intro_font_desc_medium" value="noto_sans_14"/>
    <string name="cal_intro_font_desc_large" value="noto_sans_16"/>

    <!-- Captions under a card and badge text. -->
    <string name="cal_intro_font_caption_micro" value="noto_sans_light_10"/>
    <string name="cal_intro_font_caption_tiny" value="noto_sans_light_10"/>
    <string name="cal_intro_font_caption_small" value="noto_sans_light_11"/>
    <string name="cal_intro_font_caption_medium" value="noto_sans_12"/>
    <string name="cal_intro_font_caption_large" value="noto_sans_14"/>

    <!-- Footer buttons: secondary at the left, primary at the right. -->
    <string name="cal_intro_font_secondary_micro" value="noto_sans_12"/>
    <string name="cal_intro_font_secondary_tiny" value="noto_sans_12"/>
    <string name="cal_intro_font_secondary_small" value="noto_sans_14"/>
    <string name="cal_intro_font_secondary_medium" value="noto_sans_14"/>
    <string name="cal_intro_font_secondary_large" value="noto_sans_16"/>
    <string name="cal_intro_font_primary_micro" value="noto_sans_bold_14"/>
    <string name="cal_intro_font_primary_tiny" value="noto_sans_bold_14"/>
    <string name="cal_intro_font_primary_small" value="noto_sans_bold_14"/>
    <string name="cal_intro_font_primary_medium" value="noto_sans_bold_16"/>
    <string name="cal_intro_font_primary_large" value="noto_sans_bold_18"/>

    <!-- Left column width beside the settings; portrait takes the full width. -->
    <px name="cal_intro_left_w_micro" value="190"/>
    <px name="cal_intro_left_w_tiny" value="200"/>
    <px name="cal_intro_left_w_small" value="240"/>
    <px name="cal_intro_left_w_medium" value="300"/>
    <px name="cal_intro_left_w_large" value="360"/>

    <!-- Choice chip height (materials, axes). Micro keeps 36 drawn and widens
         the hit area to the 44px minimum with ext_click_area. -->
    <px name="cal_intro_chip_h_micro" value="36"/>
    <px name="cal_intro_chip_h_tiny" value="40"/>
    <px name="cal_intro_chip_h_small" value="44"/>
    <px name="cal_intro_chip_h_medium" value="52"/>
    <px name="cal_intro_chip_h_large" value="60"/>

    <!-- The picture under the left column's label (a mesh, the belt paths). -->
    <px name="cal_intro_picture_h_micro" value="110"/>
    <px name="cal_intro_picture_h_tiny" value="130"/>
    <px name="cal_intro_picture_h_small" value="170"/>
    <px name="cal_intro_picture_h_medium" value="250"/>
    <px name="cal_intro_picture_h_large" value="300"/>

    <!-- A filament's color on the intro's filament card. -->
    <px name="cal_intro_swatch_micro" value="22"/>
    <px name="cal_intro_swatch_tiny" value="24"/>
    <px name="cal_intro_swatch_small" value="28"/>
    <px name="cal_intro_swatch_medium" value="34"/>
    <px name="cal_intro_swatch_large" value="40"/>

    <!-- Footer buttons. -->
    <px name="cal_intro_btn_h_micro" value="36"/>
    <px name="cal_intro_btn_h_tiny" value="40"/>
    <px name="cal_intro_btn_h_small" value="44"/>
    <px name="cal_intro_btn_h_medium" value="48"/>
    <px name="cal_intro_btn_h_large" value="56"/>
    <px name="cal_intro_primary_w_micro" value="150"/>
    <px name="cal_intro_primary_w_tiny" value="160"/>
    <px name="cal_intro_primary_w_small" value="180"/>
    <px name="cal_intro_primary_w_medium" value="210"/>
    <px name="cal_intro_primary_w_large" value="240"/>
  </consts>
</component>
