<component>
  <consts>
    <!-- Portrait Operations rows: a 320x480 column has no height to spare,
         so the action rows and the length row come down from a touch target. -->
    <px name="filament_portrait_row_h_tiny" value="42"/>
    <px name="filament_portrait_row_h_small" value="48"/>
    <px name="filament_portrait_row_h_medium" value="48"/>
    <px name="filament_portrait_row_h_large" value="48"/>
    <px name="filament_portrait_length_h_tiny" value="40"/>
    <px name="filament_portrait_length_h_small" value="48"/>
    <px name="filament_portrait_length_h_medium" value="48"/>
    <px name="filament_portrait_length_h_large" value="48"/>
    <!-- Landscape Operations rows: button height, except a 480x320 column,
         where the rows give up a few pixels so a printer with several heads
         keeps every row on screen. -->
    <px name="filament_landscape_row_h_micro" value="26"/>
    <px name="filament_landscape_row_h_tiny" value="42"/>
    <px name="filament_landscape_row_h_small" value="48"/>
    <px name="filament_landscape_row_h_medium" value="52"/>
    <px name="filament_landscape_row_h_large" value="72"/>
    <px name="filament_landscape_row_h_xlarge" value="80"/>
    <px name="filament_landscape_row_h_xxlarge" value="96"/>
    <!-- The lane bars' width in the portrait Operations header, beside its chevron and Pick up. -->
    <px name="filament_header_lanes_w_small" value="80"/>
    <px name="filament_header_lanes_w_medium" value="96"/>
    <px name="filament_header_lanes_w_large" value="120"/>
    <!-- AMS mini-status row height. Tuned so slot indicators have room
         even at MICRO (button_height_lg_micro=34 was visibly pinched). -->
    <px name="filament_ams_row_h_micro" value="48"/>
    <px name="filament_ams_row_h_tiny" value="54"/>
    <px name="filament_ams_row_h_small" value="64"/>
    <px name="filament_ams_row_h_medium" value="72"/>
    <px name="filament_ams_row_h_large" value="88"/>
    <!-- Graph height and flex_grow on temp_graph_card / spool_card are owned
         by FilamentPanel::apply_left_column_sizing() in C++ — the default
         per-breakpoint heights (70/80/140/180/220) live there so the sizing
         can swap between "graph fixed / spool grows" (AMS mode) and "graph
         grows / spool content" (external spool at MICRO/TINY). The responsive
         ladders above resolve for the components in ui_xml/components/ from
         here (top-level declaration only — see bed_mesh_profiles_card.xml). -->
  </consts>
  <styles>
    <!-- The portrait spacer swaps what the graph card draws, not its layout
         slot. bg_opa lives in a bind_style pair (not an inline attr) because
         an inline style_bg_opa would outrank any bound style. -->
    <style name="temp_graph_card_shown" bg_opa="255"/>
    <style name="temp_graph_card_spacer" bg_opa="0"/>
    <!-- On a home full page (filament_on_page, NavigationManager::lend_panel())
         the home grid already keeps the page margin, and every pixel of height
         goes to the controls above the swipe strip. The padding is a style, not
         an inline attr, so the bound page style can outrank it. -->
    <style name="filament_panel_pad" pad_all="#space_md"/>
    <style name="filament_panel_on_page" pad_all="0"/>
  </styles>
  <!-- Filament Management Panel -->
  <!-- Cards in the Controls panel's style. Landscape: two columns, left (the
       Temperature card, the graph, the Multi-Filament card) and right
       (Material, then Operations, which holds the tool chooser where several
       heads dock). Portrait: one column - Temperature, Material, graph,
       Operations, and the multi-filament strip. The shared subtrees live in
       ui_xml/components/filament_*.xml and heater_rows.xml and are
       instantiated by both branches so their markup exists exactly once.
       ui_is_portrait is reactive, so a rotation rebuilds this <if> in place -
       FilamentPanel::bind_widgets() re-finds the widgets afterwards (see that
       function for the ordering constraint). -->
  <view name="filament_panel"
        extends="lv_obj" width="100%" height="100%" style_border_width="0" scrollable="false" flex_flow="row"
        style_flex_cross_place="start" style_pad_gap="#space_md" style_bg_color="#screen_bg">
    <style name="filament_panel_pad"/>
    <bind_style name="filament_panel_on_page" subject="filament_on_page" ref_value="1"/>
    <!-- Disable all controls when printer not connected or klippy not ready -->
    <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>

    <if cond="ui_is_portrait eq 1">
      <!-- ================================================================== -->
      <!-- PORTRAIT: single column                                           -->
      <!-- ================================================================== -->
      <!-- A 320x480 screen has no height to spare: the cards sit #space_xs apart. -->
      <lv_obj name="portrait_column"
              width="100%" height="100%" style_pad_all="0" scrollable="false" flex_flow="column"
              style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_xs">
        <filament_temp_card/>
        <filament_material_group/>

        <!-- Temperature graph: this column's flexible remainder. Height and
             flex_grow come from apply_left_column_sizing(); whether it shows at
             all is the filament_graph_spacer subject, which
             FilamentPanel::fit_portrait_graph() sets when the remainder is too
             short to read. -->
        <lv_obj name="temp_graph_card"
                width="100%" height="0" style_pad_all="0" scrollable="false" style_bg_color="#card_bg"
                style_radius="#border_radius">
          <bind_style name="temp_graph_card_shown" subject="filament_graph_spacer" ref_value="0"/>
          <bind_style name="temp_graph_card_spacer" subject="filament_graph_spacer" ref_value="1"/>
          <bind_flag_if_eq subject="filament_graph_spacer" flag="clickable" ref_value="0"/>
          <event_cb trigger="clicked" callback="filament_temp_graph_cb"/>
          <!-- Graph container - populated by C++ via TempControlPanel -->
          <lv_obj name="temp_graph_container"
                  width="100%" height="100%" style_pad_all="0" clickable="false" event_bubble="true">
            <bind_flag_if_eq subject="filament_graph_spacer" flag="hidden" ref_value="1"/>
          </lv_obj>
        </lv_obj>

        <!-- Operations at their compact height: the graph above takes the column's slack. -->
        <filament_operations_group name="filament_operations_group"
                                   row_height="#filament_portrait_row_h" length_height="#filament_portrait_length_h"/>

        <!-- Multi-filament strip (C++ hides its header row in portrait so it
             reads as a strip, not a card). With several heads the lane bars
             sit in the Operations header instead. -->
        <filament_spool_card>
          <bind_flag_if_eq subject="target_tool_multi_head" flag="hidden" ref_value="1"/>
        </filament_spool_card>
      </lv_obj>
      <else/>
      <!-- ================================================================== -->
      <!-- LANDSCAPE: two columns                                            -->
      <!-- ================================================================== -->
      <lv_obj name="content_row"
              width="100%" height="100%" style_pad_all="0" scrollable="false" flex_flow="row"
              style_flex_cross_place="start" style_pad_gap="#space_md">
        <lv_obj name="left_column"
                width="40%" height="100%" style_pad_all="0" scrollable="false" flex_flow="column"
                style_flex_main_place="start" style_pad_gap="#space_md">
          <filament_temp_card/>

          <!-- Temperature Graph (combined nozzle + bed). Height and flex_grow
               are set from C++ (apply_left_column_sizing). The spacer subject
               stays 0 in landscape; the bindings are the same pair the
               portrait branch carries. -->
          <lv_obj name="temp_graph_card"
                  width="100%" height="0" style_pad_all="0" scrollable="false" style_bg_color="#card_bg"
                  style_radius="#border_radius">
            <bind_style name="temp_graph_card_shown" subject="filament_graph_spacer" ref_value="0"/>
            <bind_style name="temp_graph_card_spacer" subject="filament_graph_spacer" ref_value="1"/>
            <bind_flag_if_eq subject="filament_graph_spacer" flag="clickable" ref_value="0"/>
            <event_cb trigger="clicked" callback="filament_temp_graph_cb"/>
            <!-- Graph container - populated by C++ via TempControlPanel -->
            <lv_obj name="temp_graph_container"
                    width="100%" height="100%" style_pad_all="0" clickable="false" event_bubble="true">
              <bind_flag_if_eq subject="filament_graph_spacer" flag="hidden" ref_value="1"/>
            </lv_obj>
          </lv_obj>

          <filament_spool_card/>
        </lv_obj>
        <lv_obj name="right_column"
                width="0" height="100%" flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="column"
                style_pad_gap="0">
          <filament_material_group/>
          <!-- The column's slack goes between the cards, so Operations sits
               level with the left column's bottom. The spacer is the gap: with
               no slack it stays #space_md and the column overflows downward. -->
          <lv_obj name="right_column_spacer"
                  width="100%" height="0" flex_grow="1" style_min_height="#space_sm" style_pad_all="0" style_bg_opa="0"
                  style_border_width="0" scrollable="false" clickable="false"/>
          <!-- The length row shares portrait's compact height; it only steps down at tiny. -->
          <filament_operations_group name="filament_operations_group"
                                     row_height="#filament_landscape_row_h" length_height="#filament_portrait_length_h"/>
        </lv_obj>
      </lv_obj>
    </if>
  </view>
</component>
