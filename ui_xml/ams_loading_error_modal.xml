<!-- Modal for displaying AMS loading errors with retry option -->
<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <api>
    <!-- AmsLoadingErrorModal's per-instance subjects: the error message and its hint. -->
    <prop name="message_subject" type="string" default=""/>
    <prop name="hint_subject" type="string" default=""/>
  </api>
  <!-- Dialog card. The close X is wired in C++ via wire_cancel_button("btn_close"). -->
  <view name="ams_loading_error_modal"
        extends="dialog_frame" title="Loading Error" icon="alert_circle" icon_variant="danger" hide_close="false"
        style_min_width="300" style_max_width="400">
    <!-- Error text. The body is capped at the pinned ladder and scrolls, so a long backend
         fault string scrolls inside the card instead of growing it off both screen edges,
         and the diagram in the footer stays in view. -->
    <dialog_frame-body style_max_height="#dialog_content_pinned_max" style_pad_bottom="#space_md">
      <!-- Error message text -->
      <text_body name="error_message" width="100%" bind_text="$message_subject" long_mode="wrap"/>
      <!-- Hint text -->
      <text_small name="error_hint"
                  width="100%" bind_text="$hint_subject" style_text_color="#text_muted" long_mode="wrap"/>
    </dialog_frame-body>
    <dialog_frame-footer>
      <!-- AFC filament position diagram — self-hides unless AmsPanel recognised the fault
           message (prestonbrown/helixscreen#1184). Pinned under the scrolling text so the
           graphic never scrolls out of view, matching action_prompt_modal. The wrapper
           repeats the subject binding so its padding collapses too when there is no
           diagram, rather than leaving a dead gap above the buttons. -->
      <lv_obj width="100%"
              height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="0"
              style_pad_bottom="#space_lg" style_bg_opa="0" style_border_width="0" scrollable="false">
        <bind_flag_if_eq subject="fault_path_segment" flag="hidden" ref_value="0"/>
        <fault_path name="fault_path"/>
      </lv_obj>
      <!-- Action buttons (wired in C++ via wire_ok/cancel_button) -->
      <modal_button_row secondary_text="Close"
                        secondary_callback="on_modal_cancel_clicked" primary_text="Retry"
                        primary_callback="on_modal_ok_clicked"/>
    </dialog_frame-footer>
  </view>
</component>
