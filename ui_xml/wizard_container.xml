<!-- The first-run setup wizard: the guided-flow frame the calibration wizard uses
     (wizard_frame_header over the step's screen over wizard_frame_footer).

     Header: the step's title over its subtitle, "Step X of Y" at the right; "of Y"
     stays off while the total is still an estimate (ui_wizard.cpp composes
     wizard_step_text).
     Footer: Back (or Cancel on an add-printer run's first step) on the left; on the
     right Next (Finish on the last step), or Skip (Skip for now on the last step)
     while the step sets wizard_show_skip because it offers its own action. Next and
     Finish wait for connection_test_passed, the step's own verdict; none of them
     needs Moonraker, which the wizard is still setting up. -->
<component>
  <api>
    <!-- Where the current step's screen goes; Wizard fills it from C++. -->
    <slot name="wizard_content"/>
  </api>
  <!-- Background color applied via screen_bg runtime constant (theme-aware: light/dark variants) -->
  <view name="wizard_container"
        extends="lv_obj" width="100%" height="100%" style_bg_color="#screen_bg" style_bg_opa="255" flex_flow="column"
        style_pad_all="0" style_pad_gap="0" style_border_width="0">
    <wizard_frame_header name="wizard_header"
                         title_subject="wizard_title" subtitle_subject="wizard_subtitle" eta_subject="wizard_step_text">
      <style name="styles.cap_chrome"/>
    </wizard_frame_header>

    <lv_obj name="wizard_content"
            width="100%" flex_grow="1" scrollable="true" style_pad_all="0" style_pad_hor="#cal_page_pad_x"
            style_pad_top="#space_sm"/>

    <wizard_frame_footer name="wizard_footer"
                         back_name="btn_back" back_subject="wizard_back_text" back_tag=""
                         back_hide_cond="wizard_back_visible eq 0" back_callback="on_back_clicked" skip_name="btn_skip"
                         skip_subject="wizard_skip_text" skip_tag="" skip_hide_cond="wizard_show_skip eq 0"
                         skip_callback="on_next_clicked" primary_name="btn_next" primary_subject="wizard_next_text"
                         primary_hide_subject="wizard_show_skip" primary_disabled_cond="connection_test_passed ne 1"
                         primary_needs_printer="0" primary_callback="on_next_clicked">
      <style name="styles.cap_chrome"/>
    </wizard_frame_footer>
  </view>
</component>
