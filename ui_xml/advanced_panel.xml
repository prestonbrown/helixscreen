<!-- Advanced Panel - Hub for advanced printer tools and emergency controls -->
<!-- Sections ordered by usage frequency: Tools, Automation, Calibration, Power -->
<!-- Emergency buttons pinned in non-scrolling bottom bar -->
<!-- Features are conditionally shown based on printer capabilities -->
<component>
  <!-- Emergency bar orientation. Landscape seats the four buttons two to a row:
       min_width forces the wrap, because four in one row clip their labels even
       at 800x480. Portrait is too narrow for two across, so they stack
       full-width. These are the controls someone reaches for when things are
       going wrong, and their labels have to stay readable.

       Only container flex direction and child sizing differ, so this is a
       bind_style_if toggle on ui_is_portrait rather than an if/else structural
       branch. An if/else would have to duplicate all four buttons and their
       event_cb wiring inside one file, where no gate can see the copies drift
       apart (see the same reasoning in motion_panel.xml).

       Both orientations need an explicit style: an inline flex_flow or
       flex_grow attribute outranks a bound style, so leaving the landscape
       values inline would silently win over the portrait binding.

       layout="flex" is not redundant with flex_flow. The inline flex_flow=
       attribute routes through lv_obj_set_flex_flow(), which sets the layout
       AND the flow; a style sets only the property named. Without layout the
       container runs no layout at all and all four buttons land on top of
       each other at the same y. -->
  <styles>
    <style name="estop_bar_row" layout="flex" flex_flow="row_wrap"/>
    <style name="estop_bar_column" layout="flex" flex_flow="column"/>
    <style name="estop_btn_inline" min_width="45%" flex_grow="1" pad_hor="#space_sm"/>
    <style name="estop_btn_stacked" width="100%" flex_grow="0"/>
  </styles>
  <view name="advanced_panel"
        extends="lv_obj" width="100%" height="100%" style_pad_all="0" style_pad_gap="0" flex_flow="column"
        scrollable="false" style_bg_color="#screen_bg">
    <!-- ================================================================== -->
    <!-- SCROLLABLE CONTENT AREA -->
    <!-- ================================================================== -->
    <lv_obj width="100%"
            flex_grow="1" style_pad_all="0" style_pad_gap="0" flex_flow="column" scrollable="true"
            style_bg_color="#screen_bg">
      <!-- Disable settings rows when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- ================================================================== -->
      <!-- TOOLS SECTION -->
      <!-- ================================================================== -->
      <setting_group name="group_tools">
        <setting_group_header title="TOOLS" icon="toolbox_outline" hide_icon="false"/>
        <!-- Macro Browser -->
        <setting_action_row name="row_macros"
                            label="Macro Browser" icon="script_text" description="Execute printer macros">
          <event_cb trigger="clicked" callback="on_advanced_macros"/>
        </setting_action_row>
        <!-- Console / G-code Terminal -->
        <setting_action_row name="row_console"
                            label="G-code Console" icon="console" description="Send commands directly to printer">
          <bind_flag_if_eq subject="platform_console_supported" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_console_row_clicked"/>
        </setting_action_row>
        <!-- Guided cold pull (#2011) -->
        <setting_action_row name="row_cold_pull"
                            label="Cold Pull" icon="nozzle" description="Clean a clogged nozzle, step by step">
          <event_cb trigger="clicked" callback="on_cold_pull_row_clicked"/>
        </setting_action_row>
        <!-- Print History -->
        <setting_action_row name="row_print_history"
                            label="Print History" icon="clock" description="View print statistics and job history">
          <event_cb trigger="clicked" callback="on_history_row_clicked"/>
        </setting_action_row>
        <!-- Notification History: the way in when no bell widget is on the home screen -->
        <lv_obj name="container_notification_history" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="advanced_show_notification_history" flag="hidden" ref_value="0"/>
          <setting_action_row name="row_notification_history"
                              label="Notification History" icon="notifications" description="Alerts and printer events">
            <event_cb trigger="clicked" callback="status_notification_history_clicked"/>
          </setting_action_row>
        </lv_obj>
        <!-- Spoolman (hidden if not connected) -->
        <lv_obj name="container_spoolman" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="printer_has_spoolman" flag="hidden" ref_value="0"/>
          <setting_action_row name="row_spoolman"
                              label="Spoolman" icon="spoolman" description="Filament tracking and inventory">
            <event_cb trigger="clicked" callback="on_advanced_spoolman"/>
          </setting_action_row>
        </lv_obj>
        <!-- Dry filament on the heated bed (hidden on open printers) -->
        <lv_obj name="container_bed_drying" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="printer_can_bed_dry" flag="hidden" ref_value="0"/>
          <setting_action_row name="row_bed_drying"
                              label="Dry Filament" icon="heat_wave" description="Dry spools on the heated bed">
            <event_cb trigger="clicked" callback="on_bed_drying_start_clicked"/>
          </setting_action_row>
        </lv_obj>
        <!-- Fallback message when Spoolman not available -->
        <lv_obj name="container_no_spoolman" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="printer_has_spoolman" flag="hidden" ref_value="1"/>
          <setting_info_row name="row_no_spoolman" label="Spoolman" icon="spoolman" value="Not configured"/>
        </lv_obj>
      </setting_group>
      <!-- ================================================================== -->
      <!-- AUTOMATION SECTION -->
      <!-- ================================================================== -->
      <setting_group name="group_automation">
        <setting_group_header title="AUTOMATION" icon="code_tags" hide_icon="false"/>
        <!-- Timelapse Videos -->
        <setting_action_row name="row_timelapse_videos"
                            label="Timelapse Videos" icon="video" description="Browse and play recorded timelapses">
          <bind_flag_if_eq subject="printer_has_timelapse" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_timelapse_videos_clicked"/>
        </setting_action_row>
        <!-- Timelapse Setup (shown when plugin not installed but webcam available).
           Two visibility conditions are nested — outer hides when the plugin is
           already installed or the firmware owns timelapse, inner hides when no webcam — instead of stacking
           two bind_flags on a single element, where last-observer-wins
           semantics produce an OR-show race. -->
        <lv_obj width="100%" height="content" style_pad_all="0" style_pad_gap="0">
          <bind_flag_if_not_eq subject="timelapse_owner" flag="hidden" ref_value="0"/>
          <setting_action_row name="row_timelapse_setup"
                              label="Setup Timelapse" icon="camera_timer" description="Install timelapse plugin">
            <bind_flag_if_eq subject="printer_has_webcam" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_timelapse_setup_clicked"/>
          </setting_action_row>
        </lv_obj>
        <!-- HelixPrint Plugin (NOT installed - show Install row).
             Shows ONLY when value == 0 (known absent); -1 means the probe has
             not answered yet and must not advertise an install. -->
        <lv_obj name="container_helix_plugin_install"
                width="100%" height="content" style_pad_top="0" style_pad_left="0" style_pad_bottom="0"
                scrollable="false">
          <bind_flag_if_not_eq subject="helix_plugin_installed" flag="hidden" ref_value="0"/>
          <setting_action_row name="row_helix_plugin_install"
                              label="Install HelixPrint Plugin" icon="puzzle_outline"
                              description="Control optional print start features">
            <event_cb trigger="clicked" callback="on_helix_plugin_install_clicked"/>
          </setting_action_row>
        </lv_obj>

        <!-- HelixPrint Plugin overview: what the installed plugin runs -->
        <setting_action_row name="row_helix_plugin_overview"
                            label="HelixPrint Plugin" icon="puzzle_outline"
                            description="Version and what the plugin runs">
          <bind_flag_if_not_eq subject="helix_plugin_installed" flag="hidden" ref_value="1"/>
          <event_cb trigger="clicked" callback="on_helix_plugin_overview_clicked"/>
        </setting_action_row>
        <!-- HelixPrint Plugin (INSTALLED - show Uninstall row) -->
        <!-- Shows ONLY when value == 1 (installed and enabled), hidden otherwise (-1 or 0) -->
        <lv_obj name="container_helix_plugin_uninstall"
                width="100%" height="content" style_pad_top="0" style_pad_left="0" style_pad_bottom="0"
                scrollable="false">
          <setting_action_row name="row_helix_plugin_uninstall"
                              label="Uninstall HelixPrint Plugin" icon="puzzle_outline"
                              description="Remove plugin from printer">
            <bind_flag_if_not_eq subject="helix_plugin_installed" flag="hidden" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_helix_plugin_uninstall_clicked"/>
          </setting_action_row>
        </lv_obj>
        <!-- HelixPrint Plugin Help Text -->
        <lv_obj width="100%"
                height="content" style_pad_top="0" style_pad_left="0" style_pad_bottom="0" scrollable="false">
          <lv_obj width="100%"
                  height="content" style_pad_left="#space_xl" style_pad_right="#space_lg" style_pad_top="0"
                  style_pad_bottom="#space_md" scrollable="false" flex_flow="row" style_flex_cross_place="start"
                  style_pad_gap="#space_sm">
            <icon src="info" size="xs" variant="secondary"/>
            <text_small flex_grow="1"
                        text="This plugin lets HelixScreen control print start options like bed mesh and QGL."
                        long_mode="wrap" style_text_color="#text_muted"/>
          </lv_obj>
        </lv_obj>
        <!-- Helix Helper Macros (helix_macros.cfg): back the Clean Nozzle and
             Bed Mesh slots on printers with no macros of their own. One row
             visible per helix_macros_status value (bind_flag_if_not_eq hides
             the row unless the subject equals its ref_value); -1 (unknown, no
             objects list yet) matches none, so the whole feature stays hidden
             rather than offering an install that cannot honestly be made.
             Values: 0 not installed (install offer), 1 installed, 2 outdated
             (update offer), 3 staged, awaiting the Klipper restart. -->
        <setting_action_row name="row_helix_macros_install"
                            label="Install Helper Macros" icon="script_text"
                            description="Enable Clean Nozzle and other print helpers">
          <bind_flag_if_not_eq subject="helix_macros_status" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_helix_macros_install_clicked"/>
        </setting_action_row>
        <setting_action_row name="row_helix_macros_update"
                            label="Update Helper Macros" icon="script_text"
                            description="A newer version of the helper macros is available">
          <bind_flag_if_not_eq subject="helix_macros_status" flag="hidden" ref_value="2"/>
          <event_cb trigger="clicked" callback="on_helix_macros_update_clicked"/>
        </setting_action_row>
        <lv_obj name="container_helix_macros_installed" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_not_eq subject="helix_macros_status" flag="hidden" ref_value="1"/>
          <setting_info_row name="row_helix_macros_installed" label="Helper Macros" icon="script_text" value="Installed"/>
        </lv_obj>
        <lv_obj name="container_helix_macros_restart_pending" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_not_eq subject="helix_macros_status" flag="hidden" ref_value="3"/>
          <setting_info_row name="row_helix_macros_restart_pending"
                            label="Helper Macros" icon="script_text" value="Restart pending"/>
        </lv_obj>
        <!-- What the signal macro names look like on this printer: one line per
             helix_macros_signal_names value (signal_macros::SignalNamesLine);
             0 says nothing. The outer container hides on 0 and each line on
             any value but its own, nested so two bindings never share a flag. -->
        <lv_obj name="container_helix_macros_signal_names"
                width="100%" height="content" style_pad_top="0" style_pad_left="0" style_pad_bottom="0"
                scrollable="false">
          <bind_flag_if_eq subject="helix_macros_signal_names" flag="hidden" ref_value="0"/>
          <lv_obj width="100%"
                  height="content" style_pad_left="#space_xl" style_pad_right="#space_lg" style_pad_top="0"
                  style_pad_bottom="#space_md" scrollable="false" flex_flow="row" style_flex_cross_place="start"
                  style_pad_gap="#space_sm">
            <icon src="info" size="xs" variant="secondary"/>
            <lv_obj height="content" flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="column">
              <text_small name="signal_names_all_hidden"
                          width="100%" text="Signal macros are hidden from Fluidd and Mainsail macro lists."
                          long_mode="wrap" style_text_color="#text_muted">
                <bind_flag_if_not_eq subject="helix_macros_signal_names" flag="hidden" ref_value="1"/>
              </text_small>
              <text_small name="signal_names_aliases_kept"
                          width="100%" text="Signal macros keep their old names too, so older calls still work."
                          long_mode="wrap" style_text_color="#text_muted">
                <bind_flag_if_not_eq subject="helix_macros_signal_names" flag="hidden" ref_value="2"/>
              </text_small>
              <text_small name="signal_names_plugin_renames"
                          width="100%" text="The HelixPrint plugin moves old PRINT_START calls to the hidden names."
                          long_mode="wrap" style_text_color="#text_muted">
                <bind_flag_if_not_eq subject="helix_macros_signal_names" flag="hidden" ref_value="3"/>
              </text_small>
              <text_small name="signal_names_update_plugin"
                          width="100%" text="Update the HelixPrint plugin to 1.5.0 to hide old PRINT_START calls."
                          long_mode="wrap" style_text_color="#text_muted">
                <bind_flag_if_not_eq subject="helix_macros_signal_names" flag="hidden" ref_value="4"/>
              </text_small>
            </lv_obj>
          </lv_obj>
        </lv_obj>
      </setting_group>
      <!-- ================================================================== -->
      <!-- CALIBRATION SECTION -->
      <!-- ================================================================== -->
      <setting_group name="group_calibration">
        <setting_group_header title="CALIBRATION" icon="tune" hide_icon="false"/>
        <!-- Bed Leveling (hidden if screws_tilt_adjust not configured) -->
        <lv_obj name="container_bed_leveling" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="printer_has_screws_tilt" flag="hidden" ref_value="0"/>
          <setting_action_row name="row_bed_mesh"
                              label="Bed Leveling" icon="grid_large"
                              description="Auto-probe or manually check screw heights">
            <event_cb trigger="clicked" callback="on_screws_tilt_row_clicked"/>
          </setting_action_row>
        </lv_obj>
        <!-- Input Shaping (hidden if no accelerometer) -->
        <setting_action_row name="row_input_shaping"
                            label="Input Shaping" icon="inputshaper" description="Reduce ringing and ghosting artifacts">
          <bind_flag_if_eq subject="printer_has_accelerometer" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_input_shaper_row_clicked"/>
        </setting_action_row>
        <!-- Pressure Advance (only firmwares that can measure it; helix::pacal decides) -->
        <setting_action_row name="row_pa_calibration"
                            label="Pressure Advance" icon="gauge" description="Measure pressure advance automatically">
          <bind_flag_if_eq subject="printer_has_pa_cal" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_calibration_pa"/>
        </setting_action_row>
        <!-- Pressure advance tuned by eye on a live test print: any Klipper extruder -->
        <setting_action_row name="row_pa_tuning"
                            label="Pressure Advance Tuning" icon="gauge"
                            description="Print a test tower and tune K by eye">
          <event_cb trigger="clicked" callback="on_pa_tuning_clicked"/>
        </setting_action_row>
        <!-- Tool Offsets (printers with a tool offset calibration) -->
        <setting_action_row name="row_tool_offsets"
                            label="Tool Offsets" icon="axis_arrow"
                            bind_description="printer_tool_offset_cal_description">
          <bind_flag_if_eq subject="printer_has_tool_offset_cal" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_tool_offset_row_clicked"/>
        </setting_action_row>
        <!-- Vertical Artifact Compensation (firmwares with a stepper resonance
             calibration; helix::stepper_resonance_cal decides) -->
        <setting_action_row name="row_stepper_resonance_cal"
                            label="Vertical Artifact Compensation" icon="sine_wave"
                            description="Tune the motors to remove fine vertical lines">
          <bind_flag_if_eq subject="printer_has_stepper_resonance_cal" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_stepper_resonance_cal_clicked"/>
        </setting_action_row>
        <!-- Belt Tension (hidden if no accelerometer) -->
        <setting_action_row name="row_belt_tension"
                            label="Belt Tension" icon="vibrate" description="Compare belt paths with a resonance sweep">
          <!-- One binding, both conditions (two flag bindings on a widget
               fight): an accelerometer, and a kinematics whose two diagonals
               are the two belt paths (corexy, limited_corexy). -->
          <bind_flag_if cond="printer_has_accelerometer eq 0 or printer_supports_belt_compare eq 0" flag="hidden"/>
          <event_cb trigger="clicked" callback="on_belt_tension_row_clicked"/>
        </setting_action_row>
        <!-- Vertical Artifact Check (hidden without an accelerometer, a supported
             kinematics or the steppers' geometry) -->
        <setting_action_row name="row_motor_ripple"
                            label="Vertical Artifact Check" icon="vibrate"
                            description="Find the print speeds that shake the printer">
          <bind_flag_if_eq subject="printer_supports_ripple_check" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_motor_ripple_row_clicked"/>
        </setting_action_row>
        <!-- Probe Management (hidden if no probe) -->
        <setting_action_row name="row_probe"
                            label="Probe Management" icon="target"
                            description="Probe controls, accuracy test, and settings">
          <bind_flag_if_eq subject="printer_has_probe" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_probe_row_clicked"/>
        </setting_action_row>
        <!-- Z-Offset Calibration (hidden if no probe) -->
        <setting_action_row name="row_z_offset"
                            label="Z-Offset Calibration" icon="z_closer" description="Interactive probe calibration">
          <!-- One binding, every test (two flag bindings on a widget fight):
               needs a probe; steps aside where the firmware applies each
               head's own Z offset at pickup, which the calibration's absolute
               offset would overwrite on the mounted head; and steps aside for automatic tool offset calibration where
               the database says that routine covers the reference tool's Z
               too (see the same bind in controls_panel.xml). -->
          <bind_flag_if cond="printer_has_probe eq 0 or z_offset_reapplied_per_head eq 1 or (printer_has_tool_offset_cal eq 1 and hide_manual_z_calibration eq 1)"
                        flag="hidden"/>
          <event_cb trigger="clicked" callback="on_zoffset_row_clicked"/>
        </setting_action_row>
        <!-- PID Tuning -->
        <setting_action_row name="row_pid_tuning"
                            label="Heater Calibration" icon="heater"
                            description="Adjusts individual characteristics of your heaters for optimal control">
          <event_cb trigger="clicked" callback="on_pid_tuning_clicked"/>
        </setting_action_row>
      </setting_group>
      <!-- ================================================================== -->
      <!-- POWER SECTION -->
      <!-- ================================================================== -->
      <!-- Both rows open the same dialog the home-panel power widget uses,
           which handles single-/dual-host scope and confirms the action.
           Hidden whole (header + rows) on platforms without host power
           controls (Android) — see platform_host_power_supported in
           app_globals.cpp. -->
      <setting_group name="group_power">
        <bind_flag_if_eq subject="platform_host_power_supported" flag="hidden" ref_value="0"/>
        <setting_group_header title="POWER" icon="power" hide_icon="false"/>
        <!-- Shutdown / Reboot — both rows open the same dialog (which presents
           both actions plus, on dual-host, the printer/screen/both scope). -->
        <setting_action_row name="row_shutdown"
                            label="Shutdown" icon="power" description="Power off the printer or screen">
          <event_cb trigger="clicked" callback="on_advanced_power_clicked"/>
        </setting_action_row>
        <setting_action_row name="row_reboot" label="Reboot" icon="restart" description="Restart the printer or screen">
          <event_cb trigger="clicked" callback="on_advanced_power_clicked"/>
        </setting_action_row>
      </setting_group>
      <!-- Bottom padding for scroll -->
      <lv_obj width="100%" height="#space_xl" scrollable="false"/>
    </lv_obj>
    <!-- ================================================================== -->
    <!-- PINNED EMERGENCY BAR (non-scrolling, always enabled) -->
    <!-- ================================================================== -->
    <lv_obj width="100%"
            height="content" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_sm"
            style_pad_bottom="#space_sm" style_pad_gap="#space_sm" scrollable="false">
      <bind_style_if name="estop_bar_column" cond="ui_is_portrait"/>
      <bind_style_if name="estop_bar_row" cond="ui_is_portrait" invert="true"/>
      <ui_button name="advanced_estop_btn"
                 height="#button_height_sm" icon="alert_octagon" text="E-Stop (M112)" variant="danger">
        <bind_style_if name="estop_btn_stacked" cond="ui_is_portrait"/>
        <bind_style_if name="estop_btn_inline" cond="ui_is_portrait" invert="true"/>
        <event_cb trigger="clicked" callback="advanced_estop_clicked"/>
      </ui_button>
      <ui_button name="advanced_restart_klipper_btn"
                 height="#button_height_sm" icon="refresh" text="Restart Klipper" variant="warning">
        <bind_style_if name="estop_btn_stacked" cond="ui_is_portrait"/>
        <bind_style_if name="estop_btn_inline" cond="ui_is_portrait" invert="true"/>
        <event_cb trigger="clicked" callback="advanced_restart_klipper_clicked"/>
      </ui_button>
      <ui_button name="advanced_firmware_restart_btn"
                 height="#button_height_sm" icon="cog_refresh" text="Firmware Restart" variant="secondary">
        <bind_style_if name="estop_btn_stacked" cond="ui_is_portrait"/>
        <bind_style_if name="estop_btn_inline" cond="ui_is_portrait" invert="true"/>
        <event_cb trigger="clicked" callback="advanced_firmware_restart_clicked"/>
      </ui_button>
      <ui_button name="advanced_restart_moonraker_btn"
                 height="#button_height_sm" icon="refresh" text="Restart Moonraker" variant="secondary">
        <bind_style_if name="estop_btn_stacked" cond="ui_is_portrait"/>
        <bind_style_if name="estop_btn_inline" cond="ui_is_portrait" invert="true"/>
        <event_cb trigger="clicked" callback="advanced_restart_moonraker_clicked"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
