<!-- Settings > Printing > Z Offset by Material (prestonbrown/helixscreen#2142): one
     Z offset per material, applied by the print-start macro, and an optional stored
     bed mesh per material. material_zoffset_status: 0 no storage on this printer
     (setup steps), 1 the helper macros need an update, 2 ready. -->
<component>
  <view name="material_z_offset_overlay" extends="overlay_panel" title="Z Offset by Material" bg_color="#screen_bg">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
            style_pad_bottom="#space_lg" scrollable="true" flex_flow="column">
      <text_small width="100%"
                  text="A heated bed expands with temperature, so each material can keep its own first-layer offset. The print-start macro applies it, and a Save during a print changes only that print's material."
                  long_mode="wrap" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_bottom="#space_sm"/>
      <!-- Setup: no storage this screen can use -->
      <setting_group name="group_setup">
        <bind_flag_if_not_eq subject="material_zoffset_status" flag="hidden" ref_value="0"/>
        <setting_group_header title="ONE-TIME SETUP"/>
        <lv_obj name="step_install"
                width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_ver="#space_md"
                style_pad_hor="#space_lg" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
          <text_body width="100%"
                     text="1. Install the helper macros. They add the macro in step 2 and a Klipper store for the offsets."
                     long_mode="wrap"/>
          <ui_button name="btn_install_macros" width="100%" variant="primary" text="Install Helper Macros">
            <event_cb trigger="clicked" callback="on_helix_macros_install_clicked"/>
          </ui_button>
        </lv_obj>
        <lv_obj name="step_print_start"
                width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_ver="#space_md"
                style_pad_hor="#space_lg" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
          <text_body width="100%"
                     text="2. In PRINT_START, after homing and probing and before your own mesh step, add this line:"
                     long_mode="wrap"/>
          <code_block bind_text="material_zoffset_macro_line"/>
        </lv_obj>
        <lv_obj name="step_slicer"
                width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_ver="#space_md"
                style_pad_hor="#space_lg" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
          <text_body width="100%"
                     text="3. Have the slicer's start G-code pass the material to PRINT_START:" long_mode="wrap"/>
          <code_block bind_text="material_zoffset_slicer_line"/>
        </lv_obj>
      </setting_group>
      <!-- The helper macros predate the store for the offsets -->
      <setting_group name="group_update">
        <bind_flag_if_not_eq subject="material_zoffset_status" flag="hidden" ref_value="1"/>
        <lv_obj name="update_card"
                width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_ver="#space_md"
                style_pad_hor="#space_lg" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
          <text_body width="100%"
                     text="The helper macros on this printer have no store for the offsets yet. Update them, then restart Klipper."
                     long_mode="wrap"/>
          <ui_button name="btn_update_macros" width="100%" variant="primary" text="Update Helper Macros">
            <event_cb trigger="clicked" callback="on_helix_macros_update_clicked"/>
          </ui_button>
        </lv_obj>
      </setting_group>
      <!-- Ready -->
      <setting_group name="group_enabled">
        <bind_flag_if_not_eq subject="material_zoffset_status" flag="hidden" ref_value="2"/>
        <setting_toggle_row name="row_material_zoffset_enabled"
                            label="Z offset by material" icon="layers"
                            description="Save writes the print's material; off, it saves one offset for every print"
                            subject="material_zoffset_enabled" callback="on_material_zoffset_enabled_changed"/>
      </setting_group>
      <setting_group name="group_materials">
        <bind_flag_if_not_eq subject="material_zoffset_status" flag="hidden" ref_value="2"/>
        <setting_group_header title="OFFSET PER MATERIAL"/>
        <setting_value_row label="Any other material"
                           bind_description="material_zoffset_temp_default" marker_icon="grid_large"
                           marker_subject="material_zoffset_mesh_default" value_subject="material_zoffset_value_default"
                           callback="on_material_zoffset_field_clicked" user_data="DEFAULT"/>
        <setting_value_row label="PLA"
                           bind_description="material_zoffset_temp_pla" marker_icon="grid_large"
                           marker_subject="material_zoffset_mesh_pla" value_subject="material_zoffset_value_pla"
                           callback="on_material_zoffset_field_clicked" user_data="PLA"/>
        <setting_value_row label="PETG"
                           bind_description="material_zoffset_temp_petg" marker_icon="grid_large"
                           marker_subject="material_zoffset_mesh_petg" value_subject="material_zoffset_value_petg"
                           callback="on_material_zoffset_field_clicked" user_data="PETG"/>
        <setting_value_row label="ABS"
                           bind_description="material_zoffset_temp_abs" marker_icon="grid_large"
                           marker_subject="material_zoffset_mesh_abs" value_subject="material_zoffset_value_abs"
                           callback="on_material_zoffset_field_clicked" user_data="ABS"/>
        <setting_value_row label="ASA"
                           bind_description="material_zoffset_temp_asa" marker_icon="grid_large"
                           marker_subject="material_zoffset_mesh_asa" value_subject="material_zoffset_value_asa"
                           callback="on_material_zoffset_field_clicked" user_data="ASA"/>
        <setting_value_row label="TPU"
                           bind_description="material_zoffset_temp_tpu" marker_icon="grid_large"
                           marker_subject="material_zoffset_mesh_tpu" value_subject="material_zoffset_value_tpu"
                           callback="on_material_zoffset_field_clicked" user_data="TPU"/>
        <setting_value_row label="PA"
                           bind_description="material_zoffset_temp_pa" marker_icon="grid_large"
                           marker_subject="material_zoffset_mesh_pa" value_subject="material_zoffset_value_pa"
                           callback="on_material_zoffset_field_clicked" user_data="PA"/>
        <setting_value_row label="PC"
                           bind_description="material_zoffset_temp_pc" marker_icon="grid_large"
                           marker_subject="material_zoffset_mesh_pc" value_subject="material_zoffset_value_pc"
                           callback="on_material_zoffset_field_clicked" user_data="PC"/>
      </setting_group>
      <info_note icon="grid_large"
                 icon_variant="muted"
                 text="A grid marks a material with a stored bed mesh, loaded at print start for prints that do not mesh."
                 style_pad_left="#space_md" style_pad_right="#space_md">
        <bind_flag_if_not_eq subject="material_zoffset_status" flag="hidden" ref_value="2"/>
      </info_note>
    </lv_obj>
  </view>
</component>
