<component>
  <!-- WiFi Network List Item - Reusable Component -->
  <!-- Displays network SSID, signal strength icon, and security status -->
  <!-- Uses responsive theme tokens: #space_lg for padding, #font_body for text -->
  <!-- Connected network is indicated via LV_STATE_CHECKED - adds left border accent -->
  <!-- Click triggers the owner's callback, named by the click_callback prop -->
  <api>
    <prop name="click_callback" type="string" default=""/>
    <!-- Which of the eight signal icons shows: 1-4 open, 5-8 secured (with lock) -->
    <prop name="signal_state" type="string" default="4"/>
    <!-- Security type text, empty for an open network -->
    <prop name="security" type="string" default=""/>
  </api>
  <styles>
    <!-- Style applied when item has LV_STATE_CHECKED (connected network) -->
    <style name="checked_style"
           border_width="#space_xs" border_side="left" border_color="#primary" bg_color="#elevated_bg"/>
  </styles>
  <view extends="lv_button"
        width="100%" scrollable="false" clickable="true" style_bg_opa="0" style_border_width="0" style_shadow_width="0"
        style_pad_ver="#space_sm" style_pad_hor="#space_md" flex_flow="row" style_flex_main_place="start"
        style_flex_cross_place="center" style_pad_gap="#space_sm">
    <style name="checked_style" selector="checked"/>
    <event_cb trigger="clicked" callback="$click_callback"/>
    <!-- Signal strength icons: the one matching signal_state shows -->
    <!-- States 1-4: unsecured networks, States 5-8: secured networks (with lock) -->
    <lv_obj name="signal_icons" style_pad_all="0" clickable="false">
      <!-- Unsecured: strength 1 (weak) -->
      <icon name="sig_1"
            src="wifi_strength_1" size="sm" variant="primary" clickable="false" hidden_if_prop_not_eq="$signal_state|1"/>
      <!-- Unsecured: strength 2 (fair) -->
      <icon name="sig_2"
            src="wifi_strength_2" size="sm" variant="primary" clickable="false" hidden_if_prop_not_eq="$signal_state|2"/>
      <!-- Unsecured: strength 3 (good) -->
      <icon name="sig_3"
            src="wifi_strength_3" size="sm" variant="primary" clickable="false" hidden_if_prop_not_eq="$signal_state|3"/>
      <!-- Unsecured: strength 4 (strong) -->
      <icon name="sig_4"
            src="wifi_strength_4" size="sm" variant="primary" clickable="false" hidden_if_prop_not_eq="$signal_state|4"/>
      <!-- Secured: strength 1 (weak) -->
      <icon name="sig_1_lock"
            src="wifi_strength_1_lock" size="sm" variant="primary" clickable="false"
            hidden_if_prop_not_eq="$signal_state|5"/>
      <!-- Secured: strength 2 (fair) -->
      <icon name="sig_2_lock"
            src="wifi_strength_2_lock" size="sm" variant="primary" clickable="false"
            hidden_if_prop_not_eq="$signal_state|6"/>
      <!-- Secured: strength 3 (good) -->
      <icon name="sig_3_lock"
            src="wifi_strength_3_lock" size="sm" variant="primary" clickable="false"
            hidden_if_prop_not_eq="$signal_state|7"/>
      <!-- Secured: strength 4 (strong) -->
      <icon name="sig_4_lock"
            src="wifi_strength_4_lock" size="sm" variant="primary" clickable="false"
            hidden_if_prop_not_eq="$signal_state|8"/>
    </lv_obj>
    <!-- SSID and security type column (center) -->
    <lv_obj flex_grow="1"
            style_pad_all="0" style_radius="0" style_pad_gap="#space_xs" scrollable="false" clickable="false"
            flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center">
      <!-- Network SSID - uses responsive font_body from theme -->
      <text_body name="ssid_label" clickable="false"/>
      <!-- Right-justified metadata: band badge then security type -->
      <lv_obj width="content"
              height="content" style_pad_all="0" style_radius="0" style_pad_gap="#space_xs" scrollable="false"
              clickable="false" flex_flow="row" style_flex_cross_place="center">
        <!-- Band badge ("2.4G" / "5G" / "2.4/5G"). Hidden unless the scan saw
             more than one band; text and visibility are driven by per-item
             subjects owned by the C++ list builder. -->
        <text_small name="band_label" clickable="false" hidden="true"/>
        <!-- Security type -->
        <text_small name="security_label" text="$security" clickable="false"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
