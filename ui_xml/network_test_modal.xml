<!-- Network Test Modal - Tests local connection and internet access -->
<!-- Uses vertical step progress widget created dynamically in C++ -->
<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <!-- NOTE: test_complete subject is registered globally in C++ (network_settings_overlay.cpp) -->
  <!-- Dialog card (backdrop created programmatically) -->
  <view name="network_test_modal"
        extends="ui_dialog" width="70%" height="content" style_min_width="300" style_max_width="380" align="center"
        flex_flow="column" style_flex_main_place="start" style_pad_gap="0">
    <!-- Header with title -->
    <lv_obj width="100%"
            height="content" style_pad_all="#space_lg" flex_flow="row" style_flex_cross_place="center"
            style_pad_gap="#space_sm">
      <icon src="lan" size="md" variant="primary"/>
      <text_heading text="Network Test" style_text_align="left" flex_grow="1"/>
    </lv_obj>
    <!-- Step progress container - widget created dynamically in C++ -->
    <lv_obj name="step_container"
            width="100%" height="content" style_min_height="120" style_pad_left="#space_xl" style_pad_right="#space_lg"
            style_pad_top="0" style_pad_bottom="#space_lg" scrollable="false"/>
    <!-- Horizontal divider above button -->
    <divider_horizontal/>
    <!-- Close button row -->
    <lv_obj width="100%" height="#button_height" style_pad_all="0">
      <ui_button name="btn_close" width="100%" height="100%" text="Close">
        <!-- Disabled while test is running (test_complete=0) -->
        <bind_state_if_eq subject="test_complete" state="disabled" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_network_test_close"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
