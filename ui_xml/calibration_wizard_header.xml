<!-- The calibration wizard's header bar: a title over a subtitle on the left, a
     progress mark on the right, a divider under it. Every guided-run page and
     every per-step screen the run opens uses it, in place of the app's
     header_bar, so the wizard reads as one full-screen flow.

     Optional parts, each off unless asked for:
       back_callback        a back chevron before the title
       lead_icon            a status disc before the title (green);
                            lead_warn_subject at 1 turns it amber with an alert
       subtitle_icon        a small icon before the subtitle, in subtitle_color
       progress="1"         dots: one per step, the current one a wide pill; not in portrait
       progress="2"         segments: one bar per step; done and current ones
                            blue (segment_style="seg_on_warn": amber,
                            for a step that needs you), the rest a dim track
         step_count_subject    an int subject: how many steps (at most 10)
         step_current_subject  an int subject: the current step, 0-based
       eta_subject          a string subject shown at the right of the title row
                            (a run's time left, the setup wizard's "Step 3 of 9")
       hint / hint_subject  at 480x272 only: a right-hand instruction (hint_color);
                            the progress mark never shows at 480x272
       bar_subject          an int subject 0..100: a full-width progress bar
                            under the title row, in place of the subtitle
     Texts are literal or bound: title / title_subject, subtitle / subtitle_subject.
       subtitle_compact="1"  at 480x272 the subtitle sits right of the title and
                             shows subtitle_compact_subject instead
       subtitle_compact="2"  the same, and in portrait too (under the title) -->
<component>
  <consts>
    <px name="bar_h" value="6"/>
    <px name="back_size" value="44"/>
    <px name="back_pull" value="-10"/>
  </consts>
  <styles>
    <style name="cal_lead_ok" bg_color="#success"/>
    <style name="cal_lead_warn" bg_color="#warning"/>
    <style name="cal_hdr_stack" layout="flex" flex_flow="column" pad_row="#space_xxs"/>
    <style name="cal_hdr_inline" layout="flex" flex_flow="row" flex_cross_place="center" pad_column="#space_md"/>
    <style name="cal_hdr_full_w" width="100%"/>
    <style name="cal_hdr_content_w" width="content"/>
    <!-- A subtitle fills its row, or at 480x272 hugs its text so its icon stays beside it. -->
    <style name="cal_hdr_fill" width="0" flex_grow="1"/>
    <style name="cal_hdr_hug" width="content" flex_grow="0"/>
    <style name="cal_hdr_grow" flex_grow="1"/>
    <style name="cal_hdr_align_end" text_align="right"/>
  </styles>
  <api>
    <prop name="title" type="string" default=""/>
    <prop name="title_tag" type="string" default=""/>
    <prop name="title_subject" type="string" default=""/>
    <prop name="subtitle" type="string" default=""/>
    <prop name="subtitle_tag" type="string" default=""/>
    <prop name="subtitle_subject" type="string" default=""/>
    <prop name="subtitle_color" type="string" default="#text_muted"/>
    <prop name="subtitle_icon" type="string" default=""/>
    <prop name="subtitle_compact" type="int" default="0"/>
    <prop name="subtitle_compact_subject" type="string" default=""/>
    <prop name="back_callback" type="string" default=""/>
    <prop name="lead_icon" type="string" default=""/>
    <prop name="lead_warn_subject" type="string" default=""/>
    <prop name="progress" type="int" default="0"/>
    <prop name="step_count_subject" type="string" default=""/>
    <prop name="step_current_subject" type="string" default=""/>
    <prop name="segment_style" type="string" default="seg_on"/>
    <prop name="eta_subject" type="string" default=""/>
    <prop name="hint" type="string" default=""/>
    <prop name="hint_tag" type="string" default=""/>
    <prop name="hint_subject" type="string" default=""/>
    <prop name="hint_color" type="string" default="#text_muted"/>
    <prop name="bar_subject" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="100%" height="#cal_header_h" style_pad_left="#cal_header_pad_x" style_pad_right="#cal_header_pad_x"
        style_pad_top="0" style_pad_bottom="0" style_pad_gap="#space_md" style_bg_opa="0" style_radius="0"
        style_border_width="1" style_border_side="bottom" style_border_color="#border" style_border_opa="255"
        flex_flow="column" style_flex_main_place="center" style_flex_cross_place="start" scrollable="false">
    <lv_obj name="cal_header_row"
            width="100%" height="content" style_pad_all="0" style_pad_gap="#space_lg" style_bg_opa="0"
            style_border_width="0" flex_flow="row" style_flex_cross_place="center" scrollable="false">
      <lv_obj name="cal_header_back"
              width="#back_size" height="#back_size" style_margin_left="#back_pull" style_pad_all="0" style_bg_opa="0"
              style_border_width="0" style_radius="#border_radius" clickable="true" scrollable="false"
              hidden_if_empty="$back_callback">
        <style name="styles.press_wash" selector="pressed"/>
        <icon src="chevron_left" size="sm" variant="text" align="center" clickable="false" event_bubble="true"/>
        <event_cb trigger="clicked" callback="$back_callback"/>
      </lv_obj>
      <lv_obj name="cal_header_lead"
              width="#cal_box" height="#cal_box" style_pad_all="0" style_radius="9999" style_bg_opa="255"
              style_border_width="0" scrollable="false" hidden_if_empty="$lead_icon">
        <style name="cal_lead_ok"/>
        <bind_style name="cal_lead_warn" subject="$lead_warn_subject" ref_value="1"/>
        <icon src="$lead_icon" size="xs" contrast="true" align="center">
          <bind_flag_if_eq subject="$lead_warn_subject" flag="hidden" ref_value="1"/>
        </icon>
        <icon src="alert" size="xs" contrast="true" align="center" hidden="true">
          <bind_flag_if_eq subject="$lead_warn_subject" flag="hidden" ref_value="0"/>
        </icon>
      </lv_obj>
      <!-- Title over subtitle; at 480x272 the two share one line, the subtitle
           pushed right. -->
      <lv_obj name="cal_header_text"
              width="0" height="content" flex_grow="1" style_pad_all="0" style_bg_opa="0" style_border_width="0"
              scrollable="false">
        <bind_style_if_ge name="cal_hdr_stack" subject="ui_breakpoint" ref_value="1"/>
        <bind_style_if_eq name="cal_hdr_inline" subject="ui_breakpoint" ref_value="0"/>
        <!-- A literal title or subtitle and a bound one are separate labels, each
             hidden by its prop alone: one label carrying both would let the literal,
             applied after the binding, blank a value published before the header
             was built. -->
        <lv_obj name="cal_header_title_box"
                height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
          <bind_style_if_ge name="cal_hdr_full_w" subject="ui_breakpoint" ref_value="1"/>
          <bind_style_if_eq name="cal_hdr_content_w" subject="ui_breakpoint" ref_value="0"/>
          <text_body name="cal_header_title"
                     text="$title" translation_tag="$title_tag" long_mode="dots" style_text_font="#cal_font_title"
                     style_text_color="#text" hidden_if_prop_not_eq="$title_subject|"/>
          <text_body name="cal_header_title_bound"
                     bind_text="$title_subject" long_mode="dots" style_text_font="#cal_font_title"
                     style_text_color="#text" hidden_if_empty="$title_subject"/>
        </lv_obj>
        <lv_obj name="cal_header_subtitle_row"
                height="content" style_pad_all="0" style_pad_gap="#space_xs" style_bg_opa="0" style_border_width="0"
                flex_flow="row" style_flex_cross_place="center" style_flex_main_place="end" scrollable="false"
                hidden_if_prop_not_eq="$bar_subject|">
          <bind_style_if_ge name="cal_hdr_full_w" subject="ui_breakpoint" ref_value="1"/>
          <bind_style_if_eq name="cal_hdr_grow" subject="ui_breakpoint" ref_value="0"/>
          <!-- The row packs to its end at 480x272, so the icon travels with the text. -->
          <icon src="$subtitle_icon" size="xs" color="$subtitle_color" hidden_if_empty="$subtitle_icon"/>
          <if cond="$subtitle_compact eq 0">
            <lv_obj name="cal_header_subtitle_box"
                    height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
              <bind_style_if_ge name="cal_hdr_fill" subject="ui_breakpoint" ref_value="1"/>
              <bind_style_if_eq name="cal_hdr_hug" subject="ui_breakpoint" ref_value="0"/>
              <text_body name="cal_header_subtitle"
                         text="$subtitle" translation_tag="$subtitle_tag" long_mode="dots"
                         style_text_font="#cal_font_subtitle" style_text_color="$subtitle_color"
                         hidden_if_prop_not_eq="$subtitle_subject|">
                <bind_style_if_ge name="cal_hdr_full_w" subject="ui_breakpoint" ref_value="1"/>
              </text_body>
              <text_body name="cal_header_subtitle_bound"
                         bind_text="$subtitle_subject" long_mode="dots" style_text_font="#cal_font_subtitle"
                         style_text_color="$subtitle_color" hidden_if_empty="$subtitle_subject">
                <bind_style_if_ge name="cal_hdr_full_w" subject="ui_breakpoint" ref_value="1"/>
              </text_body>
            </lv_obj>
          </if>
          <if cond="$subtitle_compact eq 1">
            <!-- DUPLICATE_NAME_OK: one <if> branch is built -->
            <lv_obj name="cal_header_subtitle_box"
                    height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
              <bind_style_if_ge name="cal_hdr_fill" subject="ui_breakpoint" ref_value="1"/>
              <bind_style_if_eq name="cal_hdr_hug" subject="ui_breakpoint" ref_value="0"/>
              <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
              <!-- DUPLICATE_NAME_OK: one <if> branch is built -->
              <text_body name="cal_header_subtitle"
                         text="$subtitle" translation_tag="$subtitle_tag" long_mode="dots"
                         style_text_font="#cal_font_subtitle" style_text_color="$subtitle_color"
                         hidden_if_prop_not_eq="$subtitle_subject|">
                <bind_style_if_ge name="cal_hdr_full_w" subject="ui_breakpoint" ref_value="1"/>
              </text_body>
              <!-- DUPLICATE_NAME_OK: one <if> branch is built -->
              <text_body name="cal_header_subtitle_bound"
                         bind_text="$subtitle_subject" long_mode="dots" style_text_font="#cal_font_subtitle"
                         style_text_color="$subtitle_color" hidden_if_empty="$subtitle_subject">
                <bind_style_if_ge name="cal_hdr_full_w" subject="ui_breakpoint" ref_value="1"/>
              </text_body>
            </lv_obj>
            <text_body name="cal_header_subtitle_compact"
                       bind_text="$subtitle_compact_subject" long_mode="dots" style_text_font="#cal_font_subtitle"
                       style_text_color="$subtitle_color">
              <bind_style_if_ge name="cal_hdr_fill" subject="ui_breakpoint" ref_value="1"/>
              <bind_style_if_eq name="cal_hdr_hug" subject="ui_breakpoint" ref_value="0"/>
              <bind_flag_if_ge subject="ui_breakpoint" flag="hidden" ref_value="1"/>
            </text_body>
          </if>
          <if cond="$subtitle_compact eq 2">
            <!-- DUPLICATE_NAME_OK: one <if> branch is built -->
            <lv_obj name="cal_header_subtitle_box"
                    height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
              <bind_style_if_ge name="cal_hdr_fill" subject="ui_breakpoint" ref_value="1"/>
              <bind_style_if_eq name="cal_hdr_hug" subject="ui_breakpoint" ref_value="0"/>
              <bind_flag_if cond="ui_breakpoint eq 0 or ui_is_portrait eq 1" flag="hidden"/>
              <!-- DUPLICATE_NAME_OK: one <if> branch is built -->
              <text_body name="cal_header_subtitle"
                         text="$subtitle" translation_tag="$subtitle_tag" long_mode="dots"
                         style_text_font="#cal_font_subtitle" style_text_color="$subtitle_color"
                         hidden_if_prop_not_eq="$subtitle_subject|">
                <bind_style_if_ge name="cal_hdr_full_w" subject="ui_breakpoint" ref_value="1"/>
              </text_body>
              <!-- DUPLICATE_NAME_OK: one <if> branch is built -->
              <text_body name="cal_header_subtitle_bound"
                         bind_text="$subtitle_subject" long_mode="dots" style_text_font="#cal_font_subtitle"
                         style_text_color="$subtitle_color" hidden_if_empty="$subtitle_subject">
                <bind_style_if_ge name="cal_hdr_full_w" subject="ui_breakpoint" ref_value="1"/>
              </text_body>
            </lv_obj>
            <!-- DUPLICATE_NAME_OK: one <if> branch is built -->
            <text_body name="cal_header_subtitle_compact"
                       bind_text="$subtitle_compact_subject" long_mode="dots" style_text_font="#cal_font_subtitle"
                       style_text_color="$subtitle_color">
              <bind_style_if_ge name="cal_hdr_fill" subject="ui_breakpoint" ref_value="1"/>
              <bind_style_if_eq name="cal_hdr_hug" subject="ui_breakpoint" ref_value="0"/>
              <bind_flag_if cond="ui_breakpoint ne 0 and ui_is_portrait eq 0" flag="hidden"/>
            </text_body>
          </if>
        </lv_obj>
      </lv_obj>
      <text_body name="cal_header_eta"
                 bind_text="$eta_subject" style_text_font="#cal_font_subtitle" style_text_color="#text_muted"
                 hidden_if_empty="$eta_subject"/>
      <!-- At 480x272 the progress mark gives its place to the hint. -->
      <!-- Each hint sits in a box its prop hides: the breakpoint binding on the
           label would show an unsupplied hint again. -->
      <lv_obj width="content"
              height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
              hidden_if_empty="$hint">
        <text_body name="cal_header_hint"
                   text="$hint" translation_tag="$hint_tag" style_text_font="#cal_font_subtitle"
                   style_text_color="$hint_color">
          <bind_flag_if_ge subject="ui_breakpoint" flag="hidden" ref_value="1"/>
        </text_body>
      </lv_obj>
      <lv_obj width="content"
              height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
              hidden_if_empty="$hint_subject">
        <text_body name="cal_header_hint_bound"
                   bind_text="$hint_subject" style_text_font="#cal_font_subtitle" style_text_color="$hint_color">
          <bind_flag_if_ge subject="ui_breakpoint" flag="hidden" ref_value="1"/>
        </text_body>
      </lv_obj>
      <if cond="$progress eq 1">
        <calibration_wizard_dots name="cal_header_dots"
                                 count_subject="$step_count_subject" current_subject="$step_current_subject">
          <bind_flag_if cond="ui_breakpoint eq 0 or ui_is_portrait eq 1" flag="hidden"/>
        </calibration_wizard_dots>
      </if>
      <if cond="$progress eq 2">
        <calibration_wizard_segments name="cal_header_segments"
                                     count_subject="$step_count_subject" current_subject="$step_current_subject"
                                     on_style="$segment_style">
          <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
        </calibration_wizard_segments>
      </if>
    </lv_obj>
    <lv_bar name="cal_header_bar"
            width="100%" height="#bar_h" min_value="0" max_value="100" bind_value="$bar_subject" style_radius="9999"
            style_bg_color="#border" style_bg_opa="255" style_bg_color-indicator="#primary" style_bg_opa-indicator="255"
            style_radius-indicator="9999" hidden_if_empty="$bar_subject"/>
  </view>
</component>
