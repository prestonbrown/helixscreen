<!-- Compact form row: label (60px, muted) + dropdown (40%), its selection
     two-way bound to value_subject. -->
<component>
  <api>
    <prop name="label" type="string" default="Field:"/>
    <prop name="dropdown_name" type="string" default="dropdown"/>
    <prop name="options" type="string" default=""/>
    <prop name="options_tag" type="string" default=""/>
    <prop name="value_subject" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
        style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false">
    <text_muted name="label" width="60" text="$label"/>
    <lv_dropdown name="$dropdown_name"
                 width="40%" options="$options" options_tag="$options_tag" bind_value="$value_subject"/>
  </view>
</component>
