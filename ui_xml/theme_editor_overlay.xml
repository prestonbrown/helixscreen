<!-- Theme Colors Editor Overlay - Secondary panel for detailed color editing -->
<!-- Navigation: Settings → Appearance → Theme Colors → Edit Colors → (this) -->
<component>
  <consts>
    <!-- The color editor's height: the roles and the picker beside or under
         them. At 480x272 it is taller than the view, so the grid keeps touch-sized
         rows and the content scrolls a little to reach the properties. -->
    <px name="theme_colors_h_micro" value="236"/>
    <px name="theme_colors_h_tiny" value="250"/>
    <px name="theme_colors_h_small" value="300"/>
    <px name="theme_colors_h_medium" value="330"/>
    <px name="theme_colors_h_large" value="420"/>
    <px name="theme_roles_w_micro" value="190"/>
    <px name="theme_roles_w_tiny" value="170"/>
    <px name="theme_roles_w_small" value="180"/>
    <px name="theme_roles_w_medium" value="190"/>
    <px name="theme_roles_w_large" value="230"/>
  </consts>
  <styles>
    <style name="colors_stacked" flex_flow="column"/>
    <style name="roles_row" width="100%" height="content" flex_flow="row"/>
    <style name="roles_column" width="#theme_roles_w" height="100%" flex_flow="column"/>
    <style name="picker_below" width="100%" height="0"/>
    <style name="picker_beside" width="0" height="100%"/>
    <!-- 480x272 tightens every inset one step so the swatch grid and the
         pinned action row share the 272px; the other tiers keep the standard
         spacing. -->
    <style name="editor_content" pad_left="#space_lg" pad_right="#space_lg" pad_bottom="#space_lg"/>
    <style name="editor_content_micro" pad_left="#space_sm" pad_right="#space_sm" pad_bottom="#space_xs"/>
    <style name="editor_swatches"
           pad_left="#space_md" pad_right="#space_md" pad_top="#space_xs" pad_bottom="#space_sm" pad_gap="#space_xs"/>
    <style name="editor_swatches_micro"
           pad_left="#space_xs" pad_right="#space_xs" pad_top="0" pad_bottom="#space_xs" pad_gap="#space_xxs"/>
    <style name="editor_actions"
           pad_left="#space_lg" pad_right="#space_lg" pad_top="#space_lg" pad_bottom="#space_lg" pad_gap="#space_md"/>
    <style name="editor_actions_micro"
           pad_left="#space_sm" pad_right="#space_sm" pad_top="#space_xs" pad_bottom="#space_xs" pad_gap="#space_xs"/>
  </styles>
  <view name="theme_editor_overlay"
        extends="overlay_panel" title="Edit Theme Colors" title_subject="theme_editor_title" bg_color="#screen_bg"
        back_button_callback="on_theme_back_clicked">
    <!-- At 480x272 the picker's readout and switch sit in the header. -->
    <header_bar-header_content flex_grow="4" style_pad_gap="#space_sm">
      <lv_obj name="theme_header_picker"
              height="100%" flex_grow="1" style_pad_all="0" style_pad_gap="#space_sm" style_bg_opa="0"
              style_border_width="0" flex_flow="row" style_flex_cross_place="center" scrollable="false"
              clickable="false" hidden="true">
        <bind_flag_if_gt subject="ui_breakpoint" flag="hidden" ref_value="0"/>
        <color_picker_readout flex_grow="1"/>
        <color_picker_tabs/>
      </lv_obj>
    </header_bar-header_content>
    <!-- Content Area - no padding, rows handle their own -->
    <overlay_panel-overlay_content style_pad_top="0" scrollable="true" flex_flow="column">
      <bind_style_if_eq name="editor_content_micro" subject="ui_breakpoint" ref_value="0"/>
      <bind_style_if_ge name="editor_content" subject="ui_breakpoint" ref_value="1"/>
      <!-- ================================================================== -->
      <!-- THEME COLORS -->
      <!-- ================================================================== -->
      <setting_section_header title="THEME COLORS" icon="tune">
        <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
      </setting_section_header>
      <!-- The theme's 16 roles as color bars beside the picker (a column from the
           small class up; a sideways row above it at 480x272, where the readout
           and switch sit in the header). Tapping a bar edits that role; the
           picker repaints it and the theme previews it live. -->
      <lv_obj name="theme_colors"
              width="100%" height="#theme_colors_h" style_bg_opa="0" style_border_width="0" flex_flow="row"
              scrollable="false" clickable="false">
        <bind_style_if_eq name="colors_stacked" subject="ui_breakpoint" ref_value="0"/>
        <bind_style_if_eq name="editor_swatches_micro" subject="ui_breakpoint" ref_value="0"/>
        <bind_style_if_ge name="editor_swatches" subject="ui_breakpoint" ref_value="1"/>
        <lv_obj name="theme_role_list"
                style_pad_all="#space_xxs" style_pad_gap="#space_xs" style_bg_opa="0" style_border_width="0"
                scrollable="true" scrollbar_mode="off" clickable="false">
          <bind_style_if_eq name="roles_row" subject="ui_breakpoint" ref_value="0"/>
          <bind_style_if_ge name="roles_column" subject="ui_breakpoint" ref_value="1"/>
          <repeat count="16">
            <theme_role_bar name="role_${i}" index="${i}"/>
          </repeat>
        </lv_obj>
        <lv_obj name="theme_picker"
                flex_grow="1" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
                clickable="false">
          <bind_style_if_eq name="picker_below" subject="ui_breakpoint" ref_value="0"/>
          <bind_style_if_ge name="picker_beside" subject="ui_breakpoint" ref_value="1"/>
        </lv_obj>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STYLE PROPERTIES -->
      <!-- ================================================================== -->
      <setting_section_header title="STYLE PROPERTIES" icon="tune_variant"/>

      <setting_slider_row name="row_border_radius"
                          label="Border Radius" icon="cube" description="Corner roundness" min="0" max="7" value="3"
                          value_subject="theme_editor_radius_name" value_format="%s" min_icon="minus" max_icon="plus"
                          callback="on_theme_property_changed" user_data="border_radius"/>

      <setting_slider_row name="row_border_width"
                          label="Border Width" icon="ruler" description="Default border thickness" min="0" max="6"
                          value="1" value_subject="theme_editor_border_width" min_icon="minus" max_icon="plus"
                          callback="on_theme_property_changed" user_data="border_width"/>

      <setting_slider_row name="row_border_opacity"
                          label="Border Opacity" icon="layers"
                          description="Border transparency (0 = invisible, 255 = solid)" min="0" max="255" value="128"
                          value_subject="theme_editor_border_opacity" min_icon="minus" max_icon="plus"
                          callback="on_theme_property_changed" user_data="border_opacity"/>

      <setting_slider_row name="row_shadow_intensity"
                          label="Shadow Intensity" icon="animation" description="Drop shadow strength (0 = disabled)"
                          min="0" max="50" value="0" value_subject="theme_editor_shadow" min_icon="minus"
                          max_icon="plus" callback="on_theme_property_changed" user_data="shadow"/>

    </overlay_panel-overlay_content>
    <!-- ================================================================== -->
    <!-- ACTION BUTTONS: pinned below the scroller, so Reset / Save As / Save
         stay reachable however long the colour list above scrolls. -->
    <!-- ================================================================== -->
    <overlay_panel-overlay_footer>
      <lv_obj name="action_buttons" width="100%" height="content" flex_flow="row" scrollable="false">
        <bind_style_if_eq name="editor_actions_micro" subject="ui_breakpoint" ref_value="0"/>
        <bind_style_if_ge name="editor_actions" subject="ui_breakpoint" ref_value="1"/>

        <ui_button name="btn_reset" height="#button_height" text="Reset" variant="secondary" flex_grow="1">
          <event_cb trigger="clicked" callback="on_theme_reset_clicked"/>
        </ui_button>

        <ui_button name="btn_save_as" height="#button_height" text="Save As New" variant="secondary" flex_grow="1">
          <event_cb trigger="clicked" callback="on_theme_save_as_clicked"/>
        </ui_button>

        <ui_button name="btn_save" height="#button_height" text="Save" variant="primary" flex_grow="1">
          <bind_state_if_eq subject="theme_editor_dirty" state="disabled" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_theme_save_clicked"/>
        </ui_button>
      </lv_obj>
    </overlay_panel-overlay_footer>

  </view>
</component>
