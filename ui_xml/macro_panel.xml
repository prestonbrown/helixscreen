<component>
  <view name="macro_panel"
        extends="overlay_panel" title="Macros" title_tag="Macros" hide_action_button="false" action_button_text="Save"
        action_button_text_tag="Save" action_button_callback="on_macros_edit_save"
        action_button_hidden_subject="macros_edit_save_hidden" back_button_callback="on_macros_back_clicked">
    <!-- Content Area -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="0"
            style_pad_bottom="#space_sm" scrollable="false" flex_flow="column" style_pad_gap="0">
      <!-- Disable content when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- Status message (hidden when macros are present — C++ sets empty string) -->
      <text_small name="status_message"
                  width="100%" text="" bind_text="macros_status" style_text_align="center" hidden="true"/>
      <!-- Scrollable macro list -->
      <lv_obj name="macro_list"
              width="100%" flex_grow="1" scrollable="true" flex_flow="column" style_pad_gap="#space_xs"
              style_pad_top="0" style_pad_bottom="0">
        <!-- Hide the list when there are no rows so the empty_state gets the
             full content area (not a 50/50 split of two flex_grow=1 siblings). -->
        <bind_flag_if_eq subject="macro_row_count" flag="hidden" ref_value="0"/>
        <!-- Rows container: sole child is the reactive repeat. The repeat
             MUST be the only/last child here — rebuilt rows are appended
             to the end of their parent container. -->
        <lv_obj name="rows_container" width="100%" height="content" flex_flow="column" style_pad_row="#space_xs">
          <repeat count="macro_row_count">
            <macro_card name_subject="macro_name_${i}"
                        desc_subject="macro_desc_${i}" visible_subject="macro_visible_${i}"
                        desc_hidden_subject="macro_desc_hidden_${i}" chevron_hidden_subject="macro_chevron_hidden_${i}"
                        defaults_hidden_subject="macro_defaults_hidden_${i}" row_index="${i}"/>
          </repeat>
        </lv_obj>
      </lv_obj>
      <!-- Empty state (shown when no macros available) -->
      <lv_obj name="empty_state"
              width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_md" hidden="true"
              scrollable="false">
        <bind_flag_if_not_eq subject="macro_row_count" flag="hidden" ref_value="0"/>
        <icon src="code_tags" size="xl" variant="secondary"/>
        <text_heading width="content" text="No Macros Found" translation_tag="No Macros Found" style_text_align="center"/>
        <text_muted width="content"
                    text="Define macros in your printer.cfg" translation_tag="Define macros in your printer.cfg"
                    style_text_align="center"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
