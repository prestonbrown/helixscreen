<!-- Calibration screen: a tile per calibration step, in the calibration catalog's run
     order (calibration_catalog.cpp#kSteps). Each tile shows only where the catalog finds
     its step on this printer, says when it last ran, and opens the step's own screen.
     CalibrationHubOverlay publishes the subjects on every open. -->
<component>
  <styles>
    <style name="tiles_standard" pad_row="#space_sm"/>
    <style name="tiles_micro" pad_row="#space_xxs"/>
  </styles>
  <view name="calibration_hub_overlay" extends="overlay_panel" title="Calibration" bg_color="#screen_bg">
    <overlay_panel-overlay_content style_pad_top="0"
                                   style_pad_left="#space_md" style_pad_right="#space_md" style_pad_bottom="#space_md"
                                   scrollable="true" flex_flow="column">
      <lv_obj name="calibration_tiles"
              width="100%" height="content" style_pad_all="0" style_pad_column="#space_sm" flex_flow="row_wrap"
              scrollable="false">
        <bind_style_if name="tiles_standard" cond="ui_breakpoint gt 0"/>
        <bind_style_if name="tiles_micro" cond="ui_breakpoint eq 0"/>
        <calibration_hub_tile name="cal_tile_belt_tension"
                              step="belt_tension" icon="vibrate" label="Belt tension"
                              callback="on_belt_tension_auto_clicked"/>
        <calibration_hub_tile name="cal_tile_cutter"
                              step="cutter" icon="content_cut" label="Cutter position"
                              callback="on_cutter_calibration_clicked"/>
        <calibration_hub_tile name="cal_tile_z_offset"
                              step="z_offset" icon="z_closer" label="Z offset" callback="on_zoffset_row_clicked"/>
        <calibration_hub_tile name="cal_tile_heaters"
                              step="heaters" icon="heater" label="Heaters" callback="on_pid_tuning_clicked"/>
        <calibration_hub_tile name="cal_tile_bed_mesh"
                              step="bed_mesh" icon="grid_large" label="Bed mesh" callback="on_calibration_bed_mesh"/>
        <calibration_hub_tile name="cal_tile_input_shaper"
                              step="input_shaper" icon="inputshaper" label="Input shaper"
                              callback="on_input_shaper_row_clicked"/>
        <calibration_hub_tile name="cal_tile_pressure_advance"
                              step="pressure_advance" icon="gauge" label="Pressure advance" callback="on_calibration_pa"/>
        <calibration_hub_tile name="cal_tile_belt_compare"
                              step="belt_compare" icon="vibrate" label="Belt compare"
                              callback="on_belt_tension_row_clicked"/>
        <calibration_hub_tile name="cal_tile_bed_screws"
                              step="bed_screws" icon="grid_large" label="Bed screws"
                              callback="on_screws_tilt_row_clicked"/>
        <calibration_hub_tile name="cal_tile_tool_offsets"
                              step="tool_offsets" icon="axis_arrow" label="Tool offsets"
                              callback="on_tool_offset_row_clicked"/>
        <calibration_hub_tile name="cal_tile_vertical_artifact"
                              step="vertical_artifact" icon="sine_wave" label="Vertical artifact compensation"
                              callback="on_stepper_resonance_cal_clicked"/>
        <calibration_hub_tile name="cal_tile_pa_tuning"
                              step="pa_tuning" icon="gauge" label="Pressure advance tuning"
                              callback="on_pa_tuning_clicked"/>
        <calibration_hub_tile name="cal_tile_vibration_check"
                              step="vibration_check" icon="vibrate" label="Vertical artifact check"
                              callback="on_motor_ripple_row_clicked"/>
      </lv_obj>
    </overlay_panel-overlay_content>
  </view>
</component>
