<component>
  <api>
    <prop name="spool_id" type="int" default="0"/>
  </api>
  <!-- Full-screen backdrop overlay - tap to dismiss -->
  <view name="context_backdrop" extends="context_menu_backdrop">
    <!-- Context menu card - positioned by C++. The header carries the spool's
         vendor and material (e.g. "Polymaker PLA"); the filament-name subtitle sits
         between it and the rule, so the card's own rule is suppressed. -->
    <context_menu_card width="220"
                       title_subject="spoolman_menu_header" title_name="spool_header" title_grow="1"
                       title_long_mode="dots" hide_divider="true">
      <!-- Filament name (e.g., "PLA Matte Charcoal"), hidden when Spoolman has none -->
      <text_small name="spool_color_label"
                  width="100%" bind_text="spoolman_menu_filament" long_mode="dots" style_text_color="#text_muted">
        <bind_flag_if_eq subject="spoolman_menu_filament_shown" flag="hidden" ref_value="0"/>
      </text_small>
      <!-- Header Divider -->
      <lv_obj width="100%"
              height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"/>
      <!-- Set Active Button -->
      <ui_button name="btn_set_active"
                 width="100%" height="#button_height_sm" icon="check_circle" text="Set Active" variant="ghost"
                 clickable="true" focusable="false" style_flex_main_place="start">
        <event_cb trigger="clicked" callback="spoolman_context_set_active_cb"/>
      </ui_button>
      <!-- Edit Button -->
      <ui_button name="btn_edit"
                 width="100%" height="#button_height_sm" icon="pencil" text="Edit" variant="ghost" clickable="true"
                 focusable="false" style_flex_main_place="start">
        <event_cb trigger="clicked" callback="spoolman_context_edit_cb"/>
      </ui_button>
      <!-- Print Label Button -->
      <ui_button name="btn_print_label"
                 width="100%" height="#button_height_sm" icon="print" text="Print Label" variant="ghost"
                 clickable="true" focusable="false" style_flex_main_place="start">
        <event_cb trigger="clicked" callback="spoolman_context_print_label_cb"/>
      </ui_button>
      <!-- Duplicate Button -->
      <ui_button name="btn_duplicate"
                 width="100%" height="#button_height_sm" icon="content_copy" text="Duplicate" variant="ghost"
                 clickable="true" focusable="false" style_flex_main_place="start">
        <event_cb trigger="clicked" callback="spoolman_context_duplicate_cb"/>
      </ui_button>
      <!-- Archive Button -->
      <ui_button name="btn_archive"
                 width="100%" height="#button_height_sm" icon="archive_arrow_down" text="Archive" variant="ghost"
                 clickable="true" focusable="false" style_flex_main_place="start">
        <bind_flag_if_eq subject="spoolman_menu_archive_shown" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="spoolman_context_archive_cb"/>
      </ui_button>
      <!-- Divider before destructive action -->
      <lv_obj width="100%"
              height="1" style_bg_color="#text_muted" style_bg_opa="38" style_pad_all="0" scrollable="false"/>
      <!-- Delete Button -->
      <ui_button name="btn_delete"
                 width="100%" height="#button_height_sm" icon="delete" text="Delete" variant="ghost" clickable="true"
                 focusable="false" style_flex_main_place="start" style_text_color="#danger">
        <event_cb trigger="clicked" callback="spoolman_context_delete_cb"/>
      </ui_button>
      <!-- Plugin items for this spool (a divider, then each plugin's group), filled
           by C++; empty when no enabled plugin declares a spool item. -->
      <lv_obj name="plugin_rows"
              width="100%" height="content" flex_flow="column" style_pad_all="0" style_pad_gap="0" style_bg_opa="0"
              style_border_width="0" scrollable="false"/>
    </context_menu_card>
  </view>
</component>
