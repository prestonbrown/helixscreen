<!-- Spoolman Settings Overlay Panel -->
<!-- Configures Spoolman integration (sync, polling) and label printer settings -->
<component>
  <styles>
    <!-- The setup status line's color; bound, so no inline color outranks it -->
    <style name="setup_status_muted" text_color="#text_muted"/>
    <style name="setup_status_error" text_color="#danger"/>
  </styles>
  <view name="spoolman_settings" extends="overlay_panel" title="Spoolman" bg_color="#screen_bg">
    <!-- Content Area (scrollable) -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
            style_pad_bottom="#space_lg" scrollable="true" flex_flow="column">
      <!-- Description text -->
      <text_small name="description"
                  width="100%" text="Configure Spoolman integration and weight sync settings."
                  style_pad_left="#space_md" style_pad_right="#space_md" style_pad_bottom="#space_sm"/>
      <setting_group name="group_server">
        <!-- ================================================================== -->
        <!-- Server Setup (shown when Spoolman NOT configured, or while the      -->
        <!-- user changes the configured server)                               -->
        <!-- ================================================================== -->
        <lv_obj name="setup_card"
                width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_ver="#space_md"
                style_pad_hor="#space_lg" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
          <bind_flag_if cond="printer_has_spoolman eq 1 and spoolman_setup_editing eq 0" flag="hidden"/>
          <text_body text="Server Setup"/>
          <text_small text="Enter the IP address and port of your Spoolman server." style_text_color="#text_muted"/>
          <!-- Host + Port inputs side by side -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
            <lv_obj height="content"
                    flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
              <text_small text="IP Address / Hostname"/>
              <text_input name="spoolman_host_input" width="100%" placeholder_text="192.168.1.100" max_length="64"/>
            </lv_obj>
            <lv_obj width="80"
                    height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
              <text_small text="Port"/>
              <text_input name="spoolman_port_input"
                          width="100%" placeholder_text="7912" max_length="5" keyboard_hint="numeric" text="7912"/>
            </lv_obj>
          </lv_obj>
          <!-- Status text (for errors/progress); red for an error -->
          <text_small name="setup_status_text" width="100%" bind_text="spoolman_setup_status">
            <bind_style name="setup_status_muted" subject="spoolman_setup_status_error" ref_value="0"/>
            <bind_style name="setup_status_error" subject="spoolman_setup_status_error" ref_value="1"/>
          </text_small>
          <!-- Action buttons -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
            <ui_button name="connect_btn" variant="primary" flex_grow="1" text="Connect">
              <event_cb trigger="clicked" callback="on_spoolman_connect_clicked"/>
            </ui_button>
            <ui_button name="cancel_setup_btn" variant="outline" flex_grow="1" text="Cancel">
              <event_cb trigger="clicked" callback="on_spoolman_cancel_setup_clicked"/>
            </ui_button>
          </lv_obj>
        </lv_obj>
        <!-- ================================================================== -->
        <!-- Server Status (shown when Spoolman IS configured)                   -->
        <!-- ================================================================== -->
        <lv_obj name="status_card"
                width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_ver="#space_md"
                style_pad_hor="#space_lg" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
          <bind_flag_if cond="printer_has_spoolman eq 0 or spoolman_setup_editing eq 1" flag="hidden"/>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center" scrollable="false">
            <text_body text="Spoolman Server"/>
            <lv_obj height="content"
                    style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs"
                    scrollable="false">
              <text_small name="server_url_text" bind_text="spoolman_server_url" style_text_color="#text_muted"/>
              <icon src="check_circle" size="sm" color="#success"/>
            </lv_obj>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
            <ui_button name="change_btn" variant="outline" flex_grow="1" text="Change">
              <event_cb trigger="clicked" callback="on_spoolman_change_clicked"/>
            </ui_button>
            <ui_button name="remove_btn"
                       variant="outline" style_border_color="#danger" style_text_color="#danger" flex_grow="1"
                       text="Remove">
              <event_cb trigger="clicked" callback="on_spoolman_remove_clicked"/>
            </ui_button>
          </lv_obj>
        </lv_obj>
      </setting_group>
      <!-- ================================================================== -->
      <!-- Sync Settings                                                       -->
      <!-- ================================================================== -->
      <setting_group name="group_weight_sync">
        <setting_group_header title="WEIGHT SYNC"/>
        <lv_obj name="sync_card"
                width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_ver="#space_md"
                style_pad_hor="#space_lg" flex_flow="row" style_flex_cross_place="center" style_pad_gap="0"
                scrollable="false">
          <bind_flag_if_eq subject="printer_has_spoolman" flag="hidden" ref_value="0"/>
          <!-- Sync toggle -->
          <lv_obj height="content"
                  flex_grow="1" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center" scrollable="false">
            <lv_obj height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
              <text_body text="Sync with Spoolman"/>
              <text_small text="Auto-poll for weight updates"/>
            </lv_obj>
            <ui_switch name="sync_toggle" size="small">
              <bind_state_if_eq subject="ams_spoolman_sync_enabled" state="checked" ref_value="1"/>
              <event_cb trigger="value_changed" callback="on_ams_spoolman_sync_toggled"/>
            </ui_switch>
          </lv_obj>
          <!-- Vertical divider -->
          <divider_vertical style_margin_left="#space_md" style_margin_right="#space_md"/>
          <!-- Refresh interval -->
          <lv_obj height="content"
                  flex_grow="1" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  style_flex_cross_place="center" scrollable="false">
            <text_body text="Refresh Interval"/>
            <lv_dropdown name="interval_dropdown"
                         width="100" height="36" options="30s&#10;1 min&#10;2 min&#10;5 min"
                         options_tag="30s&#10;1 min&#10;2 min&#10;5 min" style_pad_left="#space_sm"
                         style_pad_right="#space_sm">
              <event_cb trigger="value_changed" callback="on_ams_spoolman_interval_changed"/>
            </lv_dropdown>
          </lv_obj>
        </lv_obj>
        <!-- SPOOL SWITCHING PER TOOL AND LANE: the plugin's filament_accounting feature -->
        <lv_obj name="container_filament_accounting"
                width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                scrollable="false">
          <bind_flag_if_eq subject="printer_has_spoolman" flag="hidden" ref_value="0"/>
          <plugin_feature_toggle_row name="row_filament_accounting"
                                     feature="filament_accounting" label="Switch spools at each tool change"
                                     description="Makes Spoolman charge each tool's or lane's own spool, for printers that do not switch it themselves, and records per print what each spool used."
                                     subject="plugin_feature_on_filament_accounting"
                                     callback="on_plugin_feature_switch_changed"/>
        </lv_obj>
        <!-- ================================================================== -->
        <!-- Info Note                                                          -->
        <!-- ================================================================== -->
        <lv_obj name="info_note"
                width="100%" height="content" style_pad_all="#space_sm" style_pad_left="#space_lg"
                style_pad_right="#space_lg" flex_flow="row" style_flex_main_place="start"
                style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
          <bind_flag_if_eq subject="printer_has_spoolman" flag="hidden" ref_value="0"/>
          <icon src="info" size="sm" variant="secondary"/>
          <text_small width="100%"
                      flex_grow="1"
                      text="Weight data is synced from Spoolman to display remaining filament. Changes are also synced when prints start, pause, or complete."
                      style_text_color="#text_muted"/>
        </lv_obj>
      </setting_group>
      <!-- ================================================================== -->
      <!-- Label Printer + Barcode Scanner (open sub-panels)                  -->
      <!-- ================================================================== -->
      <setting_group name="group_devices">
        <setting_group_header title="DEVICES"/>
        <setting_action_row name="row_label_printer"
                            label="Label Printer" icon="print" description="Configure label printer and auto-discovery"
                            callback="on_spoolman_label_printer_clicked">
          <!-- Hidden on the v1 (ESP32/K-Touch) cut — no label printer. Desktop
               (platform_extras_available==1) renders it exactly as before. -->
          <bind_flag_if_eq subject="platform_extras_available" flag="hidden" ref_value="0"/>
        </setting_action_row>
        <setting_action_row name="row_barcode_scanner"
                            label="Barcode Scanner" icon="qrcode_scan" bind_description="scanner_device_status"
                            callback="on_barcode_scanner_clicked">
          <!-- Hidden on the v1 (ESP32/K-Touch) cut — no barcode scanner. Desktop
               (platform_extras_available==1) renders it exactly as before. -->
          <bind_flag_if_eq subject="platform_extras_available" flag="hidden" ref_value="0"/>
        </setting_action_row>
      </setting_group>
    </lv_obj>
  </view>
</component>
