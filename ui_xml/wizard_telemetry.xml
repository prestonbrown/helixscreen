<component>
  <!-- First-Run Wizard: Updates & Data (preset mode only). The update channel shares its
       row and callback with Settings > Updates, the statistics opt-in its row with the
       Review step. -->
  <consts>
    <str name="step_title" value="Updates &amp; Data" value_tag="Updates &amp; Data"/>
    <str name="step_subtitle"
         value="Choose which releases to get, and whether to share anonymous statistics."
         value_tag="Choose which releases to get, and whether to share anonymous statistics."/>
  </consts>

  <view name="wizard_telemetry_root"
        extends="lv_obj" width="100%" height="100%" style_bg_opa="0" style_border_width="0" style_pad_all="0"
        flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center">
    <ui_card width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" scrollable="true">
      <update_channel_rows/>
      <telemetry_opt_in_row/>
    </ui_card>
  </view>
</component>
