<!-- PROTOTYPE (design mockup): the Filament System Error for a lane that could
     not load because another lane's strand still sits in the hub. The body names
     the situation, then gives a jog row for the lane IN the hub (its swatch, the
     step, Retract / Feed) and the hub sensor's live state. "Load T1 and Resume"
     waits on the hub reading clear (mock_hub_clear). -->
<component>
  <styles>
    <style name="plain_row" width="100%" height="content" pad_all="0" bg_opa="0" border_width="0"/>
    <style name="jog_card"
           bg_color="#screen_bg" bg_opa="255" border_width="1" border_color="#border" radius="#border_radius"
           pad_all="#space_sm"/>
  </styles>
  <view name="mock_lane_hub_recovery_modal"
        extends="dialog_frame" width="80%" title="Filament System Error" icon="alert_octagon" icon_variant="danger">
    <dialog_frame-body style_pad_gap="#space_sm" scrollable="false">
      <text_body name="dialog_message"
                 width="100%" text="lane1 couldn't load: lane0's filament is still in the hub." style_text_align="left"
                 long_mode="wrap">
        <bind_flag_if_eq subject="mock_hub_clear" flag="hidden" ref_value="1"/>
      </text_body>
      <text_body name="dialog_message_clear"
                 width="100%" text="The hub is clear. lane1 can load now." style_text_align="left" long_mode="wrap">
        <bind_flag_if_eq subject="mock_hub_clear" flag="hidden" ref_value="0"/>
      </text_body>
      <!-- The lane in the hub: who it is, what the hub sensor reads now, and a jog to clear it. -->
      <lv_obj name="hub_lane_card" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
        <style name="plain_row"/>
        <style name="jog_card"/>
        <lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
          <style name="plain_row"/>
          <color_swatch color="0xE53935" clickable="false" size="#space_xl" hit="0" reach="0"/>
          <text_body width="0" flex_grow="1" text="lane0" long_mode="dots"/>
          <status_pill name="hub_state_blocked" text="Hub: filament" variant="warning">
            <bind_flag_if_eq subject="mock_hub_clear" flag="hidden" ref_value="1"/>
          </status_pill>
          <status_pill name="hub_state_clear" text="Hub: clear" variant="success">
            <bind_flag_if_eq subject="mock_hub_clear" flag="hidden" ref_value="0"/>
          </status_pill>
        </lv_obj>
        <lv_obj name="jog_row"
                flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
          <style name="plain_row"/>
          <z_adjust_steps name="jog_steps"
                          width="0" flex_grow="3" subject="mock_jog_step" callback="on_mock_jog_step" text0="5 mm"
                          text1="10 mm" text2="20 mm" chip3_hidden="true" two_rows="false" chip_h="#cal_button_h"/>
          <ui_button name="btn_jog_retract"
                     width="0" height="#cal_button_h" flex_grow="1" style_min_width="content" style_pad_hor="#space_sm"
                     icon="arrow_up" text="Retract" style_text_font="#font_small">
            <event_cb trigger="clicked" callback="on_mock_lane_retract"/>
          </ui_button>
          <ui_button name="btn_jog_feed"
                     width="0" height="#cal_button_h" flex_grow="1" style_min_width="content" style_pad_hor="#space_sm"
                     icon="arrow_down" text="Feed" style_text_font="#font_small">
            <event_cb trigger="clicked" callback="on_mock_lane_feed"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
    </dialog_frame-body>
    <dialog_frame-footer>
      <!-- lane1's path: stopped short of the hub. Dropped at the smallest size,
           where the jog row needs the height. -->
      <lv_obj width="100%"
              height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="0"
              style_pad_bottom="#space_md" style_bg_opa="0" style_border_width="0" scrollable="false">
        <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
        <fault_path name="fault_path"/>
      </lv_obj>
      <modal_button_row primary_text="Load T1 and Resume"
                        primary_enable_subject="mock_hub_clear" secondary_text="Eject lane0"
                        secondary_variant="secondary" tertiary_text="Recover" tertiary_variant="danger"
                        hide_tertiary="false"/>
    </dialog_frame-footer>
  </view>
</component>
