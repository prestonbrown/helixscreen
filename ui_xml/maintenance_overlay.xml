<!-- Maintenance overlay, opened from the maintenance home tile. A card per enabled meter:
     its ring with the time left, its name, a line saying what the job is, and the hours
     used. A tap opens the meter's task page. Two columns from MEDIUM up, one below it. The
     total print time and the way to the reminder intervals follow. Everything binds
     maintenance_model's subjects (src/ui/panel_widgets/maintenance_model.h). -->
<component>
  <styles>
    <style name="mt_font_small" text_font="#font_small"/>
    <style name="mt_card_half" width="49%"/>
    <style name="mt_card_full" width="100%"/>
  </styles>
  <view name="maintenance_overlay" extends="overlay_panel" title="Maintenance" bg_color="#screen_bg">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
            style_pad_bottom="#space_xs" style_pad_row="#space_xs" scrollable="true" flex_flow="column">
      <lv_obj name="mt_cards"
              width="100%" height="content" style_pad_hor="#space_lg" style_pad_ver="0" style_pad_gap="#space_sm"
              flex_flow="row_wrap" scrollable="false" style_bg_opa="0" style_border_width="0">
        <repeat count="7">
          <lv_obj name="mt_cell_${i}"
                  height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
            <bind_style_if_ge name="mt_card_half" subject="ui_breakpoint" ref_value="3"/>
            <bind_style_if_lt name="mt_card_full" subject="ui_breakpoint" ref_value="3"/>
            <bind_flag_if_eq subject="maintenance_m${i}_on" flag="hidden" ref_value="0"/>
            <ui_card name="mt_card_${i}"
                     width="100%" height="content" flex_flow="row" style_pad_all="#space_sm"
                     style_pad_column="#space_md" style_flex_cross_place="center" scrollable="false" clickable="true"
                     style_pad_ver="#space_xxs">
              <event_cb trigger="clicked" callback="maintenance_card_cb" user_data="$i"/>
              <style name="styles.press_wash" selector="pressed"/>
              <pass_through name="mt_card_dial_${i}" width="#button_height_lg" height="#button_height_lg">
                <helix_progress_arc name="mt_card_ring_${i}"
                                    width="100%" height="100%" align="center" bind_value="maintenance_m${i}_pct"
                                    bg_start_angle="270" bg_end_angle="269" start_angle="270" end_angle="270"
                                    style_arc_width="#space_xs" style_arc_width-indicator="#space_xs" clickable="false"
                                    event_bubble="true">
                  <bind_style_if_eq name="styles.maint_arc_warn"
                                    subject="maintenance_m${i}_status" ref_value="1" selector="indicator"/>
                  <bind_style_if_eq name="styles.maint_arc_danger"
                                    subject="maintenance_m${i}_status" ref_value="2" selector="indicator"/>
                </helix_progress_arc>
                <text_tiny name="mt_card_left_${i}"
                           align="center" bind_text="maintenance_m${i}_left" clickable="false" event_bubble="true">
                  <bind_style_if_ge name="mt_font_small" subject="ui_breakpoint" ref_value="2"/>
                  <bind_style_if_eq name="styles.maint_text_warn" subject="maintenance_m${i}_status" ref_value="1"/>
                  <bind_style_if_eq name="styles.maint_text_danger" subject="maintenance_m${i}_status" ref_value="2"/>
                </text_tiny>
              </pass_through>
              <pass_through width="0" height="content" flex_grow="1" flex_flow="column" style_pad_row="#space_xxs">
                <pass_through width="100%"
                              height="content" flex_flow="row" style_pad_column="#space_xs"
                              style_flex_cross_place="center">
                  <text_body name="mt_card_name_${i}"
                             width="0" flex_grow="1" bind_text="maintenance_m${i}_name" long_mode="dots"
                             clickable="false" event_bubble="true"/>
                  <text_small name="mt_card_line_${i}"
                              bind_text="maintenance_m${i}_line" style_text_color="#text_muted" clickable="false"
                              event_bubble="true"/>
                </pass_through>
                <text_small name="mt_card_desc_${i}"
                            width="100%" bind_text="maintenance_m${i}_desc" style_text_color="#text_muted"
                            long_mode="dots" clickable="false" event_bubble="true"/>
              </pass_through>
            </ui_card>
          </lv_obj>
        </repeat>
      </lv_obj>
      <lv_obj width="100%"
              height="content" style_pad_hor="#space_lg" style_pad_ver="0" flex_flow="row"
              style_flex_main_place="space_between" style_flex_cross_place="center" scrollable="false" style_bg_opa="0"
              style_border_width="0">
        <text_small name="mt_total" bind_text="maintenance_total_text" style_text_color="#text_muted"/>
        <ui_button name="mt_open_intervals"
                   width="content" height="#button_height_sm" variant="outline" text="Reminder intervals">
          <event_cb trigger="clicked" callback="maintenance_intervals_cb"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
  </view>
</component>
