<component>
  <!-- Print status "More": each row keeps the visibility rule its strip button had -->
  <view name="print_status_more_menu" extends="context_menu_backdrop">
    <context_menu_card title="More" pad_gap="#space_xs">
      <ui_button name="btn_more_camera"
                 height="#button_height_sm" icon="webcam" text="Camera" variant="ghost" style_flex_main_place="start">
        <bind_flag_if_eq subject="print_status_camera_available" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="print_status_more_camera_cb"/>
      </ui_button>
      <ui_button name="btn_more_timelapse"
                 height="#button_height_sm" bind_icon="timelapse_button_icon" text="Timelapse" variant="ghost"
                 style_flex_main_place="start">
        <bind_flag_if_not_eq subject="timelapse_owner" flag="hidden" ref_value="1"/>
        <event_cb trigger="clicked" callback="print_status_more_timelapse_cb"/>
      </ui_button>
      <ui_button name="btn_more_light"
                 height="#button_height_sm" bind_icon="light_button_icon" text="Light" variant="ghost"
                 style_flex_main_place="start">
        <bind_flag_if_eq subject="led_controllable" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="print_status_more_light_cb"/>
      </ui_button>
    </context_menu_card>
  </view>
</component>
