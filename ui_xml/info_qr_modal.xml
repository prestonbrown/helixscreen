<component>
  <api>
    <prop name="icon_name" type="string" default="info"/>
    <prop name="title" type="string" default=""/>
    <prop name="message" type="string" default=""/>
    <prop name="url_text" type="string" default=""/>
    <slot name="qr" target="qr_frame"/>
  </api>
  <!-- Reusable info modal with QR code: backdrop created by Modal system -->
  <view name="info_qr_modal" extends="dialog_frame" width="75%" title="$title" icon="$icon_name">
    <dialog_frame-body style_flex_cross_place="center">
      <text_body width="100%" text="$message" long_mode="wrap" style_text_align="left"/>
      <qr_frame name="qr_frame"/>
      <text_small width="100%"
                  text="$url_text" long_mode="wrap" style_text_align="center" style_text_color="#text_muted"/>
    </dialog_frame-body>
    <dialog_frame-footer>
      <modal_button_row hide_secondary="true"
                        primary_name="btn_ok" primary_text="OK" primary_callback="on_modal_ok_clicked"/>
    </dialog_frame-footer>
  </view>
</component>
