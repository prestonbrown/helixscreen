<component>
  <api>
    <prop name="icon_name" type="string" default="info"/>
    <prop name="title" type="string" default=""/>
    <prop name="message" type="string" default=""/>
    <prop name="url_text" type="string" default=""/>
    <slot name="qr" target="qr_frame"/>
  </api>
  <!-- Reusable info modal with QR code — backdrop created by Modal system -->
  <view name="info_qr_modal"
        extends="ui_dialog" width="75%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <!-- Content area -->
    <lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg"
            style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_md">
      <!-- Title row: icon + heading on same line to save vertical space -->
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
        <icon src="$icon_name" size="md" variant="primary"/>
        <text_heading text="$title"/>
      </lv_obj>
      <text_body width="100%" text="$message" long_mode="wrap" style_text_align="center"/>
      <qr_frame name="qr_frame"/>
      <text_small text="$url_text" style_text_color="#text_muted"/>
    </lv_obj>
    <modal_button_row hide_secondary="true"
                      primary_name="btn_ok" primary_text="OK" primary_callback="on_modal_ok_clicked"/>
  </view>
</component>
