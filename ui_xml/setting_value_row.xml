<!-- A setting edited as a number: a label, an optional description (static, or
     bound to a subject), an optional marker icon, and a value field that opens
     the numeric keypad. user_data names the setting to the callback.
     Usage:
       <setting_value_row label="Printer power" description="Average draw while printing, in watts"
                          value_subject="print_cost_watts" callback="on_print_cost_field_clicked" user_data="watts"/>
       <setting_value_row label="PLA" bind_description="material_zoffset_temp_pla"
                          marker_icon="grid_large" marker_subject="material_zoffset_mesh_pla"
                          value_subject="material_zoffset_value_pla" callback="on_material_zoffset_field_clicked"
                          user_data="PLA"/> -->
<component>
  <api>
    <prop name="label" type="string" default=""/>
    <prop name="description" type="string" default=""/>
    <!-- Subject whose text is the description, shown muted, e.g. a material's bed temperature -->
    <prop name="bind_description" type="string" default=""/>
    <!-- Icon shown before the field while marker_subject is non-zero; no marker without a subject -->
    <prop name="marker_icon" type="string" default=""/>
    <prop name="marker_subject" type="string" default=""/>
    <prop name="value_subject" type="string" default=""/>
    <prop name="callback" type="string" default=""/>
    <prop name="user_data" type="string" default=""/>
  </api>
  <styles>
    <style name="pad_standard"
           pad_left="#space_lg" pad_right="#space_lg" pad_top="#space_md" pad_bottom="#space_md" pad_gap="#space_sm"/>
    <style name="pad_micro"
           pad_left="#space_md" pad_right="#space_md" pad_top="#space_sm" pad_bottom="#space_sm" pad_gap="#space_sm"/>
  </styles>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_main_place="space_between"
        style_flex_cross_place="center" style_bg_opa="0" style_border_width="0" scrollable="false">
    <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
    <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
    <lv_obj width="0"
            height="content" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs"
            scrollable="false">
      <text_body width="100%" text="$label" long_mode="wrap"/>
      <text_small width="100%" text="$description" long_mode="wrap" hidden_if_empty="$description"/>
      <text_small width="100%"
                  bind_text="$bind_description" long_mode="wrap" style_text_color="#text_muted"
                  hidden_if_empty="$bind_description"/>
    </lv_obj>
    <icon src="$marker_icon" size="sm" variant="muted" clickable="false" hidden_if_empty="$marker_subject">
      <bind_flag_if_eq subject="$marker_subject" flag="hidden" ref_value="0"/>
    </icon>
    <setting_value_field value_subject="$value_subject" callback="$callback" user_data="$user_data"/>
  </view>
</component>
