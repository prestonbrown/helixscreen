<!-- One LED macro device in LED Settings: name, type and edit/delete buttons,
     then either its summary or, for the device being edited, its edit form.
     LedSettingsOverlay creates one per configured device and sets the name and
     summary, which are user text: as props a leading '#' would read as a const. -->
<component>
  <api>
    <prop name="index" type="int" default="0"/>
    <prop name="type_label" type="string" default=""/>
    <prop name="editing" type="int" default="0"/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="column" style_bg_color="#card_bg" style_bg_opa="cover" style_radius="8"
        style_pad_all="#space_md" style_border_width="1" style_border_color="#border" style_pad_gap="#space_sm"
        scrollable="false">
    <lv_obj name="macro_header_row"
            width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
            style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" scrollable="false">
      <text_body name="macro_device_name" text=""/>
      <text_body name="macro_type_badge" text="$type_label" style_text_color="#text_subtle"/>
      <lv_obj height="1" flex_grow="1" style_bg_opa="0" style_border_width="0" style_pad_all="0" scrollable="false"/>
      <lv_button name="macro_edit_btn_${index}"
                 width="#icon_button_size_lg" height="#icon_button_size_lg" style_bg_opa="0" style_border_width="0">
        <icon src="pencil" size="sm" variant="tertiary"/>
        <event_cb trigger="clicked" callback="led_macro_edit_cb" user_data="$index"/>
      </lv_button>
      <lv_button name="macro_delete_btn_${index}"
                 width="#icon_button_size_lg" height="#icon_button_size_lg" style_bg_opa="0" style_border_width="0">
        <icon src="delete" size="sm" variant="secondary"/>
        <event_cb trigger="clicked" callback="led_macro_delete_cb" user_data="$index"/>
      </lv_button>
    </lv_obj>
    <if cond="${editing} eq 1">
      <led_macro_edit_form index="$index"/>
      <else/>
      <text_body name="macro_summary" width="100%" text="" long_mode="wrap" style_text_color="#text_subtle"/>
    </if>
  </view>
</component>
