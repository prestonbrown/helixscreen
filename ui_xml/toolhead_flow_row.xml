<component>
  <!-- A head's flow type, on printers that have flow variants. Dims while a print runs. -->
  <api>
    <prop name="options" type="string" default=""/>
    <prop name="options_tag" type="string" default=""/>
  </api>
  <view name="toolhead_flow_row"
        extends="setting_dropdown_row" label="Flow type" icon="heater"
        description="Standard or High Flow, as fitted to this head" options="$options" options_tag="$options_tag"
        disabled="print_in_progress" callback="on_toolhead_flow_changed"/>
</component>
