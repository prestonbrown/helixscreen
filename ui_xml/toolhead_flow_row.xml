<component>
  <!-- A head's flow type, on printers that have flow variants. -->
  <api>
    <prop name="options" type="string" default=""/>
    <prop name="options_tag" type="string" default=""/>
    <prop name="disabled" type="string" default=""/>
  </api>
  <view name="toolhead_flow_row"
        extends="setting_dropdown_row" label="Flow type" icon="heater" options="$options" options_tag="$options_tag"
        disabled="$disabled" callback="on_toolhead_flow_changed" hide_description="true"/>
</component>
