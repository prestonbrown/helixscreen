<!-- Fan Control Overlay: Full-width overlay panel displaying all fans -->
<!-- Single flex-wrap row: controllable fans first, then auto-controlled fans -->
<component>
  <api>
    <prop name="title" type="string" default="All Fans"/>
  </api>
  <view name="fan_control_overlay" extends="overlay_panel" title="$title" bg_color="#screen_bg">
    <!-- Main Content Area - minimal padding for maximum card space -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="0"
            style_pad_bottom="#space_sm" style_pad_row="0" scrollable="false" flex_flow="column"
            style_flex_main_place="start" style_flex_cross_place="center">
      <!-- Chamber air modes (helix::chamber_air): each button sends its mode.
           Hidden unless the printer offers at least one mode and any accessory
           the modes need is fitted (chamber_air_available). A printer that
           reports its active mode highlights it (chamber_air_mode: 0
           Recirculate, 1 Exhaust, 2 Off, -1 not reported); on one that does
           not, the buttons are plain actions. -->
      <lv_obj name="chamber_air_row"
              width="100%" height="content" style_pad_all="0" style_pad_bottom="#space_sm" style_pad_gap="#space_sm"
              scrollable="false" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
        <bind_flag_if cond="chamber_air_available eq 0 or (printer_has_chamber_air_recirculate eq 0 and printer_has_chamber_air_exhaust eq 0 and printer_has_chamber_air_off eq 0)"
                      flag="hidden"/>
        <text_body text="Chamber air"/>
        <!-- One choice of three, so one segmented control. -->
        <button_group name="chamber_air_modes">
          <button_group_item name="btn_chamber_air_recirculate"
                             icon="sync" text="Recirculate" variant="secondary" style_border_width="0">
            <bind_flag_if_eq subject="printer_has_chamber_air_recirculate" flag="hidden" ref_value="0"/>
            <bind_style_if_eq name="styles.choice_selected" subject="chamber_air_mode" ref_value="0"/>
            <bind_style_if name="styles.choice_idle" cond="chamber_air_mode ge 0 and chamber_air_mode ne 0"/>
            <event_cb trigger="clicked" callback="on_chamber_air_mode_clicked" user_data="recirculate"/>
          </button_group_item>
          <button_group_item name="btn_chamber_air_exhaust" icon="fan" text="Exhaust" variant="secondary">
            <bind_flag_if_eq subject="printer_has_chamber_air_exhaust" flag="hidden" ref_value="0"/>
            <bind_style_if_eq name="styles.choice_selected" subject="chamber_air_mode" ref_value="1"/>
            <bind_style_if name="styles.choice_idle" cond="chamber_air_mode ge 0 and chamber_air_mode ne 1"/>
            <event_cb trigger="clicked" callback="on_chamber_air_mode_clicked" user_data="exhaust"/>
          </button_group_item>
          <button_group_item name="btn_chamber_air_off" icon="fan_off" text="Off" variant="secondary">
            <bind_flag_if_eq subject="printer_has_chamber_air_off" flag="hidden" ref_value="0"/>
            <bind_style_if_eq name="styles.choice_selected" subject="chamber_air_mode" ref_value="2"/>
            <bind_style_if name="styles.choice_idle" cond="chamber_air_mode ge 0 and chamber_air_mode ne 2"/>
            <event_cb trigger="clicked" callback="on_chamber_air_mode_clicked" user_data="off"/>
          </button_group_item>
        </button_group>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- Single flex-wrap row for all fans (controllable first, then auto) -->
      <!-- ================================================================== -->
      <lv_obj name="fans_container"
              width="100%" flex_grow="1" style_pad_all="0" style_pad_gap="#space_md" scrollable="true"
              flex_flow="row_wrap" style_flex_main_place="center" style_flex_cross_place="start">
        <!-- All fan widgets (FanDial and fan_status_card) are created here dynamically by C++ -->
        <!-- Controllable fans are added first, then auto-controlled fans -->
      </lv_obj>
    </lv_obj>
  </view>
</component>
