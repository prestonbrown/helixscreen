<!-- Fan Status Card: Read-only arc display for auto-controlled fans (heater_fan, controller_fan) -->
<!-- Shows same visual style as fan_dial but non-interactive with muted gray indicator -->
<!-- Usage: <fan_status_card fan_name="Heater Fan" speed_percent="32"/> -->
<component>
  <api>
    <prop name="fan_name" type="string" default="Fan"/>
    <prop name="speed_percent" type="number" default="0"/>
    <!-- The card's speed line, a per-card subject FanControlOverlay publishes -->
    <prop name="speed_subject" type="string" default=""/>
  </api>
  <view name="fan_status_card_root"
        extends="ui_card" width="#fan_card_base_width" height="#fan_card_height" style_min_width="#fan_card_min_width"
        style_max_width="#fan_card_max_width" flex_flow="column" style_flex_main_place="start"
        style_flex_cross_place="center" style_pad_all="#space_sm" style_pad_gap="#space_xs" scrollable="false">
    <!-- Fan name label at top — non-clickable so long-press bubbles to card -->
    <text_small name="name_label" text="$fan_name" clickable="false" event_bubble="true"/>
    <!-- Arc display core - shared component, read-only with no knob by default -->
    <fan_arc_core initial_value="$speed_percent" speed_subject="$speed_subject"/>
    <!-- Auto indicator row (matches button row height) — non-clickable for event bubble -->
    <lv_obj name="auto_row"
            width="100%" height="#fan_btn_row_height" style_pad_all="0" scrollable="false" flex_flow="row"
            style_flex_main_place="center" style_flex_cross_place="center" clickable="false" event_bubble="true">
      <icon name="auto_icon" src="alpha_a_circle" size="sm" variant="secondary" clickable="false" event_bubble="true"/>
      <text_small text="Auto" style_pad_left="#space_xs" clickable="false" event_bubble="true"/>
    </lv_obj>
  </view>
</component>
