<component>
  <api>
    <prop name="message" type="string" default=""/>
  </api>
  <!-- Stepper resonance calibration on a printer whose routine runs with one
       chosen tool. The tool options and the message come from
       StepperResonanceCalModal. Backdrop created by the Modal system. -->
  <view name="stepper_resonance_cal_modal"
        extends="ui_dialog" width="70%" height="content" style_min_width="320" style_max_width="480"
        style_max_height="85%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0"
        scrollable="false">
    <lv_obj width="100%"
            height="content" style_max_height="#dialog_content_max" style_pad_left="#space_lg"
            style_pad_right="#space_lg" style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column"
            style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="true" scroll_snap_y="none">
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
        <icon src="sine_wave" size="md" variant="primary"/>
        <text_heading text="Vertical Artifact Compensation" long_mode="wrap" flex_grow="1"/>
      </lv_obj>
      <text_small width="100%" long_mode="wrap" text="$message" style_text_color="#text_muted" style_text_align="center"/>
      <text_small width="100%"
                  long_mode="wrap" style_text_color="#text_muted" style_text_align="center"
                  text="Afterwards, Vertical Artifact Check in this menu shows how much it helped."/>
      <lv_obj width="100%"
              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
              style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
        <text_body text="Tool" flex_grow="1"/>
        <lv_dropdown name="tool_dropdown" width="55%" style_radius="#border_radius"/>
      </lv_obj>
    </lv_obj>
    <modal_button_row primary_text="Start" secondary_text="Cancel" primary_moves_machine="true"/>
  </view>
</component>
