<component>
  <!-- Print File Detail View - Full overlay showing file details and print options -->
  <!-- Uses reactive subjects for file data (no API properties needed) -->
  <styles>
    <!-- Dim the chips, never the whole card. The header carries the mismatch
         and empty-slot lamps and the help cue, all of which still mean something
         when a remap is unavailable, and a card dimmed through LV_STATE_DISABLED
         also stops receiving touches. -->
    <style name="mapping_rows_unmappable" opa="128"/>
    <!-- Filament card shapes. Stacked: the FILAMENTS header on top, the chips
         on a row of their own under it. Inline (small portrait, where the
         preview and the options compete for one column): title, chips and the
         tap cue share ONE row, giving the chip row's height back to the
         options. Paired so every size is covered; inline width or flex_flow
         attributes on these widgets would win over the bound styles. -->
    <style name="fil_card_stacked" layout="flex" flex_flow="column"/>
    <style name="fil_card_inline" layout="flex" flex_flow="row" flex_cross_place="center"/>
    <style name="fil_head_stacked" width="100%"/>
    <style name="fil_head_inline" width="content"/>
    <style name="fil_chips_stacked" width="100%" flex_grow="0"/>
    <style name="fil_chips_inline" width="0" flex_grow="1"/>
    <!-- Landscape: preview column left, options column right. Portrait: the
         preview block on top, options below, both full width. Paired so each
         orientation is always covered; inline attributes would win over them.
         layout="flex" is required: a style carries only style properties, and
         the flex layout itself is installed by LV_STYLE_LAYOUT, which an
         inline flex_flow attribute sets as a side effect and a style does not. -->
    <style name="content_row" layout="flex" flex_flow="row"/>
    <style name="content_column" layout="flex" flex_flow="column"/>
    <style name="left_landscape" width="0" height="100%" flex_grow="5"/>
    <style name="left_portrait" width="100%" height="content" flex_grow="0"/>
    <style name="options_landscape" width="0" height="100%" flex_grow="4"/>
    <style name="options_portrait" width="100%" height="0" flex_grow="1"/>
    <style name="card_landscape" flex_grow="1"/>
    <style name="card_portrait" flex_grow="0"/>
    <!-- Portrait stacks the buttons under the preview, where the tall tier
         steals too much height from the options; landscape keeps it. The row
         carries the tier height so the buttons can fill it and the square
         delete width can match it. -->
    <style name="btn_row_landscape" height="#button_height_lg"/>
    <style name="btn_row_portrait" height="#button_height"/>
    <style name="delete_btn_landscape" width="#button_height_lg"/>
    <style name="delete_btn_portrait" width="#button_height"/>
    <!-- With a plugin declaring a print_file item the row is three square icon
         buttons (Delete, more, Print), centred; without one Print takes the rest
         of the row with its label. -->
    <style name="btn_row_icons" flex_main_place="center"/>
    <style name="print_btn_wide" flex_grow="1"/>
    <style name="print_btn_square_landscape" width="#button_height_lg" flex_grow="0"/>
    <style name="print_btn_square_portrait" width="#button_height" flex_grow="0"/>
  </styles>
  <view name="detail_view_root"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" style_bg_opa="255"
        style_bg_color="#card_bg" style_border_width="0" style_pad_all="0" style_pad_gap="0" flex_flow="column"
        clickable="true">
    <event_cb trigger="clicked" callback="on_print_select_detail_backdrop"/>
    <!-- CONTENT AREA (two columns in landscape, one stacked block in portrait) -->
    <lv_obj name="content_container"
            width="100%" flex_grow="1" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="0"
            style_pad_bottom="#space_lg" style_pad_gap="#space_md" scrollable="false">
      <bind_style_if_eq name="content_row" subject="ui_is_portrait" ref_value="0"/>
      <bind_style_if_eq name="content_column" subject="ui_is_portrait" ref_value="1"/>

      <!-- ================================================================== -->
      <!-- LEFT SECTION: Header + File card (5/9 width)                     -->
      <!-- Header is scoped to left column so right section extends to top  -->
      <!-- ================================================================== -->
      <lv_obj name="left_column"
              style_pad_all="0" style_pad_gap="0" flex_flow="column" style_margin_left="#space_sm" scrollable="false">
        <bind_style_if_eq name="left_landscape" subject="ui_is_portrait" ref_value="0"/>
        <bind_style_if_eq name="left_portrait" subject="ui_is_portrait" ref_value="1"/>
        <!-- HEADER BAR (left column only) -->
        <header_bar name="detail_header" title="Print File" back_button_callback="on_print_detail_back_clicked"/>
        <!-- File card with reactive bindings                                -->
        <!-- NOTE: Can't reuse print_file_card here because it uses props ($) -->
        <!-- for static data, but detail view needs bindings (bind_*) for     -->
        <!-- reactive updates when user selects different files.              -->
        <ui_card name="detail_card"
                 width="100%" style_radius="#border_radius" style_pad_all="0" style_clip_corner="true">
          <!-- Portrait height is measured in C++ (fit_portrait_preview): it
               depends on runtime pixel sizes of the scroll content below. -->
          <bind_style_if_eq name="card_landscape" subject="ui_is_portrait" ref_value="0"/>
          <bind_style_if_eq name="card_portrait" subject="ui_is_portrait" ref_value="1"/>
          <!-- Shared preview stack (thumbnail / 2D / 3D + rotate hint) - the same
               component print status uses, see components/preview_stack.xml.
               Here the two swap: the viewer stays hidden until it has real
               content on its canvas - the 2D ghost copy, or the first complete
               3D frame - and the thumbnail carries the wait, so both conditions
               key off detail_viewer_first_frame. A viewer left visible under an
               opaque thumbnail would be composited every frame for pixels
               nobody sees, which is the whole cost on a slow panel. Print
               status swaps on mode instead: it shows its render progressively
               as the print advances rather than waiting for a finished one. -->
          <preview_stack name="detail_preview_clear_area"
                         gradient_name="gradient_bg" viewer_name="detail_gcode_viewer" thumbnail_name="detail_thumbnail"
                         hint_name="detail_rotate_hint" thumbnail_src="selected_detail_thumbnail"
                         gradient_hidden="selected_has_thumbnail eq 0" thumbnail_offset_y="#preview_offset_y"
                         viewer_hidden="detail_viewer_hidden eq 1" thumbnail_hidden="detail_viewer_first_frame eq 1"
                         hint_hidden="detail_gcode_viewer_mode ne 1"/>
          <!-- Top-left of the preview: the skip-objects button (same component and
               corner as print status) and, beside it, the loading pill, shown while
               G-code downloads/indexes. The corner keeps the thumbnail readable, toasts
               (top-right) never cover it, and the metadata strip stays clear; the
               strip's own background keeps the text legible in either theme. The
               label carries the percentage whenever the streaming indexer can report
               one (a 133MB print spends over a minute in the index scan, and a bare
               spinner for that long reads as a hung app). The row itself takes no
               taps, so the gap between button and pill reaches the preview. -->
          <lv_obj name="detail_top_left_row"
                  width="100%" height="content" align="top_left" y="#space_md" flex_flow="row_wrap"
                  style_flex_cross_place="center" style_pad_top="0" style_pad_bottom="0" style_pad_left="#space_md"
                  style_pad_right="#space_md" style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0"
                  scrollable="false" clickable="false">
            <exclude_objects_button name="btn_detail_objects"
                                    callback="on_print_select_detail_objects"
                                    hidden_when="detail_exclude_available eq 0"
                                    count_text_subject="detail_exclude_pick_count_text"
                                    count_hidden_when="detail_exclude_pick_count eq 0"/>
            <!-- Sliced colors: recolours the 3D preview with each tool's own
                 slicer color instead of the matched lane's (apply_preview_colors()
                 reads detail_prefer_sliced_colors). Same disc as the skip-objects
                 button; on, it fills with the accent. Offered only while the
                 LIVE viewer is what is on screen, because that is the only thing
                 it recolours: mode 0 means the viewer is not the active preview,
                 and no first frame means the slicer thumbnail still covers it.
                 One expression, so the two reasons cannot be ORed apart;
                 invert="true" reads as "show when". -->
            <lv_obj name="sliced_colors_toggle"
                    width="#icon_button_size_lg" height="#icon_button_size_lg" style_bg_color="#card_bg"
                    style_bg_opa="180" style_bg_color-checked="#primary" style_bg_opa-checked="255"
                    style_radius="#icon_button_radius_lg" style_border_width="0" style_pad_all="0" checkable="true"
                    scrollable="false" state_trickle="true">
              <style name="styles.press_wash" selector="pressed"/>
              <bind_flag_if cond="detail_gcode_viewer_mode eq 1 and detail_viewer_first_frame eq 1"
                            flag="hidden" invert="true"/>
              <bind_state_if_eq subject="detail_prefer_sliced_colors" state="checked" ref_value="1"/>
              <event_cb trigger="value_changed" callback="on_toggle_sliced_colors"/>
              <icon src="palette"
                    size="sm" variant="muted" align="center" clickable="false" style_text_color-checked="#text"/>
            </lv_obj>
            <lv_obj name="detail_loading_overlay"
                    width="content" height="content" flex_flow="row" style_flex_cross_place="center"
                    style_pad_top="#space_xs" style_pad_bottom="#space_xs" style_border_width="0" scrollable="false">
              <style name="styles.metadata_strip"/>
              <bind_flag_if_eq subject="detail_gcode_loading" flag="hidden" ref_value="0"/>
              <spinner size="xs"/>
              <text_small name="detail_loading_label" bind_text="detail_gcode_progress_text"/>
            </lv_obj>
            <!-- Plate of a sliced .3mf: the preview, time and filament follow
                 the plate shown, and Print prints it. The arrows show with
                 several sliced plates, with where the shown one sits among
                 them beside its name; with one, only its name or number. A
                 long plate name ends in an ellipsis at plate_label_max_width,
                 which leaves the arrows room on the narrowest preview card of
                 each size; when the buttons beside it leave too little room,
                 the row wraps the stepper onto a line of its own. -->
            <lv_obj name="detail_plate_stepper"
                    width="content" height="#icon_button_size_lg" style_max_width="100%" flex_flow="row"
                    style_flex_cross_place="center" style_pad_left="0" style_pad_right="0" style_pad_top="0"
                    style_pad_bottom="0" style_border_width="0" scrollable="false" hidden="true">
              <style name="styles.metadata_strip"/>
              <bind_flag_if_lt subject="selected_plate_count" flag="hidden" ref_value="1"/>
              <lv_obj name="btn_plate_prev"
                      width="#icon_button_size_lg" height="100%" clickable="true" scrollable="false" style_pad_all="0"
                      style_bg_opa="0" style_border_width="0" style_radius="#border_radius">
                <style name="styles.press_wash" selector="pressed"/>
                <bind_flag_if_lt subject="selected_plate_count" flag="hidden" ref_value="2"/>
                <event_cb trigger="clicked" callback="on_print_select_plate_prev"/>
                <icon src="chevron_left" size="sm" variant="text" align="center" clickable="false" event_bubble="true"/>
              </lv_obj>
              <text_small name="detail_plate_label"
                          bind_text="selected_plate_text" style_max_width="#plate_label_max_width" long_mode="dots"
                          style_pad_left="#space_sm"/>
              <!-- Where the plate sits among several ("2/3"). Never shortened:
                   the name gives way first. -->
              <text_small name="detail_plate_position"
                          bind_text="selected_plate_position" style_text_color="#text_muted" style_pad_right="#space_sm">
                <bind_flag_if_lt subject="selected_plate_count" flag="hidden" ref_value="2"/>
              </text_small>
              <lv_obj name="btn_plate_next"
                      width="#icon_button_size_lg" height="100%" clickable="true" scrollable="false" style_pad_all="0"
                      style_bg_opa="0" style_border_width="0" style_radius="#border_radius">
                <style name="styles.press_wash" selector="pressed"/>
                <bind_flag_if_lt subject="selected_plate_count" flag="hidden" ref_value="2"/>
                <event_cb trigger="clicked" callback="on_print_select_plate_next"/>
                <icon src="chevron_right" size="sm" variant="text" align="center" clickable="false" event_bubble="true"/>
              </lv_obj>
            </lv_obj>
          </lv_obj>
          <!-- No-thumbnail placeholder - responsive hero-size glyph shown when file has no real thumbnail.
             Uses icon_font_hero so the cube scales with the breakpoint (96px micro → 128px large+). -->
          <lv_label name="detail_no_thumbnail_icon"
                    text="#icon_cube_outline" style_text_font="#icon_font_hero" style_text_color="#tertiary"
                    align="center" style_translate_y="-20" hidden="true">
            <!-- The live viewer is the preview while its mode is above 0 -->
            <bind_flag_if cond="selected_has_thumbnail eq 1 or detail_gcode_viewer_mode gt 0" flag="hidden"/>
          </lv_label>
          <!-- Metadata clip - content-sized, hides top rounded corners of inner overlay -->
          <lv_obj name="detail_metadata_clip"
                  width="100%" height="content" style_radius="0" style_pad_all="0" align="bottom_mid" scrollable="false">
            <!-- translate_y="-12" pushes the overlay up so its rounded top corners
               are clipped by the clip container and its rounded bottom corners
               ride along the card's rounded bottom (card has style_clip_corner="true").
               pad_top must exceed the translate magnitude so the filename isn't
               cut off at the clip — 16px gives 4px breathing room above the 12px
               font on micro. -->
            <lv_obj name="detail_metadata_overlay"
                    width="100%" height="content" style_pad_top="16" style_pad_bottom="#space_sm"
                    style_translate_y="-12" flex_flow="column" scrollable="false">
              <!-- Translucency, radius, side padding and row gap come from the
                   shared style - same strip as print status, different placement. -->
              <style name="styles.metadata_strip"/>
              <!-- Filename with reactive binding - scrolls if too long for single line -->
              <!-- Uses selected_display_filename (without .gcode extension) for cleaner UI -->
              <text_body name="detail_filename_label"
                         width="100%" height="content" bind_text="selected_display_filename" long_mode="scroll_circular"
                         style_pad_bottom="0" style_border_width="0"/>
              <!-- Print history status display (hidden by default). The
                   wrapper gives a size-driven hide a target that is not the
                   row's own hidden flag, which update_history_display()
                   owns. At micro the strip is filename + one stats line, so
                   the history row is one of the three it drops. -->
              <lv_obj name="detail_history_wrap" width="100%" height="content" style_pad_all="0" scrollable="false">
                <bind_flag_if cond="ui_breakpoint eq 0 or ui_is_portrait eq 1" flag="hidden"/>
                <!-- detail_history_status is a FileHistoryStatus: 0 never printed,
                     1 printing, 2 completed, 3 failed, 4 canceled -->
                <lv_obj name="history_status_row"
                        width="100%" height="content" flex_flow="row" style_pad_gap="#space_xs"
                        style_flex_cross_place="center">
                  <bind_flag_if_eq subject="detail_history_status" flag="hidden" ref_value="0"/>
                  <icon name="history_status_printing" src="clock" size="sm" variant="accent">
                    <bind_flag_if_not_eq subject="detail_history_status" flag="hidden" ref_value="1"/>
                  </icon>
                  <icon name="history_status_completed" src="check" size="sm" variant="success">
                    <bind_flag_if_not_eq subject="detail_history_status" flag="hidden" ref_value="2"/>
                  </icon>
                  <icon name="history_status_failed" src="alert" size="sm" variant="danger">
                    <bind_flag_if_not_eq subject="detail_history_status" flag="hidden" ref_value="3"/>
                  </icon>
                  <icon name="history_status_canceled" src="cancel" size="sm" variant="warning">
                    <bind_flag_if_not_eq subject="detail_history_status" flag="hidden" ref_value="4"/>
                  </icon>
                  <text_body name="history_status_label" bind_text="detail_history_text"/>
                </lv_obj>
              </lv_obj>
              <!-- Metadata 2x2 grid - minimal gap from filename -->
              <lv_obj name="detail_metadata_grid"
                      width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs"
                      scrollable="false">
                <!-- Row 1: Print time + Filament weight -->
                <lv_obj name="metadata_row_1"
                        width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs"
                        scrollable="false">
                  <lv_obj flex_grow="1"
                          style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs" style_flex_cross_place="center"
                          scrollable="false">
                    <icon src="clock" size="xs" variant="primary"/>
                    <text_small name="detail_time_label"
                                bind_text="selected_print_time" long_mode="dots" flex_grow="1" style_translate_y="2"/>
                  </lv_obj>
                  <lv_obj flex_grow="1"
                          style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs" style_flex_cross_place="center"
                          scrollable="false">
                    <icon src="weight" size="xs" variant="primary"/>
                    <text_small name="detail_filament_label"
                                bind_text="selected_filament_weight" long_mode="dots" flex_grow="1"
                                style_translate_y="2"/>
                  </lv_obj>
                </lv_obj>
                <!-- Row 2: Print height + Layer count. Hidden at micro: the
                     strip there is filename + one stats line. -->
                <lv_obj name="metadata_row_2"
                        width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs"
                        scrollable="false">
                  <bind_flag_if cond="ui_breakpoint eq 0 or ui_is_portrait eq 1" flag="hidden"/>
                  <lv_obj flex_grow="1"
                          style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs" style_flex_cross_place="center"
                          scrollable="false">
                    <icon src="ruler" size="xs" variant="primary"/>
                    <text_small name="detail_height_label"
                                bind_text="selected_print_height" long_mode="dots" flex_grow="1" style_translate_y="2"/>
                  </lv_obj>
                  <lv_obj flex_grow="1"
                          style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs" style_flex_cross_place="center"
                          scrollable="false">
                    <icon src="layers" size="xs" variant="primary"/>
                    <text_small name="detail_layers_label"
                                bind_text="selected_layer_count" long_mode="dots" flex_grow="1" style_translate_y="2"/>
                  </lv_obj>
                </lv_obj>
                <!-- Row 3: Layer height + Filament type (full width for truncation).
                     Hidden at micro, like row 2. -->
                <lv_obj name="metadata_row_3"
                        width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs"
                        scrollable="false">
                  <bind_flag_if cond="ui_breakpoint eq 0 or ui_is_portrait eq 1" flag="hidden"/>
                  <lv_obj flex_grow="1"
                          style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs" style_flex_cross_place="center"
                          scrollable="false">
                    <icon src="cube" size="xs" variant="primary"/>
                    <text_small name="detail_layer_height_label" bind_text="selected_layer_height" style_translate_y="2"/>
                  </lv_obj>
                  <lv_obj flex_grow="1"
                          style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs" style_flex_cross_place="center"
                          scrollable="false">
                    <icon src="filament" size="xs" variant="primary"/>
                    <text_small name="detail_filament_type_label"
                                flex_grow="1" long_mode="scroll_circular" bind_text="selected_filament_type"
                                style_translate_y="2"/>
                  </lv_obj>
                </lv_obj>
              </lv_obj>
            </lv_obj>
          </lv_obj>
        </ui_card>
      </lv_obj>

      <!-- ================================================================== -->
      <!-- RIGHT SECTION: Options and buttons (4/9 width)                    -->
      <!-- ================================================================== -->
      <lv_obj name="options_section"
              style_pad_hor="0" style_pad_top="#space_sm" style_pad_bottom="0" style_pad_gap="#space_sm"
              flex_flow="column" scrollable="false">
        <bind_style_if_eq name="options_landscape" subject="ui_is_portrait" ref_value="0"/>
        <bind_style_if_eq name="options_portrait" subject="ui_is_portrait" ref_value="1"/>
        <!-- Options scroll area. The four cards scroll; the prep time, action
             buttons and blocked reason below this wrapper stay pinned at the
             column's bottom. detail_options_wrap is a plain non-flex box so
             the cue can overlay it with ignore_layout. -->
        <lv_obj name="detail_options_wrap"
                width="100%" height="0" flex_grow="1" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                scrollable="false">
          <lv_obj name="detail_options_scroll"
                  width="100%" height="100%" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="column"
                  scrollable="true" scroll_dir="ver" scrollbar_mode="off">
            <!-- Bypass notice: when bypass is engaged the print runs on the
                 external spool. The mapping card below hides itself for a
                 single-tool bypass print (the mapping decides nothing there), so
                 this must not promise "the lanes below": a multi-lane bypass print
                 still shows them. Bound to AmsState's global subject; no
                 per-view C++. -->
            <ui_card name="bypass_source_card"
                     width="100%" style_pad_hor="0" style_pad_ver="#space_xs" style_pad_gap="#space_xs"
                     style_border_width="0" style_bg_color="#elevated_bg" flex_flow="row"
                     style_flex_cross_place="center" scrollable="false" clickable="false">
              <bind_flag_if_eq subject="ams_bypass_active" flag="hidden" ref_value="0"/>
              <icon src="source_branch" size="sm" variant="info" clickable="false"/>
              <text_small name="bypass_source_label"
                          text="Bypass active — this print runs on the external spool." clickable="false" flex_grow="1"/>
            </ui_card>

            <!-- File-fits-printer findings, one line each: a move past the
                 travel, a heater past its limit or a missing tool blocks (danger),
                 a nozzle mismatch warns, another printer model is a note (info).
                 Text and severity come from PrintSelectDetailView::refresh_fit_check(). -->
            <ui_card name="fit_check_card"
                     width="100%" style_pad_hor="0" style_pad_ver="#space_xs" style_pad_gap="#space_xs"
                     style_border_width="0" style_bg_color="#elevated_bg" flex_flow="row" style_flex_cross_place="start"
                     scrollable="false" clickable="false">
              <bind_flag_if_eq subject="detail_fit_check_severity" flag="hidden" ref_value="0"/>
              <icon name="fit_check_block_icon" src="alert_octagon" size="sm" variant="danger" clickable="false">
                <bind_flag_if_not_eq subject="detail_fit_check_severity" flag="hidden" ref_value="3"/>
              </icon>
              <icon name="fit_check_warn_icon" src="alert" size="sm" variant="warning" clickable="false">
                <bind_flag_if_not_eq subject="detail_fit_check_severity" flag="hidden" ref_value="2"/>
              </icon>
              <icon name="fit_check_note_icon" src="info_circle" size="sm" variant="info" clickable="false">
                <bind_flag_if_not_eq subject="detail_fit_check_severity" flag="hidden" ref_value="1"/>
              </icon>
              <text_small name="fit_check_label"
                          width="0" flex_grow="1" bind_text="detail_fit_check_text" clickable="false"/>
            </ui_card>

            <!-- Filament card. ONE chip surface for every AMS backend: one
                 filament_swatch chip per used tool, bound to the subjects the card
                 publishes from its own mappings store.
                 Visibility is the C++-owned filament_mapping_visible subject,
                 published after each FilamentMappingCard::update(). Tapping opens
                 the remap picker, and the chevron says so.

                 The clickable binding below is NOT the only writer of that flag:
                 FilamentMappingCard::create() also adds CLICKABLE unconditionally,
                 and lv_subject_set_int only notifies on a CHANGE, so publishing
                 color_card_remappable=0 over an already-0 subject never fires this
                 binding and the C++ flag survives. A tap on a non-remappable
                 backend is stopped by on_color_card_clicked()'s own guard, not by
                 the flag. Tracked; do not read this binding as authoritative. -->
            <ui_card name="filament_mapping_card"
                     width="100%" style_pad_ver="#space_sm" style_pad_gap="#space_xs" style_bg_color="#elevated_bg">
              <bind_style_if name="fil_card_stacked" cond="ui_is_portrait eq 0 or ui_breakpoint ge 2"/>
              <bind_style_if name="fil_card_inline" cond="ui_is_portrait eq 1 and ui_breakpoint lt 2"/>
              <bind_flag_if_eq subject="filament_mapping_visible" flag="hidden" ref_value="0"/>
              <!-- Hidden in queue mode: the mapping is not saved with the job, it
                   is recomputed against the lanes loaded when the job starts. The
                   two bindings OR together (one hidden flag, two independent
                   reasons), so no C++ writer composes them. -->
              <bind_flag_if_eq subject="print_select_button_mode" flag="hidden" ref_value="1"/>
              <bind_flag_if_eq subject="color_card_remappable" flag="clickable" ref_value="1"/>
              <lv_obj name="color_card_header"
                      height="content" style_pad_all="0" style_pad_gap="#space_xs" flex_flow="row"
                      style_flex_cross_place="center" scrollable="false" clickable="false" event_bubble="true">
                <bind_style_if name="fil_head_stacked" cond="ui_is_portrait eq 0 or ui_breakpoint ge 2"/>
                <bind_style_if name="fil_head_inline" cond="ui_is_portrait eq 1 and ui_breakpoint lt 2"/>
                <text_small text="FILAMENTS" clickable="false" event_bubble="true"/>
                <!-- Holds the header at the tap cue's height while the cue is out
                   of the flow (stacked), so the title stays centred on the cue's
                   line. Inline, the cue is in the row and this goes. -->
                <icon name="color_card_header_strut"
                      src="chevron_right" size="sm" variant="secondary" style_opa="0" clickable="false"
                      event_bubble="true">
                  <bind_flag_if cond="ui_is_portrait eq 1 and ui_breakpoint lt 2" flag="hidden"/>
                </icon>
              </lv_obj>
              <!-- height is FIXED, not "content": the filament_swatch chips inside are
                   height="100%" and collapse to zero in a content-height parent. The
                   chips sit in one row; the card caps them at what fits and shows a
                   "+N" pill for the rest (FilamentMappingCard::publish_chips). -->
              <!-- #filament_chip_row_height IS the chip height. filament_swatch is
                   height="100%" and resolves against this row's CONTENT box, so padding
                   here shortens the chips instead of growing the row - the card is flex
                   column with style_pad_gap, which is what spaces this from the header. -->
              <lv_obj name="filament_mapping_rows"
                      height="#filament_chip_row_height" style_pad_all="0" style_pad_gap="#space_xs" flex_flow="row"
                      style_flex_main_place="center" scrollable="false" clickable="false" event_bubble="true">
                <bind_style_if name="fil_chips_stacked" cond="ui_is_portrait eq 0 or ui_breakpoint ge 2"/>
                <bind_style_if name="fil_chips_inline" cond="ui_is_portrait eq 1 and ui_breakpoint lt 2"/>
                <bind_style_if_eq name="mapping_rows_unmappable" subject="color_card_remap_needs_setup" ref_value="1"/>
                <bind_flag_if_eq subject="detail_mapping_ready" flag="hidden" ref_value="0"/>
                <filament_chip_row name="filament_chip_row"/>
              </lv_obj>
              <!-- Skeleton: two chip-sized placeholders shown only until the
                   authoritative tool set exists; a cache hit never shows this.
                   Height, flow and alignment all mirror filament_mapping_rows above,
                   so nothing moves when detail_mapping_ready flips. -->
              <lv_obj name="mapping_skeleton"
                      height="#filament_chip_row_height" style_pad_all="0" style_pad_gap="#space_xs" flex_flow="row"
                      style_flex_main_place="center" scrollable="false" clickable="false" event_bubble="true">
                <bind_style_if name="fil_chips_stacked" cond="ui_is_portrait eq 0 or ui_breakpoint ge 2"/>
                <bind_style_if name="fil_chips_inline" cond="ui_is_portrait eq 1 and ui_breakpoint lt 2"/>
                <bind_flag_if_eq subject="detail_mapping_ready" flag="hidden" ref_value="1"/>
                <lv_obj width="#filament_chip_width"
                        height="100%" style_radius="#space_sm" style_bg_color="#card_bg" style_bg_opa="100"
                        clickable="false" event_bubble="true"/>
                <lv_obj width="#filament_chip_width"
                        height="100%" style_radius="#space_sm" style_bg_color="#card_bg" style_bg_opa="100"
                        clickable="false" event_bubble="true"/>
              </lv_obj>
              <!-- The tap cue, last in the card so it ends the inline row. Stacked,
                   it leaves the flow and sits at the top right, on the header's
                   line. -->
              <lv_obj name="color_card_header_end"
                      width="content" height="content" align="top_right" style_pad_all="0" style_bg_opa="0"
                      style_border_width="0" flex_flow="row" style_flex_cross_place="center" scrollable="false"
                      clickable="false" event_bubble="true">
                <bind_flag_if cond="ui_is_portrait eq 0 or ui_breakpoint ge 2" flag="ignore_layout"/>
                <!-- The tap cue. Same chevron every tappable row in the app uses
                       (setting_action_row.xml, ams_edit_overlay.xml), so it reads as
                       "this opens something" without a label to translate. -->
                <icon name="color_card_remap_chevron"
                      src="chevron_right" size="sm" variant="secondary" clickable="false" event_bubble="true">
                  <bind_flag_if_eq subject="color_card_remappable" flag="hidden" ref_value="0"/>
                </icon>
                <!-- Takes the chevron's place when a remap is unavailable or will
                       cost something. Its own clickable object, never a bubbling chip:
                       the card greys itself with LV_STATE_DISABLED and LVGL delivers
                       no pointer events to a disabled object, so an icon relying on
                       the card's handler would be dead exactly when it is needed. -->
                <icon name="color_card_remap_help" src="help_circle" size="sm" variant="secondary" clickable="true">
                  <bind_flag_if_eq subject="color_card_remap_help_visible" flag="hidden" ref_value="0"/>
                  <event_cb trigger="clicked" callback="on_color_card_remap_help"/>
                </icon>
              </lv_obj>
            </ui_card>

            <!-- Options card.
                 Option tiles are populated dynamically in C++ from the active
                 printer's PrePrintOptionSet (see PrintSelectDetailView::
                 populate_option_rows). The card is hidden when no preprint
                 options apply, via has_any_preprint_options. -->
            <ui_card name="options_card"
                     width="100%" style_pad_ver="#space_sm" style_pad_gap="#space_sm" flex_flow="column"
                     style_bg_color="#elevated_bg">
              <bind_flag_if_eq subject="has_any_preprint_options" flag="hidden" ref_value="0"/>
              <!-- Hidden in queue mode when Moonraker starts the next job by
                   itself (automatic_transition): the saved options would never
                   be read, because no detail view opens on start. One
                   conjunction, so one cond= rather than two stacked bindings,
                   which OR. -->
              <bind_flag_if cond="print_select_button_mode eq 1 and job_queue_automatic_transition eq 1" flag="hidden"/>
              <text_small text="PRINT OPTIONS"/>
              <lv_obj name="pre_print_options_container"
                      width="100%" height="content" style_pad_all="0" flex_flow="row_wrap" style_pad_row="#space_xs"
                      style_pad_column="#space_xs" style_flex_main_place="space_between" scrollable="false">
                <!-- Children added dynamically in C++ -->
              </lv_obj>
            </ui_card>

          </lv_obj>
          <!-- Bottom fade: hints the scroll area continues below the visible
               edge. Not clickable, so touches fall through to the tiles under
               it. Shown only while content IS hidden below AND the
               page-scroll buttons are off - where they are on, their chevron
               gutter is the cue and this fade would only duplicate it. -->
          <lv_obj name="detail_options_cue"
                  width="100%" height="#space_2xl" ignore_layout="true" align="bottom_mid" clickable="false"
                  scrollable="false" style_pad_all="0" style_border_width="0" style_radius="0" style_bg_opa="255"
                  style_bg_color="#card_bg" style_bg_grad_color="#card_bg" style_bg_grad_dir="ver" style_bg_main_opa="0"
                  style_bg_grad_opa="255">
            <bind_flag_if cond="detail_options_more_below eq 1 and settings_page_scroll_buttons eq 0"
                          flag="hidden" invert="true"/>
            <icon src="chevron_down" size="sm" variant="secondary" align="bottom_mid" clickable="false"/>
          </lv_obj>
        </lv_obj>
        <!-- Pre-print time estimate; hidden entirely while no estimate exists,
             because an empty string still occupies a row, and at micro and tiny,
             where the options column needs that row more. -->
        <text_small name="prep_time_estimate"
                    width="100%" bind_text="preprint_estimate_text" style_text_color="#text_muted"
                    style_text_align="center" style_pad_bottom="#space_xs">
          <bind_flag_if cond="preprint_estimate_visible eq 0 or ui_breakpoint lt 2" flag="hidden"/>
        </text_small>

        <!-- Button row -->
        <lv_obj name="button_row" width="100%" style_pad_all="0" style_pad_gap="#button_padding" flex_flow="row">
          <bind_style_if_eq name="btn_row_landscape" subject="ui_is_portrait" ref_value="0"/>
          <bind_style_if_eq name="btn_row_portrait" subject="ui_is_portrait" ref_value="1"/>
          <bind_style_if_eq name="btn_row_icons" subject="print_detail_has_plugin_items" ref_value="1"/>
          <!-- Delete button (icon-only). Hidden for a USB stick file: delete
               targets Moonraker's storage, and sticks are often mounted read-only. -->
          <ui_button name="delete_button" height="100%" variant="danger" icon="trash_can_outline">
            <bind_style_if_eq name="delete_btn_landscape" subject="ui_is_portrait" ref_value="0"/>
            <bind_style_if_eq name="delete_btn_portrait" subject="ui_is_portrait" ref_value="1"/>
            <bind_flag_if_eq subject="print_source_is_usb" flag="hidden" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_print_select_delete_button"/>
          </ui_button>
          <!-- Plugin actions for this file, shown while an enabled plugin declares
               a print_file menu item. -->
          <ui_button name="more_button" height="100%" variant="secondary" icon="dots_vertical">
            <bind_style_if_eq name="delete_btn_landscape" subject="ui_is_portrait" ref_value="0"/>
            <bind_style_if_eq name="delete_btn_portrait" subject="ui_is_portrait" ref_value="1"/>
            <bind_flag_if_eq subject="print_detail_has_plugin_items" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_print_select_more_button"/>
          </ui_button>
          <!-- Print button - primary action styling (disabled when print in progress).
               Label and icon follow the mode subjects: "Print" + printer icon idle,
               "Add to Queue" + the queue's clock icon while another print holds the
               machine and Moonraker has the job_queue component (the same tap then
               routes to the queue path). -->
          <ui_button name="print_button"
                     height="100%" bind_text="print_select_button_label" icon="print"
                     bind_icon="print_select_button_icon" label_hidden_cond="print_detail_has_plugin_items eq 1">
            <bind_style_if_eq name="print_btn_wide" subject="print_detail_has_plugin_items" ref_value="0"/>
            <bind_style_if name="print_btn_square_landscape"
                           cond="print_detail_has_plugin_items eq 1 and ui_is_portrait eq 0"/>
            <bind_style_if name="print_btn_square_portrait"
                           cond="print_detail_has_plugin_items eq 1 and ui_is_portrait eq 1"/>
            <event_cb trigger="clicked" callback="on_print_select_print_button"/>
            <bind_state_if_eq subject="print_select_can_print" state="disabled" ref_value="0"/>
          </ui_button>
        </lv_obj>

        <!-- Why the print button is disabled (active print or macro analysis),
             or the queue hint while it offers Add to Queue. Text comes from
             print_select_blocked_reason; hidden whenever the button is a plain
             usable Print so the detail view reads clean when idle. -->
        <text_small name="print_blocked_reason"
                    width="100%" bind_text="print_select_blocked_reason" style_text_color="#text_muted"
                    style_text_align="center" style_pad_top="#space_xs">
          <bind_flag_if cond="print_select_can_print eq 0 or print_select_button_mode eq 1" flag="hidden" invert="true"/>
        </text_small>

      </lv_obj>
    </lv_obj>
  </view>
</component>
