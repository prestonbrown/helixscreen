<!-- Test/Development Panel - Only accessible via -p test or -panel test flag -->
<!-- i18n: skip-file — dev-only demo strings, never shown to end users -->
<component>
  <!-- Styles used by the XML Expression Demo (bind_style_if) -->
  <styles>
    <style name="demo_alarm_style" bg_color="#warning" bg_opa="255"/>
  </styles>
  <!-- Subjects for the XML Expression Demo. Inputs are driven by the sliders/switch
       below; demo_alarm is a <subject_expr> computed from all three (boolean logic).
       Input subjects MUST be declared before the subject_expr that references them. -->
  <subjects>
    <int name="demo_temp" value="50"/>
    <int name="demo_threshold" value="70"/>
    <int name="demo_error" value="0"/>
    <subject_expr name="demo_alarm" expr="demo_error or demo_temp gt demo_threshold"/>
    <!-- Subjects for the XML Repeat Demo (see below). demo_count drives the
         subject-bound <repeat>; demo_slot_*_label are the indexed subjects each
         repeated card self-wires to via ${i} composition. -->
    <int name="demo_count" value="3"/>
    <string name="demo_slot_0_label" value="Alpha"/>
    <string name="demo_slot_1_label" value="Bravo"/>
    <string name="demo_slot_2_label" value="Charlie"/>
    <string name="demo_slot_3_label" value="Delta"/>
    <string name="demo_slot_4_label" value="Echo"/>
    <string name="demo_slot_5_label" value="Foxtrot"/>
  </subjects>
  <view extends="lv_obj"
        width="100%" height="100%" style_pad_all="#space_lg" style_border_width="0" flex_flow="column"
        style_pad_gap="#space_md" scrollable="true" style_bg_opa="255" style_bg_color="#screen_bg">
    <!-- ============================================================ -->
    <!-- XML EXPRESSION DEMO  (subject_expr + inline cond= binds)     -->
    <!-- Drive the sliders / Error switch and watch the widgets below -->
    <!-- react via boolean-logic expressions over multiple subjects.  -->
    <!-- ============================================================ -->
    <text_heading text="XML Expression Demo"/>
    <ui_card width="100%"
             style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="column" style_pad_gap="#space_md">
      <!-- INPUTS (two-way bound: dragging/toggling writes the subject) -->
      <lv_obj width="100%"
              flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_bg_opa="0"
              style_border_width="0" style_pad_all="0">
        <text_body text="Temp"/>
        <text_body bind_text="demo_temp"/>
      </lv_obj>
      <lv_slider width="100%" min_value="0" max_value="100" bind_value="demo_temp"/>
      <lv_obj width="100%"
              flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_bg_opa="0"
              style_border_width="0" style_pad_all="0">
        <text_body text="Threshold"/>
        <text_body bind_text="demo_threshold"/>
      </lv_obj>
      <lv_slider width="100%" min_value="0" max_value="100" bind_value="demo_threshold"/>
      <lv_obj width="100%"
              flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_bg_opa="0"
              style_border_width="0" style_pad_all="0">
        <text_body text="Error switch"/>
        <ui_switch name="demo_error_switch" bind_checked="demo_error"/>
      </lv_obj>
      <divider_horizontal/>
      <!-- COMPUTED subject_expr: demo_alarm = demo_error OR demo_temp > demo_threshold -->
      <lv_obj width="100%"
              flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_bg_opa="0"
              style_border_width="0" style_pad_all="0">
        <text_body text="demo_alarm (subject_expr) ="/>
        <text_heading bind_text="demo_alarm"/>
      </lv_obj>
    </ui_card>
    <!-- WIDGETS driven by the conditions (binds on containers for widest support) -->
    <ui_card width="100%"
             style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="column" style_pad_gap="#space_md">
      <!-- bind_flag_if on the subject_expr: banner visible only while alarm -->
      <lv_obj width="100%"
              flex_flow="row" style_flex_cross_place="center" style_bg_opa="0" style_border_width="0" style_pad_all="0">
        <bind_flag_if cond="demo_alarm" flag="hidden" invert="true"/>
        <text_heading text="ALARM  (bind_flag_if on subject_expr)"/>
      </lv_obj>
      <!-- bind_flag_if on a DIRECT multi-subject expression -->
      <lv_obj width="100%"
              flex_flow="row" style_flex_cross_place="center" style_bg_opa="0" style_border_width="0" style_pad_all="0">
        <bind_flag_if cond="demo_temp gt demo_threshold" flag="hidden" invert="true"/>
        <text_body text="Temp is over threshold  (direct cond=)"/>
      </lv_obj>
      <!-- bind_state_if: button goes disabled while alarm -->
      <ui_button name="btn_demo_action" text="Action  (disabled when alarm)">
        <bind_state_if cond="demo_alarm" state="disabled"/>
      </ui_button>
      <!-- bind_style_if: card background turns warning-colored while alarm -->
      <ui_card name="demo_alarm_card"
               width="100%" height="56" style_radius="#border_radius" style_pad_all="#space_md" flex_flow="row"
               style_flex_cross_place="center">
        <bind_style_if name="demo_alarm_style" cond="demo_alarm"/>
        <text_body text="Styled by bind_style_if"/>
      </ui_card>
    </ui_card>
    <divider_horizontal/>
    <!-- ============================================================ -->
    <!-- XML REPEAT DEMO  (repeat count, $i, ${i})                    -->
    <!-- Drag the slider to change demo_count and watch the SUBJECT   -->
    <!-- BOUND card row below rebuild live. The FIXED card row above  -->
    <!-- it never changes; count="4" is a literal, resolved once      -->
    <!-- at load time.                                                -->
    <!-- ============================================================ -->
    <text_heading text="XML Repeat Demo" translation_tag="XML Repeat Demo"/>
    <ui_card width="100%"
             style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="column" style_pad_gap="#space_md">
      <lv_obj width="100%"
              flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_bg_opa="0"
              style_border_width="0" style_pad_all="0">
        <text_body text="Count (demo_count)"/>
        <text_body bind_text="demo_count"/>
      </lv_obj>
      <lv_slider width="100%" min_value="0" max_value="6" bind_value="demo_count"/>
      <text_small text="FIXED count=&quot;4&quot; -- expands once at load time, $i is the index"
                  translation_tag="FIXED count=&quot;4&quot; -- expands once at load time, $i is the index"/>
      <lv_obj width="100%"
              flex_flow="row" style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" style_pad_all="0">
        <repeat count="4">
          <ui_card width="60"
                   height="60" style_radius="#border_radius" flex_flow="column" style_flex_main_place="center"
                   style_flex_cross_place="center">
            <text_heading text="$i"/>
          </ui_card>
        </repeat>
      </lv_obj>
      <text_small text="SUBJECT-BOUND count=&quot;demo_count&quot; -- rebuilds on slider change, each card self-wires to its indexed subject (demo_slot_N_label)"
                  translation_tag="SUBJECT-BOUND count=&quot;demo_count&quot; -- rebuilds on slider change, each card self-wires to its indexed subject (demo_slot_N_label)"/>
      <!-- Dedicated container: the subject-bound repeat is its ONLY child.
           A reactive repeat that shares a parent with later static siblings
           mis-orders on rebuild (rebuilt items are always appended to the end
           of the parent's child list); see LVGL9_XML_GUIDE.md, "Repeating
           fragments with repeat", for why this container exists. -->
      <lv_obj width="100%"
              flex_flow="row" style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0" style_pad_all="0">
        <repeat count="demo_count">
          <ui_card width="80"
                   height="60" style_radius="#border_radius" flex_flow="column" style_flex_main_place="center"
                   style_flex_cross_place="center">
            <text_body bind_text="demo_slot_${i}_label"/>
          </ui_card>
        </repeat>
      </lv_obj>
    </ui_card>
    <divider_horizontal/>
    <!-- ============================================================ -->
    <!-- MARKDOWN VIEWER TEST                                         -->
    <!-- ============================================================ -->
    <text_heading text="Markdown Viewer" translation_tag="Markdown Viewer"/>
    <ui_card width="100%" height="400" style_radius="#border_radius" style_pad_all="#space_lg">
      <lv_obj width="100%"
              height="100%" scrollable="true" style_pad_all="0" style_border_width="0" style_bg_opa="0" style_radius="0">
        <ui_markdown name="markdown_test" width="100%"/>
      </lv_obj>
    </ui_card>
    <divider_horizontal/>
    <!-- ============================================================ -->
    <!-- SPINNER TEST - Material Design Indeterminate Animation       -->
    <!-- ============================================================ -->
    <text_heading text="Material Design Spinner"/>
    <ui_card width="100%"
             height="120" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_evenly" style_flex_cross_place="center">
      <lv_obj flex_flow="column"
              style_flex_cross_place="center" style_pad_gap="8" style_bg_opa="0" style_border_width="0"
              style_pad_all="0">
        <spinner size="lg"/>
        <text_small text="lg" translation_tag="lg"/>
      </lv_obj>
      <lv_obj flex_flow="column"
              style_flex_cross_place="center" style_pad_gap="8" style_bg_opa="0" style_border_width="0"
              style_pad_all="0">
        <spinner size="md"/>
        <text_small text="md" translation_tag="md"/>
      </lv_obj>
      <lv_obj flex_flow="column"
              style_flex_cross_place="center" style_pad_gap="8" style_bg_opa="0" style_border_width="0"
              style_pad_all="0">
        <spinner size="sm"/>
        <text_small text="sm" translation_tag="sm"/>
      </lv_obj>
      <lv_obj flex_flow="column"
              style_flex_cross_place="center" style_pad_gap="8" style_bg_opa="0" style_border_width="0"
              style_pad_all="0">
        <spinner size="xs"/>
        <text_small text="xs" translation_tag="xs"/>
      </lv_obj>
    </ui_card>
    <divider_horizontal/>
    <!-- ============================================================ -->
    <!-- SPOOL VISUALIZATION TESTS - Pseudo-3D Canvas vs Flat Ring    -->
    <!-- ============================================================ -->
    <text_heading text="Spool Visualization (Pseudo-3D Canvas)" translation_tag="Spool Visualization (Pseudo-3D Canvas)"/>
    <ui_card width="100%"
             height="100" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_evenly" style_flex_cross_place="center">
      <spool_canvas name="test_spool_canvas_0" color="0xE53935" fill_level="1.0" size="64"/>
      <spool_canvas name="test_spool_canvas_1" color="0x1E88E5" fill_level="0.75" size="64"/>
      <spool_canvas name="test_spool_canvas_2" color="0x43A047" fill_level="0.40" size="64"/>
      <spool_canvas name="test_spool_canvas_3" color="0xFDD835" fill_level="0.10" size="64"/>
    </ui_card>
    <text_small text="Fill: 100% / 75% / 40% / 10%" translation_tag="Fill: 100% / 75% / 40% / 10%"/>
    <text_heading text="Flat Concentric Rings (existing ams_slot)"
                  translation_tag="Flat Concentric Rings (existing ams_slot)"/>
    <ui_card width="100%"
             height="100" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_evenly" style_flex_cross_place="center">
      <ams_slot name="test_ams_slot_0" slot_index="0" fill_level="1.0"/>
      <ams_slot name="test_ams_slot_1" slot_index="1" fill_level="0.75"/>
      <ams_slot name="test_ams_slot_2" slot_index="2" fill_level="0.40"/>
      <ams_slot name="test_ams_slot_3" slot_index="3" fill_level="0.10"/>
    </ui_card>
    <text_small text="Fill: 100% / 75% / 40% / 10%" translation_tag="Fill: 100% / 75% / 40% / 10%"/>
    <divider_horizontal/>
    <!-- ============================================================ -->
    <!-- PROGRESS BAR TESTS - Understanding lv_bar behavior           -->
    <!-- ============================================================ -->
    <text_heading text="Progress Bar Tests" translation_tag="Progress Bar Tests"/>
    <ui_card width="100%"
             height="60" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_small text="Default (value=50)" translation_tag="Default (value=50)"/>
      <lv_bar name="test_bar_default" width="60%" height="12" value="50"/>
    </ui_card>
    <ui_card width="100%"
             height="60" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_small text="min=0, max=100, value=25" translation_tag="min=0, max=100, value=25"/>
      <lv_bar name="test_bar_explicit_range" width="60%" height="12" min_value="0" max_value="100" value="25"/>
    </ui_card>
    <ui_card width="100%"
             height="60" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_small text="value=0 (shows FULL - BUG!)" translation_tag="value=0 (shows FULL - BUG!)"/>
      <lv_bar name="test_bar_zero" width="60%" height="12" min_value="0" max_value="100" value="0"/>
    </ui_card>
    <ui_card width="100%"
             height="60" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_small text="value=1 (tiny sliver?)" translation_tag="value=1 (tiny sliver?)"/>
      <lv_bar name="test_bar_one" width="60%" height="12" min_value="0" max_value="100" value="1"/>
    </ui_card>
    <ui_card width="100%"
             height="60" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_small text="value=100 (should be full)" translation_tag="value=100 (should be full)"/>
      <lv_bar name="test_bar_full" width="60%" height="12" min_value="0" max_value="100" value="100"/>
    </ui_card>
    <ui_card width="100%"
             height="60" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_small text="Styled (value=75)" translation_tag="Styled (value=75)"/>
      <lv_bar name="test_bar_styled" width="60%" height="12" min_value="0" max_value="100" value="75" style_radius="4"/>
    </ui_card>
    <ui_card width="100%"
             height="60" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_small text="Thin bar (height=8)" translation_tag="Thin bar (height=8)"/>
      <lv_bar name="test_bar_thin" width="60%" height="8" min_value="0" max_value="100" value="50" style_radius="4"/>
    </ui_card>
    <divider_horizontal/>
    <!-- ============================================================ -->
    <!-- SWITCH TESTS                                                 -->
    <!-- ============================================================ -->
    <text_heading text="Switch Tests" translation_tag="Switch Tests"/>
    <ui_card width="100%"
             height="56" style_radius="#border_radius" style_pad_all="#space_lg" style_pad_gap="#space_md"
             flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_body text="Toggle Feature" translation_tag="Toggle Feature"/>
      <ui_switch name="test_switch_1" width="44" height="24"/>
    </ui_card>
    <ui_card width="100%"
             height="72" style_radius="#border_radius" style_pad_all="#space_lg" style_pad_gap="#space_md"
             flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_heading text="Advanced Setting" translation_tag="Advanced Setting"/>
      <ui_switch name="test_switch_2" width="56" height="32" checked="true"/>
    </ui_card>
    <ui_card width="100%"
             height="56" style_radius="#border_radius" style_pad_all="#space_lg" style_pad_gap="#space_md"
             flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center">
      <text_body text="WiFi" style_margin_right="10"/>
      <ui_switch name="test_switch_3" width="44" height="24" style_margin_right="20"/>
      <text_body text="Bluetooth" style_margin_right="10"/>
      <ui_switch name="test_switch_4" width="44" height="24" checked="true"/>
    </ui_card>
    <divider_horizontal/>
    <!-- ============================================================ -->
    <!-- SEMANTIC SWITCH SIZES                                        -->
    <!-- ============================================================ -->
    <text_heading text="Semantic Size Parameter Tests" translation_tag="Semantic Size Parameter Tests"/>
    <ui_card width="100%"
             height="60" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_body text="size=&quot;tiny&quot;" translation_tag="size=&quot;tiny&quot;"/>
      <ui_switch name="test_switch_tiny" size="tiny"/>
    </ui_card>
    <ui_card width="100%"
             height="60" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_body text="size=&quot;small&quot;" translation_tag="size=&quot;small&quot;"/>
      <ui_switch name="test_switch_small" size="small" checked="true"/>
    </ui_card>
    <ui_card width="100%"
             height="70" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_body text="size=&quot;medium&quot;" translation_tag="size=&quot;medium&quot;"/>
      <ui_switch name="test_switch_medium" size="medium"/>
    </ui_card>
    <ui_card width="100%"
             height="80" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_body text="size=&quot;large&quot;" translation_tag="size=&quot;large&quot;"/>
      <ui_switch name="test_switch_large" size="large" checked="true"/>
    </ui_card>
    <ui_card width="100%"
             height="70" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="row"
             style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_body text="size=&quot;medium&quot; width=&quot;100&quot;"
                 translation_tag="size=&quot;medium&quot; width=&quot;100&quot;"/>
      <ui_switch name="test_switch_override" width="100" size="medium"/>
    </ui_card>
    <divider_horizontal/>
    <!-- ============================================================ -->
    <!-- KEYBOARD TEST                                                -->
    <!-- ============================================================ -->
    <text_heading text="Keyboard Test (Gboard-style)" translation_tag="Keyboard Test (Gboard-style)"/>
    <ui_card width="100%" height="120" style_pad_all="#space_lg">
      <text_input name="keyboard_test_textarea"
                  width="100%" height="100%" placeholder="Tap to show keyboard..."
                  placeholder_tag="Tap to show keyboard..." multiline="true"/>
    </ui_card>
    <!-- Bottom spacer for scroll clearance -->
    <lv_obj height="#space_lg" style_bg_opa="0" style_border_width="0" style_pad_all="0"/>
  </view>
</component>
