<!-- Label Printer Settings Overlay -->
<component>
  <subjects>
    <!-- DO NOT declare printer_type_subject here — it's managed by C++ (LabelPrinterSettingsManager) -->
  </subjects>
  <styles>
    <style name="size_preset_side_by_side" layout="flex" flex_flow="row"/>
    <style name="size_preset_stacked" layout="flex" flex_flow="column"/>
    <!-- min_width wins over the rows' 50% width, which a bound style could not replace -->
    <style name="fill_row" min_width="100%"/>
  </styles>
  <view name="label_printer_settings" extends="overlay_panel" title="Label Printer" bg_color="#screen_bg">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_top="0" style_pad_left="0" style_pad_right="0"
            style_pad_bottom="#space_lg" scrollable="true" flex_flow="column">

      <!-- Printer Type selector -->
      <setting_group name="group_connection_type">
        <setting_group_header title="CONNECTION TYPE"/>
        <setting_dropdown_row name="row_printer_type"
                              label="Type" icon="swap_vertical" hide_description="true" callback="on_lp_type_changed"/>
      </setting_group>

      <!-- Network config section — visible when type=0 (network) -->
      <lv_obj name="section_network"
              width="100%" height="content" flex_flow="column" style_bg_opa="0" style_border_width="0" style_pad_all="0"
              scrollable="false">
        <bind_flag_if_not_eq subject="printer_type_subject" flag="hidden" ref_value="0"/>
        <setting_group name="group_discovered_printers">
          <setting_group_header title="DISCOVERED PRINTERS"/>
          <setting_dropdown_row name="row_discovered_printers"
                                label="Printer" icon="magnify" dropdown_width="66%" hide_description="true"
                                callback="on_lp_printer_selected"/>
        </setting_group>
        <setting_group name="group_manual">
          <setting_group_header title="MANUAL"/>
          <lv_obj name="row_address_port"
                  width="100%" height="content" flex_flow="row" style_flex_cross_place="center"
                  style_flex_main_place="end" style_pad_all="0" style_pad_left="#space_lg" style_pad_right="#space_lg"
                  style_pad_top="#space_sm" style_pad_bottom="#space_sm" style_pad_gap="#space_md" style_bg_opa="0"
                  style_border_width="0" scrollable="false">
            <text_muted name="label_address" width="content" text="Address"/>
            <text_input name="input_address"
                        width="40%" placeholder_text="192.168.1.50" one_line="true" scrollbar_mode="off">
              <event_cb trigger="focused" callback="on_lp_manual_entry_focused"/>
              <event_cb trigger="defocused" callback="on_lp_address_done"/>
            </text_input>
            <text_muted name="label_port" width="content" text="Port"/>
            <text_input name="input_port" width="15%" placeholder_text="9100" one_line="true" scrollbar_mode="off">
              <event_cb trigger="focused" callback="on_lp_manual_entry_focused"/>
              <event_cb trigger="defocused" callback="on_lp_port_done"/>
            </text_input>
          </lv_obj>
        </setting_group>
      </lv_obj>

      <!-- USB config section — visible when type=1 (usb) -->
      <lv_obj name="section_usb"
              width="100%" height="content" flex_flow="column" style_bg_opa="0" style_border_width="0" style_pad_all="0"
              scrollable="false">
        <bind_flag_if_not_eq subject="printer_type_subject" flag="hidden" ref_value="1"/>
        <setting_group name="group_usb_printers">
          <setting_group_header title="DETECTED USB PRINTERS"/>
          <setting_dropdown_row name="row_usb_printers"
                                label="Printer" icon="magnify" dropdown_width="66%" hide_description="true"
                                callback="on_lp_usb_printer_selected"/>
        </setting_group>
      </lv_obj>

      <!-- Bluetooth config section — visible when type=2 (bluetooth) -->
      <lv_obj name="section_bluetooth"
              width="100%" height="content" flex_flow="column" style_bg_opa="0" style_border_width="0" style_pad_all="0"
              scrollable="false">
        <bind_flag_if_not_eq subject="printer_type_subject" flag="hidden" ref_value="2"/>
        <setting_group name="group_bluetooth_printers">
          <setting_group_header title="BLUETOOTH PRINTERS"/>
          <setting_dropdown_row name="row_bt_printers"
                                label="Printer" icon="magnify" dropdown_width="66%" hide_description="true"
                                callback="on_lp_bt_printer_selected"/>
          <lv_obj name="row_bt_scan"
                  width="100%" height="content" flex_flow="row" style_flex_main_place="center"
                  style_flex_cross_place="center" style_pad_all="#space_md" style_bg_opa="0" style_border_width="0"
                  style_pad_gap="#space_md" scrollable="false">
            <spinner name="bt_scan_spinner" size="sm" hidden="true">
              <bind_flag_if_eq subject="bt_scanning" flag="hidden" ref_value="0"/>
            </spinner>
            <!-- SIZE_OK: 200, not #button_width_action, because "Scan for Printers"
                 is the longest label in the row and does not fit 140. The two
                 siblings below are the standard action width. -->
            <ui_button name="btn_bt_scan" width="200" text="Scan for Printers" icon="magnify_scan">
              <event_cb trigger="clicked" callback="on_lp_bt_scan"/>
            </ui_button>
            <ui_button name="btn_bt_connect"
                       width="#button_width_action" text="Connect" icon="bluetooth" disabled="true">
              <event_cb trigger="clicked" callback="on_lp_bt_connect"/>
            </ui_button>
            <ui_button name="btn_bt_forget" width="#button_width_action" text="Forget" icon="delete" disabled="true">
              <event_cb trigger="clicked" callback="on_lp_bt_forget"/>
            </ui_button>
          </lv_obj>
        </setting_group>
      </lv_obj>

      <setting_group name="group_labels">
        <!-- Label count for IPP sheet printing — visible when IPP protocol detected -->
        <setting_dropdown_row name="row_label_count"
                              label="Labels Per Sheet" icon="view_grid" description="How many labels to print"
                              callback="on_lp_label_count_changed">
          <bind_flag_if_eq subject="ipp_selected" flag="hidden" ref_value="0"/>
        </setting_dropdown_row>

        <!-- Label Size + Preset (shared): side by side, stacked where half a row cannot fit a label -->
        <lv_obj name="row_size_preset"
                width="100%" height="content" style_flex_cross_place="center" style_bg_opa="0" style_border_width="0"
                style_pad_all="0" style_pad_gap="0" scrollable="false">
          <bind_style_if name="size_preset_side_by_side" cond="ui_breakpoint ge 2 and ui_is_portrait eq 0"/>
          <bind_style_if name="size_preset_stacked" cond="ui_breakpoint lt 2 or ui_is_portrait eq 1"/>
          <setting_dropdown_row name="row_label_size"
                                width="50%" label="Label Size" icon="ruler" hide_description="true" dropdown_width="55%"
                                callback="on_lp_label_size_changed">
            <bind_style_if name="fill_row" cond="ui_breakpoint lt 2 or ui_is_portrait eq 1"/>
          </setting_dropdown_row>
          <setting_dropdown_row name="row_preset"
                                width="50%" label="Preset" icon="tune" hide_description="true" dropdown_width="55%"
                                callback="on_lp_preset_changed">
            <bind_style_if name="fill_row" cond="ui_breakpoint lt 2 or ui_is_portrait eq 1"/>
          </setting_dropdown_row>
        </lv_obj>
        <!-- Test Print (shared) -->
        <lv_obj name="row_test_print"
                width="100%" height="content" flex_flow="row" style_flex_main_place="center" style_pad_all="#space_md"
                style_bg_opa="0" style_border_width="0" scrollable="false">
          <ui_button name="btn_test_print"
                     width="content" style_min_width="#button_width_action" style_pad_hor="#space_sm" text="Test Print"
                     icon="print">
            <bind_state_if_eq subject="test_printing" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_lp_test_print"/>
          </ui_button>
        </lv_obj>
      </setting_group>
    </lv_obj>
  </view>
</component>
