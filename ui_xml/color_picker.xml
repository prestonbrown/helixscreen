<!-- Modal color picker with preset swatches -->
<!-- NOTE: Use 0x prefix for literal hex colors, NOT # (# triggers constant lookup) -->
<!-- NOTE: Backdrop created programmatically by Modal system -->
<!-- Responsive: TINY screens get tabbed full-screen layout (Presets | Custom) -->
<!-- Non-TINY screens get two-column modal layout -->
<component>
  <consts>
    <px name="swatch_size" value="32"/>
    <!-- preview_size comes from globals as #color_preview_size (responsive: 40/48/56px) -->
    <!-- sv_size, hue_height registered at runtime by register_color_picker_component_constants() -->
  </consts>
  <styles>
    <!-- MICRO/TINY segment pills: the open tab is a filled primary pill (ui_button
         picks its contrast text), the other a muted ghost. -->
    <style name="picker_tab_active" bg_color="#primary" bg_opa="255"/>
    <style name="picker_tab_idle" bg_opa="0" text_color="#text_muted"/>
  </styles>
  <!-- SIZE_OK: an absolute width, not the house 70%, because the two-column
       layout below has a hard content floor and the swatch grid is a fixed-px
       row_wrap that overflows rather than reflowing. #color_picker_modal_width
       is 470 on SMALL (a 480-wide panel cannot host more) and 500+ on the core
       tiers, tracking the space_* padding growth. SMALL budget:
         space_md pad 8 x2 + left column 190 + space_lg gap 12 + grid 248 = 466
       The grid width is #swatch_grid_width at 6 columns of swatch + 2*hit
       touch targets. A percentage width narrower than the budget clips the
       rightmost swatch column.
       MICRO/TINY never see this card - ui_color_picker.cpp forces LV_PCT(100)
       and the tabbed layout below takes over. -->
  <view name="color_picker"
        extends="ui_dialog" width="#color_picker_modal_width" height="content" align="center" flex_flow="column"
        style_flex_main_place="start" style_pad_gap="0">
    <!-- Header: title + close. -->
    <modal_header title="Pick Color" hide_icon="true" hide_close="false" close_callback="color_picker_close_cb"/>
    <!-- Horizontal divider -->
    <divider_horizontal/>

    <!-- ============================================================ -->
    <!-- TINY ONLY: Segment bar for tab switching (Presets | Custom)   -->
    <!-- ============================================================ -->
    <lv_obj name="segment_bar"
            width="100%" height="content" style_pad_left="#space_md" style_pad_right="#space_md"
            style_pad_top="#space_sm" style_pad_bottom="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
      <bind_flag_if_gt subject="ui_breakpoint" flag="hidden" ref_value="1"/>
      <ui_button name="btn_tab_presets"
                 height="#button_height_sm" text="Presets" flex_grow="1" variant="ghost" focusable="false">
        <bind_style name="picker_tab_active" subject="color_picker_custom_tab" ref_value="0"/>
        <bind_style name="picker_tab_idle" subject="color_picker_custom_tab" ref_value="1"/>
        <event_cb trigger="clicked" callback="color_picker_tab_presets_cb"/>
      </ui_button>
      <ui_button name="btn_tab_custom"
                 height="#button_height_sm" text="Custom" flex_grow="1" variant="ghost" focusable="false">
        <bind_style name="picker_tab_active" subject="color_picker_custom_tab" ref_value="1"/>
        <bind_style name="picker_tab_idle" subject="color_picker_custom_tab" ref_value="0"/>
        <event_cb trigger="clicked" callback="color_picker_tab_custom_cb"/>
      </ui_button>
    </lv_obj>

    <!-- ============================================================ -->
    <!-- NON-TINY: Standard two-column content (hidden on TINY)       -->
    <!-- ============================================================ -->
    <lv_obj name="standard_content"
            width="100%" height="content" style_pad_all="#space_md" flex_flow="row" style_pad_gap="#space_lg"
            scrollable="false">
      <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="2"/>
      <!-- LEFT COLUMN: Preview + HSV Picker (fixed width to prevent jumping) -->
      <lv_obj width="190"
              height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="start"
              style_flex_cross_place="start" style_pad_gap="#space_md" scrollable="false">
        <!-- Selected colour preview: a colour area, so a rounded rect -->
        <swatch_paint name="selected_color_preview"
                      width="#color_preview_size" height="#color_preview_size_small" style_radius="#border_radius"
                      color="#card_bg"/>
        <!-- HSV picker: SV square + horizontal hue bar below -->
        <ui_hsv_picker name="hsv_picker" sv_size="#sv_size" hue_height="#hue_height" gap="#space_sm"/>
      </lv_obj>
      <!-- RIGHT COLUMN: Hex input + name + Presets -->
      <!-- Content-sized: the preset grid's row pitch varies with the class's
           touch-target padding, so a fixed height would clip it on some tiers. -->
      <lv_obj height="content"
              flex_grow="1" style_pad_all="0" flex_flow="column" style_flex_main_place="start"
              style_flex_cross_place="start" style_pad_gap="#space_sm" scrollable="false">
        <!-- TOP: Hex input + color name + presets label -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="start"
                style_flex_cross_place="start" style_pad_gap="#space_sm" scrollable="false">
          <!-- Hex input + color name row -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="start"
                  style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
            <text_input name="hex_input"
                        width="100" height="content" max_length="9" text="#808080" placeholder_text="#hex_placeholder"
                        style_outline_width="0" scrollable="false">
              <bind_style name="styles.text_tone_danger" subject="color_picker_hex_invalid" ref_value="1"/>
              <event_cb trigger="value_changed" callback="hex_input_changed_cb"/>
              <event_cb trigger="defocused" callback="hex_input_defocused_cb"/>
            </text_input>
            <lv_label name="selected_name_label" flex_grow="1" text="Gray" long_mode="wrap"/>
          </lv_obj>
          <!-- Presets label -->
          <text_small text="Presets"/>
        </lv_obj>
        <!-- BOTTOM: Presets grid (pushed to bottom via space_between) -->
        <!-- Preset grid: 6 columns x 5 rows. ColorPicker::set_palette() drives
             color_picker_palette, so only the matching grid is ever built.
             Must stay the LAST child — a reactive <if> appends its rebuilt body
             to the end of the parent's child list. -->
        <if cond="color_picker_palette eq 1">
          <color_swatch_grid palette="theme"
                             swatch_callback="color_swatch_clicked_cb" selected_subject="color_picker_selected_swatch"/>
          <else/>
          <color_swatch_grid swatch_callback="color_swatch_clicked_cb" selected_subject="color_picker_selected_swatch"/>
        </if>
      </lv_obj>
    </lv_obj>

    <!-- ============================================================ -->
    <!-- TINY ONLY: Tabbed content (hidden on non-TINY)               -->
    <!-- ============================================================ -->
    <lv_obj name="tiny_content"
            width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="0" scrollable="false">
      <bind_flag_if_gt subject="ui_breakpoint" flag="hidden" ref_value="1"/>

      <!-- Presets tab content (visible by default) -->
      <lv_obj name="presets_content"
              width="100%" height="content" style_pad_all="#space_md" flex_flow="row_wrap" style_pad_gap="#space_xs"
              style_flex_main_place="center" scrollable="false">
        <bind_flag_if_eq subject="color_picker_custom_tab" flag="hidden" ref_value="1"/>
        <!-- Only child of presets_content, so the reactive <if> ordering
             constraint is satisfied. -->
        <if cond="color_picker_palette eq 1">
          <color_swatch_grid width="100%"
                             palette="theme" swatch_callback="color_swatch_clicked_cb"
                             selected_subject="color_picker_selected_swatch" swatch_size="#picker_tab_swatch_size"
                             gap="#picker_tab_swatch_gap" gap_half="#picker_tab_swatch_gap_half"/>
          <else/>
          <color_swatch_grid width="100%"
                             swatch_callback="color_swatch_clicked_cb" selected_subject="color_picker_selected_swatch"
                             swatch_size="#picker_tab_swatch_size" gap="#picker_tab_swatch_gap"
                             gap_half="#picker_tab_swatch_gap_half"/>
        </if>
      </lv_obj>

      <!-- Custom tab content -->
      <lv_obj name="custom_content"
              width="100%" height="content" style_pad_all="#space_md" flex_flow="row" style_pad_gap="#space_md"
              style_flex_main_place="center" scrollable="false">
        <bind_flag_if_eq subject="color_picker_custom_tab" flag="hidden" ref_value="0"/>
        <!-- LEFT: HSV picker -->
        <ui_hsv_picker name="hsv_picker_tiny" sv_size="#sv_size" hue_height="#hue_height" gap="#space_sm"/>
        <!-- RIGHT: Preview + hex input + color name stacked -->
        <lv_obj width="content"
                height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="start"
                style_flex_cross_place="start" style_pad_gap="#space_sm" scrollable="false">
          <!-- Selected colour preview: a colour area, so a rounded rect -->
          <swatch_paint name="selected_color_preview_tiny"
                        width="#color_preview_size" height="#color_preview_size_small" style_radius="#border_radius"
                        color="#card_bg"/>
          <!-- Hex input -->
          <text_input name="hex_input_tiny"
                      width="100" height="content" max_length="9" text="#808080" placeholder_text="#hex_placeholder"
                      style_outline_width="0" scrollable="false">
            <bind_style name="styles.text_tone_danger" subject="color_picker_hex_invalid" ref_value="1"/>
            <event_cb trigger="value_changed" callback="hex_input_changed_cb"/>
            <event_cb trigger="defocused" callback="hex_input_defocused_cb"/>
          </text_input>
          <!-- Color name -->
          <lv_label name="selected_name_label_tiny" text="Gray" long_mode="wrap"/>
        </lv_obj>
      </lv_obj>
    </lv_obj>

    <!-- Flex spacer to push buttons to bottom on TINY (full-screen) -->
    <lv_obj flex_grow="1" scrollable="false">
      <bind_flag_if_gt subject="ui_breakpoint" flag="hidden" ref_value="1"/>
    </lv_obj>
    <!-- Action buttons row using standard modal component -->
    <modal_button_row secondary_text="Cancel"
                      secondary_callback="color_picker_cancel_cb" primary_text="Select"
                      primary_callback="color_picker_select_cb"/>
  </view>
</component>
