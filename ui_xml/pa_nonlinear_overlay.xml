<!-- Nonlinear pressure advance, tuned pass by pass on the firmware's own tower. -->
<!-- -->
<!-- Five stages selected by pa_nl_stage: READY (the next pass and the values it -->
<!-- runs with), PREPARING and PRINTING (the swept value as the tower climbs), -->
<!-- JUDGE (the height that looked best, and for a two-sided pass how the left -->
<!-- compared with the front) and RESULT (save, keep or discard). -->
<component>
  <view name="pa_nonlinear_overlay" extends="overlay_panel" title="Nonlinear Pressure Advance">
    <overlay_panel-overlay_content style_pad_left="#space_lg"
                                   style_pad_right="#space_lg" style_pad_bottom="#space_md" style_pad_top="0"
                                   flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>

      <!-- ============================================================ -->
      <!-- READY                                                        -->
      <!-- ============================================================ -->
      <lv_obj name="pa_nl_ready"
              width="100%" flex_grow="1" style_pad_all="0" flex_flow="row" style_pad_gap="#space_md" scrollable="false">
        <bind_flag_if_not_eq subject="pa_nl_stage" flag="hidden" ref_value="0"/>
        <lv_obj name="pa_nl_ready_left"
                width="1" height="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
                scrollable="false">
          <text_heading name="pa_nl_title" width="100%" bind_text="pa_nl_pass_title" long_mode="wrap"/>
          <text_small name="pa_nl_hint"
                      width="100%" bind_text="pa_nl_pass_hint" long_mode="wrap" style_text_color="#text_muted"/>
          <text_small name="pa_nl_tower_note"
                      width="100%" long_mode="wrap" style_text_color="#text_muted" hidden="true"
                      text="The firmware's test tower is not in the printer's config. Adding it writes one section and restarts Klipper.">
            <bind_flag_if_eq subject="pa_nl_has_tower" flag="hidden" ref_value="1"/>
          </text_small>
          <text_small name="pa_nl_error"
                      width="100%" bind_text="pa_nl_error" long_mode="wrap" style_text_color="#danger"/>
        </lv_obj>
        <lv_obj name="pa_nl_ready_right"
                width="1" height="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
                scrollable="false">
          <text_small text="Values" text_transform="uppercase" style_text_color="#text_muted"/>
          <text_body name="pa_nl_values" width="100%" bind_text="pa_nl_values" long_mode="wrap"/>
          <lv_obj width="100%" flex_grow="1" style_pad_all="0" scrollable="false"/>
          <ui_button name="pa_nl_btn_add_tower" width="100%" icon="cog" text="Add Tower to Config" hidden="true">
            <bind_flag_if_eq subject="pa_nl_has_tower" flag="hidden" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_pa_nl_add_tower"/>
          </ui_button>
          <ui_button name="pa_nl_btn_print" width="100%" icon="play" text="Print Tower" moves_machine="true">
            <bind_flag_if_eq subject="pa_nl_has_tower" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_pa_nl_print"/>
          </ui_button>
          <ui_button name="pa_nl_btn_discard" width="100%" variant="outline" icon="close" text="Discard">
            <event_cb trigger="clicked" callback="on_pa_nl_discard"/>
          </ui_button>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- PREPARING / PRINTING                                         -->
      <!-- ============================================================ -->
      <lv_obj name="pa_nl_running"
              width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm"
              style_flex_cross_place="center" style_flex_main_place="center" scrollable="false" hidden="true">
        <bind_flag_if cond="pa_nl_stage ne 1 and pa_nl_stage ne 2" flag="hidden"/>
        <text_body name="pa_nl_live_text" bind_text="pa_nl_live_text" long_mode="dots"/>
        <lv_label name="pa_nl_live_value"
                  bind_text="pa_nl_live_value" style_text_font="#font_display" style_text_color="#text"/>
        <text_small name="pa_nl_running_title"
                    width="100%" bind_text="pa_nl_pass_title" long_mode="wrap" style_text_align="center"
                    style_text_color="#text_muted"/>
        <ui_button name="pa_nl_btn_stop" height="#button_height_sm" text="Stop Tower" icon="stop">
          <bind_flag_if_eq subject="pa_nl_busy" flag="hidden" ref_value="2"/>
          <event_cb trigger="clicked" callback="on_pa_nl_stop"/>
        </ui_button>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- JUDGE                                                        -->
      <!-- ============================================================ -->
      <lv_obj name="pa_nl_judge"
              width="100%" flex_grow="1" style_pad_all="0" flex_flow="row" style_pad_gap="#space_md" scrollable="false"
              hidden="true">
        <bind_flag_if_not_eq subject="pa_nl_stage" flag="hidden" ref_value="3"/>
        <lv_obj name="pa_nl_judge_left"
                width="1" height="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
                scrollable="false">
          <text_heading name="pa_nl_judge_title" width="100%" bind_text="pa_nl_pass_title" long_mode="wrap"/>
          <text_small name="pa_nl_judge_hint"
                      width="100%" bind_text="pa_nl_pass_hint" long_mode="wrap" style_text_color="#text_muted"/>
          <text_small text="Best height, measured up from the plate" style_text_color="#text_muted"/>
          <lv_obj name="pa_nl_height_row"
                  width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs"
                  style_flex_cross_place="center" scrollable="false">
            <ui_button name="pa_nl_h_minus_5" width="1" height="#button_height_sm" flex_grow="1" text="-5">
              <event_cb trigger="clicked" callback="on_pa_nl_height" user_data="-5"/>
            </ui_button>
            <ui_button name="pa_nl_h_minus_1" width="1" height="#button_height_sm" flex_grow="1" text="-1">
              <event_cb trigger="clicked" callback="on_pa_nl_height" user_data="-1"/>
            </ui_button>
            <text_heading name="pa_nl_height" bind_text="pa_nl_height" style_text_align="center"/>
            <ui_button name="pa_nl_h_plus_1" width="1" height="#button_height_sm" flex_grow="1" text="+1">
              <event_cb trigger="clicked" callback="on_pa_nl_height" user_data="1"/>
            </ui_button>
            <ui_button name="pa_nl_h_plus_5" width="1" height="#button_height_sm" flex_grow="1" text="+5">
              <event_cb trigger="clicked" callback="on_pa_nl_height" user_data="5"/>
            </ui_button>
          </lv_obj>
          <text_small name="pa_nl_height_value" bind_text="pa_nl_height_value" style_text_color="#text_muted"/>
        </lv_obj>
        <lv_obj name="pa_nl_judge_right"
                width="1" height="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
                scrollable="false">
          <lv_obj width="100%" flex_grow="1" style_pad_all="0" scrollable="false"/>
          <ui_button name="pa_nl_btn_use" width="100%" icon="check" text="Use This Height">
            <bind_flag_if_eq subject="pa_nl_two_sided" flag="hidden" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_pa_nl_judge" user_data="1"/>
          </ui_button>
          <ui_button name="pa_nl_btn_lower" width="100%" text="Left Best Lower" hidden="true">
            <bind_flag_if_eq subject="pa_nl_two_sided" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_pa_nl_judge" user_data="0"/>
          </ui_button>
          <ui_button name="pa_nl_btn_same" width="100%" icon="check" text="Same Height" hidden="true">
            <bind_flag_if_eq subject="pa_nl_two_sided" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_pa_nl_judge" user_data="1"/>
          </ui_button>
          <ui_button name="pa_nl_btn_higher" width="100%" text="Left Best Higher" hidden="true">
            <bind_flag_if_eq subject="pa_nl_two_sided" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="on_pa_nl_judge" user_data="2"/>
          </ui_button>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- RESULT                                                       -->
      <!-- ============================================================ -->
      <lv_obj name="pa_nl_result"
              width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm"
              style_flex_cross_place="center" style_flex_main_place="center" scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="pa_nl_stage" flag="hidden" ref_value="4"/>
        <text_heading name="pa_nl_result_title" bind_text="pa_nl_pass_title"/>
        <text_body name="pa_nl_result_values" bind_text="pa_nl_values" long_mode="wrap"/>
        <text_small name="pa_nl_result_hint"
                    width="100%" bind_text="pa_nl_pass_hint" long_mode="wrap" style_text_align="center"
                    style_text_color="#text_muted"/>
        <text_small name="pa_nl_result_error"
                    width="100%" bind_text="pa_nl_error" long_mode="wrap" style_text_align="center"
                    style_text_color="#danger"/>
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
          <ui_button name="pa_nl_btn_result_discard"
                     width="1" flex_grow="1" variant="outline" icon="close" text="Discard">
            <event_cb trigger="clicked" callback="on_pa_nl_discard"/>
          </ui_button>
          <ui_button name="pa_nl_btn_keep" width="1" flex_grow="1" variant="secondary" icon="clock" text="Keep for Now">
            <event_cb trigger="clicked" callback="on_pa_nl_keep"/>
          </ui_button>
          <ui_button name="pa_nl_btn_save" width="1" flex_grow="1" icon="check" text="Save to Config">
            <event_cb trigger="clicked" callback="on_pa_nl_save"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
    </overlay_panel-overlay_content>
  </view>
</component>
