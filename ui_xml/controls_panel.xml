                      src="lightbulb_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
                <text_small text="Light" clickable="false" event_bubble="true"/>
                <event_cb trigger="clicked" callback="light_toggle_cb"/>
              </ui_button>
            </lv_obj>
          </lv_obj>
          <!-- Macro row 2: macro_3 + macro_4 -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
            <ui_button name="btn_macro_3"
                       width="0" height="#button_height" style_pad_ver="0" flex_grow="1" bind_text="macro_3_name"
                       variant="secondary" style_text_font="#font_small" long_mode="wrap" moves_machine="true">
              <bind_flag_if_eq subject="macro_3_visible" flag="hidden" ref_value="0"/>
              <!-- Two disable reasons that compose: moves_machine carries the
                   job guard, this bind carries the availability half. -->
              <bind_state_if cond="macro_3_available eq 0" state="disabled"/>
              <event_cb trigger="clicked" callback="on_controls_macro" user_data="2"/>
            </ui_button>
            <!-- The light toggle, when this slot holds it (see resolve_quick_slots) -->
            <lv_obj name="macro_3_light_cell"
                    width="0" height="#button_height" flex_grow="1" style_pad_all="0" scrollable="false" hidden="true">
              <bind_flag_if cond="macro_3_light eq 0 or led_controllable eq 0" flag="hidden"/>
              <!-- DUPLICATE_NAME_OK: each slot cell hands itself to its own LedWidget, which finds light_button inside that cell -->
              <ui_button name="light_button"
                         width="100%" height="100%" style_pad_ver="0" variant="secondary" flex_flow="row"
                         style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_xs"
                         focusable="false">
                <bind_state_if cond="printer_connection_state ne 2 or led_command_in_flight eq 1" state="disabled"/>
                <!-- DUPLICATE_NAME_OK: found per cell by that cell's LedWidget -->
                <icon name="light_icon"
                      src="lightbulb_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
                <text_small text="Light" clickable="false" event_bubble="true"/>
                <event_cb trigger="clicked" callback="light_toggle_cb"/>
              </ui_button>
            </lv_obj>
            <ui_button name="btn_macro_4"
                       width="0" height="#button_height" style_pad_ver="0" flex_grow="1" bind_text="macro_4_name"
                       variant="secondary" style_text_font="#font_small" long_mode="wrap" moves_machine="true">
              <bind_flag_if_eq subject="macro_4_visible" flag="hidden" ref_value="0"/>
              <!-- Two disable reasons that compose: moves_machine carries the
                   job guard, this bind carries the availability half. -->
              <bind_state_if cond="macro_4_available eq 0" state="disabled"/>
              <event_cb trigger="clicked" callback="on_controls_macro" user_data="3"/>
