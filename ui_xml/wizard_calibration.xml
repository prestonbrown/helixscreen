<component>
  <!-- First-Run Wizard, last page: calibrate now with the guided run, or skip and calibrate
       later from Advanced > Calibration. Setup is already complete when the run opens. -->
  <consts>
    <str name="step_title" value="Calibrate your printer" value_tag="Calibrate your printer"/>
    <str name="step_subtitle"
         value="Run the calibrations this printer needs now, or later from Advanced, Calibration."
         value_tag="Run the calibrations this printer needs now, or later from Advanced, Calibration."/>
  </consts>
  <view name="wizard_calibration_root"
        extends="lv_obj" width="100%" height="100%" style_bg_opa="0" style_border_width="0" style_pad_all="0"
        flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center">
    <ui_card width="100%"
             flex_grow="1" style_pad_all="#space_md" style_pad_gap="#space_sm" flex_flow="column"
             style_flex_main_place="center" style_flex_cross_place="center" scrollable="false">
      <icon src="tune" size="lg" variant="secondary">
        <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
      </icon>
      <text_body name="wizard_calibration_steps"
                 width="100%" bind_text="wizard_calibration_steps" long_mode="wrap" style_text_align="center"/>
      <text_small name="wizard_calibration_time"
                  width="100%" bind_text="wizard_calibration_time" long_mode="wrap" style_text_align="center"
                  style_text_color="#text_muted"/>
      <ui_button name="btn_wizard_calibrate_now"
                 width="50%" style_min_height="#touch_target_min" text="Calibrate now" moves_machine="true">
        <event_cb trigger="clicked" callback="on_wizard_calibrate_now"/>
      </ui_button>
    </ui_card>
  </view>
</component>
