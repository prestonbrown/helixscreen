<component>
  <api>
    <!-- "N icons", from the icon map's size -->
    <prop name="icon_count_text" type="string" default=""/>
    <!-- GlyphsPanel fills it with one glyph_item per icon map entry. -->
    <slot name="glyph_list"/>
  </api>
  <view name="glyphs_panel" extends="lv_obj" width="100%" height="100%">
    <!-- Container with vertical flex layout -->
    <lv_obj width="100%" height="100%" flex_flow="column" style_bg_color="#screen_bg" style_pad_all="0">
      <!-- Header -->
      <lv_obj width="100%"
              height="#header_height" style_bg_color="#card_bg" style_pad_all="#space_lg" flex_flow="row"
              style_flex_main_place="space_between" style_flex_cross_place="center">
        <text_heading text="MDI Icons"/>
        <text_small name="glyph_count_label" text="$icon_count_text"/>
      </lv_obj>
      <!-- Scrollable content area -->
      <lv_obj name="glyph_list"
              width="100%" flex_grow="1" scrollable="true" flex_flow="column" style_bg_color="#screen_bg"
              style_pad_all="#space_lg" style_pad_row="#space_md"/>
    </lv_obj>
  </view>
</component>
