<component>
  <!-- overlay_bg and overlay_text are theme-aware pairs defined in globals.xml -->
  <consts>
    <!-- metadata_clip_height is declared at top level in ui_xml/print_status_panel.xml, -->
    <!-- where token discovery registers it globally; referenced here. -->
  </consts>
  <styles>
    <!-- Fully transparent but still takes up layout space -->
    <style name="invisible" opa="0"/>
  </styles>
  <!-- Print Status Panel - Active print monitoring with G-code 3D viewer -->
  <!-- Portrait: preview on top, controls stacked below. Width is re-applied by NavigationManager at push time (ui_set_overlay_width). -->
  <view name="print_status_panel"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" style_bg_opa="255"
        style_bg_color="#card_bg" style_pad_all="0" style_border_width="0" flex_flow="column" clickable="true">
    <!-- Header Bar with the dedicated E-Stop slot. The slot floats the e-stop
         circle (ignore_layout) and reserves a horizontal gutter so any future
         action button shifts left rather than sitting under it. The circle
         overflows header_height at micro/tiny (prestonbrown/helixscreen#1204);
         the slot handles that itself, so this panel no longer needs a standalone
         floating FAB. estop_visible_subject gates it to active prints. -->
    <header_bar name="overlay_header"
                title="Print Status" title_tag="Print Status" estop_visible_subject="estop_visible"/>
    <!-- Content Area (portrait: stacked column, viewer on top, controls below) -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="0"
            flex_flow="column" style_pad_gap="#space_md" scrollable="false">
      <!-- Disable content when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- ================================================================== -->
      <!-- TOP SECTION: G-code Viewer / Thumbnail (fills remaining height)    -->
      <!-- ================================================================== -->
      <!-- Shared with the landscape layout - see components/print_status_preview_card.xml.
           Only the sizing differs: full width, swallows the column's leftover height. -->
      <print_status_preview_card width="100%" flex_grow="1"/>

      <!-- SLACK ABSORBER between the preview block and the controls block.
           thumbnail_section is the column's only flex_grow child, so on an
           ultratall panel it swallows everything the controls decline and the
           model ends up adrift in a 302x1090 band. C++ caps the card at
           helix::ui::portrait_preview_card_max_height() (measured width, so it
           cannot be a style attribute here) and sizes this child to the
           remainder, which is the only way to land the leftover BETWEEN the two
           blocks: LVGL treats a flex track containing any grow item as full, so
           a capped card on its own strands the slack below the controls and
           style_flex_main_place="space_between" cannot see it either.

           No bg of its own — transparent, so the gap is whatever the panel
           background is (#card_bg on the view root) and follows the theme.
           Starts hidden with height 0, and stays that way at every size where
           the cap does not bind; a hidden child is skipped by the flex pass
           entirely, size AND gap, so those sizes lay out exactly as they did
           before the cap existed. -->
      <lv_obj name="preview_slack"
              width="100%" height="0" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
              hidden="true">

        <!-- The temperature mini-graph sits at the TOP of the absorber, full
             width, capped square by C++ (helix::ui::portrait_graph_height() —
             measured width, so it cannot be a style attribute here). Filling the
             whole absorber was the first cut and it read badly: at 320x1480 that
             is a 302x709 plot where a reheat is a vertical wall and steady state
             is three flat lines in half a screen of void. Whatever the graph does
             not take stays transparent, so the remainder reads as background
             between the graph and the controls.

             height="0" because the height is C++'s to decide and the absorber is
             the same: the cap runs before print_status_graph_fits is published,
             so the container is never shown at a size nobody chose.

             It is a CHILD of the absorber rather than the absorber itself so that
             each hidden flag has exactly ONE owner. preview_slack's visibility is
             imperative by necessity — it is the same measured-layout decision as
             its height, and hidden is how a flex child costs zero. The graph's
             visibility is a declarative binding on print_status_graph_fits.
             Collapsing the two onto one object would leave C++ writing the flag
             directly while the observer writes it on subject change, and whichever
             ran last would win at an arbitrary time.

             Populated from C++ (PrintStatusPanel::ensure_temp_graph) — the graph
             is a procedural chart widget, so there is no XML beneath it to bind. -->
        <lv_obj name="temp_graph_container"
                width="100%" height="0" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
                clickable="true">
          <bind_flag_if_eq subject="print_status_graph_fits" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_print_status_graph_clicked"/>
        </lv_obj>

      </lv_obj>

      <!-- ================================================================== -->
      <!-- BOTTOM SECTION: Controls (content height, full width)          -->
      <!-- ================================================================== -->
      <lv_obj name="controls_section"
              width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
              style_pad_gap="#space_md">

        <!-- Compact Temperature Strip: nozzle / bed / chamber as one row of icon chips -->
        <ui_card name="temp_card"
                 width="100%" height="content" style_radius="#border_radius" flex_flow="row" style_pad_top="#space_sm"
                 style_pad_bottom="#space_sm" style_pad_left="#space_md" style_pad_right="#space_md"
                 style_pad_gap="#space_sm" style_flex_cross_place="center" scrollable="false" clickable="true">
          <event_cb trigger="clicked" callback="on_temp_card_clicked"/>

          <lv_obj name="nozzle_row"
                  width="content" height="content" flex_grow="1" style_pad_all="0" flex_flow="row"
                  style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false" clickable="false"
                  event_bubble="true">
            <icon src="heater" size="sm" variant="muted" clickable="false" event_bubble="true"/>
            <temp_display name="nozzle_temp"
                          size="md" show_target="true" bind_current="extruder_temp" bind_target="extruder_target"
                          flex_grow="1" clickable="false" event_bubble="true"/>
          </lv_obj>

          <lv_obj name="bed_row"
                  width="content" height="content" flex_grow="1" style_pad_all="0" flex_flow="row"
                  style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false" clickable="false"
                  event_bubble="true">
            <icon src="radiator" size="sm" variant="muted" clickable="false" event_bubble="true"/>
            <temp_display name="bed_temp"
                          size="md" show_target="true" bind_current="bed_temp" bind_target="bed_target" flex_grow="1"
                          clickable="false" event_bubble="true"/>
          </lv_obj>

          <lv_obj name="chamber_row"
                  width="content" height="content" flex_grow="1" style_pad_all="0" flex_flow="row"
                  style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false" clickable="false"
                  event_bubble="true" hidden="true">
            <bind_flag_if_eq subject="printer_has_chamber" flag="hidden" ref_value="0"/>
            <icon src="fridge_industrial" size="sm" variant="muted" clickable="false" event_bubble="true"/>
            <temp_display name="chamber_temp_display"
                          size="md" show_target="true" bind_current="chamber_temp"
                          bind_target="chamber_effective_target" bind_mode="chamber_mode" flex_grow="1"
                          clickable="false" event_bubble="true"/>
          </lv_obj>
        </ui_card>

        <!-- Merged status row: Speed/Flow on the left, filament + AMS on the right. -->
        <!-- Tap opens Tune overlay (same as Tune button) -->
        <lv_obj name="speed_flow_row"
                width="100%" height="content" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="0"
                flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
                style_pad_gap="#space_sm" scrollable="false" clickable="true">
          <event_cb trigger="clicked" callback="on_print_status_tune"/>
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_xs" scrollable="false" clickable="false" event_bubble="true">
            <text_small text="Speed" translation_tag="Speed" clickable="false" event_bubble="true"/>
            <text_small name="speed_value" bind_text="print_speed_text" clickable="false" event_bubble="true"/>
            <text_small text=" · " clickable="false" event_bubble="true"/>
            <text_small text="Flow" translation_tag="Flow" clickable="false" event_bubble="true"/>
            <text_small name="flow_value" bind_text="print_flow_text" clickable="false" event_bubble="true"/>
          </lv_obj>

          <!-- Filament + AMS cluster (was its own row in the baseline) -->
          <lv_obj name="filament_ams_status_row"
                  width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_sm" scrollable="false">
            <!-- Filament Sensor Status — the no-AMS form of the runout glyph;
                 stands down while ams_status_row carries it. See the landscape
                 panel for why the cond needs both terms. -->
            <lv_obj name="filament_status_row"
                    width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_sm">
              <bind_flag_if cond="filament_sensor_count eq 0 or (ams_slot_count gt 0 and ams_current_tool ge 0)"
                            flag="hidden"/>
              <filament_sensor_indicator subject="filament_runout_scoped"/>
            </lv_obj>
            <!-- Tool Change Progress (hidden when no multi-color swaps expected) -->
            <lv_obj name="toolchange_status"
                    width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_xs">
              <bind_flag_if_eq subject="toolchange_visible" flag="hidden" ref_value="0"/>
              <icon src="swap_vertical" size="sm" variant="muted"/>
              <text_small bind_text="toolchange_text"/>
            </lv_obj>
            <!-- AMS Current Tool Status (hidden if no AMS) -->
            <lv_obj name="ams_status_row"
                    width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_sm">
              <bind_flag_if_eq subject="ams_slot_count" flag="hidden" ref_value="0"/>
              <ams_current_tool name="ams_current_tool_indicator" runout_subject="filament_runout_scoped"/>
            </lv_obj>
          </lv_obj>
        </lv_obj>

        <!-- Fan info row: part / hotend / aux speeds, click → fan control overlay. -->
        <print_status_fan_row name="print_status_fan_row"/>

        <!-- Control buttons: ONE row of five, each flex_grow=1, icon stacked over label. -->
        <lv_obj name="button_grid"
                width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                style_flex_cross_place="center" style_pad_gap="#space_sm">
          <lv_obj width="100%"
                  height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_main_place="center"
                  style_flex_cross_place="center" style_pad_gap="#space_sm">
            <ui_button name="btn_light"
                       height="#button_height" flex_grow="1" text="Light" translation_tag="Light"
                       icon="lightbulb_outline" bind_icon="light_button_icon" icon_position="top">
              <event_cb trigger="clicked" callback="on_print_status_light"/>
              <bind_flag_if_eq subject="led_controllable" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="led_command_in_flight" state="disabled" ref_value="1"/>
            </ui_button>
            <ui_button name="btn_timelapse"
                       height="#button_height" flex_grow="1" icon="video_off" bind_icon="timelapse_button_icon"
                       text="Off" bind_text="timelapse_button_label" icon_position="top">
              <event_cb trigger="clicked" callback="on_print_status_timelapse"/>
              <bind_flag_if_eq subject="printer_has_timelapse" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="print_controls_enabled" state="disabled" ref_value="0"/>
            </ui_button>
            <ui_button name="btn_pause"
                       height="#button_height" flex_grow="1" icon="pause" bind_icon="print_control_primary_icon"
                       text="Pause" bind_text="print_control_primary_label" icon_position="top">
              <event_cb trigger="clicked" callback="on_print_control_primary"/>
              <bind_state_if_eq subject="print_control_primary_enabled" state="disabled" ref_value="0"/>
            </ui_button>
            <ui_button name="btn_tune"
                       height="#button_height" flex_grow="1" icon="tune" text="Tune" translation_tag="Tune"
                       icon_position="top">
              <event_cb trigger="clicked" callback="on_print_status_tune"/>
              <bind_state_if_eq subject="print_controls_enabled" state="disabled" ref_value="0"/>
            </ui_button>
            <ui_button name="btn_cancel"
                       height="#button_height" flex_grow="1" variant="danger" icon="stop" text="Cancel"
                       translation_tag="Cancel" icon_position="top">
              <bind_flag_if_not_eq subject="print_outcome" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="print_control_stop_enabled" state="disabled" ref_value="0"/>
              <event_cb trigger="clicked" callback="on_print_control_stop"/>
            </ui_button>
            <ui_button name="btn_reprint"
                       height="#button_height" flex_grow="1" icon="refresh" text="Reprint" translation_tag="Reprint"
                       icon_position="top" hidden="true">
              <bind_flag_if_eq subject="print_outcome" flag="hidden" ref_value="0"/>
              <event_cb trigger="clicked" callback="on_print_status_reprint"/>
            </ui_button>
          </lv_obj>
        </lv_obj>

        <!-- Plugin injection point: widgets from plugins appear here -->
        <!-- Plugins can inject print monitoring widgets, sensor readouts, etc. -->
        <lv_obj name="print_status_extras"
                width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_md"/>
      </lv_obj>
    </lv_obj>

    <!-- E-Stop FAB — child of the panel ROOT (full-height), not the header, so
         it never clips and stays fully hit-testable regardless of header_height
         (prestonbrown/helixscreen#1204). The header_bar above reserves a spacer
         gutter (estop_visible_subject) so the title never runs under this FAB.
         estop_visible covers PRINTING + PAUSED + the preparing phase. Declared
         last so it draws above the content it overlaps. -->
    <lv_button name="estop_fab"
               width="44" height="44" ignore_layout="true" align="top_right" style_translate_y="#space_sm"
               style_radius="9999" style_bg_color="#danger" style_pad_all="0" hidden="true">
      <bind_flag_if_eq subject="estop_visible" flag="hidden" ref_value="0"/>
      <icon src="alert_octagon" size="md" color="#text" align="center"/>
      <event_cb trigger="clicked" callback="emergency_stop_clicked"/>
    </lv_button>
  </view>
</component>
