<component>
  <api>
    <prop name="name_subject" type="string" default=""/>
    <prop name="desc_subject" type="string" default=""/>
    <prop name="visible_subject" type="string" default=""/>
    <prop name="desc_hidden_subject" type="string" default=""/>
    <prop name="chevron_hidden_subject" type="string" default=""/>
    <prop name="defaults_hidden_subject" type="string" default=""/>
    <prop name="row_index" type="string" default=""/>
  </api>
  <view name="macro_card"
        extends="lv_button" width="100%" height="content" style_radius="#border_radius" style_bg_color="#card_bg"
        style_bg_opa="255" style_border_width="0" style_pad_all="#space_md" style_shadow_width="0">
    <!-- Content container: checkbox (edit mode) + icon + text -->
    <lv_obj width="100%"
            height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
            scrollable="false" clickable="false">
      <!-- Leading slot: code icon (normal) OR visibility checkbox (edit mode). Same
           footprint so the row does not shift between modes. -->
      <lv_obj name="lead_slot" width="content" height="content" clickable="false" event_bubble="true">
        <!-- code icon: shown when NOT editing -->
        <icon name="macro_icon"
              src="code_tags" size="sm" variant="primary" align="center" clickable="false" event_bubble="true">
          <bind_flag_if_eq subject="macro_edit_mode" flag="hidden" ref_value="1"/>
        </icon>
        <!-- checkbox (outline box + light check overlaid): shown when editing -->
        <lv_obj name="check_wrap" width="content" height="content" align="center" clickable="false" event_bubble="true">
          <bind_flag_if_eq subject="macro_edit_mode" flag="hidden" ref_value="0"/>
          <icon name="chk_box"
                src="check_box_outline_blank" size="sm" variant="secondary" align="center" clickable="false"
                event_bubble="true"/>
          <icon name="chk_mark"
                src="check" size="xs" variant="secondary" align="center" clickable="false" event_bubble="true">
            <bind_flag_if_eq subject="$visible_subject" flag="hidden" ref_value="0"/>
          </icon>
        </lv_obj>
      </lv_obj>
      <!-- Text container: name + optional description -->
      <lv_obj flex_grow="1" flex_flow="column" style_pad_gap="#space_xs" scrollable="false" clickable="false">
        <text_body name="macro_label" bind_text="$name_subject"/>
        <text_small name="macro_desc"
                    width="100%" bind_text="$desc_subject" style_text_color="#text_muted" long_mode="dots">
          <bind_flag_if_eq subject="$desc_hidden_subject" flag="hidden" ref_value="1"/>
        </text_small>
      </lv_obj>
      <!-- Edit-mode "Default Parameters" editor entry: KNOWN_PARAMS rows only
           (the panel hides it otherwise). event_bubble off so the tap edits
           defaults instead of toggling the row's visibility checkbox. -->
      <ui_button name="defaults_btn"
                 width="#button_height_sm" height="#button_height_sm" icon="tune" variant="ghost" focusable="false"
                 event_bubble="false">
        <bind_flag_if_eq subject="$defaults_hidden_subject" flag="hidden" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_macro_defaults_clicked" user_data="$row_index"/>
      </ui_button>
      <!-- Chevron indicating it's tappable -->
      <icon name="chevron_icon" src="chevron_right" size="sm" variant="secondary">
        <bind_flag_if_eq subject="$chevron_hidden_subject" flag="hidden" ref_value="1"/>
      </icon>
    </lv_obj>
    <!-- Event callback: branches on edit mode (toggle visibility vs. run macro) -->
    <event_cb trigger="clicked" callback="on_macro_row_clicked" user_data="$row_index"/>
    <!-- Long-press enters edit mode (suppressed mid-scroll in C++) -->
    <event_cb trigger="long_pressed" callback="on_macro_card_long_press" user_data="$row_index"/>
  </view>
</component>
