<!-- Screws Tilt Adjust Panel - Manual bed leveling with visual screw diagram -->
<!-- Iterative workflow: Probe -> Show results -> User adjusts -> Re-probe -> Repeat -->
<component>
  <consts>
    <!-- ===================================================================== -->
    <!-- Responsive Screws Tilt Panel Sizes (bed_diagram_*, screw_indicator_*) -->
    <!-- ===================================================================== -->
    <!-- Bed diagram container height -->
    <px name="bed_diagram_height_small" value="130"/>
    <px name="bed_diagram_height_medium" value="160"/>
    <px name="bed_diagram_height_large" value="200"/>

    <!-- Screw indicator compound widget size (direction + adjustment text) -->
    <px name="screw_indicator_width_small" value="54"/>
    <px name="screw_indicator_width_medium" value="64"/>
    <px name="screw_indicator_width_large" value="80"/>
    <px name="screw_indicator_height_small" value="48"/>
    <px name="screw_indicator_height_medium" value="56"/>
    <px name="screw_indicator_height_large" value="68"/>

    <px name="panel_button_width" value="140"/>
  </consts>
  <!-- Responsive constants (bed_diagram_height, screw_indicator_*) defined in globals.xml -->
  <view name="screws_tilt_panel"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" style_bg_opa="255"
        style_bg_color="#card_bg" style_pad_all="0" style_border_width="0" scrollable="false" flex_flow="column">
    <!-- Header Bar -->
    <header_bar name="overlay_header" title="Bed Screw Adjustment" title_tag="Bed Screw Adjustment"/>
    <!-- Content Area -->
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="#space_lg" flex_flow="column" style_pad_gap="#space_md"
            scrollable="false">
      <!-- Disable content when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- ================================================================== -->
      <!-- STATE: IDLE - Instructions and Start Button -->
      <!-- ================================================================== -->
      <lv_obj name="state_idle"
              width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_lg" scrollable="false">
        <bind_flag_if_not_eq subject="screws_tilt_state" flag="hidden" ref_value="0"/>
        <!-- Instructions -->
        <lv_obj width="100%" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm">
          <text_heading width="100%"
                        text="Manual Bed Leveling" translation_tag="Manual Bed Leveling" style_text_align="center"/>
          <text_small width="100%"
                      text="This tool probes each bed screw and tells you how much to adjust."
                      translation_tag="This tool probes each bed screw and tells you how much to adjust."
                      style_text_align="center"/>
          <!-- Generic text - not hex-key specific -->
          <text_small width="100%"
                      text="Have your bed adjustment tool (screwdriver, hex-key, etc.) ready if your bed isn't adjusted with                              thumb wheels or some other built-in mechanism."
                      translation_tag="Have your bed adjustment tool (screwdriver, hex-key, etc.) ready if your bed isn't adjusted with                              thumb wheels or some other built-in mechanism."
                      style_text_align="center"/>
        </lv_obj>
        <!-- Steps Preview -->
        <lv_obj width="90%"
                height="content" style_bg_color="#section_bg_color" style_radius="#border_radius"
                style_pad_all="#space_lg" flex_flow="column" style_pad_gap="#space_xs">
          <text_small width="100%"
                      text="1. Printer will home and probe each screw"
                      translation_tag="1. Printer will home and probe each screw"/>
          <text_small width="100%"
                      text="2. Results show how much to turn each screw"
                      translation_tag="2. Results show how much to turn each screw"/>
          <text_small width="100%"
                      text="3. Adjust screws, then re-probe to verify"
                      translation_tag="3. Adjust screws, then re-probe to verify"/>
          <text_small width="100%" text="4. Repeat until bed is level" translation_tag="4. Repeat until bed is level"/>
        </lv_obj>
        <!-- Start Button -->
        <ui_button name="btn_start" width="#panel_button_width" text="Start Probing" translation_tag="Start Probing">
          <event_cb trigger="clicked" callback="screws_tilt_start_cb"/>
        </ui_button>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: PROBING - Waiting for probe to complete -->
      <!-- ================================================================== -->
      <lv_obj name="state_probing"
              width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_lg" scrollable="false">
        <bind_flag_if_not_eq subject="screws_tilt_state" flag="hidden" ref_value="1"/>
        <spinner size="lg"/>
        <text_heading width="100%"
                      text="Probing Bed Screws..." translation_tag="Probing Bed Screws..." style_text_align="center"/>
        <text_small width="100%"
                    text="Please wait while the printer probes each screw position."
                    translation_tag="Please wait while the printer probes each screw position."
                    style_text_align="center"/>
        <!-- Cancel Button -->
        <ui_button name="btn_cancel_probing"
                   width="#panel_button_width" text="Cancel" translation_tag="Cancel" variant="danger">
          <event_cb trigger="clicked" callback="screws_tilt_cancel_cb"/>
        </ui_button>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: RESULTS - Horizontal layout: Bed diagram LEFT, List+Buttons RIGHT -->
      <!-- Also shows success banner when all screws are within tolerance -->
      <!-- ================================================================== -->
      <lv_obj name="state_results"
              width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm"
              style_flex_cross_place="center" scrollable="false">
        <bind_flag_if_not_eq subject="screws_tilt_state" flag="hidden" ref_value="2"/>
        <!-- Success banner (shown when all screws are level) -->
        <lv_obj name="success_banner"
                width="100%" height="content" style_pad_all="#space_sm" flex_flow="row" style_flex_main_place="center"
                style_flex_cross_place="center" style_pad_gap="#space_sm" style_bg_color="#success" style_bg_opa="40"
                style_radius="#border_radius" scrollable="false">
          <bind_flag_if_eq subject="results_is_leveled" flag="hidden" ref_value="0"/>
          <lv_label text="#icon_check_circle" style_text_font="mdi_icons_24" style_text_color="#success"/>
          <text_body text="Bed is Level!" translation_tag="Bed is Level!" style_text_color="#success"/>
          <text_small name="probe_count_label" bind_text="probe_count_text" style_text_color="#success"/>
        </lv_obj>
        <!-- Main content: diagram + list side by side -->
        <lv_obj name="results_content"
                width="100%" flex_grow="1" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
                style_pad_gap="#space_md" scrollable="false">
          <!-- LEFT: Bed Diagram (square aspect, takes ~45% width) -->
          <lv_obj name="bed_diagram_column"
                  width="45%" height="100%" style_pad_all="0" flex_flow="column" style_flex_main_place="center"
                  style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false">
            <!-- Bed Diagram Container (square) -->
            <lv_obj name="bed_diagram_container"
                    width="100%" flex_grow="1" style_bg_color="#section_bg_color" style_radius="#border_radius"
                    style_pad_all="#space_sm" scrollable="false">
              <!-- Screw indicators positioned dynamically by C++ code using LVGL alignment -->
            </lv_obj>
            <!-- FRONT label below diagram -->
            <text_xs text="^ FRONT" translation_tag="^ FRONT"/>
          </lv_obj>
          <!-- RIGHT: Screw List + Buttons (takes ~55% width) -->
          <lv_obj name="results_right_column"
                  height="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm"
                  scrollable="false">
            <!-- Instruction text (hidden when leveled) -->
            <text_small name="results_instruction"
                        width="100%" text="Adjust screws, then re-probe."
                        translation_tag="Adjust screws, then re-probe." style_text_align="center">
              <bind_flag_if_eq subject="results_is_leveled" flag="hidden" ref_value="1"/>
            </text_small>
            <!-- Legend for rotation icons -->
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
                    style_pad_gap="#space_lg" scrollable="false">
              <lv_obj height="content"
                      style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs"
                      scrollable="false">
                <icon src="rotate_right" size="xs" variant="secondary"/>
                <text_xs text="= Tighten" translation_tag="= Tighten"/>
              </lv_obj>
              <lv_obj height="content"
                      style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs"
                      scrollable="false">
                <icon src="rotate_left" size="xs" variant="secondary"/>
                <text_xs text="= Loosen" translation_tag="= Loosen"/>
              </lv_obj>
            </lv_obj>
            <!-- Screw List - 4 pre-defined rows with subject bindings -->
            <lv_obj name="screw_list_container"
                    width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
                    scrollable="true">
              <!-- Row 0 -->
              <lv_obj name="screw_row_0"
                      width="100%" height="content" style_bg_color="#section_bg_color" style_bg_opa="255"
                      style_radius="6" style_pad_all="#space_sm" flex_flow="row" style_flex_main_place="space_between"
                      style_flex_cross_place="center" scrollable="false">
                <bind_flag_if_eq subject="screw_0_visible" flag="hidden" ref_value="0"/>
                <lv_obj name="screw_dot_0" width="10" height="10" style_radius="32767" style_bg_opa="255"/>
                <text_body name="screw_name_0" bind_text="screw_0_name" flex_grow="1" style_pad_left="#space_sm"/>
                <text_body name="screw_adj_0" bind_text="screw_0_adjustment"/>
              </lv_obj>
              <!-- Row 1 -->
              <lv_obj name="screw_row_1"
                      width="100%" height="content" style_bg_color="#section_bg_color" style_bg_opa="255"
                      style_radius="6" style_pad_all="#space_sm" flex_flow="row" style_flex_main_place="space_between"
                      style_flex_cross_place="center" scrollable="false">
                <bind_flag_if_eq subject="screw_1_visible" flag="hidden" ref_value="0"/>
                <lv_obj name="screw_dot_1" width="10" height="10" style_radius="32767" style_bg_opa="255"/>
                <text_body name="screw_name_1" bind_text="screw_1_name" flex_grow="1" style_pad_left="#space_sm"/>
                <text_body name="screw_adj_1" bind_text="screw_1_adjustment"/>
              </lv_obj>
              <!-- Row 2 -->
              <lv_obj name="screw_row_2"
                      width="100%" height="content" style_bg_color="#section_bg_color" style_bg_opa="255"
                      style_radius="6" style_pad_all="#space_sm" flex_flow="row" style_flex_main_place="space_between"
                      style_flex_cross_place="center" scrollable="false">
                <bind_flag_if_eq subject="screw_2_visible" flag="hidden" ref_value="0"/>
                <lv_obj name="screw_dot_2" width="10" height="10" style_radius="32767" style_bg_opa="255"/>
                <text_body name="screw_name_2" bind_text="screw_2_name" flex_grow="1" style_pad_left="#space_sm"/>
                <text_body name="screw_adj_2" bind_text="screw_2_adjustment"/>
              </lv_obj>
              <!-- Row 3 -->
              <lv_obj name="screw_row_3"
                      width="100%" height="content" style_bg_color="#section_bg_color" style_bg_opa="255"
                      style_radius="6" style_pad_all="#space_sm" flex_flow="row" style_flex_main_place="space_between"
                      style_flex_cross_place="center" scrollable="false">
                <bind_flag_if_eq subject="screw_3_visible" flag="hidden" ref_value="0"/>
                <lv_obj name="screw_dot_3" width="10" height="10" style_radius="32767" style_bg_opa="255"/>
                <text_body name="screw_name_3" bind_text="screw_3_name" flex_grow="1" style_pad_left="#space_sm"/>
                <text_body name="screw_adj_3" bind_text="screw_3_adjustment"/>
              </lv_obj>
            </lv_obj>
            <!-- Re-centring hint: the same plane described the cheap way round.
                 Klipper's per-screw numbers above stay authoritative so the panel
                 remains cross-checkable against Fluidd and the console; this only
                 appears when moving the datum alone would genuinely save turns. -->
            <text_small name="recenter_hint"
                        width="100%" bind_text="screws_tilt_recenter_hint" style_text_align="center" long_mode="wrap"
                        style_pad_top="#space_xs">
              <bind_flag_if_eq subject="screws_tilt_recenter_available" flag="hidden" ref_value="0"/>
            </text_small>
            <!-- Action Buttons (bottom of right column) -->
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
                    style_pad_gap="#space_sm" scrollable="false">
              <!-- Share results: opens a modal with the values as text + a QR code -->
              <ui_button name="btn_share"
                         width="#icon_button_size_lg" height="#icon_button_size_lg" variant="ghost" icon="qrcode_scan">
                <event_cb trigger="clicked" callback="screws_tilt_share_cb"/>
              </ui_button>
              <ui_button name="btn_done_results" width="100" text="Done" translation_tag="Done">
                <event_cb trigger="clicked" callback="screws_tilt_done_cb"/>
              </ui_button>
              <ui_button name="btn_reprobe" width="25%" text="Re-probe" translation_tag="Re-probe">
                <event_cb trigger="clicked" callback="screws_tilt_reprobe_cb"/>
              </ui_button>
            </lv_obj>
          </lv_obj>
        </lv_obj>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: ERROR - Something went wrong -->
      <!-- ================================================================== -->
      <lv_obj name="state_error"
              width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_lg" scrollable="false">
        <bind_flag_if_not_eq subject="screws_tilt_state" flag="hidden" ref_value="3"/>
        <lv_label text="#icon_close_circle" style_text_font="mdi_icons_48" style_text_color="#danger"/>
        <text_heading text="Probing Failed" translation_tag="Probing Failed" style_text_align="center"/>
        <text_muted name="error_message"
                    width="80%" bind_text="error_message_text" style_text_align="center" long_mode="wrap"/>
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
                style_pad_gap="#space_md" scrollable="false">
          <ui_button name="btn_close_error" width="#panel_button_width" text="Close" translation_tag="Close">
            <event_cb trigger="clicked" callback="screws_tilt_done_cb"/>
          </ui_button>
          <ui_button name="btn_retry" width="#panel_button_width" text="Retry" translation_tag="Retry">
            <event_cb trigger="clicked" callback="screws_tilt_retry_cb"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
    </lv_obj>
  </view>
</component>
