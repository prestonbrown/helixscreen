<component>
  <!-- MICRO OVERRIDE of ui_xml/components/header_bar.xml for 480x272 displays -->
  <!-- Divergences from standard:
       - Height: 40px (vs 48px standard)
       - Title: left-aligned (vs centered) to maximize usable width
       - Padding: #space_sm left, #space_xl right (vs larger standard padding)
  -->
  <!-- Reusable Header Bar: back button + title + optional action button -->
  <!-- API Properties -->
  <api>
    <prop name="title" type="string"/>
    <prop name="title_tag" type="string" default=""/>
    <!-- Optional trailing badge: a small image plus a short label, for a screen
         that needs to show WHICH record it is editing. Both parts are empty by
         default and the group stays hidden unless title_badge_subject resolves
         to 1. The label text is left to the owning screen — bind
         "header_title_badge_text" with lv_label_bind_text. -->
    <prop name="title_badge_image" type="string" default=""/>
    <prop name="title_badge_subject" type="string" default=""/>
    <!-- Back button callback - defaults to standard navigation go_back -->
    <prop name="back_button_callback" type="string" default="on_header_back_clicked"/>
    <!-- Text-based action button (use action_button_text) -->
    <prop name="action_button_text" type="string" default=""/>
    <prop name="action_button_text_tag" type="string" default=""/>
    <!-- Icon-based action button (use action_button_icon instead of text) -->
    <prop name="action_button_icon" type="string" default=""/>
    <!-- Icon size for action_button: sm (default), md, lg. md/lg scale the -->
    <!-- icon-only e-stop glyph up on micro/small displays. -->
    <prop name="action_button_icon_size" type="string" default="sm"/>
    <!-- Hide the icon in action button (for text-only buttons) -->
    <prop name="hide_action_button_icon" type="string" default="false"/>
    <!-- Hide the text label in action button (for icon-only circular buttons) -->
    <prop name="hide_action_button_text" type="string" default="false"/>
    <prop name="action_button_icon_color" type="string" default="#text"/>
    <!-- Styling props for custom action buttons (e.g., E-stop) -->
    <prop name="action_button_bg_color" type="string" default="#primary"/>
    <prop name="action_button_radius" type="string" default="#border_radius"/>
    <!-- Button dimensions - use same value for width/height + radius=9999 for circular buttons -->
    <prop name="action_button_width" type="string" default="content"/>
    <prop name="action_button_height" type="string" default="content"/>
    <prop name="action_button_pad" type="string" default="#space_sm"/>
    <!-- Use hide_action_button="false" to show the action button -->
    <prop name="hide_action_button" type="string" default="true"/>
    <prop name="action_button_callback" type="string" default=""/>
    <!-- Subject name for reactive disabled state binding (empty = no binding) -->
    <prop name="action_button_disabled_subject" type="string" default=""/>
    <!-- Expression form of the above, for buttons whose disabled state depends on
         more than one subject. Mirrors the base header_bar; see its comment for
         why the two forms are mutually exclusive and why ordering matters. -->
    <prop name="action_button_disabled_cond" type="string" default="0"/>
    <!-- Optional int subject: 1 hides the action button entirely (per-view Save) -->
    <prop name="action_button_hidden_subject" type="string" default=""/>
    <!-- Second action button (appears to LEFT of primary action button) -->
    <prop name="action_button_2_text" type="string" default=""/>
    <prop name="action_button_2_text_tag" type="string" default=""/>
    <prop name="action_button_2_bg_color" type="string" default="#secondary"/>
    <prop name="action_button_2_callback" type="string" default=""/>
    <prop name="hide_action_button_2" type="string" default="true"/>
    <!-- Dedicated E-Stop spacer (rightmost). Mirrors the base header_bar; see
         its comment. The floating circle lives at the panel root, not here. -->
    <prop name="estop_visible_subject" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="100%" height="40" style_pad_left="0" style_pad_right="#space_xl" style_pad_top="0" style_pad_bottom="0"
        flex_flow="row" style_flex_main_place="space_between" style_flex_track_place="center"
        style_flex_cross_place="center" scrollable="false">
    <!-- Back button: flex_grow region covers arrow + title = huge touch target -->
    <lv_obj name="back_button"
            height="100%" flex_grow="1" style_pad_left="#space_xs" style_pad_right="0" style_pad_top="0"
            style_pad_bottom="0" scrollable="false" clickable="true" style_flex_cross_place="center"
            style_flex_track_place="center" flex_flow="row" style_pad_gap="#space_xs">
      <event_cb trigger="clicked" callback="$back_button_callback"/>
      <icon src="back" size="lg" variant="text" clickable="false" event_bubble="true"/>
      <text_heading name="header_title"
                    text="$title" translation_tag="$title_tag" text_transform="uppercase" flex_grow="1"
                    style_text_align="left" clickable="false" event_bubble="true" scrollable="false"/>
      <!-- Trailing badge (image + label), see the props above. -->
      <lv_obj name="header_title_badge"
              width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
              style_pad_gap="#space_xxs" hidden="true" clickable="false" event_bubble="true" scrollable="false">
        <bind_flag_if_eq subject="$title_badge_subject" flag="hidden" ref_value="0"/>
        <lv_image src="$title_badge_image"
                  style_image_recolor="#text_muted" style_image_recolor_opa="255" clickable="false" event_bubble="true"/>
        <text_small name="header_title_badge_text" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
      </lv_obj>
    </lv_obj>
    <!-- Secondary action button (left of primary, hidden by default) -->
    <ui_button name="action_button_2"
               width="content" height="$action_button_height" style_min_width="72"
               style_bg_color="$action_button_2_bg_color" hidden="$hide_action_button_2" text="$action_button_2_text"
               translation_tag="$action_button_2_text_tag">
      <event_cb trigger="clicked" callback="$action_button_2_callback"/>
    </ui_button>
    <!-- Primary action button (hidden by default, pass hide_action_button="false" to show) -->
    <!-- Supports both text (action_button_text) and icon (action_button_icon) modes -->
    <!-- For icon-only buttons like E-stop, use circular radius and custom bg_color -->
    <ui_button name="action_button"
               width="$action_button_width" height="$action_button_height" style_radius="$action_button_radius"
               style_bg_color="$action_button_bg_color" hidden="$hide_action_button" icon="$action_button_icon"
               icon_size="$action_button_icon_size" text="$action_button_text" translation_tag="$action_button_text_tag">
      <!-- Expression-driven disabled binding. Must precede the subject binding below;
           see the action_button_disabled_cond prop comment in the base header_bar. -->
      <bind_state_if cond="$action_button_disabled_cond" state="disabled"/>
      <!-- Reactive disabled state binding (enabled when subject exists and is non-empty) -->
      <bind_state_if_eq subject="$action_button_disabled_subject" state="disabled" ref_value="1"/>
      <!-- Reactive hidden binding: 1 hides the action button entirely (per-view Save) -->
      <bind_flag_if_eq subject="$action_button_hidden_subject" flag="hidden" ref_value="1"/>
      <event_cb trigger="clicked" callback="$action_button_callback"/>
    </ui_button>
    <!-- E-Stop spacer: rightmost reserved gutter — NO button inside. The
         floating circle lives at the panel root; this just keeps the title and
         any action button clear of it. See base header_bar for full design. -->
    <!-- SIZE_OK: 48 matches estop_slot_width_micro in the base file's ladder
         (FAB 44 + 4px margin). Micro override has no <consts> block by
         convention; a token would not resolve to 48 at this tier anyway. -->
    <lv_obj name="estop_slot"
            width="48" height="100%" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
            clickable="false" hidden="true">
      <bind_flag_if_eq subject="$estop_visible_subject" flag="hidden" ref_value="0"/>
    </lv_obj>
  </view>
</component>
