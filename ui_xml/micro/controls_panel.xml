<!-- MICRO OVERRIDE of ui_xml/controls_panel.xml for 480x272 displays -->
<component>
  <styles>
    <!-- Motion goes inline where the position row is too short to stack -->
    <style name="motion_stacked" flex_flow="column" layout="flex" pad_row="#space_xs"/>
    <style name="motion_inline" flex_flow="row" layout="flex" pad_column="#space_xs"/>
    <style name="motion_label_inline" text_font="#font_small"/>
    <!-- Homing button styles -->
    <style name="home_btn_homed" bg_color="#success"/>
    <style name="home_btn_unhomed" bg_color="#card_bg"/>
    <!-- Note: home_label styles removed - ui_button auto-contrast handles text color -->
    <!-- Motor icon styles: warning when enabled, dimmed when disabled -->
    <style name="icon_motors_enabled" text_color="#warning"/>
    <style name="icon_motors_disabled" text_color="#text_muted"/>
    <!-- Homing indicator styles for Position card -->
    <style name="indicator_homed" bg_color="#success"/>
    <style name="indicator_unhomed" bg_color="#text_muted"/>
  </styles>
  <!-- Main container: 3+2 layout (3 cards top, 2 cards bottom) -->
  <!-- NOTE: Using explicit heights (55%) instead of flex-grow to work around LVGL bug
       where hidden objects affect flex-grow space calculation -->
  <view name="controls_panel"
        extends="lv_obj" width="100%" height="100%" style_pad_all="#space_xs" style_border_width="0" flex_flow="column"
        style_bg_color="#screen_bg" style_pad_gap="#space_xs" scrollable="false">
    <!-- Disable all controls when printer not connected or klippy not ready -->
    <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
    <!-- Row 1: Position card (left) | Right section with conditional E-Stop + Temps/Cooling -->
    <!-- Using explicit 55% height instead of flex-grow to avoid LVGL hidden-object bug -->
    <lv_obj width="100%" height="50%" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs" scrollable="false">
      <!-- Card 1: Position (Toolhead Position + Motion) -->
      <ui_card name="card_position"
               height="100%" flex_grow="1" flex_flow="column" style_flex_main_place="space_between"
               style_radius="#border_radius" style_pad_all="#space_xs" scrollable="false">
        <!-- Header -->
        <lv_obj flex_flow="row"
                style_flex_cross_place="center" style_flex_track_place="center" style_pad_all="0"
                style_pad_gap="#space_sm">
          <icon src="axis_arrow" size="sm" variant="primary"/>
          <text_small text="Position" style_translate_y="2" style_text_color="#text"/>
        </lv_obj>
        <!-- Position display with homing indicators -->
        <!-- Split into static label + dynamic value for proper alignment with proportional fonts -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" scrollable="false" flex_flow="column" style_pad_gap="#space_xxs">
          <!-- X Position Row -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_xs">
            <text_muted width="content" text="X:"/>
            <text_body name="pos_x" bind_text="controls_pos_x" flex_grow="1" style_text_align="right"/>
            <lv_obj width="10" height="10" style_radius="9999" style_margin_left="#space_xs">
              <bind_style name="indicator_homed" subject="x_homed" ref_value="1"/>
              <bind_style name="indicator_unhomed" subject="x_homed" ref_value="0"/>
            </lv_obj>
          </lv_obj>
          <!-- Y Position Row -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_xs">
            <text_muted width="content" text="Y:"/>
            <text_body name="pos_y" bind_text="controls_pos_y" flex_grow="1" style_text_align="right"/>
            <lv_obj width="10" height="10" style_radius="9999" style_margin_left="#space_xs">
              <bind_style name="indicator_homed" subject="y_homed" ref_value="1"/>
              <bind_style name="indicator_unhomed" subject="y_homed" ref_value="0"/>
            </lv_obj>
          </lv_obj>
          <!-- Z Position Row -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_xs">
            <text_muted width="content" text="Z:"/>
            <text_body name="pos_z" bind_text="controls_pos_z" flex_grow="1" style_text_align="right"/>
            <lv_obj width="10" height="10" style_radius="9999" style_margin_left="#space_xs">
              <bind_style name="indicator_homed" subject="z_homed" ref_value="1"/>
              <bind_style name="indicator_unhomed" subject="z_homed" ref_value="0"/>
            </lv_obj>
          </lv_obj>
          <!-- Z-Offset display (clickable to open Print Tune overlay) -->
          <lv_obj name="btn_zoffset_tune"
                  width="100%" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs"
                  style_margin_top="#space_sm" clickable="true" scrollable="false" style_radius="#border_radius">
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="on_zoffset_tune"/>
            <text_muted width="content" text="Z-Off:"/>
            <text_body bind_text="controls_z_offset" flex_grow="1" style_text_align="right"/>
            <icon src="chevron_right" size="xs" variant="secondary"/>
          </lv_obj>
        </lv_obj>
        <!-- Save Z-Offset button. Same rule and same handler as the full-size
             Controls panel: z_offset_save_available covers the firmware-auto-save
             test and both kinds of dirtiness, machine-wide and per-tool. -->
        <ui_button name="btn_save_z_offset"
                   width="100%" height="#button_height_sm" variant="success" icon="check" text="Save Z-Offset"
                   hidden="true" moves_machine="true">
          <bind_flag_if_eq subject="z_offset_save_available" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_controls_save_z_offset"/>
        </ui_button>
        <!-- Motion | Motors Off. Motors Off keeps a fixed tappable width and
             Motion takes the rest; Motors Off drops its label where the row is
             too short for one. -->
        <lv_obj name="position_action_row"
                width="100%" height="#button_height_sm" style_pad_all="0" flex_flow="row"
                style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false">
          <!-- Icon over label like Motors Off beside it, so the icons share a line
               and the labels the next; inline where Motors Off is icon-only. -->
          <ui_button name="btn_motion"
                     width="0" height="100%" flex_grow="1" variant="primary" style_pad_all="0" flex_flow="column"
                     style_flex_main_place="center" style_flex_cross_place="center">
            <!-- The direction lives on this wrapper: a style cannot override the
                 button's own local layout, but can set a plain container's. -->
            <lv_obj width="content"
                    height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                    style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
                    clickable="false" event_bubble="true" scrollable="false">
              <bind_style_if_ge name="motion_stacked" subject="ui_breakpoint" ref_value="2"/>
              <bind_style_if_le name="motion_inline" subject="ui_breakpoint" ref_value="1"/>
              <icon name="btn_motion_icon"
                    src="cursor_move" size="#controls_toggle_icon_size" clickable="false" event_bubble="true"/>
              <text_tiny text="Motion" style_text_color="#text" clickable="false" event_bubble="true">
                <bind_style_if_le name="motion_label_inline" subject="ui_breakpoint" ref_value="1"/>
              </text_tiny>
            </lv_obj>
            <event_cb trigger="clicked" callback="on_controls_quick_actions"/>
          </ui_button>
          <home_action_tile name="btn_motors_tile"
                            width="#controls_toggle_width" height="100%" flex_grow="0" icon="engine"
                            icon_variant="warning" alt_icon="engine_off" alt_icon_variant="secondary"
                            icon_swap_subject="motors_enabled" icon_size="#controls_toggle_icon_size" label="Motors Off"
                            label_hidden_cond="ui_breakpoint le 1" callback="on_calibration_motors"
                            button_name="btn_motors" icon_name="btn_motors_icon" moves_machine="true"
                            disabled_cond="motors_enabled eq 0"/>
        </lv_obj>
      </ui_card>
      <!-- Right section: Temps + Cooling -->
      <lv_obj height="100%"
              flex_grow="2" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" style_pad_row="0"
              scrollable="false">
        <!-- Temps + Cooling row (always visible) -->
        <lv_obj width="100%"
                flex_grow="1" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs" scrollable="false">
          <!-- Card 2: Temperatures (Combined Nozzle + Bed) -->
          <ui_card name="card_temperatures"
                   height="100%" flex_grow="1" flex_flow="column" style_flex_main_place="start"
                   style_flex_cross_place="center" style_radius="#border_radius" style_pad_all="#space_xs"
                   scrollable="false">
            <lv_obj width="100%"
                    height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                    style_pad_gap="#space_sm" scrollable="false">
              <icon src="thermometer" size="sm" variant="secondary"/>
              <text_small text="Temperatures" style_translate_y="2" style_text_color="#text"/>
            </lv_obj>
            <!-- Nozzle section (clickable) -->
            <lv_obj name="btn_nozzle_temp"
                    width="100%" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
                    style_margin_top="#space_xs" clickable="true" scrollable="false" style_radius="#border_radius">
              <style name="styles.press_wash" selector="pressed"/>
              <event_cb trigger="clicked" callback="on_nozzle_temp_clicked"/>
              <!-- Left side: animated heater icon + label -->
              <lv_obj width="content"
                      height="content" flex_flow="row" style_pad_all="0" scrollable="false"
                      style_flex_cross_place="center" style_pad_gap="#space_xs" clickable="false" event_bubble="true">
                <icon name="nozzle_icon_glyph"
                      src="heater" size="xs" variant="secondary" clickable="false" event_bubble="true"/>
                <temp_display name="nozzle_temp_display"
                              size="md" show_target="true" bind_current="extruder_temp" bind_target="extruder_target"
                              clickable="false" event_bubble="true"/>
              </lv_obj>
              <!-- Right side: temp display + edit icon -->
              <lv_obj name="nozzle_temp_edit_container"
                      width="content" height="content" flex_flow="row" style_pad_all="0" scrollable="false"
                      style_flex_cross_place="center" style_pad_gap="#space_xs" clickable="true" ext_click_area="12"
                      style_radius="#border_radius">
                <style name="styles.press_wash" selector="pressed"/>
                <event_cb trigger="clicked" callback="on_nozzle_target_edit"/>
                <icon src="pencil" size="xs" variant="tertiary" clickable="false" event_bubble="true"/>
              </lv_obj>
            </lv_obj>
            <!-- Bed section (clickable) -->
            <lv_obj name="btn_bed_temp"
                    width="100%" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
                    clickable="true" scrollable="false" style_radius="#border_radius">
              <style name="styles.press_wash" selector="pressed"/>
              <event_cb trigger="clicked" callback="on_bed_temp_clicked"/>
              <!-- Left side: animated bed icon + label -->
              <lv_obj width="content"
                      height="content" flex_flow="row" style_pad_all="0" scrollable="false"
                      style_flex_cross_place="center" style_pad_gap="#space_xs" clickable="false" event_bubble="true">
                <heater_icon src="radiator" glyph_name="bed_icon_glyph" size="xs"/>
                <temp_display name="bed_temp_display"
                              size="md" show_target="true" bind_current="bed_temp" bind_target="bed_target"
                              clickable="false" event_bubble="true"/>
              </lv_obj>
              <!-- Right side: temp display + edit icon -->
              <lv_obj name="bed_temp_edit_container"
                      width="content" height="content" flex_flow="row" style_pad_all="0" scrollable="false"
                      style_flex_cross_place="center" style_pad_gap="#space_xs" clickable="true" ext_click_area="12"
                      style_radius="#border_radius">
                <style name="styles.press_wash" selector="pressed"/>
                <event_cb trigger="clicked" callback="on_bed_target_edit"/>
                <icon src="pencil" size="xs" variant="tertiary" clickable="false" event_bubble="true"/>
              </lv_obj>
            </lv_obj>
            <!-- Chamber section (visible only if printer has chamber sensor) -->
            <lv_obj name="btn_chamber_temp"
                    width="100%" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center"
                    hidden="true" clickable="true" scrollable="false" style_radius="#border_radius">
              <style name="styles.press_wash" selector="pressed"/>
              <bind_flag_if_eq subject="printer_has_chamber" flag="hidden" ref_value="0"/>
              <event_cb trigger="clicked" callback="on_chamber_temp_clicked"/>
              <!-- Left side: icon + label + temp display -->
              <lv_obj width="content"
                      height="content" flex_flow="row" style_pad_all="0" scrollable="false"
                      style_flex_cross_place="center" style_pad_gap="#space_xs" clickable="false" event_bubble="true">
                <heater_icon src="fridge_industrial" glyph_name="chamber_icon_glyph" size="xs"/>
                <temp_display name="chamber_temp_display"
                              size="md" show_target="true" bind_current="chamber_temp"
                              bind_target="chamber_effective_target" bind_mode="chamber_mode" clickable="false"
                              event_bubble="true"/>
              </lv_obj>
              <!-- Right side: edit icon -->
              <lv_obj name="chamber_temp_edit_container"
                      width="content" height="content" flex_flow="row" style_pad_all="0" scrollable="false"
                      style_flex_cross_place="center" style_pad_gap="#space_xs" clickable="true" ext_click_area="12"
                      style_radius="#border_radius">
                <style name="styles.press_wash" selector="pressed"/>
                <event_cb trigger="clicked" callback="on_chamber_target_edit"/>
                <icon src="pencil" size="xs" variant="tertiary" clickable="false" event_bubble="true"/>
              </lv_obj>
            </lv_obj>
            <!-- "N more sensors" link to the sensors overlay; hidden when there are none -->
            <lv_obj name="secondary_temps_list"
                    width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row"
                    style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_top="#space_xxs"
                    clickable="true">
              <bind_flag_if_eq subject="controls_more_sensors_count" flag="hidden" ref_value="0"/>
              <event_cb trigger="clicked" callback="on_controls_more_sensors"/>
              <text_small name="more_sensors_label"
                          bind_text="controls_more_sensors" style_text_color="#text_muted" clickable="false"
                          event_bubble="true"/>
              <icon src="chevron_right" size="xs" variant="secondary" clickable="false" event_bubble="true"/>
            </lv_obj>
          </ui_card>
          <!-- Card 3: Cooling (Multi-Fan) -->
          <ui_card name="card_cooling"
                   height="100%" flex_grow="1" flex_flow="column" style_flex_main_place="start" style_pad_gap="0"
                   style_flex_cross_place="center" style_radius="#border_radius" style_pad_all="#space_xs"
                   scrollable="false" clickable="true">
            <event_cb trigger="clicked" callback="on_controls_cooling"/>
            <lv_obj width="100%"
                    height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                    style_pad_gap="#space_sm" scrollable="false">
              <icon name="fan_icon" src="fan" size="sm" variant="primary"/>
              <text_small text="Cooling" style_translate_y="2" style_text_color="#text"/>
            </lv_obj>
            <!-- Part cooling hero section -->
            <text_small width="100%" text="Part Fan" style_margin_top="#space_sm"/>
            <lv_slider name="part_fan_slider"
                       width="80%" height="#space_lg" bind_value="controls_fan_pct" min_value="0" max_value="100"
                       style_radius="#space_md" style_margin_left="#space_md" style_margin_right="#space_sm">
              <event_cb trigger="value_changed" callback="on_controls_fan_slider"/>
            </lv_slider>
            <text_body name="fan_speed_display" width="80%" bind_text="controls_fan_speed" style_text_align="right">
              <!-- ref_value matches the base file's "hide at TINY". This file only
                   ever loads on the MICRO layout, where ui_breakpoint is pinned to
                   0, so the condition never fires and the readout stays visible —
                   which is the point: the slider position is the only other fan
                   feedback on a 480x272 panel. -->
              <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="1"/>
            </text_body>
            <!-- Secondary fans list (populated dynamically) -->
            <lv_obj name="secondary_fans_list"
                    width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="column"
                    style_pad_gap="#space_xxs" style_pad_top="#space_xs" clickable="true">
              <event_cb trigger="clicked" callback="on_controls_secondary_fans"/>
              <!-- Fan rows are added here by C++ -->
            </lv_obj>
          </ui_card>
        </lv_obj>
      </lv_obj>
    </lv_obj>
    <!-- Row 2: Calibration & Tools (40%) | Quick Actions (60%) -->
    <!-- Using flex_grow here since Row 1 has explicit 55% height -->
    <lv_obj width="100%" flex_grow="1" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs" scrollable="false">
      <!-- Card 4: Calibration & Tools (40% width, 2x2 grid) -->
      <ui_card name="card_calibration"
               width="0" height="100%" flex_grow="2" flex_flow="column" style_flex_main_place="start"
               style_radius="#border_radius" style_border_width="0" style_pad_all="#space_xs" style_pad_gap="#space_xs"
               scrollable="false">
        <!-- Header Row -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_sm">
          <icon src="wrench" size="sm" variant="primary"/>
          <text_small text="Calibration &amp; Tools" style_translate_y="2" style_text_color="#text"/>
        </lv_obj>
        <!-- Calibration grid: one wrapping flow of tiles, so a hidden tile drops
             out and whatever is visible packs without gaps. Each layout pass
             refits the visible tiles to the grid's size (calib_tile.xml). -->
        <lv_obj name="calib_tools_grid"
                width="100%" flex_grow="1" style_pad_all="0" flex_flow="row_wrap" style_flex_main_place="center"
                style_flex_track_place="space_evenly" style_pad_row="#space_xs" style_pad_column="#space_xs"
                scrollable="false">
          <event_cb trigger="layout_changed" callback="on_calib_grid_layout_changed"/>
          <calib_tile icon="grid_large"
                      label="Bed Mesh" callback="on_calibration_bed_mesh" button_name="btn_bed_mesh"
                      icon_name="btn_bed_mesh_icon"/>
          <calib_tile icon="z_closer"
                      label="Z Calibration" callback="on_calibration_zoffset" button_name="btn_z_calibration"
                      icon_name="btn_z_calibration_icon" moves_machine="true">
            <bind_flag_if cond="printer_z_offset_per_head eq 1 or (printer_has_tool_offset_cal eq 1 and hide_manual_z_calibration eq 1)"
                          flag="hidden"/>
          </calib_tile>
          <calib_tile icon="axis_arrow"
                      label="Tool Offsets" callback="on_calibration_tool_offsets" button_name="btn_tool_offsets"
                      icon_name="btn_tool_offsets_icon" moves_machine="true" hidden="true">
            <bind_flag_if_eq subject="printer_has_tool_offset_cal" flag="hidden" ref_value="0"/>
          </calib_tile>
          <calib_tile icon="gauge"
                      label="Pressure Adv." callback="on_calibration_pa" button_name="btn_pa_cal"
                      icon_name="btn_pa_cal_icon" moves_machine="true" hidden="true">
            <bind_flag_if cond="printer_has_pa_cal eq 0" flag="hidden"/>
          </calib_tile>
          <calib_tile icon="wrench"
                      label="Bed Screws" callback="on_calibration_screws" button_name="btn_screws"
                      icon_name="btn_screws_icon" moves_machine="true" hidden="true">
            <bind_flag_if cond="printer_has_screws_tilt eq 0" flag="hidden"/>
          </calib_tile>
        </lv_obj>
      </ui_card>
      <!-- Card 5: Quick Actions (60% width) -->
      <ui_card name="card_quick_actions"
               width="0" height="100%" flex_grow="3" flex_flow="column" style_flex_main_place="space_between"
               style_radius="#border_radius" style_pad_all="#space_xs" scrollable="false">
        <!-- Header -->
        <lv_obj flex_flow="row"
                style_flex_cross_place="center" style_flex_track_place="center" style_pad_all="0"
                style_pad_gap="#space_sm">
          <icon src="flash" size="sm" variant="primary"/>
          <text_small text="Quick Actions" style_translate_y="2" style_text_color="#text"/>
        </lv_obj>
        <!-- Home row: label + segmented homing button bar -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_xs">
          <text_small text="Home"/>
          <button_group flex_grow="1">
            <button_group_item name="btn_home_all"
                               width="0" style_min_width="content" style_pad_hor="#space_xs" text="All" flex_grow="1"
                               style_border_width="0" moves_machine="true">
              <bind_style name="home_btn_homed" subject="all_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="all_homed" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_all"/>
            </button_group_item>
            <button_group_item name="btn_home_x"
                               width="0" style_min_width="content" style_pad_hor="#space_xs" text="X" flex_grow="1"
                               moves_machine="true">
              <bind_style name="home_btn_homed" subject="x_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="x_homed" ref_value="0"/>
              <bind_flag_if_eq subject="printer_has_individual_xyz_homing" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_x"/>
            </button_group_item>
            <button_group_item name="btn_home_y"
                               width="0" style_min_width="content" style_pad_hor="#space_xs" text="Y" flex_grow="1"
                               moves_machine="true">
              <bind_style name="home_btn_homed" subject="y_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="y_homed" ref_value="0"/>
              <bind_flag_if_eq subject="printer_has_individual_xyz_homing" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_y"/>
            </button_group_item>
            <button_group_item name="btn_home_xy"
                               width="0" style_min_width="content" style_pad_hor="#space_xs" text="XY" flex_grow="1"
                               moves_machine="true">
              <bind_style name="home_btn_homed" subject="xy_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="xy_homed" ref_value="0"/>
              <bind_flag_if_eq subject="printer_has_individual_xyz_homing" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_xy"/>
            </button_group_item>
            <button_group_item name="btn_home_z"
                               width="0" style_min_width="content" style_pad_hor="#space_xs" text="Z" flex_grow="1"
                               moves_machine="true">
              <bind_style name="home_btn_homed" subject="z_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="z_homed" ref_value="0"/>
              <bind_flag_if_eq subject="printer_has_individual_xyz_homing" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_z"/>
            </button_group_item>
          </button_group>
        </lv_obj>
        <!-- Macro buttons grid with QGL/Z-Tilt -->
        <lv_obj width="100%"
