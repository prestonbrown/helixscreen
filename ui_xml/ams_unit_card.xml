<component>
  <consts>
    <!-- Mini bar dimensions (used by C++ for dynamic bar creation) -->
    <px name="status_line_height" value="3"/>
    <px name="status_line_gap" value="2"/>
  </consts>
  <api>
    <!-- Unit index the click callback receives as event user_data. -->
    <prop name="index" type="int" default="0"/>
    <!-- 1 while the unit is an absent placeholder: a box address held for a box
         that is not on the bus. The card shows disabled and says so. -->
    <prop name="absent" type="subject" default="ams_env_ind_off_flag"/>
    <!-- 1 while the unit's logo is full-color art, drawn as is; 0 for a white mono mark,
         which is tinted to the text color. -->
    <prop name="logo_color" type="subject" default="ams_env_ind_off_flag"/>
    <!-- 1 while a present unit is reported offline: drawn faded, with a chip. -->
    <prop name="disconnected" type="subject" default="ams_env_ind_off_flag"/>
    <prop name="temp_text" type="subject" default="ams_env_ind_0_temp_text"/>
    <prop name="humidity_text" type="subject" default="ams_env_ind_0_humidity_text"/>
    <prop name="humidity" type="subject" default="ams_env_ind_0_humidity"/>
    <prop name="humidity_status" type="subject" default="ams_env_ind_0_humidity_status"/>
    <prop name="humidity_visible" type="subject" default="ams_env_ind_0_humidity_visible"/>
    <prop name="visible" type="subject" default="ams_env_ind_0_visible"/>
    <prop name="drying_active" type="subject" default="ams_env_ind_0_drying_active"/>
    <prop name="drying_text" type="subject" default="ams_env_ind_0_drying_text"/>
  </api>
  <view name="ams_unit_card"
        extends="lv_obj" height="content" scrollable="false" flex_flow="column" style_flex_main_place="start"
        style_flex_cross_place="center" style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="#border_radius"
        style_pad_ver="#space_sm" style_pad_hor="#space_xs" style_pad_gap="#space_xs" style_border_width="1"
        style_border_color="#border" style_border_opa="80" style_min_width="#ams_card_min_width"
        style_max_width="#ams_card_max_width" clickable="true">
    <style name="styles.press_wash" selector="pressed"/>
    <event_cb trigger="clicked" callback="on_ams_unit_card_clicked" user_data="$index"/>
    <bind_state_if_eq subject="$absent" state="disabled" ref_value="1"/>
    <!-- Offline fades the header, bars and readout, but not the card itself: it stays
         tappable (its detail still shows what it last reported) and the chip keeps full
         contrast, since a parent's opa would fade it too. -->
    <!-- Unit header: logo + name (clickable=false + event_bubble so clicks reach card) -->
    <lv_obj name="unit_header"
            width="100%" height="content" scrollable="false" clickable="false" event_bubble="true" flex_flow="row"
            style_flex_main_place="center" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_xs"
            style_bg_opa="0" style_border_width="0">
      <bind_style_if_eq name="styles.unit_offline" subject="$disconnected" ref_value="1"/>
      <!-- The logo is the first thing to go when the cards are width-starved: on a
           5-unit rig it costs ~28px of a ~102px card, and the unit's NAME is what
           the row is for. No inline hidden="" here - an inline attr would outrank
           the binding. -->
      <lv_obj name="unit_logo_slot"
              width="#ams_logo_size" height="#ams_logo_size" style_pad_all="0" scrollable="false" clickable="false"
              event_bubble="true" style_bg_opa="0" style_border_width="0">
        <bind_flag_if_eq subject="ams_cards_compact" flag="hidden" ref_value="1"/>
        <lv_image name="unit_logo" width="100%" height="100%" align="center" inner_align="contain">
          <bind_style_if_eq name="styles.ams_logo_mono" subject="$logo_color" ref_value="0"/>
        </lv_image>
      </lv_obj>
      <!-- width="1"+flex_grow so the label is sized by the row rather than by its
           own content: a name longer than the card used to size to content, overflow
           the centered row, and get clipped at BOTH ends ("HTLF Claymore 1" read as
           "TLF Claym"). long_mode="dots" needs a bounded width to do anything. -->
      <text_body name="unit_name"
                 width="1" height="#ams_unit_name_h" text="Unit" flex_grow="1" long_mode="dots"
                 style_text_align="center"/>
    </lv_obj>
    <!-- Body: the lane bars take the card's full width; under them one line holds
         either the lane count or the environment readout. The readout takes it
         while ams_cards_env_line says it fits under a full row of bars (the
         overview measures that); otherwise it is left to the unit's own page.
         Either way the card keeps one line under the bars, so its height does
         not depend on the environment. -->
    <lv_obj width="100%"
            height="content" scrollable="false" clickable="false" event_bubble="true" flex_flow="column"
            style_flex_main_place="center" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_xs"
            style_bg_opa="0" style_border_width="0">
      <!-- Mini status bars container (clickable=false + event_bubble so clicks reach card) -->
      <lv_obj name="bars_container"
              width="100%" height="#ams_bars_height" scrollable="false" clickable="false" event_bubble="true"
              flex_flow="row" style_flex_main_place="center" style_flex_cross_place="end" style_pad_all="0"
              style_pad_column="#space_xxs" style_bg_opa="0" style_border_width="0">
        <bind_style_if_eq name="styles.unit_offline" subject="$disconnected" ref_value="1"/>
      </lv_obj>
      <!-- Lane count; a noun too long for the card ellipsizes. -->
      <text_small name="slot_count"
                  width="100%" text="0 slots" long_mode="dots" style_text_align="center" event_bubble="true">
        <bind_flag_if_eq subject="$absent" flag="hidden" ref_value="1"/>
        <bind_flag_if_eq subject="$disconnected" flag="hidden" ref_value="1"/>
        <bind_flag_if cond="ams_cards_env_line and ${visible}" flag="hidden"/>
      </text_small>
      <ams_disconnected_chip name="unit_disconnected_chip" disconnected="$disconnected"/>
      <text_small name="unit_absent_label" text="Not connected" event_bubble="true">
        <bind_flag_if_eq subject="$absent" flag="hidden" ref_value="0"/>
      </text_small>
      <!-- Environment readout on one line: temperature (the heat icon and the dryer's
           status while it dries), then humidity in its comfort-range color. Tapping it
           opens the unit's environment overlay. The icons are a size down from the
           text so the line fits a narrow card. Its width is content-sized whether
           shown or not, which is what the overview measures. A disconnected unit's
           chip takes the line instead. -->
      <lv_obj name="env_indicator"
              width="content" height="content" scrollable="false" clickable="true" flex_flow="row"
              style_flex_main_place="center" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_xs"
              style_bg_opa="0" style_border_width="0" hidden="true">
        <style name="styles.press_wash" selector="pressed"/>
        <bind_flag_if cond="ams_cards_env_line and ${visible} and ${disconnected} eq 0" flag="hidden" invert="true"/>
        <event_cb trigger="clicked" callback="on_env_indicator_clicked"/>
        <lv_obj width="content"
                height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_xxs" scrollable="false" clickable="false" event_bubble="true">
          <icon src="thermometer" size="xs" variant="secondary" clickable="false" event_bubble="true">
            <bind_flag_if_not_eq subject="$drying_active" flag="hidden" ref_value="0"/>
          </icon>
          <icon src="heat_wave" size="xs" variant="warning" clickable="false" event_bubble="true" hidden="true">
            <bind_flag_if_eq subject="$drying_active" flag="hidden" ref_value="0"/>
          </icon>
          <text_small bind_text="$temp_text" clickable="false" event_bubble="true">
            <bind_flag_if_not_eq subject="$drying_active" flag="hidden" ref_value="0"/>
          </text_small>
          <text_small bind_text="$drying_text"
                      style_text_color="#warning" clickable="false" event_bubble="true" hidden="true">
            <bind_flag_if_eq subject="$drying_active" flag="hidden" ref_value="0"/>
          </text_small>
        </lv_obj>
        <lv_obj name="env_humidity"
                width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_xxs" scrollable="false" clickable="false" event_bubble="true" hidden="true">
          <bind_flag_if_not_eq subject="$humidity_visible" flag="hidden" ref_value="1"/>
          <humidity_drop name="env_humidity_drop" bind_value="$humidity" size="xs" clickable="false" event_bubble="true"/>
          <text_small bind_text="$humidity_text" clickable="false" event_bubble="true" hidden="true">
            <bind_flag_if_not_eq subject="$humidity_status" flag="hidden" ref_value="0"/>
          </text_small>
          <text_small bind_text="$humidity_text"
                      style_text_color="#warning" clickable="false" event_bubble="true" hidden="true">
            <bind_flag_if_not_eq subject="$humidity_status" flag="hidden" ref_value="1"/>
          </text_small>
          <text_small bind_text="$humidity_text"
                      style_text_color="#danger" clickable="false" event_bubble="true" hidden="true">
            <bind_flag_if_not_eq subject="$humidity_status" flag="hidden" ref_value="2"/>
          </text_small>
        </lv_obj>
      </lv_obj>
      <!-- Filament runout indicator — only shown on a real runout (print paused).
           ams_filament_runout is gated on PAUSED state in ams_state.cpp so the
           pre-load filament_useup assertion at print start never lights it. -->
      <icon name="runout_indicator" src="alert" size="sm" variant="warning" hidden="true" event_bubble="true">
        <bind_flag_if_eq subject="ams_filament_runout" flag="hidden" ref_value="0"/>
      </icon>
    </lv_obj>
  </view>
</component>
