<component>
  <consts>
    <!-- Mini bar dimensions (used by C++ for dynamic bar creation) -->
    <px name="status_line_height" value="3"/>
    <px name="status_line_gap" value="2"/>
  </consts>
  <api>
    <prop name="temp_text" type="subject" default="ams_env_ind_0_temp_text"/>
    <prop name="humidity_text" type="subject" default="ams_env_ind_0_humidity_text"/>
    <prop name="humidity_status" type="subject" default="ams_env_ind_0_humidity_status"/>
    <prop name="humidity_visible" type="subject" default="ams_env_ind_0_humidity_visible"/>
    <prop name="visible" type="subject" default="ams_env_ind_0_visible"/>
    <prop name="drying_active" type="subject" default="ams_env_ind_0_drying_active"/>
    <prop name="drying_text" type="subject" default="ams_env_ind_0_drying_text"/>
  </api>
  <view name="ams_unit_card"
        extends="lv_obj" height="content" scrollable="false" flex_flow="column" style_flex_main_place="start"
        style_flex_cross_place="center" style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="#border_radius"
        style_pad_all="#space_sm" style_pad_gap="#space_xs" style_border_width="1" style_border_color="#border"
        style_border_opa="80" style_min_width="#ams_card_min_width" style_max_width="#ams_card_max_width"
        clickable="true">
    <!-- Unit header: logo + name (clickable=false + event_bubble so clicks reach card) -->
    <lv_obj width="100%"
            height="content" scrollable="false" clickable="false" event_bubble="true" flex_flow="row"
            style_flex_main_place="center" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_xs"
            style_bg_opa="0" style_border_width="0">
      <!-- The logo is the first thing to go when the cards are width-starved: on a
           5-unit rig it costs ~28px of a ~102px card, and the unit's NAME is what
           the row is for. No inline hidden="" here - an inline attr would outrank
           the binding. -->
      <lv_image name="unit_logo" width="#ams_logo_size" height="#ams_logo_size" inner_align="contain">
        <bind_flag_if_eq subject="ams_cards_compact" flag="hidden" ref_value="1"/>
      </lv_image>
      <!-- width="1"+flex_grow so the label is sized by the row rather than by its
           own content: a name longer than the card used to size to content, overflow
           the centered row, and get clipped at BOTH ends ("HTLF Claymore 1" read as
           "TLF Claym"). long_mode="dots" needs a bounded width to do anything. -->
      <text_body name="unit_name"
                 width="1" height="#ams_unit_name_h" text="Unit" translation_tag="Unit" flex_grow="1" long_mode="dots"
                 style_text_align="center"/>
    </lv_obj>
    <!-- Body row: slot content on the left, environment/dryer indicator on the right.
         Keeping the indicator in the row (not stacked below) prevents it from growing
         the card's height and pushing the panel's system-path area off the bottom;
         mirrors the single-unit detail layout (ams_unit_detail.xml). -->
    <lv_obj width="100%"
            height="content" scrollable="false" clickable="false" event_bubble="true" flex_flow="row"
            style_flex_main_place="center" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_xs"
            style_bg_opa="0" style_border_width="0">
      <!-- Left column: mini bars + slot count + runout. width="1"+flex_grow per L066 so
           flex allocates from grown width (not content), letting the indicator take the rest. -->
      <lv_obj width="1"
              height="content" flex_grow="1" scrollable="false" clickable="false" event_bubble="true" flex_flow="column"
              style_flex_main_place="center" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_xs"
              style_bg_opa="0" style_border_width="0">
        <!-- Mini status bars container (clickable=false + event_bubble so clicks reach card) -->
        <lv_obj name="bars_container"
                width="100%" height="#ams_bars_height" scrollable="false" clickable="false" event_bubble="true"
                flex_flow="row" style_flex_main_place="center" style_flex_cross_place="end" style_pad_all="0"
                style_pad_column="#space_xxs" style_bg_opa="0" style_border_width="0"/>
        <!-- Slot count label -->
        <text_small name="slot_count" text="0 slots" translation_tag="0 slots" event_bubble="true"/>
        <!-- Filament runout indicator — only shown on a real runout (print paused).
             ams_filament_runout is gated on PAUSED state in ams_state.cpp so the
             pre-load filament_useup assertion at print start never lights it. -->
        <icon name="runout_indicator" src="alert" size="sm" variant="warning" hidden="true" event_bubble="true">
          <bind_flag_if_eq subject="ams_filament_runout" flag="hidden" ref_value="0"/>
        </icon>
      </lv_obj>
      <!-- Environment indicator (temp/humidity/dryer) — to the right; hidden when no sensors -->
      <ams_environment_indicator name="env_indicator"
                                 event_bubble="true" temp_text="$temp_text" humidity_text="$humidity_text"
                                 humidity_status="$humidity_status" humidity_visible="$humidity_visible"
                                 visible="$visible" drying_active="$drying_active" drying_text="$drying_text"/>
    </lv_obj>
  </view>
</component>
