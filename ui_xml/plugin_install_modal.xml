<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <!-- Dialog card (backdrop created programmatically) -->
  <view name="plugin_install_modal"
        extends="ui_dialog" width="85%" height="content" align="center" flex_flow="column" style_flex_main_place="start"
        style_pad_gap="0">
    <!-- ============================================================ -->
    <!-- Content area -->
    <!-- ============================================================ -->
    <lv_obj width="100%"
            height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg"
            style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_md">
      <!-- Icon -->
      <icon src="puzzle_outline" size="lg" variant="success"/>
      <!-- Title -->
      <text_heading name="modal_title" width="100%" text="Optimize Your Printing" style_text_align="center"/>
      <!-- plugin_install_phase: 0 local prompt, 1 remote prompt, 2 installing, 3 succeeded,
           4 failed. Each part below shows for its own phases. -->
      <!-- Description (LOCAL mode - auto-install available) -->
      <lv_obj name="local_description"
              width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm">
        <bind_flag_if_not_eq subject="plugin_install_phase" flag="hidden" ref_value="0"/>
        <text_body width="100%"
                   text="The HelixPrint plugin enables fast G-code modifications directly on your printer—like skipping bed mesh for quick reprints."
                   long_mode="wrap" style_text_align="left"/>
        <text_small width="100%" text="Installation takes about 30 seconds." long_mode="wrap" style_text_align="left"/>
      </lv_obj>
      <!-- Description (REMOTE mode - manual install required) -->
      <lv_obj name="remote_description"
              width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm">
        <bind_flag_if_not_eq subject="plugin_install_phase" flag="hidden" ref_value="1"/>
        <text_body width="100%"
                   text="Install the HelixPrint plugin to enable fast G-code modifications. Run this command via SSH on your printer:"
                   long_mode="wrap" style_text_align="left"/>
        <!-- Command textarea (read-only, displays curl command) -->
        <lv_textarea name="command_textarea"
                     width="100%" height="content" text="" one_line="false" clickable="false" scrollable="false"
                     style_pad_all="#space_sm" style_text_font="#font_small" style_margin_top="#space_sm"
                     style_min_height="56"/>
        <!-- Copy feedback, by plugin_install_copy_result: 1 copied, 2 failed, 3 no clipboard -->
        <text_small name="copy_feedback"
                    width="100%" text="Copied to clipboard!" style_text_align="center" style_text_color="#success">
          <bind_flag_if_not_eq subject="plugin_install_copy_result" flag="hidden" ref_value="1"/>
        </text_small>
        <text_small name="copy_feedback_failed"
                    width="100%" text="Copy failed - use SSH manually" style_text_align="center"
                    style_text_color="#success">
          <bind_flag_if_not_eq subject="plugin_install_copy_result" flag="hidden" ref_value="2"/>
        </text_small>
        <text_small name="copy_feedback_unavailable"
                    width="100%" text="Clipboard unavailable - use SSH" style_text_align="center"
                    style_text_color="#success">
          <bind_flag_if_not_eq subject="plugin_install_copy_result" flag="hidden" ref_value="3"/>
        </text_small>
      </lv_obj>
      <!-- Installing state (spinner) -->
      <lv_obj name="installing_container"
              width="100%" height="content" style_pad_all="#space_lg" flex_flow="column" style_flex_cross_place="center"
              style_pad_gap="#space_md">
        <bind_flag_if_not_eq subject="plugin_install_phase" flag="hidden" ref_value="2"/>
        <spinner size="lg"/>
        <text_heading text="Installing..." style_text_align="center"/>
        <text_small text="This may take up to 30 seconds"/>
      </lv_obj>
      <!-- Result state (success/failure) -->
      <lv_obj name="result_container"
              width="100%" height="content" style_pad_all="#space_md" flex_flow="column" style_flex_cross_place="center"
              style_pad_gap="#space_sm">
        <bind_flag_if_lt subject="plugin_install_phase" flag="hidden" ref_value="3"/>
        <icon name="result_icon" src="check_circle" size="lg" variant="success">
          <bind_flag_if_not_eq subject="plugin_install_phase" flag="hidden" ref_value="3"/>
        </icon>
        <icon name="result_icon_failed" src="alert_circle" size="lg" variant="danger">
          <bind_flag_if_not_eq subject="plugin_install_phase" flag="hidden" ref_value="4"/>
        </icon>
        <text_heading name="result_title" width="100%" text="Success!" style_text_align="center">
          <bind_flag_if_not_eq subject="plugin_install_phase" flag="hidden" ref_value="3"/>
        </text_heading>
        <text_heading name="result_title_failed" width="100%" text="Installation Failed" style_text_align="center">
          <bind_flag_if_not_eq subject="plugin_install_phase" flag="hidden" ref_value="4"/>
        </text_heading>
        <text_body name="result_message"
                   width="100%" bind_text="plugin_install_result_message" long_mode="wrap" style_text_align="center"/>
      </lv_obj>
      <!-- Don't ask again checkbox -->
      <lv_obj name="checkbox_container"
              width="100%" height="content" style_pad_top="#space_md" style_pad_bottom="0" flex_flow="row"
              style_flex_main_place="center">
        <bind_flag_if_ge subject="plugin_install_phase" flag="hidden" ref_value="2"/>
        <lv_checkbox name="dont_ask_checkbox" text="Don't ask again" style_pad_all="#space_xs"/>
      </lv_obj>
    </lv_obj>
    <!-- Button rows, one per phase; each carries its own top divider. -->
    <!-- LOCAL mode: Not Now | Install Plugin -->
    <modal_button_row name="local_button_row"
                      secondary_name="btn_cancel" secondary_text="Not Now" secondary_callback="on_plugin_install_cancel"
                      primary_name="btn_install" primary_text="Install Plugin" primary_variant="success"
                      primary_callback="on_plugin_install_clicked">
      <bind_flag_if_not_eq subject="plugin_install_phase" flag="hidden" ref_value="0"/>
    </modal_button_row>
    <!-- REMOTE mode: Done | Copy Command -->
    <modal_button_row name="remote_button_row"
                      secondary_name="btn_done" secondary_text="Done" secondary_variant="primary"
                      secondary_callback="on_plugin_install_cancel" primary_name="btn_copy" primary_text="Copy Command"
                      primary_variant="success" primary_callback="on_plugin_copy_clicked">
      <bind_flag_if_not_eq subject="plugin_install_phase" flag="hidden" ref_value="1"/>
    </modal_button_row>
    <!-- RESULT mode: OK -->
    <modal_button_row name="result_button_row"
                      hide_secondary="true" primary_name="btn_ok" primary_text="OK"
                      primary_callback="on_plugin_install_ok">
      <bind_flag_if_lt subject="plugin_install_phase" flag="hidden" ref_value="3"/>
    </modal_button_row>
  </view>
</component>
