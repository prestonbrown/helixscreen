<!-- The shared shape of a settings row: optional icon, label with an optional
     description under it, the (i) buttons, then the row's control at the right.
     setting_toggle_row, setting_dropdown_row and setting_text_row extend it; the
     control an extending view declares lands after these, at the row's end. Responsive: compact padding at the
     micro breakpoint; below the small breakpoint the description hides and an
     (i) reveals it. -->
<component>
  <api>
    <prop name="label" type="string" default="Setting"/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="icon" type="string" default=""/>
    <prop name="description" type="string" default=""/>
    <prop name="description_tag" type="string" default=""/>
    <!-- "true" drops the description line and its (i) even when one is given. -->
    <prop name="hide_description" type="string" default="false"/>
    <!-- Int subject; the label dims while it equals disabled_ref_value. Empty: never dims. -->
    <prop name="disabled" type="string" default=""/>
    <prop name="disabled_ref_value" type="string" default="1"/>
    <!-- An event callback that explains the setting, usually by opening a modal. Set, it
         gives the row an (i) at every breakpoint that calls it, in place of the (i) that
         reveals the description on small screens. -->
    <prop name="info_callback" type="string" default=""/>
    <prop name="info_pad" type="string" default="2"/>
  </api>
  <styles>
    <style name="label_enabled" text_color="#text"/>
    <style name="label_disabled" text_color="#text_subtle"/>
    <style name="pad_standard"
           pad_left="#space_lg" pad_right="#space_lg" pad_top="#space_lg" pad_bottom="#space_lg" pad_gap="#space_sm"/>
    <style name="pad_micro"
           pad_left="#space_md" pad_right="#space_md" pad_top="#space_lg" pad_bottom="#space_lg" pad_gap="#space_sm"/>
  </styles>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
        style_bg_opa="0" style_border_width="0" scrollable="false">
    <bind_style_if_eq name="pad_micro" subject="ui_breakpoint" ref_value="0"/>
    <bind_style_if_ge name="pad_standard" subject="ui_breakpoint" ref_value="1"/>
    <!-- Optional icon: hidden (no broken-glyph fallback) when none is given -->
    <icon name="row_icon" src="$icon" size="sm" variant="secondary" hidden_if_empty="$icon"/>
    <!-- Label and optional description -->
    <lv_obj width="0"
            height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm" flex_grow="1"
            scrollable="false">
      <text_body name="label" width="100%" text="$label" translation_tag="$label_tag" long_mode="wrap">
        <bind_style_if_not_eq name="label_enabled" subject="$disabled" ref_value="$disabled_ref_value"/>
        <bind_style_if_eq name="label_disabled" subject="$disabled" ref_value="$disabled_ref_value"/>
      </text_body>
      <!-- Description wrapper: collapsed at parse time when there is no description or
           hide_description="true", so the reactive breakpoint bind below cannot bring back
           an empty line. The label then centers vertically against the control. -->
      <lv_obj width="100%"
              height="content" style_pad_all="0" style_border_width="0" scrollable="false"
              hidden_if_empty="$description" hidden_if_prop_eq="$hide_description|true">
        <text_small name="description"
                    width="100%" text="$description" translation_tag="$description_tag" long_mode="wrap">
          <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="2"/>
        </text_small>
      </lv_obj>
    </lv_obj>
    <!-- Info icon: only with a description to reveal, and only on small breakpoints. The
         parse-time checks live on an outer wrapper because the reactive breakpoint bind on
         the button would clear them, bringing back an (i) that reveals nothing. -->
    <lv_obj width="content"
            height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
            hidden_if_empty="$description" hidden_if_prop_eq="$hide_description|true"
            hidden_if_prop_not_eq="$info_callback|">
      <lv_obj name="info_btn"
              width="content" height="content" style_pad_all="$info_pad" style_bg_opa="0" style_border_width="0"
              clickable="true" event_bubble="false" scrollable="false">
        <bind_flag_if_gt subject="ui_breakpoint" flag="hidden" ref_value="1"/>
        <icon src="info_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
        <event_cb trigger="clicked" callback="on_setting_info_clicked"/>
      </lv_obj>
    </lv_obj>
    <!-- Info button for info_callback. The callback name rides as user_data on the shared
         info handler, which calls it: a callback attribute left empty would warn on every
         row that has none. -->
    <lv_obj name="info_modal_btn"
            width="content" height="content" style_pad_all="#space_xxs" style_bg_opa="0" style_border_width="0"
            clickable="true" event_bubble="false" scrollable="false" hidden_if_empty="$info_callback">
      <icon src="info_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
      <event_cb trigger="clicked" callback="on_setting_info_clicked" user_data="$info_callback"/>
    </lv_obj>
  </view>
</component>
