<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <!-- A fixed-height card: the body grows into it and the tool list is its one
       scroll region. -->
  <view name="filament_mapping_modal"
        extends="dialog_frame" height="90%" style_max_height="90%" title="Filament Mapping" icon="palette"
        icon_variant="info">
    <dialog_frame-body flex_grow="1"
                       style_max_height="100%" style_pad_bottom="#space_sm" style_pad_gap="#space_sm" scrollable="false">
      <!-- Start macro parameters a file-rewrite remap leaves as sliced -->
      <lv_obj name="start_macro_note_row"
              width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
        <bind_flag_if_eq subject="filament_mapping_note_visible" flag="hidden" ref_value="0"/>
        <lv_obj width="100%"
                height="content" style_bg_color="#warning" style_bg_opa="25" style_radius="#border_radius"
                style_border_width="1" style_border_color="#warning" style_pad_all="#space_sm" flex_flow="row"
                style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
          <icon src="alert" size="sm" variant="warning"/>
          <text_small name="start_macro_note" flex_grow="1" long_mode="wrap" bind_text="filament_mapping_note"/>
        </lv_obj>
      </lv_obj>

      <!-- Scrollable tool mapping list -->
      <lv_obj name="mapping_tool_list"
              width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
              scrollable="true" scrollbar_mode="active">
        <!-- Rows populated dynamically in C++ -->
      </lv_obj>
    </dialog_frame-body>

    <dialog_frame-footer>
      <modal_button_row secondary_text="Cancel"
                        secondary_callback="on_modal_cancel_clicked" primary_text="Done"
                        primary_callback="on_modal_ok_clicked"/>
    </dialog_frame-footer>
  </view>
</component>
