<!-- Spoolman spool item row for picker modal -->
<component>
  <api>
    <prop name="spool_id" type="int" default="0"/>
    <!-- detail_flow="row" collapses the row to a single line on small panels. -->
    <prop name="detail_flow" type="string" default="column"/>
    <!-- Opt-in identity-edit pencil (AMS editor's picker only; the AMS panel
         list keeps it hidden). Shown on the highlighted/current row. -->
    <prop name="hide_edit_pencil" type="boolean" default="true"/>
  </api>
  <consts>
    <!-- Picker-row sizing. Component-scoped (only this component uses them),
         resolved responsively as #spool_row_min_height / #spool_swatch_size. -->
    <!-- spool_row_min_height: touch-target min height. _small=44 is the hard
         floor for a reliable touch target; scales up on larger panels. -->
    <px name="spool_row_min_height_micro" value="40"/>
    <px name="spool_row_min_height_tiny" value="42"/>
    <px name="spool_row_min_height_small" value="44"/>
    <px name="spool_row_min_height_medium" value="46"/>
    <px name="spool_row_min_height_large" value="60"/>
    <px name="spool_row_min_height_xlarge" value="68"/>
    <px name="spool_row_min_height_xxlarge" value="76"/>
    <!-- spool_swatch_size: color swatch square edge. -->
    <px name="spool_swatch_size_micro" value="20"/>
    <px name="spool_swatch_size_tiny" value="22"/>
    <px name="spool_swatch_size_small" value="22"/>
    <px name="spool_swatch_size_medium" value="28"/>
    <px name="spool_swatch_size_large" value="32"/>
    <px name="spool_swatch_size_xlarge" value="36"/>
    <px name="spool_swatch_size_xxlarge" value="40"/>
  </consts>
  <styles>
    <!-- Checked state: left border highlight + elevated background (matches spoolman_spool_row) -->
    <style name="checked_style"
           border_width="#space_xs" border_side="left" border_color="#primary" bg_color="#elevated_bg" bg_opa="255"/>
  </styles>
  <view name="spool_item"
        extends="lv_button" width="100%" height="content" style_min_height="#spool_row_min_height"
        style_radius="#border_radius" style_border_width="0" style_shadow_width="0" style_bg_opa="0"
        style_pad_all="#space_sm" style_pad_gap="#space_sm" flex_flow="row" style_flex_main_place="start"
        style_flex_cross_place="center" clickable="true">
    <style name="checked_style" selector="checked"/>
    <event_cb trigger="clicked" callback="spoolman_spool_item_clicked_cb"/>
    <!-- Color swatch -->
    <lv_obj name="spool_swatch"
            width="#spool_swatch_size" height="#spool_swatch_size" style_radius="#border_radius_small"
            style_bg_color="#text_muted" style_bg_opa="255" style_border_color="#text_muted" style_border_opa="80"
            scrollable="false" clickable="false"/>
    <!-- Details column (rich) / details row (compact) -->
    <lv_obj height="content"
            style_pad_all="0" flex_flow="$detail_flow" style_flex_main_place="center" style_flex_cross_place="start"
            style_pad_gap="0" scrollable="false" flex_grow="1" clickable="false">
      <!-- Primary: the spool's name (e.g., "#12 Kingroon Basic PETG Clear"). Grows +
           ellipsizes when constrained (compact); full-width and un-truncated in rich mode. -->
      <text_body name="spool_name"
                 text="Unknown Spool" translation_tag="Unknown Spool" flex_grow="1" long_mode="dots" clickable="false"/>
      <!-- Secondary: Weight -->
      <lv_obj height="content"
              style_pad_all="0" flex_flow="row" style_flex_main_place="start" style_pad_gap="#space_xs"
              scrollable="false" clickable="false">
        <text_small name="spool_weight" text="" clickable="false"/>
      </lv_obj>
    </lv_obj>
    <icon name="edit_pencil" src="pencil" size="sm" variant="muted" hidden="$hide_edit_pencil" clickable="true">
      <event_cb trigger="clicked" callback="spoolman_spool_item_edit_cb"/>
    </icon>
    <!-- Checkmark for current selection (hidden by default) -->
    <icon name="selected_icon" src="check_circle" size="sm" variant="success" hidden="true" clickable="false"/>
  </view>
</component>
