<!-- Keep-or-revert after an IPv4 change. Backdrop and buttons are wired by
     Ipv4KeepModal; the title and countdown come from Ipv4SettingsOverlay. -->
<component>
  <view name="ipv4_keep_modal" extends="dialog_frame" style_max_width="480" title_subject="ipv4_keep_title" icon="lan">
    <text_muted width="100%" bind_text="ipv4_keep_message" long_mode="wrap" style_text_align="left"/>
    <dialog_frame-footer>
      <modal_button_row secondary_text="Revert now" primary_text="Keep"/>
    </dialog_frame-footer>
  </view>
</component>
