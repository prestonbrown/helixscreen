<!-- Crash Report Modal - Shows after crash, offers to send report -->
<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <api>
    <slot name="qr" target="qr_frame"/>
  </api>
  <!-- The body is capped by #dialog_content_max and scrolls: a real crash
       report carries a resolved backtrace, so its details do reach the cap. -->
  <view name="crash_report_modal"
        extends="dialog_frame" width="85%" title="HelixScreen Crashed" title_tag="HelixScreen Crashed" icon="alert"
        icon_variant="warning">
    <!-- Details + QR row -->
    <lv_obj width="100%"
            height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_md" style_flex_cross_place="center">
      <!-- Left: crash details + status -->
      <lv_obj height="content" flex_grow="1" flex_flow="column" style_pad_all="0" style_pad_gap="#space_md">
        <!-- Crash details -->
        <lv_obj width="100%"
                height="content" flex_flow="column" style_pad_all="#space_sm" style_pad_gap="#space_xs"
                style_bg_opa="cover" style_bg_color="#card_bg" style_radius="#border_radius">
          <text_body width="100%" bind_text="crash_report_details" long_mode="wrap"/>
        </lv_obj>
        <!-- Status message -->
        <text_body name="status_text" width="100%" bind_text="crash_report_status" long_mode="wrap"/>
      </lv_obj>
      <!-- Right: QR code (hidden initially) -->
      <ui_card name="qr_card" width="content" height="content" style_pad_all="#space_xs">
        <bind_flag_if_eq subject="crash_report_show_qr" flag="hidden" ref_value="0"/>
        <qr_frame name="qr_frame"/>
      </ui_card>
    </lv_obj>
    <dialog_frame-footer>
      <modal_button_row secondary_name="modal_cancel_btn"
                        secondary_text="Dismiss" secondary_callback="on_crash_report_dismiss"
                        primary_name="modal_send_btn" primary_text="Send Report" primary_callback="on_crash_report_send"/>
    </dialog_frame-footer>
  </view>
</component>
