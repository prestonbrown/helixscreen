<!--
  Print-tune feature tokens.

  Own file rather than <consts> inside print_tune_panel.xml: both the base panel
  and ui_xml/portrait/print_tune_panel.xml reference these, so parking them in
  one of the two consumers would be the backward-coupling ams_tokens.xml warns
  about.

  Both tokens are HORIZONTAL, so they resolve from the cramped axis with no
  entry in VERTICAL_AXIS_TOKENS — see docs/devel/UI_CONTRIBUTOR_GUIDE.md
  § "Adding New Tokens". In portrait the cramped axis IS the width, which is
  exactly the axis these two need to track.

  theme_manager scans every file in ui_xml/ for responsive px tokens and
  registers the bare base name per current breakpoint, so any component can
  reference #z_tune_indicator_w regardless of which file declares the tiers.
-->
<component>
  <consts>
    <!-- Nozzle-over-bed indicator width. It draws proportionally (tick spacing
         is w/16, the scale column is measured off the tick labels), so it
         survives shrinking; what it must not do is eat the width the z-step
         buttons need. At MICRO/TINY it was a flat 170px, which left the four
         step buttons ~36px each in landscape and nothing at all in portrait. -->
    <px name="z_tune_indicator_w_micro" value="120"/>
    <px name="z_tune_indicator_w_tiny" value="140"/>
    <px name="z_tune_indicator_w_small" value="150"/>
    <px name="z_tune_indicator_w_medium" value="170"/>
    <px name="z_tune_indicator_w_large" value="190"/>
    <px name="z_tune_indicator_w_xlarge" value="210"/>

    <!-- Indicator height. Deliberately NOT in VERTICAL_AXIS_TOKENS: the vertical
         ladder reads the height, and at 272x480 that is 480 -> _medium, so the
         graphic would keep its full size on the very display that has no room
         for it. What actually squeezes this panel is the narrow axis forcing
         every row to stack, so it tracks the cramped ladder like a neutral. -->
    <px name="z_tune_indicator_h_micro" value="92"/>
    <px name="z_tune_indicator_h_tiny" value="120"/>
    <px name="z_tune_indicator_h_small" value="140"/>
    <px name="z_tune_indicator_h_medium" value="160"/>
    <px name="z_tune_indicator_h_large" value="176"/>
    <px name="z_tune_indicator_h_xlarge" value="192"/>

    <!-- Width of the stacked closer/farther direction buttons. Icon-only, so it
         needs far less than the 90px the landscape layout hardcoded once the
         display gets narrow. -->
    <px name="z_tune_dir_col_w_micro" value="64"/>
    <px name="z_tune_dir_col_w_tiny" value="72"/>
    <px name="z_tune_dir_col_w_small" value="80"/>
    <px name="z_tune_dir_col_w_medium" value="90"/>
    <px name="z_tune_dir_col_w_large" value="96"/>
    <px name="z_tune_dir_col_w_xlarge" value="104"/>
  </consts>
</component>
