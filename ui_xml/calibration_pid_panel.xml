<!-- Heater calibration: PID_CALIBRATE, or MPC_CALIBRATE where the firmware has MPC.
     Idle shows one of three pages (pid_page): 0 the intro (heater, temperature,
     part-fan switch, badges), 1 the "switch to MPC" confirm page, 2 Advanced. -->
<component>
  <styles>
    <style name="pid_heater_selected" bg_color="#primary" bg_opa="255"/>
    <style name="pid_heater_unselected" bg_color="#elevated_bg" bg_opa="255"/>

    <!-- A heater card, idle and picked -->
    <style name="pid_card_idle" bg_color="#elevated_bg" bg_opa="24%" border_color="#primary" border_opa="0"/>
    <style name="pid_card_picked" bg_color="#primary" bg_opa="12%" border_color="#primary" border_opa="255"/>
    <style name="pid_note_warn" text_color="#warning"/>
    <style name="pid_note_quiet" text_color="#text_muted"/>
  </styles>
  <view name="calibration_pid_panel"
        extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" style_bg_opa="255"
        style_bg_color="#card_bg" style_pad_all="0" style_pad_gap="0" style_border_width="0" scrollable="false"
        flex_flow="column">
    <!-- Intro and Advanced header. Back from Advanced returns to the intro. -->
    <header_bar name="overlay_header" title="Heater Calibration" back_button_callback="on_pid_back">
      <bind_flag_if cond="pid_cal_state eq 0 and pid_page eq 1" flag="hidden"/>
    </header_bar>
    <!-- The switch page asks its question in the title, in its own case. -->
    <header_bar name="switch_header"
                title="Switch the nozzle to MPC?" title_transform="none" back_button_callback="on_pid_back"
                hidden="true">
      <bind_flag_if cond="pid_cal_state ne 0 or pid_page ne 1" flag="hidden"/>
    </header_bar>
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="0" scrollable="false">
      <!-- Disable content when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- ================================================================== -->
      <!-- STATE: IDLE, page 0: the intro -->
      <!-- ================================================================== -->
      <lv_obj name="state_idle"
              width="100%" flex_grow="1" style_pad_all="0" style_pad_gap="0" flex_flow="column" scrollable="false">
        <bind_flag_if cond="pid_cal_state ne 0 or pid_page ne 0" flag="hidden"/>
        <calibration_intro name="heater_intro"
                           left_label="Heater" right_label="Calibrate at" secondary_name="btn_advanced"
                           secondary_text="Advanced" secondary_callback="on_pid_advanced" primary_name="btn_start"
                           primary_bind_text="pid_cta_text" primary_callback="on_pid_start"
                           primary_disabled_cond="pid_cal_not_idle eq 1" status_subject="pid_restart_note"
                           status_color="#warning">
          <!-- What is calibrated, and what it runs today -->
          <lv_obj name="btn_heater_extruder"
                  width="100%" height="content" style_radius="#border_radius" style_border_width="2"
                  style_pad_hor="#space_md" style_pad_ver="#space_md" style_pad_gap="#space_xxs" flex_flow="column"
                  clickable="true" scrollable="false">
            <bind_style name="pid_card_picked" subject="pid_heater_is_extruder" ref_value="1"/>
            <bind_style name="pid_card_idle" subject="pid_heater_is_extruder" ref_value="0"/>
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="on_pid_heater_extruder"/>
            <text_small text="Nozzle"
                        style_text_font="#cal_font_name_bold" style_text_color="#text" clickable="false"
                        event_bubble="true"/>
            <text_small width="100%"
                        bind_text="pid_nozzle_today" style_text_font="#cal_font_detail" style_text_color="#text_muted"
                        long_mode="wrap" clickable="false" event_bubble="true"/>
            <text_small width="100%"
                        bind_text="pid_nozzle_note" style_text_font="#cal_font_detail" long_mode="wrap"
                        clickable="false" event_bubble="true">
              <bind_style name="pid_note_warn" subject="pid_nozzle_note_warn" ref_value="1"/>
              <bind_style name="pid_note_quiet" subject="pid_nozzle_note_warn" ref_value="0"/>
              <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
            </text_small>
          </lv_obj>
          <lv_obj name="btn_heater_bed"
                  width="100%" height="content" style_radius="#border_radius" style_border_width="2"
                  style_pad_hor="#space_md" style_pad_ver="#space_md" style_pad_gap="#space_xxs" flex_flow="column"
                  clickable="true" scrollable="false">
            <bind_style name="pid_card_picked" subject="pid_heater_is_extruder" ref_value="0"/>
            <bind_style name="pid_card_idle" subject="pid_heater_is_extruder" ref_value="1"/>
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="on_pid_heater_bed"/>
            <text_small text="Bed"
                        style_text_font="#cal_font_name_bold" style_text_color="#text" clickable="false"
                        event_bubble="true"/>
            <text_small width="100%"
                        bind_text="pid_bed_today" style_text_font="#cal_font_detail" style_text_color="#text_muted"
                        long_mode="wrap" clickable="false" event_bubble="true"/>
            <text_small width="100%"
                        bind_text="pid_bed_note" style_text_font="#cal_font_detail" long_mode="wrap" clickable="false"
                        event_bubble="true">
              <bind_style name="pid_note_warn" subject="pid_bed_note_warn" ref_value="1"/>
              <bind_style name="pid_note_quiet" subject="pid_bed_note_warn" ref_value="0"/>
              <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
            </text_small>
          </lv_obj>
          <!-- Which extruder the nozzle card means, on a printer with several -->
          <lv_obj name="pid_tool_row"
                  width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs"
                  style_flex_cross_place="center" scrollable="false">
            <bind_flag_if cond="pid_cal_multi_tool eq 0 or pid_heater_is_extruder eq 0" flag="hidden"/>
            <repeat count="pid_cal_tool_count">
              <ui_button name="pid_tool_${i}"
                         width="1" height="#button_height_sm" flex_grow="1" bind_text="pid_cal_tool_label_${i}">
                <bind_style name="pid_heater_selected" subject="pid_cal_tool_selected_${i}" ref_value="1"/>
                <bind_style name="pid_heater_unselected" subject="pid_cal_tool_selected_${i}" ref_value="0"/>
                <event_cb trigger="clicked" callback="on_pid_cal_tool" user_data="$i"/>
              </ui_button>
            </repeat>
          </lv_obj>
          <calibration_intro-settings>
            <!-- Temperatures, then the part-fan switch -->
            <lv_obj name="settings_split"
                    width="100%" height="content" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="column"
                    scrollable="false">
              <lv_obj name="temp_chips"
                      width="100%" height="content" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="column"
                      scrollable="false">
                <lv_obj width="100%"
                        height="content" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="row" scrollable="false">
                  <cal_intro_chip name="btn_preset_m0"
                                  bind_label="preset_material_0_name" bind_detail="pid_preset_deg_0"
                                  choice="pid_preset_sel" value="0" index="0" callback="on_pid_preset_material"/>
                  <cal_intro_chip name="btn_preset_m1"
                                  bind_label="preset_material_1_name" bind_detail="pid_preset_deg_1"
                                  choice="pid_preset_sel" value="1" index="1" callback="on_pid_preset_material"/>
                </lv_obj>
                <lv_obj width="100%"
                        height="content" style_pad_all="0" style_pad_gap="#space_sm" flex_flow="row" scrollable="false">
                  <cal_intro_chip name="btn_preset_m2"
                                  bind_label="preset_material_2_name" bind_detail="pid_preset_deg_2"
                                  choice="pid_preset_sel" value="2" index="2" callback="on_pid_preset_material"/>
                  <cal_intro_chip name="btn_preset_m3"
                                  bind_label="preset_material_3_name" bind_detail="pid_preset_deg_3"
                                  choice="pid_preset_sel" value="3" index="3" callback="on_pid_preset_material"/>
                </lv_obj>
              </lv_obj>
              <!-- One switch for the part fan: MPC models it, PID tunes without it -->
              <lv_obj name="row_measure_fan"
                      width="100%" height="content" style_min_height="#cal_button_h" style_radius="#border_radius"
                      style_bg_color="#elevated_bg" style_bg_opa="24%" style_border_width="0" style_pad_hor="#space_md"
                      style_pad_ver="#space_xs" style_pad_gap="#space_md" flex_flow="row"
                      style_flex_cross_place="center" style_flex_track_place="center" clickable="true"
                      scrollable="false">
                <bind_flag_if_eq subject="cal_fan_row_shown" flag="hidden" ref_value="0"/>
                <bind_state_if_eq subject="cal_fan_locked" state="disabled" ref_value="1"/>
                <style name="styles.press_wash" selector="pressed"/>
                <event_cb trigger="clicked" callback="on_cal_measure_fan_row"/>
                <lv_obj width="0"
                        height="content" flex_grow="1" style_pad_all="0" style_pad_gap="0" flex_flow="column"
                        clickable="false" event_bubble="true" scrollable="false">
                  <text_small width="100%"
                              text="Also measure part-fan cooling" style_text_font="#cal_font_name"
                              style_text_color="#text" long_mode="wrap" clickable="false" event_bubble="true"/>
                  <text_small width="100%"
                              text="Holds temperature better when the fan changes · +3 min"
                              style_text_font="#cal_font_detail" style_text_color="#text_muted" long_mode="wrap"
                              clickable="false" event_bubble="true">
                    <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
                  </text_small>
                </lv_obj>
                <ui_switch name="toggle_measure_fan" size="small" clickable="false" event_bubble="true">
                  <bind_state_if_eq subject="cal_add_cooling_fan" state="checked" ref_value="1"/>
                  <bind_state_if_eq subject="cal_fan_locked" state="disabled" ref_value="1"/>
                </ui_switch>
              </lv_obj>
            </lv_obj>
          </calibration_intro-settings>
          <calibration_intro-badges>
            <cal_intro_badge bind="pid_duration_text"/>
            <cal_intro_badge bind="pid_heats_to_text" warm="true"/>
            <cal_intro_badge bind="pid_method_text">
              <!-- 480x272 keeps two badges on one line; Advanced shows the method -->
              <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
            </cal_intro_badge>
          </calibration_intro-badges>
        </calibration_intro>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: IDLE, page 1: switch the nozzle to MPC -->
      <!-- ================================================================== -->
      <lv_obj name="state_switch_mpc"
              width="100%" flex_grow="1" style_pad_all="0" style_pad_gap="0" flex_flow="column" scrollable="false"
              hidden="true">
        <bind_flag_if cond="pid_cal_state ne 0 or pid_page ne 1" flag="hidden"/>
        <calibration_intro name="switch_intro"
                           secondary_name="btn_keep_pid" secondary_text="Keep PID" secondary_callback="on_pid_keep_pid"
                           primary_name="btn_switch_mpc" primary_text="Switch and calibrate"
                           primary_callback="on_pid_switch_mpc"
                           primary_disabled_cond="cal_switch_ready eq 0 or pid_cal_not_idle eq 1">
          <!-- What MPC is, and the same fan change under both methods -->
          <text_small width="100%"
                      text="PID corrects the temperature after it drifts. MPC predicts the drift: it learns how the heater, the block and the fan move heat, so the nozzle holds steady when the fan or the flow changes."
                      style_text_font="#cal_font_subtitle" style_text_color="#text_muted" long_mode="wrap">
            <bind_flag_if cond="ui_breakpoint eq 0 or ui_is_portrait eq 1" flag="hidden"/>
          </text_small>
          <heater_mpc_switch_steps name="switch_steps_micro">
            <bind_flag_if cond="ui_breakpoint ne 0 or ui_is_portrait eq 1" flag="hidden"/>
          </heater_mpc_switch_steps>
          <lv_obj width="100%"
                  height="content" style_radius="#border_radius" style_bg_color="#screen_bg" style_bg_opa="255"
                  style_border_width="0" style_pad_hor="#space_md" style_pad_ver="#space_md" style_pad_gap="#space_xs"
                  flex_flow="column" scrollable="false">
            <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_md" scrollable="false">
              <text_small text="PID" style_text_font="#cal_font_detail" style_text_color="#text_muted"/>
              <heater_response_sketch height="#button_height_sm" flex_grow="1" method="pid"/>
            </lv_obj>
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_md" scrollable="false">
              <text_small text="MPC" style_text_font="#cal_font_detail" style_text_color="#text_muted"/>
              <heater_response_sketch height="#button_height_sm" flex_grow="1" method="mpc"/>
            </lv_obj>
            <text_small width="100%"
                        text="Same part-fan change, both methods" style_text_font="#cal_font_detail"
                        style_text_color="#text_muted" long_mode="wrap"/>
          </lv_obj>
          <calibration_intro-settings>
            <lv_obj name="switch_right"
                    width="100%" height="content" style_pad_all="0" style_pad_gap="#space_md" flex_flow="column"
                    scrollable="false">
              <!-- Power known from the printer database -->
              <lv_obj name="power_known"
                      width="100%" height="content" style_radius="#border_radius" style_bg_color="#elevated_bg"
                      style_bg_opa="24%" style_border_width="0" style_pad_hor="#space_md" style_pad_ver="#space_md"
                      style_pad_gap="#space_md" flex_flow="row" style_flex_cross_place="center" scrollable="false">
                <bind_flag_if_eq subject="cal_power_known" flag="hidden" ref_value="0"/>
                <lv_obj width="0"
                        height="content" flex_grow="1" style_pad_all="0" style_pad_gap="#space_xxs" flex_flow="column"
                        scrollable="false">
                  <cal_intro_section_label text="Heater power"/>
                  <text_heading bind_text="cal_wattage_display"/>
                  <text_small width="100%"
                              bind_text="cal_power_source" style_text_font="#cal_font_detail"
                              style_text_color="#text_muted" long_mode="wrap"/>
                </lv_obj>
                <ui_button name="btn_power_change"
                           height="#cal_button_h" variant="outline" text="Change" style_pad_hor="#space_lg"
                           style_border_width="1" style_border_color="#border" style_text_font="#cal_font_button"
                           style_text_color="#text_muted">
                  <event_cb trigger="clicked" callback="on_cal_power_change"/>
                </ui_button>
              </lv_obj>
              <!-- Power unknown: ask, with where to find it -->
              <lv_obj name="power_ask"
                      width="100%" height="content" style_radius="#border_radius" style_bg_color="#elevated_bg"
                      style_bg_opa="24%" style_border_width="2" style_border_color="#warning" style_border_opa="40%"
                      style_pad_hor="#space_md" style_pad_ver="#space_md" style_pad_gap="#space_sm" flex_flow="column"
                      scrollable="false">
                <bind_flag_if_eq subject="cal_power_known" flag="hidden" ref_value="1"/>
                <text_small text="Heater power needed"
                            text_transform="uppercase" style_text_font="#cal_font_detail" style_text_color="#warning"/>
                <text_small width="100%"
                            text="We don't know this hotend's heater. It is printed on the cartridge or its wires, usually 40 to 70 W."
                            style_text_font="#cal_font_detail" style_text_color="#text_muted" long_mode="wrap">
                  <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
                </text_small>
                <!-- One row of four, or two rows of two at 480x272 -->
                <lv_obj width="100%"
                        height="content" style_pad_all="0" style_pad_gap="#space_xs" flex_flow="row" scrollable="false">
                  <cal_intro_chip name="btn_power_0"
                                  bind_label="cal_power_chip_0" choice="cal_power_pick" value="1" index="1"
                                  callback="on_cal_power_pick" label_align="center" label_font="#cal_font_subtitle"/>
                  <cal_intro_chip name="btn_power_1"
                                  bind_label="cal_power_chip_1" choice="cal_power_pick" value="2" index="2"
                                  callback="on_cal_power_pick" label_align="center" label_font="#cal_font_subtitle"/>
                  <cal_intro_chip name="btn_power_2"
                                  bind_label="cal_power_chip_2" choice="cal_power_pick" value="3" index="3"
                                  callback="on_cal_power_pick" label_align="center" label_font="#cal_font_subtitle">
                    <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
                  </cal_intro_chip>
                  <cal_intro_chip name="btn_power_3"
                                  bind_label="cal_power_chip_3" choice="cal_power_pick" value="4" index="4"
                                  callback="on_cal_power_pick" label_align="center" label_font="#cal_font_subtitle">
                    <bind_flag_if_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
                  </cal_intro_chip>
                </lv_obj>
                <lv_obj width="100%"
                        height="content" style_pad_all="0" style_pad_gap="#space_xs" flex_flow="row" scrollable="false">
                  <bind_flag_if_not_eq subject="ui_breakpoint" flag="hidden" ref_value="0"/>
                  <cal_intro_chip name="btn_power_2_micro"
                                  bind_label="cal_power_chip_2" choice="cal_power_pick" value="3" index="3"
                                  callback="on_cal_power_pick" label_align="center" label_font="#cal_font_subtitle"/>
                  <cal_intro_chip name="btn_power_3_micro"
                                  bind_label="cal_power_chip_3" choice="cal_power_pick" value="4" index="4"
                                  callback="on_cal_power_pick" label_align="center" label_font="#cal_font_subtitle"/>
                </lv_obj>
                <!-- "Other": any wattage, in the heater's own steps -->
                <lv_obj width="100%"
                        height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
                        style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false">
                  <bind_flag_if_not_eq subject="cal_power_pick" flag="hidden" ref_value="4"/>
                  <ui_button name="btn_wattage_down"
                             width="#cal_button_h" height="#cal_button_h" text="-" variant="outline">
                    <event_cb trigger="clicked" callback="on_cal_wattage_down"/>
                  </ui_button>
                  <text_small name="wattage_display"
                              flex_grow="1" bind_text="cal_wattage_display" style_text_font="#cal_font_name"
                              style_text_color="#text" style_text_align="center"/>
                  <ui_button name="btn_wattage_up"
                             width="#cal_button_h" height="#cal_button_h" text="+" variant="outline">
                    <event_cb trigger="clicked" callback="on_cal_wattage_up"/>
                  </ui_button>
                </lv_obj>
              </lv_obj>
              <!-- What switching does, in order (in the left column at 480x272) -->
              <heater_mpc_switch_steps name="switch_steps">
                <bind_flag_if cond="ui_breakpoint eq 0 and ui_is_portrait eq 0" flag="hidden"/>
              </heater_mpc_switch_steps>
            </lv_obj>
          </calibration_intro-settings>
        </calibration_intro>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: IDLE, page 2: Advanced -->
      <!-- ================================================================== -->
      <lv_obj name="state_advanced"
              width="100%" flex_grow="1" style_pad_hor="#space_lg" style_pad_top="0" style_pad_bottom="#space_md"
              flex_flow="column" style_pad_gap="#space_sm" scrollable="false" hidden="true">
        <bind_flag_if cond="pid_cal_state ne 0 or pid_page ne 2" flag="hidden"/>
        <lv_obj width="100%"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm" scrollable="true">
          <!-- Method: automatic by default, changed only here -->
          <lv_obj name="method_selector"
                  width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm"
                  style_flex_cross_place="center" scrollable="false">
            <bind_flag_if_eq subject="cal_supports_mpc" flag="hidden" ref_value="0"/>
            <text_body width="30%" text="Method"/>
            <ui_button name="btn_method_mpc" height="#modal_button_height" flex_grow="1" text="MPC">
              <bind_style name="pid_heater_selected" subject="cal_method_is_mpc" ref_value="1"/>
              <bind_style name="pid_heater_unselected" subject="cal_method_is_mpc" ref_value="0"/>
              <event_cb trigger="clicked" callback="on_cal_method_mpc"/>
            </ui_button>
            <ui_button name="btn_method_pid" height="#modal_button_height" flex_grow="1" text="PID">
              <bind_style name="pid_heater_selected" subject="cal_method_is_mpc" ref_value="0"/>
              <bind_style name="pid_heater_unselected" subject="cal_method_is_mpc" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_cal_method_pid"/>
            </ui_button>
          </lv_obj>
          <!-- Exact temperature -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_sm" scrollable="false">
            <text_body width="30%" text="Temperature"/>
            <ui_button name="btn_temp_down"
                       width="#modal_button_height" height="#modal_button_height" text="-" variant="outline">
              <event_cb trigger="clicked" callback="on_pid_temp_down"/>
            </ui_button>
            <text_body name="temp_display" flex_grow="1" bind_text="pid_temp_display" style_text_align="center"/>
            <ui_button name="btn_temp_up"
                       width="#modal_button_height" height="#modal_button_height" text="+" variant="outline">
              <event_cb trigger="clicked" callback="on_pid_temp_up"/>
            </ui_button>
          </lv_obj>
          <!-- PID: run the part fan at a print's speed while tuning -->
          <lv_obj name="fan_speed_section"
                  width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_sm" scrollable="false">
            <bind_flag_if_eq subject="cal_show_pid_fan" flag="hidden" ref_value="0"/>
            <text_body width="30%" text="Part fan"/>
            <lv_slider name="fan_speed_slider" flex_grow="1" min_value="0" max_value="100" value="0"/>
            <text_body name="fan_speed_label"
                       width="15%" text="0%" style_text_align="right" bind_text="cal_fan_speed_text"/>
          </lv_obj>
          <!-- MPC: how many fan speeds the model measures -->
          <lv_obj name="fan_calibration_section"
                  width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_sm" scrollable="false">
            <bind_flag_if cond="cal_show_fan_config eq 0 or cal_add_cooling_fan eq 0" flag="hidden"/>
            <text_body width="30%" text="Fan points"/>
            <ui_button name="btn_fan_quick" height="#modal_button_height" flex_grow="1" text="Quick">
              <bind_style name="pid_heater_selected" subject="cal_fan_is_quick" ref_value="1"/>
              <bind_style name="pid_heater_unselected" subject="cal_fan_is_quick" ref_value="0"/>
              <event_cb trigger="clicked" callback="on_cal_fan_quick"/>
            </ui_button>
            <ui_button name="btn_fan_detailed" height="#modal_button_height" flex_grow="1" text="Detailed">
              <bind_style name="pid_heater_selected" subject="cal_fan_is_detailed" ref_value="1"/>
              <bind_style name="pid_heater_unselected" subject="cal_fan_is_detailed" ref_value="0"/>
              <event_cb trigger="clicked" callback="on_cal_fan_detailed"/>
            </ui_button>
            <ui_button name="btn_fan_thorough" height="#modal_button_height" flex_grow="1" text="Thorough">
              <bind_style name="pid_heater_selected" subject="cal_fan_is_thorough" ref_value="1"/>
              <bind_style name="pid_heater_unselected" subject="cal_fan_is_thorough" ref_value="0"/>
              <event_cb trigger="clicked" callback="on_cal_fan_thorough"/>
            </ui_button>
          </lv_obj>
          <!-- A bed moving to MPC: its heater power (the nozzle asks on the switch page) -->
          <lv_obj name="wattage_section"
                  width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_sm" scrollable="false">
            <bind_flag_if cond="cal_show_wattage eq 0 or pid_heater_is_extruder eq 1" flag="hidden"/>
            <text_body width="30%" text="Heater power"/>
            <ui_button name="btn_bed_wattage_down"
                       width="#modal_button_height" height="#modal_button_height" text="-" variant="outline">
              <event_cb trigger="clicked" callback="on_cal_wattage_down"/>
            </ui_button>
            <text_body flex_grow="1" bind_text="cal_wattage_display" style_text_align="center"/>
            <ui_button name="btn_bed_wattage_up"
                       width="#modal_button_height" height="#modal_button_height" text="+" variant="outline">
              <event_cb trigger="clicked" callback="on_cal_wattage_up"/>
            </ui_button>
          </lv_obj>
        </lv_obj>
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="end"
                style_flex_cross_place="center" scrollable="false">
          <ui_button name="btn_advanced_done" width="30%" height="#modal_button_height" text="Done">
            <event_cb trigger="clicked" callback="on_pid_advanced_done"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: CALIBRATING - Progress display -->
      <!-- ================================================================== -->
      <lv_obj name="state_calibrating"
              width="100%" flex_grow="1" style_pad_all="#space_lg" flex_flow="column"
              style_flex_main_place="space_around" style_flex_cross_place="center" style_flex_track_place="center"
              style_pad_gap="#space_sm" scrollable="false">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="1"/>
        <!-- Top row: spinner+status (left) | graph+temp (right) -->
        <lv_obj width="100%"
                flex_grow="1" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_lg" scrollable="false">
          <!-- Left: progress + labels -->
          <lv_obj height="100%"
                  style_pad_all="#space_md" flex_flow="column" style_flex_cross_place="center"
                  style_flex_main_place="center" style_flex_track_place="center" style_pad_gap="#space_sm" flex_grow="1">
            <text_heading text="Calibrating..." style_text_align="center"/>
            <text_muted name="calibrating_heater"
                        text="Extruder PID Tuning" translation_tag="Extruder PID Tuning"
                        bind_text="pid_calibrating_heater"/>
            <progress_bar name="pid_progress_bar" width="80%" bind_value="pid_cal_progress"/>
            <text_small name="pid_progress_text"
                        bind_text="pid_progress_text" text="Starting..." style_text_color="#text_muted"/>
            <text_small name="pid_eta_text" bind_text="pid_cal_eta" text="" style_text_color="#text_muted"/>
          </lv_obj>
          <!-- Right: temperature graph + live display -->
          <lv_obj height="100%"
                  flex_grow="1" style_bg_color="#section_bg_color" style_radius="#border_radius"
                  style_pad_all="#space_md" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_sm">
            <!-- Temperature graph (populated by C++) -->
            <lv_obj name="pid_temp_graph_container" width="100%" flex_grow="1" style_pad_all="0" scrollable="false"/>
            <!-- Extruder temp (shown when extruder selected) -->
            <lv_obj width="content" height="content" style_pad_all="0" scrollable="false">
              <bind_flag_if_eq subject="pid_heater_is_extruder" flag="hidden" ref_value="0"/>
              <temp_display name="pid_temp_extruder"
                            size="lg" show_target="true" bind_current="extruder_temp" bind_target="extruder_target"/>
            </lv_obj>
            <!-- Bed temp (shown when bed selected) -->
            <lv_obj width="content" height="content" style_pad_all="0" scrollable="false">
              <bind_flag_if_not_eq subject="pid_heater_is_extruder" flag="hidden" ref_value="0"/>
              <temp_display name="pid_temp_bed"
                            size="lg" show_target="true" bind_current="bed_temp" bind_target="bed_target"/>
            </lv_obj>
            <text_small text="Current Temperature" style_text_color="#text_muted"/>
          </lv_obj>
        </lv_obj>
        <text_small width="80%"
                    text="The heater will cycle on and off several times." style_text_align="center"
                    style_text_color="#text_muted"/>
        <!-- Abort Button -->
        <ui_button name="btn_abort" width="25%" icon="alert_octagon" text="Stop" variant="danger">
          <event_cb trigger="clicked" callback="on_pid_abort"/>
        </ui_button>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: SAVING - Saving configuration -->
      <!-- ================================================================== -->
      <lv_obj name="state_saving"
              width="100%" flex_grow="1" style_pad_all="#space_lg" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_lg"
              scrollable="false">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="2"/>
        <spinner size="lg"/>
        <text_heading text="Saving Configuration..." style_text_align="center"/>
        <text_small width="80%" text="Klipper will restart to apply new settings." style_text_align="center"/>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: COMPLETE - Results display -->
      <!-- ================================================================== -->
      <lv_obj name="state_complete"
              width="100%" flex_grow="1" style_pad_all="#space_lg" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_md"
              scrollable="false">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="3"/>
        <!-- Title row: icon + heading inline -->
        <lv_obj width="content"
                height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_sm" scrollable="false">
          <icon src="check_circle" size="md" variant="success"/>
          <text_heading text="Calibration Complete!"/>
        </lv_obj>
        <text_body name="pid_result_summary"
                   width="80%" bind_text="pid_result_summary" text="Temperature control has been optimized."
                   style_text_align="center" style_text_color="#text_muted"/>
        <!-- PID Technical details (hidden when MPC) -->
        <lv_obj name="pid_results"
                width="70%" height="content" style_bg_color="#section_bg_color" style_radius="#border_radius"
                style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_xs">
          <bind_flag_if_eq subject="cal_method_is_mpc" flag="hidden" ref_value="1"/>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  scrollable="false">
            <text_small text="Response (Kp)" style_text_color="#text_muted"/>
            <text_small name="pid_kp" bind_text="pid_kp" text="0.000"/>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  scrollable="false">
            <text_small text="Correction (Ki)" style_text_color="#text_muted"/>
            <text_small name="pid_ki" bind_text="pid_ki" text="0.000"/>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  scrollable="false">
            <text_small text="Damping (Kd)" style_text_color="#text_muted"/>
            <text_small name="pid_kd" bind_text="pid_kd" text="0.000"/>
          </lv_obj>
        </lv_obj>
        <!-- MPC Technical details (shown when MPC) -->
        <lv_obj name="mpc_results"
                width="70%" height="content" style_bg_color="#section_bg_color" style_radius="#border_radius"
                style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_xs">
          <bind_flag_if_eq subject="cal_method_is_mpc" flag="hidden" ref_value="0"/>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  scrollable="false">
            <text_small text="Heat Capacity" style_text_color="#text_muted"/>
            <text_small bind_text="mpc_block_heat_capacity" text="0.0000 J/K"/>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  scrollable="false">
            <text_small text="Sensor Response" style_text_color="#text_muted"/>
            <text_small bind_text="mpc_sensor_responsiveness" text="0.000000 K/s/K"/>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  scrollable="false">
            <text_small text="Ambient Transfer" style_text_color="#text_muted"/>
            <text_small bind_text="mpc_ambient_transfer" text="0.000000 W/K"/>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between"
                  scrollable="false">
            <text_small text="Fan Transfer" style_text_color="#text_muted"/>
            <text_small bind_text="mpc_fan_ambient_transfer" text=""/>
          </lv_obj>
        </lv_obj>
        <text_small width="80%"
                    text="Saved to printer configuration." style_text_align="center" style_text_color="#text_muted"/>
        <!-- Spacer pushes Done button to bottom -->
        <lv_obj width="0" flex_grow="1" style_pad_all="0" scrollable="false"/>
        <ui_button name="btn_done" width="#button_width_action" height="#button_height" text="Done">
          <event_cb trigger="clicked" callback="on_pid_done"/>
        </ui_button>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: ERROR - Something went wrong -->
      <!-- ================================================================== -->
      <lv_obj name="state_error"
              width="100%" flex_grow="1" style_pad_all="#space_lg" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_lg"
              scrollable="false">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="4"/>
        <icon src="close_circle" size="lg" variant="danger"/>
        <text_heading text="Calibration Failed" style_text_align="center"/>
        <text_muted name="error_message"
                    width="80%" text="An error occurred during calibration."
                    translation_tag="An error occurred during calibration." style_text_align="center" long_mode="wrap"
                    bind_text="pid_error_message"/>
        <lv_obj width="100%"
                height="#button_height" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
                style_pad_gap="#space_md" scrollable="false">
          <ui_button name="btn_close_error" width="#button_width_action" text="Close">
            <event_cb trigger="clicked" callback="on_pid_done"/>
          </ui_button>
          <ui_button name="btn_retry" width="#button_width_action" text="Retry" variant="primary">
            <event_cb trigger="clicked" callback="on_pid_retry"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: MIGRATING - Updating config for MPC -->
      <!-- ================================================================== -->
      <lv_obj name="state_migrating"
              width="100%" flex_grow="1" style_pad_all="#space_lg" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_lg"
              scrollable="false">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="5"/>
        <spinner size="lg"/>
        <text_heading text="Updating Configuration..." style_text_align="center"/>
        <text_small width="80%"
                    text="Switching heater control to MPC. Klipper will restart." style_text_align="center"
                    style_text_color="#text_muted"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
