<component>
  <!-- Full-screen backdrop overlay - tap to dismiss. The clock tile's Face
       picker: Text first, then one row per painted face with a still preview
       of it (src/ui/panel_widgets/clock_face_picker.h paints the previews into
       each row's preview box). A row's user_data is its face's index (ClockFace), Text 0. -->
  <view name="clock_face_picker" extends="context_menu_backdrop">
    <context_menu_card title="Clock Face" title_tag="Clock Face" pad_gap="#space_xs">
      <!-- max_height set by C++ to a share of the screen -->
      <lv_obj name="clock_face_list"
              width="100%" height="content" flex_flow="column" style_pad_all="#space_xs" style_pad_gap="0"
              scrollable="true">
        <lv_obj name="clock_face_row_text"
                width="100%" height="#button_height" flex_flow="row" style_flex_cross_place="center"
                style_flex_track_place="center" style_pad_gap="#space_sm" clickable="true" scrollable="false">
          <style name="styles.press_wash" selector="pressed"/>
          <style name="styles.picker_row"/>
          <bind_style_if_eq name="styles.selected_row" subject="clock_face_selected" ref_value="0"/>
          <!-- The Text face's preview is the time itself, at its own width. -->
          <lv_obj name="clock_face_preview_text"
                  height="100%" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
                  style_flex_cross_place="center" style_flex_track_place="center" clickable="false" event_bubble="true"
                  scrollable="false">
            <text_body bind_text="clock_time_text" clickable="false" event_bubble="true"/>
          </lv_obj>
          <text_body text="Text Clock"
                     translation_tag="Text Clock" flex_grow="1" long_mode="dots" clickable="false" event_bubble="true"/>
          <event_cb trigger="clicked" callback="clock_face_row_cb" user_data="0"/>
        </lv_obj>
        <repeat count="clock_face_count">
          <lv_obj name="clock_face_row_${i}"
                  width="100%" height="#button_height" flex_flow="row" style_flex_cross_place="center"
                  style_flex_track_place="center" style_pad_gap="#space_sm" clickable="true" scrollable="false">
            <style name="styles.press_wash" selector="pressed"/>
            <style name="styles.picker_row"/>
            <bind_style_if_eq name="styles.selected_row" subject="clock_face_selected" ref_value="${i + 1}"/>
            <!-- Sized by C++ to the row's height; the preview canvas goes in here. -->
            <lv_obj name="clock_face_preview_${i}"
                    height="100%" style_pad_all="0" style_pad_ver="#space_xxs" flex_flow="row"
                    style_flex_main_place="center" style_flex_cross_place="center" clickable="false" event_bubble="true"
                    scrollable="false"/>
            <text_body name="clock_face_label_${i}"
                       bind_text="clock_face_name_${i}" flex_grow="1" long_mode="dots" clickable="false"
                       event_bubble="true"/>
            <event_cb trigger="clicked" callback="clock_face_row_cb" user_data="${i + 1}"/>
          </lv_obj>
        </repeat>
      </lv_obj>
    </context_menu_card>
  </view>
</component>
