<component>
  <!-- A head's nozzle size; the overlay passes the options and selects the current one. Dims while a print runs. -->
  <api>
    <prop name="options" type="string" default=""/>
    <prop name="options_tag" type="string" default=""/>
  </api>
  <view name="toolhead_size_row"
        extends="setting_dropdown_row" label="Nozzle size" icon="nozzle"
        description="Orifice diameter of the nozzle fitted to this head" options="$options" options_tag="$options_tag"
        disabled="print_in_progress" callback="on_toolhead_size_changed"/>
</component>
