<!-- Abort Progress Modal - Shows progress during abort state machine execution -->
<!-- NOTE: Backdrop created manually on lv_layer_top() to survive screen changes -->
<!-- (Cannot use Modal::show() which defaults to lv_screen_active()) -->
<component>
  <view name="abort_progress_modal"
        extends="dialog_frame" title="Cancel Print" title_tag="Cancel Print" icon="stop" icon_variant="danger">
    <!-- Spinner and message, centered: a progress readout -->
    <dialog_frame-body style_pad_top="#space_md"
                       style_pad_bottom="#space_xl" style_flex_cross_place="center" style_pad_gap="#space_lg">
      <!-- Spinner animation (Material Design style) -->
      <spinner size="lg"/>
      <!-- Progress message (dynamically bound to abort_progress_message subject) -->
      <text_muted name="abort_message_label"
                  width="100%" bind_text="abort_progress_message" text="Processing..." translation_tag="Processing..."
                  long_mode="wrap" style_text_align="center"/>
      <!-- E-Stop escape hatch -->
      <ui_button name="abort_estop_btn"
                 width="100%" height="#button_height_lg" variant="danger" icon="alert_octagon" text="EMERGENCY STOP"
                 style_margin_top="#space_sm">
        <event_cb trigger="clicked" callback="on_abort_emergency_stop"/>
      </ui_button>
    </dialog_frame-body>
  </view>
</component>
