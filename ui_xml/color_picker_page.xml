<!-- The color picker as an overlay page (helix::ui::ColorPickerPage): back, the
     readout and the Grid | Sliders switch in the header, the picker body under
     it (color_picker_view, attached into cpp_body by C++). The page edits its
     host's draft live; Back returns, and the host's own Save commits. -->
<component>
  <view name="color_picker_page" extends="overlay_panel" title="" title_transform="none">
    <!-- The readout takes the header and goes back like the arrow beside it,
         so the whole left of the header is one back target. -->
    <header_bar-header_content flex_grow="20" style_pad_gap="#space_md">
      <lv_obj name="cpp_readout_back"
              height="100%" flex_grow="1" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row"
              style_flex_cross_place="center" scrollable="false" clickable="true">
        <event_cb trigger="clicked" callback="on_header_back_clicked"/>
        <color_picker_readout name="cpp_readout" flex_grow="1" clickable="false" event_bubble="true"/>
      </lv_obj>
      <color_picker_tabs/>
    </header_bar-header_content>
    <overlay_panel-overlay_content style_pad_left="#space_md"
                                   style_pad_right="#space_md" style_pad_top="0" style_pad_bottom="#space_sm"
                                   scrollable="false">
      <lv_obj name="cpp_body"
              width="100%" flex_grow="1" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
              clickable="false"/>
    </overlay_panel-overlay_content>
  </view>
</component>
