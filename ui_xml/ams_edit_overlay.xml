<!-- Spool editor overlay. One overlay, internal views selected by the
     ams_edit_view int subject: 0=editor (the identity form; the entry view),
     1=Spoolman spool picker, 2=custom color (presets + HSV).
     Header: back (ams_edit_back_cb), lane-name title (bound from C++ in AmsEditOverlay::create()),
     the linked-spool badge (an indicator, part of the back target), and Spoolman
     + Scan QR round icon buttons (header_content slot, left of the
     dirty-gated Save action). All three header subjects are written
     exclusively by AmsEditOverlay::set_view()/update_ui(). -->
<component>
  <consts>
    <!-- Spool-picker list max height: caps the scroll viewport so the picker
         stays inside the overlay. Tuned to show ~5 rows at each breakpoint. -->
    <px name="spool_list_max_height_micro" value="130"/>
    <px name="spool_list_max_height_tiny" value="150"/>
    <px name="spool_list_max_height_small" value="180"/>
    <px name="spool_list_max_height_medium" value="250"/>
    <px name="spool_list_max_height_large" value="330"/>
    <px name="spool_list_max_height_xlarge" value="420"/>
    <px name="spool_list_max_height_xxlarge" value="520"/>
    <!-- Spool-details Notes field height (mirrors spoolman_edit_modal) -->
    <px name="notes_height_small" value="44"/>
    <px name="notes_height_medium" value="72"/>
    <px name="notes_height_large" value="88"/>
    <!-- Spool-edit field widths, sized to their content so several fields share a
         row (row_wrap falls back to stacked at micro). A flex_grow field would
         stretch an 8-digit gram value across half the overlay.
         Numeric = up to 8 digits, text = a short label. -->
    <px name="field_w_num_small" value="76"/>
    <px name="field_w_num_medium" value="96"/>
    <px name="field_w_num_large" value="110"/>
    <px name="field_w_text_small" value="120"/>
    <px name="field_w_text_medium" value="150"/>
    <px name="field_w_text_large" value="180"/>
    <!-- Vertical gap between the editor's rows: the theme's space_xs (4)
         everywhere except the cramped small class, where the stack needs two
         pixels back to fit the fold. -->
    <px name="ams_edit_vgap_micro" value="4"/>
    <px name="ams_edit_vgap_tiny" value="1"/>
    <px name="ams_edit_vgap_small" value="1"/>
    <px name="ams_edit_vgap_medium" value="4"/>
    <px name="ams_edit_vgap_large" value="4"/>
    <px name="ams_edit_vgap_xlarge" value="4"/>
    <px name="ams_edit_vgap_xxlarge" value="4"/>
    <!-- The collapsed More row's vertical padding, trimmed at the cramped
         classes for the same reason. -->
    <px name="ams_edit_more_pad_micro" value="0"/>
    <px name="ams_edit_more_pad_tiny" value="0"/>
    <px name="ams_edit_more_pad_small" value="0"/>
    <px name="ams_edit_more_pad_medium" value="2"/>
    <px name="ams_edit_more_pad_large" value="2"/>
    <px name="ams_edit_more_pad_xlarge" value="2"/>
    <px name="ams_edit_more_pad_xxlarge" value="2"/>
    <!-- Row label column ("Material", "Variant"): fixed so the four rows
         align; sized for the longest locale at text_small. -->
    <px name="ams_edit_row_label_w_micro" value="56"/>
    <px name="ams_edit_row_label_w_tiny" value="64"/>
    <px name="ams_edit_row_label_w_small" value="72"/>
    <px name="ams_edit_row_label_w_medium" value="76"/>
    <px name="ams_edit_row_label_w_large" value="80"/>
    <!-- Colour column width in the split (short-landscape) layout: wide
         enough for four swatches plus the ring reach. -->
    <px name="ams_edit_color_col_w_micro" value="132"/>
    <px name="ams_edit_color_col_w_tiny" value="148"/>
    <px name="ams_edit_color_col_w_small" value="160"/>
    <!-- The split column exists only at the micro class; the taller classes
         stack the grid full-width and never read this token. -->
    <px name="ams_edit_color_col_w_medium" value="#ams_edit_color_col_w_small"/>
    <px name="ams_edit_color_col_w_large" value="#ams_edit_color_col_w_small"/>
    <!-- The lane-setting dropdowns, as narrow as their options allow so both
         share one row at every landscape class: the backup's wide enough for
         "Gate 12", the tool's for "None". -->
    <px name="ams_edit_tool_dd_w_micro" value="72"/>
    <px name="ams_edit_tool_dd_w_tiny" value="72"/>
    <px name="ams_edit_tool_dd_w_small" value="80"/>
    <px name="ams_edit_tool_dd_w_medium" value="96"/>
    <px name="ams_edit_tool_dd_w_large" value="110"/>
    <px name="ams_edit_lane_dd_w_micro" value="96"/>
    <px name="ams_edit_lane_dd_w_tiny" value="96"/>
    <px name="ams_edit_lane_dd_w_small" value="110"/>
    <px name="ams_edit_lane_dd_w_medium" value="130"/>
    <px name="ams_edit_lane_dd_w_large" value="150"/>
    <!-- Hit reach for the weight pill: its 24px minimum height reaches 44.
         The summary row is 44 tall, so the reach stays inside it. -->
    <px name="ams_edit_pill_hit" value="10"/>
    <!-- Hit reach for the More toggle and the Add link: the bar's height
         plus twice this is at least 44 at every class. -->
    <px name="ams_edit_bar_hit_micro" value="13"/>
    <px name="ams_edit_bar_hit_tiny" value="13"/>
    <px name="ams_edit_bar_hit_small" value="12"/>
    <px name="ams_edit_bar_hit_medium" value="8"/>
    <px name="ams_edit_bar_hit_large" value="8"/>
    <px name="ams_edit_bar_hit_xlarge" value="8"/>
    <px name="ams_edit_bar_hit_xxlarge" value="8"/>
    <!-- Header icon buttons: hit reach and spacing. The buttons are
         #button_height_sm circles; the reach takes each to the header's
         height (40 at micro) or 44, and the gap is twice the reach so the
         two targets meet without overlapping. -->
    <px name="ams_edit_hdr_hit_micro" value="8"/>
    <px name="ams_edit_hdr_hit_small" value="2"/>
    <px name="ams_edit_hdr_hit_medium" value="2"/>
    <px name="ams_edit_hdr_hit_large" value="2"/>
    <px name="ams_edit_hdr_gap_micro" value="16"/>
    <px name="ams_edit_hdr_gap_small" value="4"/>
    <px name="ams_edit_hdr_gap_medium" value="4"/>
    <px name="ams_edit_hdr_gap_large" value="4"/>
  </consts>
  <subjects>
    <!-- Save stays shut until the lane records are read: an edit before the
         read would overwrite records nobody has seen. -->
    <subject_expr name="ams_edit_save_blocked" expr="ams_edit_save_disabled eq 1 or ams_lane_records_ready eq 0"/>
  </subjects>
  <styles>
    <!-- The colour view's presets pane: content-wide beside the picker, the
         view's full width alone. Both are bound styles, since an inline width
         would outrank either. -->
    <style name="color_pane_fit" width="content"/>
    <style name="color_pane_fill" width="100%"/>
  </styles>
  <view name="ams_edit_overlay"
        extends="overlay_panel" title="Edit Spool" hide_action_button="false" action_button_text="Save"
        action_button_callback="ams_edit_save_cb" action_button_disabled_subject="ams_edit_save_blocked"
        action_button_hidden_subject="ams_edit_save_hidden" title_badge_icon="spoolman"
        title_badge_subject="ams_edit_is_managed" back_button_callback="ams_edit_back_cb">
    <!-- Header icon buttons, left of Save: Choose from Spoolman and Scan QR,
         drawn by styles.header_icon_button. Injected into header_bar's content slot;
         gated on Spoolman availability (ams_edit_scan_enabled also carries
         the no-camera build gate). The row is the header's full height and
         padded by the reach, so each button's ext_click_area lies inside it:
         LVGL only hit-tests a child inside its parent's box. -->
    <header_bar-header_content>
      <lv_obj name="hdr_actions"
              width="content" height="100%" style_pad_ver="0" style_pad_hor="#ams_edit_hdr_hit"
              style_pad_gap="#ams_edit_hdr_gap" style_bg_opa="0" style_border_width="0" scrollable="false"
              clickable="false" flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center"
              hidden="true">
        <bind_flag_if_eq subject="printer_has_spoolman" flag="hidden" ref_value="0"/>
        <ui_button name="btn_hdr_spoolman"
                   width="#button_height_sm" height="#button_height_sm" icon="spoolman" icon_size="sm"
                   ext_click_area="#ams_edit_hdr_hit" hidden="true">
          <style name="styles.header_icon_button"/>
          <bind_flag_if_eq subject="printer_has_spoolman" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="ams_edit_choose_spoolman_cb"/>
        </ui_button>
        <ui_button name="btn_hdr_scan_qr"
                   width="#button_height_sm" height="#button_height_sm" icon="qrcode_scan" icon_size="sm"
                   ext_click_area="#ams_edit_hdr_hit" hidden="true">
          <style name="styles.header_icon_button"/>
          <bind_flag_if_eq subject="ams_edit_scan_enabled" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="ams_edit_scan_qr_cb"/>
        </ui_button>
      </lv_obj>
    </header_bar-header_content>
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_xs"
            style_pad_bottom="#space_xs" flex_flow="column" style_pad_gap="#space_xs" scrollable="true"
            scrollbar_mode="auto">

      <!-- ============================================================ -->
      <!-- EDITOR VIEW (ams_edit_view=0): the entry view.               -->
      <!-- ============================================================ -->
      <lv_obj name="editor_view"
              width="100%" height="content" flex_flow="column" style_pad_gap="#ams_edit_vgap" scrollable="false">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="0"/>

        <text_small name="lane_records_loading"
                    width="100%" long_mode="wrap" text="Loading lane details…" style_text_color="#text_muted">
          <bind_flag_if_eq subject="ams_lane_records_ready" flag="hidden" ref_value="1"/>
        </text_small>
        <!-- A save waits for the lane to hold it; one that does not stick says
             why here and keeps the form, so Save retries it. -->
        <text_small name="save_waiting" width="100%" long_mode="wrap" text="Saving..." style_text_color="#text_muted">
          <bind_flag_if_not_eq subject="ams_edit_save_state" flag="hidden" ref_value="1"/>
        </text_small>
        <text_small name="save_error"
                    width="100%" long_mode="wrap" bind_text="ams_edit_save_error" style_text_color="#danger">
          <bind_flag_if_not_eq subject="ams_edit_save_state" flag="hidden" ref_value="2"/>
        </text_small>

        <!-- Summary: colour dot + "eSUN Silk PETG, Blue" + from-tag badge +
             the weight pill. -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row_wrap" style_flex_cross_place="center"
                style_pad_gap="#space_sm" scrollable="false">
          <lv_obj name="summary_swatch_wrap"
                  width="44" height="44" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row"
                  style_flex_main_place="center" style_flex_cross_place="center" scrollable="false" clickable="true">
            <event_cb trigger="clicked" callback="ams_edit_custom_color_cb"/>
            <color_dot name="summary_color_swatch" size="#swatch_grid_size" color="#card_bg"/>
          </lv_obj>
          <text_body name="summary_text" bind_text="ams_edit_summary_text" flex_grow="1" long_mode="dots"/>
          <tag_badge name="summary_tag_badge" subject="ams_edit_tag_badge_visible"/>
          <lv_obj name="weight_pill"
                  width="content" height="content" flex_flow="row" style_flex_cross_place="center"
                  style_pad_hor="#space_md" style_pad_ver="#space_xs" style_pad_gap="#space_xs"
                  style_radius="#border_radius" style_bg_color="#elevated_bg" style_bg_opa="255" style_border_width="1"
                  style_border_color="#border" scrollable="false" clickable="true" ext_click_area="#ams_edit_pill_hit">
            <style name="styles.press_wash" selector="pressed"/>
            <icon src="weight" size="xs" variant="muted" clickable="false" event_bubble="true"/>
            <text_body bind_text="ams_edit_weight_text" clickable="false" event_bubble="true"/>
            <text_small bind_text="ams_edit_weight_hint"
                        style_text_color="#text_muted" clickable="false" event_bubble="true"/>
            <icon src="pencil" size="xs" variant="muted" clickable="false" event_bubble="true"/>
            <event_cb trigger="clicked" callback="ams_edit_weight_cb"/>
          </lv_obj>
        </lv_obj>
        <!-- Temperature line, full-width outside the short-landscape class; the
             split layout carries its own under the form, where the colour
             column leaves room. -->
        <lv_obj name="temp_row"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_xs" scrollable="false">
          <bind_flag_if cond="ui_breakpoint eq 0 and ui_is_portrait eq 0" flag="hidden"/>
          <text_small name="temp_line" bind_text="ams_edit_temp_text" style_text_color="#text_muted"/>
          <tag_badge subject="ams_edit_tag_temps"/>
        </lv_obj>

        <!-- Two layouts, both built, one hidden (bind_flag, not a structural
             <if>: the engine refuses <repeat> nested inside <if>). The short
             landscape class (min dimension <= 272, not portrait) splits -
             dropdown form left, colour column right; everything else stacks
             the colour grid under the form. Each dropdown's option list ends
             in "Browse catalog..." for the full catalog picker. -->
        <lv_obj name="layout_split"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_md"
                style_flex_cross_place="start" scrollable="false">
          <bind_flag_if cond="ui_breakpoint gt 0 or ui_is_portrait eq 1" flag="hidden"/>
          <lv_obj height="content"
                  flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
            <lv_obj width="100%"
                    height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                    style_pad_gap="#space_xs" scrollable="false">
              <text_small text="Material" style_min_width="#ams_edit_row_label_w"/>
              <lv_dropdown name="dropdown_material_split"
                           height="#button_height_sm" flex_grow="1" style_radius="#border_radius" options="">
                <event_cb trigger="value_changed" callback="ams_edit_material_dd_cb"/>
              </lv_dropdown>
              <tag_badge subject="ams_edit_tag_material"/>
            </lv_obj>
            <lv_obj width="100%"
                    height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                    style_pad_gap="#space_xs" scrollable="false">
              <text_small text="Variant" style_min_width="#ams_edit_row_label_w"/>
              <lv_dropdown name="dropdown_variant_split"
                           height="#button_height_sm" flex_grow="1" style_radius="#border_radius" options="">
                <event_cb trigger="value_changed" callback="ams_edit_variant_dd_cb"/>
              </lv_dropdown>
            </lv_obj>
            <lv_obj width="100%"
                    height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                    style_pad_gap="#space_xs" scrollable="false">
              <text_small text="Brand" style_min_width="#ams_edit_row_label_w"/>
              <lv_dropdown name="dropdown_brand_split"
                           height="#button_height_sm" flex_grow="1" style_radius="#border_radius" options="">
                <event_cb trigger="value_changed" callback="ams_edit_brand_dd_cb"/>
              </lv_dropdown>
              <tag_badge subject="ams_edit_tag_brand"/>
            </lv_obj>
            <lv_obj width="100%"
                    height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                    style_pad_gap="#space_xs" scrollable="false">
              <bind_flag_if_eq subject="ams_edit_product_hidden" flag="hidden" ref_value="1"/>
              <text_small text="Product" style_min_width="#ams_edit_row_label_w"/>
              <lv_dropdown name="dropdown_product_split"
                           height="#button_height_sm" flex_grow="1" style_radius="#border_radius" options="">
                <event_cb trigger="value_changed" callback="ams_edit_product_dd_cb"/>
              </lv_dropdown>
              <tag_badge subject="ams_edit_tag_product"/>
            </lv_obj>
            <lv_obj name="temp_row_split"
                    width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_xs" scrollable="false">
              <text_small bind_text="ams_edit_temp_text" style_text_color="#text_muted"/>
              <tag_badge subject="ams_edit_tag_temps"/>
            </lv_obj>
          </lv_obj>

          <lv_obj width="#ams_edit_color_col_w"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs"
                    style_flex_cross_place="center" scrollable="false">
              <text_small text="Color"/>
              <tag_badge subject="ams_edit_tag_color"/>
            </lv_obj>
            <lv_obj name="color_grid_split"
                    width="100%" height="content" style_pad_all="#swatch_grid_gap_half" flex_flow="row_wrap"
                    style_pad_gap="#swatch_grid_gap" scrollable="false">
              <!-- The custom colour: the app's rainbow custom swatch, the grid's
                   first tile so it shares the 44px hit pitch. It leads because
                   a count change rebuilds the repeat at the end of the row. -->
              <custom_color_swatch name="btn_custom_color_split"
                                   selected_subject="ams_edit_color_selected" callback="ams_edit_custom_color_cb"/>
              <repeat count="ams_edit_color_col_count">
                <color_swatch index="${i}"
                              color_subject="general_swatch_color_${i}" selected_subject="ams_edit_color_selected"
                              callback="ams_edit_quick_swatch_cb" size="#swatch_grid_size" hit="#swatch_grid_gap_half"
                              reach="#swatch_grid_ring_reach" ring="styles.grid_swatch_ring"/>
              </repeat>
            </lv_obj>
          </lv_obj>
        </lv_obj>

        <lv_obj name="layout_stacked"
                width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
                scrollable="false">
          <bind_flag_if cond="ui_breakpoint eq 0 and ui_is_portrait eq 0" flag="hidden"/>
          <lv_obj width="100%"
                  height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                  style_pad_gap="#space_xs" scrollable="false">
            <text_small text="Material" style_min_width="#ams_edit_row_label_w"/>
            <lv_dropdown name="dropdown_material"
                         height="#button_height_sm" flex_grow="1" style_radius="#border_radius" options="">
              <event_cb trigger="value_changed" callback="ams_edit_material_dd_cb"/>
            </lv_dropdown>
            <tag_badge subject="ams_edit_tag_material"/>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                  style_pad_gap="#space_xs" scrollable="false">
            <text_small text="Variant" style_min_width="#ams_edit_row_label_w"/>
            <lv_dropdown name="dropdown_variant"
                         height="#button_height_sm" flex_grow="1" style_radius="#border_radius" options="">
              <event_cb trigger="value_changed" callback="ams_edit_variant_dd_cb"/>
            </lv_dropdown>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                  style_pad_gap="#space_xs" scrollable="false">
            <text_small text="Brand" style_min_width="#ams_edit_row_label_w"/>
            <lv_dropdown name="dropdown_brand"
                         height="#button_height_sm" flex_grow="1" style_radius="#border_radius" options="">
              <event_cb trigger="value_changed" callback="ams_edit_brand_dd_cb"/>
            </lv_dropdown>
            <tag_badge subject="ams_edit_tag_brand"/>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                  style_pad_gap="#space_xs" scrollable="false">
            <bind_flag_if_eq subject="ams_edit_product_hidden" flag="hidden" ref_value="1"/>
            <text_small text="Product" style_min_width="#ams_edit_row_label_w"/>
            <lv_dropdown name="dropdown_product"
                         height="#button_height_sm" flex_grow="1" style_radius="#border_radius" options="">
              <event_cb trigger="value_changed" callback="ams_edit_product_dd_cb"/>
            </lv_dropdown>
            <tag_badge subject="ams_edit_tag_product"/>
          </lv_obj>

          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs"
                  style_flex_cross_place="center" scrollable="false">
            <text_small text="Color"/>
            <tag_badge subject="ams_edit_tag_color"/>
          </lv_obj>
          <lv_obj name="color_grid"
                  width="100%" height="content" style_pad_all="#swatch_grid_gap_half" flex_flow="row_wrap"
                  style_pad_gap="#swatch_grid_gap" scrollable="false">
            <!-- The custom colour: the app's rainbow custom swatch, the grid's
                 first tile so it shares the 44px hit pitch. It leads because
                 a count change rebuilds the repeat at the end of the row. -->
            <custom_color_swatch name="btn_custom_color"
                                 selected_subject="ams_edit_color_selected" callback="ams_edit_custom_color_cb"/>
            <repeat count="ams_edit_color_row_count">
              <color_swatch index="${i}"
                            color_subject="general_swatch_color_${i}" selected_subject="ams_edit_color_selected"
                            callback="ams_edit_quick_swatch_cb" size="#swatch_grid_size" hit="#swatch_grid_gap_half"
                            reach="#swatch_grid_ring_reach" ring="styles.grid_swatch_ring"/>
            </repeat>
          </lv_obj>
        </lv_obj>

        <!-- The lane's own settings, written to the backend on Save: which tool
             it feeds and its Endless Spool backup. Each row shows only where
             the backend supports it; the backup row reads disabled where the
             firmware picks the backup itself. The status line under them says
             what a runout will do, including where neither row can show. It
             sits above More, so it is in view when the editor opens. -->
        <lv_obj name="lane_section"
                width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#ams_edit_vgap"
                scrollable="false" hidden="true">
          <bind_flag_if_eq subject="ams_edit_lane_visible" flag="hidden" ref_value="0"/>
          <lv_obj name="lane_row"
                  width="100%" height="content" style_pad_all="0" flex_flow="row_wrap" style_flex_cross_place="center"
                  style_pad_column="#space_lg" style_pad_row="#ams_edit_vgap" scrollable="false">
            <bind_flag_if cond="ams_edit_tool_row_visible eq 0 and ams_edit_backup_row_visible eq 0" flag="hidden"/>
            <lv_obj name="tool_dropdown_row"
                    width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_xs" scrollable="false" hidden="true">
              <bind_flag_if_eq subject="ams_edit_tool_row_visible" flag="hidden" ref_value="0"/>
              <text_small name="tool_label" text="Assigned Tool"/>
              <lv_dropdown name="tool_dropdown"
                           width="#ams_edit_tool_dd_w" height="#button_height_sm" style_radius="#border_radius"
                           options="">
                <event_cb trigger="value_changed" callback="ams_edit_tool_dd_cb"/>
              </lv_dropdown>
            </lv_obj>
            <lv_obj name="backup_dropdown_row"
                    width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_xs" scrollable="false" hidden="true">
              <bind_flag_if_eq subject="ams_edit_backup_row_visible" flag="hidden" ref_value="0"/>
              <icon src="infinity" size="xs" variant="muted"/>
              <text_small name="backup_label" bind_text="ams_edit_backup_label"/>
              <lv_dropdown name="backup_dropdown"
                           width="#ams_edit_lane_dd_w" height="#button_height_sm" style_radius="#border_radius"
                           options="">
                <bind_state_if_eq subject="ams_edit_backup_editable" state="disabled" ref_value="0"/>
                <event_cb trigger="value_changed" callback="ams_edit_backup_dd_cb"/>
              </lv_dropdown>
            </lv_obj>
          </lv_obj>
          <ams_endless_status name="endless_status"/>
        </lv_obj>

        <!-- The quiet actions bar. MORE is a collapsed disclosure for the four
             logistics fields, which are Spoolman-owned, so the toggle exists
             only on a linked slot. The Add-to-Spoolman link is the untracked
             slot's way in, so it sits beside the toggle rather than inside it.
             Reset to tag restores every field the spool's tag states. Clear
             Spool takes the spool off the slot, Spoolman or not. Each
             reaches a 44px hit through ext_click_area, so the bar stays short. -->
        <lv_obj name="more_bar"
                width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                style_pad_gap="#space_sm" scrollable="false">
          <bind_flag_if cond="ams_edit_is_managed eq 0 and ams_edit_add_spoolman_visible eq 0 and ams_edit_reset_tag_visible eq 0 and ams_edit_clear_visible eq 0"
                        flag="hidden"/>
          <lv_obj name="more_row"
                  height="content" flex_grow="1" flex_flow="row" style_flex_cross_place="center" hidden="true"
                  style_pad_hor="#space_sm" style_pad_ver="#ams_edit_more_pad" style_pad_gap="#space_sm"
                  style_radius="#border_radius" style_bg_opa="0" style_border_width="0" scrollable="false"
                  clickable="true" ext_click_area="#ams_edit_bar_hit">
            <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="ams_edit_more_toggle_cb"/>
            <icon name="more_chevron" src="chevron_down" size="sm" variant="muted" clickable="false" event_bubble="true"/>
            <text_body text="More" clickable="false" event_bubble="true"/>
            <text_small text="Price, location, lot, notes"
                        flex_grow="1" long_mode="dots" clickable="false" event_bubble="true"/>
          </lv_obj>
          <lv_obj name="add_to_spoolman_link"
                  width="content" height="content" style_pad_hor="#space_xs" style_pad_ver="#space_xxs" flex_flow="row"
                  style_flex_cross_place="center" style_pad_gap="#space_xxs" style_radius="#border_radius"
                  style_bg_opa="0" style_border_width="0" clickable="true" scrollable="false" hidden="true"
                  ext_click_area="#ams_edit_bar_hit">
            <bind_flag_if_eq subject="ams_edit_add_spoolman_visible" flag="hidden" ref_value="0"/>
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="ams_edit_add_to_spoolman_cb"/>
            <icon src="plus" size="xs" variant="primary" clickable="false" event_bubble="true"/>
            <text_small text="Add to Spoolman + label" style_text_color="#primary" clickable="false" event_bubble="true"/>
          </lv_obj>
          <lv_obj name="btn_reset_tag"
                  width="content" height="content" style_pad_hor="#space_xs" style_pad_ver="#space_xxs" flex_flow="row"
                  style_flex_cross_place="center" style_pad_gap="#space_xxs" style_radius="#border_radius"
                  style_bg_opa="0" style_border_width="0" clickable="true" scrollable="false" hidden="true"
                  ext_click_area="#ams_edit_bar_hit">
            <bind_flag_if_eq subject="ams_edit_reset_tag_visible" flag="hidden" ref_value="0"/>
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="ams_edit_reset_tag_cb"/>
            <icon src="undo" size="xs" variant="primary" clickable="false" event_bubble="true"/>
            <text_small text="Reset to tag" style_text_color="#primary" clickable="false" event_bubble="true"/>
          </lv_obj>
          <lv_obj name="btn_clear_spool"
                  width="content" height="content" style_pad_hor="#space_xs" style_pad_ver="#space_xxs" flex_flow="row"
                  style_flex_cross_place="center" style_pad_gap="#space_xxs" style_radius="#border_radius"
                  style_bg_opa="0" style_border_width="0" clickable="true" scrollable="false" hidden="true"
                  ext_click_area="#ams_edit_bar_hit">
            <bind_flag_if_eq subject="ams_edit_clear_visible" flag="hidden" ref_value="0"/>
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="ams_edit_clear_spool_cb"/>
            <icon src="close" size="xs" variant="primary" clickable="false" event_bubble="true"/>
            <text_small text="Clear Spool" style_text_color="#primary" clickable="false" event_bubble="true"/>
          </lv_obj>
        </lv_obj>
        <lv_obj name="more_section"
                width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
                scrollable="false" hidden="true">
          <bind_flag_if_eq subject="ams_edit_more_open" flag="hidden" ref_value="0"/>
          <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="row_wrap" style_pad_gap="#space_md" scrollable="false">
            <lv_obj width="content"
                    height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
              <text_small text="Price"/>
              <text_input name="detail_field_price"
                          width="#field_w_num" keyboard_hint="numeric" placeholder="0.00" max_length="10">
                <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
              </text_input>
            </lv_obj>
            <lv_obj width="content"
                    height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
              <text_small text="Location"/>
              <text_input name="detail_field_location"
                          width="#field_w_text" placeholder="Shelf A" placeholder_tag="Shelf A" max_length="64">
                <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
              </text_input>
            </lv_obj>
            <lv_obj width="content"
                    height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
              <text_small text="Lot/Batch Nr"/>
              <text_input name="detail_field_lot_nr" width="#field_w_text" placeholder="" max_length="32">
                <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
              </text_input>
            </lv_obj>
          </lv_obj>
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Notes"/>
            <text_input name="detail_field_comment"
                        width="100%" height="#notes_height" placeholder="" max_length="256" multiline="true">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <!-- Spool-logistics action: visible only when a label printer is
               configured. Starts hidden so it stays hidden wherever the
               binding cannot resolve. -->
          <ui_button name="btn_detail_print_label"
                     width="content" height="#button_height_sm" text="Print Label" variant="secondary" icon="printer"
                     hidden="true">
            <bind_flag_if_eq subject="label_printer_configured" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="ams_edit_print_label_cb"/>
          </ui_button>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- PICKER VIEW: Spoolman spool selection (ams_edit_view=1)      -->
      <!-- ============================================================ -->
      <lv_obj name="picker_view"
              width="100%" height="content" flex_flow="column" style_pad_all="#space_md" style_pad_gap="#space_sm"
              scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="1"/>

        <!-- Search filter -->
        <text_input name="picker_search"
                    width="100%" placeholder_text="Search spools..." placeholder_tag="Search spools...">
          <event_cb trigger="value_changed" callback="ams_edit_picker_search_cb"/>
        </text_input>

        <!-- Loading state: the canonical centered loading pattern (cf.
             spoolman_panel.xml loading_state). -->
        <centered_column name="picker_loading" width="100%" height="120" hidden="true">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="0"/>
          <spinner size="md"/>
          <text_body text="Loading spools..." style_text_align="center"/>
        </centered_column>

        <!-- Empty state: the FETCH failed - tap retries the fetch -->
        <lv_obj name="picker_empty"
                width="100%" height="120" scrollable="false" hidden="true" clickable="true"
                style_radius="#border_radius">
          <style name="styles.press_wash" selector="pressed"/>
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="1"/>
          <event_cb trigger="clicked" callback="ams_edit_picker_retry_cb"/>
          <empty_state icon="spoolman" text="No spools found — tap to retry" clickable="false" event_bubble="true"/>
        </lv_obj>

        <!-- No-match state: the fetch succeeded, the term just matches nothing
             (edit_picker_state=3). Informational, not clickable - distinct from
             the retry card above so a narrowing search never reads as an error. -->
        <lv_obj name="picker_no_match" width="100%" height="120" scrollable="false" hidden="true">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="3"/>
          <empty_state icon="magnify" text="No spools match your search" clickable="false"/>
        </lv_obj>

        <!-- Spool list (populated dynamically by C++) -->
        <lv_obj name="picker_spool_list"
                width="100%" height="content" style_max_height="#spool_list_max_height" style_pad_all="#space_xxs"
                style_radius="#border_radius" style_pad_gap="#space_xxs" flex_flow="column"
                style_flex_main_place="start" style_flex_cross_place="start" style_bg_color="#card_bg"
                style_bg_opa="255" scrollable="true" hidden="true">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="2"/>
        </lv_obj>

        <!-- Escape hatch to untracked setup — locked naming (spec §3.8).
             Outlined (border) row, visually distinct from spool rows; always
             visible, including the empty state (resolution §2.4). -->
        <lv_obj name="picker_setup_entry"
                width="100%" height="content" style_bg_opa="0" style_border_width="1" style_border_color="#text_muted"
                style_border_opa="120" style_radius="#border_radius" style_pad_all="#space_sm" flex_flow="row"
                style_flex_main_place="center" clickable="true" scrollable="false">
          <style name="styles.press_wash" selector="pressed"/>
          <event_cb trigger="clicked" callback="ams_edit_setup_entry_cb"/>
          <text_body text="Not in your spools? Set it up" clickable="false"/>
          <icon src="chevron_right" size="sm" variant="muted" clickable="false"/>
        </lv_obj>

      </lv_obj>

      <!-- ============================================================ -->
      <!-- COLOR VIEW (ams_edit_view=2): preset grid and custom HSV.    -->
      <!-- A preset tap applies immediately; HSV/hex + Select applies a -->
      <!-- custom color. Returns to the editor view (its sole entry).   -->
      <!-- ============================================================ -->
      <!-- Where both panes fit the content area (ams_edit_color_fits, measured
           by update_color_fit) they show together, side by side or wrapped onto
           two rows. Where they do not, one pane fills the view at a time
           (ams_edit_color_pane): the presets lead with the rainbow custom swatch,
           which swaps in the picker, and the picker's Presets button swaps back. -->
      <lv_obj name="color_view"
              width="100%" height="content" style_min_height="100%" flex_flow="row_wrap" style_pad_all="#space_lg"
              style_pad_gap="#space_xl" style_flex_main_place="center" style_flex_cross_place="center"
              style_flex_track_place="center" scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="2"/>

        <!-- Preset swatches: tap applies + returns -->
        <lv_obj name="color_presets"
                height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
          <bind_flag_if cond="ams_edit_color_fits eq 0 and ams_edit_color_pane eq 1" flag="hidden"/>
          <bind_style name="color_pane_fit" subject="ams_edit_color_fits" ref_value="1"/>
          <bind_style name="color_pane_fill" subject="ams_edit_color_fits" ref_value="0"/>
          <text_small text="Presets"/>
          <!-- Last child: the reactive <if> rebuilds at the end of the list. -->
          <if cond="ams_edit_color_fits eq 1">
            <color_swatch_grid swatch_callback="ams_edit_color_swatch_cb"/>
            <else/>
            <color_swatch_grid width="100%"
                               swatch_callback="ams_edit_color_swatch_cb" lead_hidden="false"
                               lead_callback="ams_edit_color_show_picker_cb"/>
          </if>
        </lv_obj>

        <!-- Custom hue: HSV + hex + Select -->
        <lv_obj name="color_custom"
                width="content" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xl"
                style_flex_cross_place="center" scrollable="false">
          <bind_flag_if cond="ams_edit_color_fits eq 0 and ams_edit_color_pane eq 0" flag="hidden"/>
          <ui_hsv_picker name="ams_color_hsv" sv_size="#sv_size" hue_height="#hue_height" gap="#space_sm"/>
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="start"
                  style_flex_cross_place="start" style_pad_gap="#space_sm" scrollable="false">
            <!-- A colour area, not a swatch: a rounded rect. -->
            <swatch_paint name="ams_color_preview"
                          width="#color_preview_size" height="#color_preview_size_small" style_radius="#border_radius"
                          color="#card_bg"/>
            <text_input name="ams_color_hex_input"
                        width="100" height="content" max_length="9" text="#808080" placeholder_text="#hex_placeholder"
                        style_outline_width="0" scrollable="false">
              <event_cb trigger="value_changed" callback="ams_edit_color_hex_changed_cb"/>
            </text_input>
            <ui_button name="btn_color_apply" width="100" height="#button_height_sm" text="Select" variant="primary">
              <event_cb trigger="clicked" callback="ams_edit_color_apply_cb"/>
            </ui_button>
            <ui_button name="btn_color_presets" width="100" height="#button_height_sm" text="Presets" variant="ghost">
              <bind_flag_if_eq subject="ams_edit_color_fits" flag="hidden" ref_value="1"/>
              <event_cb trigger="clicked" callback="ams_edit_color_show_presets_cb"/>
            </ui_button>
          </lv_obj>
        </lv_obj>
      </lv_obj>

    </lv_obj>
  </view>
</component>
