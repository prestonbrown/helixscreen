<!-- AMS slot editor overlay. One overlay, internal views selected by the
     ams_edit_view int subject: 0=overview (form), 1=Spoolman spool picker.
     Header bar: back button (per-view routing via ams_edit_back_cb) and a
     dirty-gated Save action (ams_edit_save_disabled subject), hidden outside
     the overview via ams_edit_save_hidden. Both subjects are written
     exclusively by AmsEditOverlay::set_view(). -->
<component>
  <consts>
    <px name="left_column_width" value="120"/>
    <!-- Spool-picker list max height: caps the scroll viewport so the picker
         stays inside the overlay. Tuned to show ~5 rows at each breakpoint. -->
    <px name="spool_list_max_height_micro" value="130"/>
    <px name="spool_list_max_height_tiny" value="150"/>
    <px name="spool_list_max_height_small" value="180"/>
    <px name="spool_list_max_height_medium" value="250"/>
    <px name="spool_list_max_height_large" value="330"/>
    <px name="spool_list_max_height_xlarge" value="420"/>
    <px name="spool_list_max_height_xxlarge" value="520"/>
    <!-- Spool-details Notes field height (mirrors spoolman_edit_modal) -->
    <px name="notes_height_small" value="44"/>
    <px name="notes_height_medium" value="72"/>
    <px name="notes_height_large" value="88"/>
    <!-- Spool-edit field widths, sized to their content so several fields share a
         row (row_wrap falls back to stacked at micro). A flex_grow field would
         stretch an 8-digit gram value across half the overlay.
         Numeric = up to 8 digits, text = a short label. -->
    <px name="field_w_num_small" value="76"/>
    <px name="field_w_num_medium" value="96"/>
    <px name="field_w_num_large" value="110"/>
    <px name="field_w_text_small" value="120"/>
    <px name="field_w_text_medium" value="150"/>
    <px name="field_w_text_large" value="180"/>
    <!-- Height of the spool-edit color column, so the catalog selector beside it
         can be pinned to the same height and its product list lands flush with the
         bottom swatch row (LVGL flex has no cross-axis stretch, so the selector
         needs a definite height for its flex_grow list to have slack — #1128).
         = swatch grid (5 rows) + the 28px "Color ▣ ✎" header + one space_xs gap.
         KEEP IN SYNC with the swatch/gap ladder in
         register_swatch_grid_constants() (src/xml_registration.cpp):
           micro 24px/6gap, tiny+small 28/8, medium+ 32/8. -->
    <px name="swatch_col_height_micro" value="174"/>
    <px name="swatch_col_height_tiny" value="202"/>
    <px name="swatch_col_height_small" value="204"/>
    <px name="swatch_col_height_medium" value="225"/>
    <px name="swatch_col_height_large" value="226"/>
    <px name="swatch_col_height_xlarge" value="228"/>
    <px name="swatch_col_height_xxlarge" value="230"/>
  </consts>
  <view name="ams_edit_overlay"
        extends="overlay_panel" title="Edit Slot" title_tag="Edit Slot" hide_action_button="false"
        action_button_text="Save" action_button_text_tag="Save" action_button_callback="ams_edit_save_cb"
        action_button_disabled_subject="ams_edit_save_disabled" action_button_hidden_subject="ams_edit_save_hidden"
        title_badge_image="spoolman_mark" title_badge_subject="ams_edit_is_managed"
        back_button_callback="ams_edit_back_cb">
    <lv_obj name="overlay_content"
            width="100%" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="0" scrollable="true"
            scrollbar_mode="auto">

      <!-- ============================================================ -->
      <!-- OVERVIEW VIEW: slot state + manual edit (ams_edit_view=0)    -->
      <!-- ============================================================ -->
      <lv_obj name="form_view"
              width="100%" flex_grow="1" flex_flow="column" style_pad_gap="0" style_flex_main_place="center"
              scrollable="false">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="0"/>
        <!-- Content area - HORIZONTAL layout with side-by-side sections -->
        <lv_obj width="100%"
                height="content" style_pad_all="#space_lg" flex_flow="row" style_pad_gap="#space_xl" scrollable="false">
          <!-- LEFT COLUMN: Tool remap + Color preview -->
          <lv_obj width="#left_column_width"
                  height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="start"
                  style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
            <!-- Tool assignment dropdown (hidden when backend doesn't support remapping) -->
            <lv_obj name="tool_remap_row"
                    width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs"
                    scrollable="false" hidden="true">
              <text_small text="Remap Tool" translation_tag="Remap Tool"/>
              <lv_dropdown name="tool_dropdown"
                           width="100%" height="content" style_radius="#border_radius" style_border_width="0"
                           options="None">
                <event_cb trigger="value_changed" callback="ams_edit_tool_changed_cb"/>
              </lv_dropdown>
            </lv_obj>
          </lv_obj>
          <!-- RIGHT: current-spool card. All display of the loaded spool in one
               tappable unit; pencil signals editability; tap opens spool-edit.
               Every child is clickable="false" event_bubble="true" so taps reach
               the card [L071]. -->
          <lv_obj name="spool_card"
                  height="content" flex_grow="1" style_bg_color="#elevated_bg" style_bg_opa="255"
                  style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_sm"
                  clickable="true" scrollable="false">
            <event_cb trigger="clicked" callback="ams_edit_card_clicked_cb"/>
            <!-- Row 1: swatch + name + mark + pencil -->
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_sm" clickable="false" event_bubble="true" scrollable="false">
              <lv_obj name="card_color_swatch"
                      width="28" height="28" style_radius="#border_radius_small" style_bg_color="#card_bg"
                      style_bg_opa="255" style_border_width="1" style_border_color="#text_muted" style_border_opa="80"
                      clickable="false" event_bubble="true" scrollable="false"/>
              <text_body name="card_identity_label"
                         text="" flex_grow="1" long_mode="dots" clickable="false" event_bubble="true"/>
              <!-- Trailing Spoolman-tracked badge. Rendered at the asset's
                   intrinsic 24px (spoolman_24.png) and tinted via recolor. -->
              <lv_image name="chip_spoolman_mark"
                        src="spoolman_mark" style_image_recolor="#text_muted" style_image_recolor_opa="255"
                        hidden="true" clickable="false" event_bubble="true">
                <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
              </lv_image>
              <!-- Spoolman spool number ("#19") next to the mark. The mark alone
                   says "tracked" but not *which* spool; the id is what the user
                   cross-references against Spoolman's own list. -->
              <text_small name="chip_spoolman_id"
                          bind_text="ams_edit_spoolman_id" style_text_color="#text_muted" hidden="true"
                          clickable="false" event_bubble="true">
                <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
              </text_small>
              <icon src="pencil" size="sm" variant="muted" clickable="false" event_bubble="true"/>
            </lv_obj>
            <!-- Row 2: remaining (display-only). remaining_progress_container's
                 hidden state has exactly one writer: update_ui() (total <= 0
                 hides it). -->
            <lv_obj name="card_remaining_row"
                    width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_sm" clickable="false" event_bubble="true" scrollable="false">
              <lv_obj name="remaining_progress_container"
                      height="#slider_height" flex_grow="1" style_bg_color="#text_muted" style_bg_opa="38"
                      style_radius="#border_radius" style_pad_all="0" clickable="false" event_bubble="true"
                      scrollable="false">
                <lv_obj name="remaining_progress_fill"
                        width="100%" height="100%" style_bg_color="#primary" style_bg_opa="255"
                        style_radius="#border_radius" style_pad_all="0" clickable="false" scrollable="false"/>
              </lv_obj>
              <text_small name="remaining_pct_label" text="—" clickable="false" event_bubble="true"/>
            </lv_obj>
            <!-- Row 3: temps (full strings written by update_temp_display) -->
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_lg" clickable="false"
                    event_bubble="true" scrollable="false">
              <text_small name="temp_nozzle_label" text="" clickable="false" event_bubble="true"/>
              <text_small name="temp_bed_label" text="" clickable="false" event_bubble="true"/>
            </lv_obj>
          </lv_obj>
        </lv_obj>
        <!-- Filament actions: paired row under the card (design Option 1).
             Change Filament is the primary swap action — the Spoolman picker
             when connected, else the untracked spool-edit setup (routing in
             handle_change_filament). Scan QR is the identity fast path for both
             linked and unlinked slots and is gated on Spoolman availability
             (update_spoolman_button_state toggles btn_scan_qr_code's hidden
             flag). A hidden flex child drops out of layout, so when Scan QR is
             hidden the lone Change Filament button stays centered. Unlink and
             Print Label live in the spool-edit view. -->
        <lv_obj name="filament_action_row"
                width="100%" height="content" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="0"
                style_pad_bottom="#space_sm" flex_flow="row_wrap" style_flex_main_place="center"
                style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false">
          <ui_button name="btn_change_filament"
                     height="#button_height" text="Change Filament" translation_tag="Change Filament"
                     variant="secondary" icon="arrow_left_right">
            <event_cb trigger="clicked" callback="ams_edit_change_filament_cb"/>
          </ui_button>
          <ui_button name="btn_scan_qr_code"
                     height="#button_height" text="Scan QR Code" translation_tag="Scan QR Code" variant="secondary"
                     icon="qrcode_scan">
            <event_cb trigger="clicked" callback="ams_edit_scan_qr_cb"/>
          </ui_button>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- PICKER VIEW: Spoolman spool selection (ams_edit_view=1)      -->
      <!-- ============================================================ -->
      <lv_obj name="picker_view"
              width="100%" height="content" flex_flow="column" style_pad_all="#space_md" style_pad_gap="#space_sm"
              scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="1"/>

        <!-- Search filter -->
        <text_input name="picker_search"
                    width="100%" placeholder_text="Search spools..." placeholder_tag="Search spools...">
          <event_cb trigger="value_changed" callback="ams_edit_picker_search_cb"/>
        </text_input>

        <!-- Loading state -->
        <lv_obj name="picker_loading"
                width="100%" height="120" flex_flow="column" style_flex_main_place="center"
                style_flex_cross_place="center" style_pad_all="0" scrollable="false">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="0"/>
          <lv_spinner width="32"
                      height="32" style_arc_width-indicator="2" style_arc_color="#primary" style_arc_opa-main="0"/>
          <text_body text="Loading spools..." translation_tag="Loading spools..." style_pad_top="#space_sm"/>
        </lv_obj>

        <!-- Empty state -->
        <lv_obj name="picker_empty" width="100%" height="120" scrollable="false" hidden="true" clickable="true">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="1"/>
          <event_cb trigger="clicked" callback="ams_edit_picker_retry_cb"/>
          <empty_state icon="spoolman"
                       text="No spools found — tap to retry" translation_tag="No spools found — tap to retry"
                       clickable="false" event_bubble="true"/>
        </lv_obj>

        <!-- Spool list (populated dynamically by C++) -->
        <lv_obj name="picker_spool_list"
                width="100%" height="content" style_max_height="#spool_list_max_height" style_pad_all="#space_xxs"
                style_radius="#border_radius" style_pad_gap="#space_xxs" flex_flow="column"
                style_flex_main_place="start" style_flex_cross_place="start" style_bg_color="#card_bg"
                style_bg_opa="255" scrollable="true" hidden="true">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="2"/>
        </lv_obj>

        <!-- Escape hatch to untracked setup — locked naming (spec §3.8).
             Outlined (border) row, visually distinct from spool rows; always
             visible, including the empty state (resolution §2.4). -->
        <lv_obj name="picker_setup_entry"
                width="100%" height="content" style_bg_opa="0" style_border_width="1" style_border_color="#text_muted"
                style_border_opa="120" style_radius="#border_radius" style_pad_all="#space_sm" flex_flow="row"
                style_flex_main_place="center" clickable="true" scrollable="false">
          <event_cb trigger="clicked" callback="ams_edit_setup_entry_cb"/>
          <text_body text="Not in your spools? Set it up"
                     translation_tag="Not in your spools? Set it up" clickable="false"/>
          <icon src="chevron_right" size="sm" variant="muted" clickable="false"/>
        </lv_obj>

      </lv_obj>

      <!-- ============================================================ -->
      <!-- SPOOL EDIT VIEW (ams_edit_view=2): unified identity + color + -->
      <!-- logistics. Untracked setup AND editing the current filament  -->
      <!-- (spec §3.3); logistics section shows for managed slots only.  -->
      <!-- ============================================================ -->
      <lv_obj name="details_view"
              width="100%" height="content" flex_flow="column" style_pad_all="#space_md" style_pad_gap="#space_md"
              scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="2"/>

        <!-- Identity + color side by side: the color palette (LEFT) fits the
             fixed-width swatch grid; the catalog identity (RIGHT) takes the
             remaining width. Horizontal space is plentiful here, vertical is
             scarce — so the two stacks share a row instead of stacking.
             The selector carries a DEFINITE height (#swatch_col_height above) so its
             children can fill it: LVGL flex has no cross-axis stretch, and a
             content-sized column would leave the flex_grow product list collapsed to
             its min-height instead of running down to the swatch baseline (#1128). -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_lg"
                style_flex_cross_place="start" scrollable="false">
          <!-- LEFT: inline color — shared full preset palette (one palette
               everywhere) + custom-hue affordance (✎ opens the color view). -->
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm"
                    style_flex_cross_place="center" scrollable="false">
              <text_small text="Color" translation_tag="Color"/>
              <!-- Selected-color preview -->
              <lv_obj name="details_color_preview"
                      width="28" height="28" style_radius="#border_radius_small" style_bg_color="#card_bg"
                      style_bg_opa="255" style_border_width="2" style_border_color="#text_muted" style_border_opa="80"
                      scrollable="false"/>
              <!-- Custom-hue escape hatch: opens the color view (swatches + HSV) -->
              <ui_button name="btn_details_custom_color" width="28" height="28" icon="pencil" variant="ghost">
                <event_cb trigger="clicked" callback="ams_edit_custom_color_cb"/>
              </ui_button>
            </lv_obj>
            <color_swatch_grid swatch_callback="ams_edit_quick_swatch_cb"/>
          </lv_obj>
          <!-- RIGHT: Brand / Material / product. Pinned to the color column's exact
               height (#swatch_col_height) so the flex_grow product list has real
               slack and lands flush with the bottom of the last swatch row. -->
          <lv_obj height="content"
                  flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
            <filament_catalog_selector name="details_catalog_selector" height="#swatch_col_height"/>
          </lv_obj>
        </lv_obj>

        <!-- One full-width metadata row for every short field: Remaining and Spool wt
             (which apply to tracked AND untracked slots) plus the Spoolman-only
             Price / Location / Lot. Full width rather than inside the selector column
             because five content-sized fields need more room than that column has.
             The three Spoolman fields carry the ams_edit_is_managed gate individually
             so an untracked slot drops them and keeps the two gram fields — the row
             is shared, so the gate cannot live on a wrapper. row_wrap reflows the set
             onto as many lines as the width allows. -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row_wrap" style_pad_gap="#space_md" scrollable="false">
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Remaining (g)" translation_tag="Remaining (g)"/>
            <text_input name="detail_field_remaining"
                        width="#field_w_num" keyboard_hint="numeric" placeholder="1000" max_length="8">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Spool wt (g)" translation_tag="Spool wt (g)"/>
            <text_input name="detail_field_spool_weight"
                        width="#field_w_num" keyboard_hint="numeric" placeholder="0" max_length="8">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false"
                  hidden="true">
            <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
            <text_small text="Price" translation_tag="Price"/>
            <text_input name="detail_field_price"
                        width="#field_w_num" keyboard_hint="numeric" placeholder="0.00" max_length="10">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false"
                  hidden="true">
            <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
            <text_small text="Location" translation_tag="Location"/>
            <text_input name="detail_field_location"
                        width="#field_w_text" placeholder="Shelf A" placeholder_tag="Shelf A" max_length="64">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false"
                  hidden="true">
            <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
            <text_small text="Lot/Batch Nr" translation_tag="Lot/Batch Nr"/>
            <text_input name="detail_field_lot_nr" width="#field_w_text" placeholder="" max_length="32">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <!-- Save to Spoolman toggle — locked naming (spec §3.8). Absent when
               Spoolman is disconnected; defaults to the slot's managed state. Gated on
               printer_has_spoolman (NOT is_managed): it must stay reachable on an
               untracked slot, since it is how the user opts that slot into Spoolman. -->
          <lv_obj name="save_to_spoolman_row"
                  height="content" flex_grow="1" style_pad_all="0" style_min_width="170" flex_flow="row"
                  style_flex_main_place="end" style_flex_cross_place="center" style_pad_gap="#space_sm"
                  scrollable="false">
            <bind_flag_if_eq subject="printer_has_spoolman" flag="hidden" ref_value="0"/>
            <text_small text="Save to Spoolman" translation_tag="Save to Spoolman"/>
            <ui_switch name="save_to_spoolman_switch" size="small">
              <bind_state_if_eq subject="ams_edit_is_managed" state="checked" ref_value="1"/>
            </ui_switch>
          </lv_obj>
        </lv_obj>

        <!-- Logistics: the remaining Spoolman-only field. Price/Location/Lot moved up
             into the shared metadata row; Notes stays here because it is the one
             field that wants the full width. Hidden for untracked slots. -->
        <lv_obj name="spool_edit_logistics"
                width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm"
                scrollable="false" hidden="true">
          <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
          <!-- Notes (full width) -->
          <lv_obj width="100%"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Notes" translation_tag="Notes"/>
            <text_input name="detail_field_comment"
                        width="100%" height="#notes_height" placeholder="" max_length="256" multiline="true">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
        </lv_obj>

        <!-- Save lives in the header bar on this view (visible on overview AND
             spool-edit); it applies identity/color/logistics, then finishes and
             closes the editor. The former in-content Save button was retired. -->

        <!-- Spool-logistics action: visible only when a label printer is
             configured. The static hidden="true" is the fallback for builds
             without label-printer support, where `label_printer_configured` is
             never registered and this binding is skipped. -->
        <ui_button name="btn_detail_print_label"
                   width="100%" height="#button_height" text="Print Label" translation_tag="Print Label"
                   variant="secondary" icon="printer" hidden="true">
          <bind_flag_if_eq subject="label_printer_configured" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="ams_edit_print_label_cb"/>
        </ui_button>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- COLOR VIEW (ams_edit_view=3): one screen — preset grid AND   -->
      <!-- custom HSV side by side. A preset tap applies immediately;   -->
      <!-- HSV/hex + Select applies a custom color. Returns to the      -->
      <!-- spool-edit view (its sole entry point).                      -->
      <!-- ============================================================ -->
      <lv_obj name="color_view"
              width="100%" flex_grow="1" flex_flow="row" style_pad_all="#space_lg" style_pad_gap="#space_xl"
              style_flex_main_place="center" style_flex_cross_place="center" scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_view" flag="hidden" ref_value="3"/>

        <!-- Preset swatches: tap applies + returns -->
        <lv_obj height="content"
                flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
          <text_small text="Presets" translation_tag="Presets"/>
          <color_swatch_grid swatch_callback="ams_edit_color_swatch_cb"/>
        </lv_obj>

        <!-- Custom hue: HSV + hex + Select -->
        <lv_obj width="content"
                height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_md"
                style_flex_cross_place="center" scrollable="false">
          <ui_hsv_picker name="ams_color_hsv" sv_size="#sv_size" hue_height="#hue_height" gap="#space_sm"/>
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="start"
                  style_flex_cross_place="start" style_pad_gap="#space_sm" scrollable="false">
            <lv_obj name="ams_color_preview"
                    width="#color_preview_size" height="#color_preview_size_small" style_radius="#border_radius"
                    style_bg_color="#card_bg" style_bg_opa="255" style_border_width="2" style_border_color="#text_muted"
                    style_border_opa="80" scrollable="false"/>
            <text_input name="ams_color_hex_input"
                        width="100" height="content" max_length="9" text="#808080" placeholder_text="#hex_placeholder"
                        style_border_width="0" style_outline_width="0" scrollable="false">
              <event_cb trigger="value_changed" callback="ams_edit_color_hex_changed_cb"/>
            </text_input>
            <ui_button name="btn_color_apply"
                       width="100" height="#button_height_sm" text="Select" translation_tag="Select" variant="primary">
