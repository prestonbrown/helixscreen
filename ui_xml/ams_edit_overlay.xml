<!-- The lane spool editor: one overlay, one page at a time, picked by the
     ams_edit_page int subject (AmsEditOverlay::kPage*):
       0 = the lane summary (the spool, its weight, Clear Lane and Save),
       1 = the empty lane (what it last held, Same Filament, Choose),
       2 = the New Spool list (the user's spools, Use, Add New),
       3 = the Filament screen (material, brand, product, color),
       4 = the Lane Settings screen (tool, runout backup),
       5 = the Spoolman Details screen (price, location, lot, notes).
     Edits on the Filament and Details screens are held until the summary's
     Save. Colors open the color page (ColorPickerPage) over the overlay.
     Subjects are written from AmsEditOverlay. -->
<component>
  <consts>
    <!-- Spool-details Notes field height (mirrors spoolman_edit_modal) -->
    <px name="notes_height_small" value="44"/>
    <px name="notes_height_medium" value="72"/>
    <px name="notes_height_large" value="88"/>
    <!-- Spool-details field widths, sized to their content so several fields
         share a row. Numeric = up to 8 digits, text = a short label. -->
    <px name="field_w_num_small" value="76"/>
    <px name="field_w_num_medium" value="96"/>
    <px name="field_w_num_large" value="110"/>
    <px name="field_w_text_small" value="120"/>
    <px name="field_w_text_medium" value="150"/>
    <px name="field_w_text_large" value="180"/>
    <!-- Vertical gap between a page's rows. -->
    <px name="ams_edit_vgap_micro" value="2"/>
    <px name="ams_edit_vgap_tiny" value="4"/>
    <px name="ams_edit_vgap_small" value="4"/>
    <px name="ams_edit_vgap_medium" value="4"/>
    <px name="ams_edit_vgap_large" value="12"/>
    <!-- Hit reach for the quiet text actions (Unlink, Re-apply spool): the
         bar's height plus twice this is at least 44 at every class. -->
    <px name="ams_edit_bar_hit_micro" value="13"/>
    <px name="ams_edit_bar_hit_tiny" value="13"/>
    <px name="ams_edit_bar_hit_small" value="12"/>
    <px name="ams_edit_bar_hit_medium" value="8"/>
    <px name="ams_edit_bar_hit_large" value="8"/>
    <!-- The summary's weight row: - / value / + at #button_height, each
         reaching 44 tall (only the micro class needs the reach), spaced so the
         reaches meet without overlapping. -->
    <px name="ams_edit_step_hit_micro" value="9"/>
    <px name="ams_edit_step_hit_tiny" value="0"/>
    <px name="ams_edit_step_hit_small" value="0"/>
    <px name="ams_edit_step_hit_medium" value="0"/>
    <px name="ams_edit_step_hit_large" value="0"/>
    <px name="ams_edit_step_gap_micro" value="18"/>
    <px name="ams_edit_step_gap_tiny" value="12"/>
    <px name="ams_edit_step_gap_small" value="12"/>
    <px name="ams_edit_step_gap_medium" value="16"/>
    <px name="ams_edit_step_gap_large" value="20"/>
    <!-- The weight pill's least width, so - and + do not move as the value
         changes from "50 g of 1 kg" to "1000 g of 1 kg". -->
    <px name="ams_edit_weight_w_micro" value="150"/>
    <px name="ams_edit_weight_w_tiny" value="180"/>
    <px name="ams_edit_weight_w_small" value="200"/>
    <px name="ams_edit_weight_w_medium" value="260"/>
    <px name="ams_edit_weight_w_large" value="320"/>
    <!-- Header buttons: hit reach and spacing. The buttons are
         #button_height_sm tall; the reach takes each to the header's height
         (40 at micro) or 44, and the gap is twice the reach so the two
         targets meet without overlapping. -->
    <px name="ams_edit_hdr_hit_micro" value="8"/>
    <px name="ams_edit_hdr_hit_small" value="2"/>
    <px name="ams_edit_hdr_hit_medium" value="2"/>
    <px name="ams_edit_hdr_hit_large" value="2"/>
    <px name="ams_edit_hdr_gap_micro" value="16"/>
    <px name="ams_edit_hdr_gap_small" value="4"/>
    <px name="ams_edit_hdr_gap_medium" value="4"/>
    <px name="ams_edit_hdr_gap_large" value="4"/>
    <!-- The New Spool list's search field, in the header. -->
    <px name="ams_edit_search_w_micro" value="190"/>
    <px name="ams_edit_search_w_tiny" value="200"/>
    <px name="ams_edit_search_w_small" value="220"/>
    <px name="ams_edit_search_w_medium" value="320"/>
    <px name="ams_edit_search_w_large" value="420"/>
    <!-- Height of the list's loading and fetch-error states. -->
    <px name="assign_state_h_micro" value="64"/>
    <px name="assign_state_h_small" value="96"/>
    <px name="assign_state_h_medium" value="120"/>
    <px name="assign_state_h_large" value="140"/>
    <!-- A common spool tile's height: a full touch target. -->
    <px name="assign_tile_h" value="44"/>
    <!-- The summary's spool drawing: as large as the page leaves room for
         once the weight, lane and action rows are in. -->
    <px name="edit_spool_size_micro" value="64"/>
    <px name="edit_spool_size_tiny" value="96"/>
    <px name="edit_spool_size_small" value="120"/>
    <px name="edit_spool_size_medium" value="168"/>
    <px name="edit_spool_size_large" value="210"/>
    <!-- The empty lane's drawing of what it last held. -->
    <px name="empty_spool_size_micro" value="40"/>
    <px name="empty_spool_size_tiny" value="48"/>
    <px name="empty_spool_size_small" value="56"/>
    <px name="empty_spool_size_medium" value="72"/>
    <px name="empty_spool_size_large" value="88"/>
    <!-- A multi-color spool's mode dropdown and the bar of its colors. -->
    <px name="ams_edit_mode_dd_w_micro" value="104"/>
    <px name="ams_edit_mode_dd_w_tiny" value="110"/>
    <px name="ams_edit_mode_dd_w_small" value="130"/>
    <px name="ams_edit_mode_dd_w_medium" value="150"/>
    <px name="ams_edit_mode_dd_w_large" value="170"/>
    <px name="ams_edit_preview_h_micro" value="18"/>
    <px name="ams_edit_preview_h_tiny" value="20"/>
    <px name="ams_edit_preview_h_small" value="22"/>
    <px name="ams_edit_preview_h_medium" value="24"/>
    <px name="ams_edit_preview_h_large" value="28"/>
    <!-- The Lane Settings dropdowns. -->
    <px name="ams_edit_lane_dd_w_micro" value="110"/>
    <px name="ams_edit_lane_dd_w_tiny" value="120"/>
    <px name="ams_edit_lane_dd_w_small" value="150"/>
    <px name="ams_edit_lane_dd_w_medium" value="200"/>
    <px name="ams_edit_lane_dd_w_large" value="240"/>
  </consts>
  <styles>
    <!-- The color row pads by its swatches' reach so the outer ones are
         hit-testable. -->
    <style name="color_row_pad" pad_all="#swatch_grid_gap_half"/>
    <!-- A full-width row that opens another page: card-toned, pressable. -->
    <style name="nav_row"
           bg_color="#elevated_bg" bg_opa="255" radius="#border_radius" border_width="0" pad_hor="#space_sm"
           pad_ver="#space_xs"/>
  </styles>
  <view name="ams_edit_overlay"
        extends="overlay_panel" title="Lane" title_transform="none" title_badge_icon="spoolman"
        title_badge_subject="ams_edit_is_managed" back_button_callback="ams_edit_back_cb">
    <overlay_panel-actions>
      <lv_obj name="hdr_actions"
              width="content" height="100%" style_pad_ver="0" style_pad_hor="#ams_edit_hdr_hit"
              style_pad_gap="#ams_edit_hdr_gap" style_bg_opa="0" style_border_width="0" scrollable="false"
              clickable="false" flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center">
        <!-- The summary: a spool going in starts here. -->
        <ui_button name="btn_hdr_new_spool"
                   width="content" height="#button_height_sm" text="New Spool" variant="secondary"
                   ext_click_area="#ams_edit_hdr_hit" hidden="true">
          <bind_flag_if_not_eq subject="ams_edit_page" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="ams_edit_new_spool_cb"/>
        </ui_button>
        <!-- Scan Label, where Spoolman is set up: labeled where the header
             has room, the icon alone at the two smallest classes. -->
        <ui_button name="btn_hdr_scan_qr"
                   width="content" height="#button_height_sm" text="Scan Label" icon="qrcode_scan" icon_size="sm"
                   variant="secondary" ext_click_area="#ams_edit_hdr_hit" hidden="true">
          <bind_flag_if cond="ams_edit_scan_enabled eq 0 or ui_breakpoint le 1 or ams_edit_page gt 2" flag="hidden"/>
          <event_cb trigger="clicked" callback="ams_edit_scan_qr_cb"/>
        </ui_button>
        <ui_button name="btn_hdr_scan_qr_icon"
                   width="#button_height_sm" height="#button_height_sm" icon="qrcode_scan" icon_size="sm"
                   ext_click_area="#ams_edit_hdr_hit" hidden="true">
          <style name="styles.header_icon_button"/>
          <bind_flag_if cond="ams_edit_scan_enabled eq 0 or ui_breakpoint gt 1 or ams_edit_page gt 2" flag="hidden"/>
          <event_cb trigger="clicked" callback="ams_edit_scan_qr_cb"/>
        </ui_button>
        <!-- The New Spool list's search: name, brand, color or #ID. -->
        <text_input name="picker_search"
                    width="#ams_edit_search_w" placeholder_text="Search spools..." placeholder_tag="Search spools..."
                    hidden="true">
          <bind_flag_if cond="ams_edit_page ne 2 or printer_has_spoolman eq 0" flag="hidden"/>
          <event_cb trigger="value_changed" callback="ams_edit_picker_search_cb"/>
        </text_input>
      </lv_obj>
    </overlay_panel-actions>
    <overlay_panel-overlay_content style_pad_left="#space_md"
                                   style_pad_right="#space_md" style_pad_top="#space_xs" style_pad_bottom="#space_sm"
                                   flex_flow="column" style_pad_gap="0" scrollable="false">

      <!-- ============================================================ -->
      <!-- SUMMARY (page 0): the spool in the lane.                     -->
      <!-- ============================================================ -->
      <lv_obj name="summary_page"
              width="100%" height="100%" flex_flow="column" style_pad_all="0" style_pad_gap="#ams_edit_vgap"
              scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_page" flag="hidden" ref_value="0"/>

        <!-- While the lane records load or a save waits or fails, one line
             says so above the card. -->
        <text_small name="lane_records_loading"
                    width="100%" long_mode="dots" text="Loading lane details…" style_text_color="#text_muted">
          <bind_flag_if_eq subject="ams_lane_records_ready" flag="hidden" ref_value="1"/>
        </text_small>
        <text_small name="save_waiting"
                    width="100%" long_mode="dots" bind_text="ams_edit_save_wait_text" style_text_color="#text_muted">
          <bind_flag_if_not_eq subject="ams_edit_save_state" flag="hidden" ref_value="1"/>
        </text_small>
        <text_small name="save_error"
                    width="100%" long_mode="dots" bind_text="ams_edit_save_error" style_text_color="#danger">
          <bind_flag_if_not_eq subject="ams_edit_save_state" flag="hidden" ref_value="2"/>
        </text_small>

        <!-- The lane holds one filament and its linked spool says another:
             the note names the spool's and offers both ways to settle it. -->
        <lv_obj name="spool_disagreement_note"
                width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0"
                style_pad_gap="#space_xs" scrollable="false" hidden="true">
          <bind_flag_if_eq subject="ams_edit_spool_disagrees" flag="hidden" ref_value="0"/>
          <icon src="alert" size="xs" variant="warning"/>
          <text_small name="spool_disagreement_text"
                      flex_grow="1" long_mode="wrap" bind_text="ams_edit_spool_disagreement_text"/>
          <lv_obj name="btn_unlink_disagreeing"
                  width="content" height="content" style_pad_hor="#space_xs" style_pad_ver="#space_xxs" flex_flow="row"
                  style_flex_cross_place="center" style_radius="#border_radius" style_bg_opa="0" style_border_width="0"
                  clickable="true" scrollable="false" ext_click_area="#ams_edit_bar_hit">
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="ams_edit_unlink_spool_cb"/>
            <text_small text="Unlink" style_text_color="#primary" clickable="false" event_bubble="true"/>
          </lv_obj>
          <!-- The margin keeps this button's hit reach off Unlink beside it. -->
          <lv_obj name="btn_reapply_spool"
                  width="content" height="content" style_margin_left="#ams_edit_bar_hit" style_pad_hor="#space_xs"
                  style_pad_ver="#space_xxs" flex_flow="row" style_flex_cross_place="center"
                  style_radius="#border_radius" style_bg_opa="0" style_border_width="0" clickable="true"
                  scrollable="false" ext_click_area="#ams_edit_bar_hit">
            <style name="styles.press_wash" selector="pressed"/>
            <event_cb trigger="clicked" callback="ams_edit_reapply_spool_cb"/>
            <text_small text="Re-apply spool" style_text_color="#primary" clickable="false" event_bubble="true"/>
          </lv_obj>
        </lv_obj>

        <!-- The spool card: drawn in its color and filled to what is left.
             A tap opens the Filament screen. -->
        <lv_obj name="summary_card"
                width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_md"
                scrollable="false" clickable="true">
          <style name="nav_row"/>
          <style name="styles.press_wash" selector="pressed"/>
          <event_cb trigger="clicked" callback="ams_edit_open_filament_cb"/>
          <spool_canvas name="edit_spool"
                        size="#edit_spool_size" view="front" color="#text_muted" fill_level="1.0" clickable="false"
                        event_bubble="true"/>
          <lv_obj height="content"
                  flex_grow="1" style_pad_all="0" style_pad_gap="#space_xxs" flex_flow="column" style_bg_opa="0"
                  style_border_width="0" scrollable="false" clickable="false" event_bubble="true">
            <text_heading name="summary_product"
                          width="100%" bind_text="ams_edit_product_line" long_mode="dots" clickable="false"
                          event_bubble="true"/>
            <text_body name="summary_material"
                       width="100%" bind_text="ams_edit_material_line" long_mode="dots" clickable="false"
                       event_bubble="true"/>
            <lv_obj name="temp_row"
                    width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_xs" style_bg_opa="0" style_border_width="0" scrollable="false"
                    clickable="false" event_bubble="true">
              <text_small name="temp_line"
                          bind_text="ams_edit_temp_text" long_mode="dots" style_text_color="#text_muted"
                          clickable="false" event_bubble="true"/>
              <tag_badge subject="ams_edit_tag_temps"/>
            </lv_obj>
          </lv_obj>
          <icon src="chevron_right" size="sm" variant="muted" clickable="false" event_bubble="true"/>
        </lv_obj>

        <!-- What is left: - / "850 g of 1 kg" / +, the number opening the
             keypad, and a drag bar under them. -->
        <lv_obj name="weight_row"
                width="100%" height="content" style_pad_ver="#ams_edit_step_hit" style_pad_hor="#ams_edit_step_hit"
                flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center"
                style_pad_gap="#ams_edit_step_gap" scrollable="false">
          <ui_button name="btn_remaining_minus"
                     width="#button_height" height="#button_height" icon="minus" icon_size="md" variant="secondary"
                     ext_click_area="#ams_edit_step_hit">
            <event_cb trigger="clicked" callback="ams_edit_remaining_minus_cb"/>
          </ui_button>
          <lv_obj name="weight_pill"
                  width="content" height="#button_height" style_min_width="#ams_edit_weight_w" flex_flow="row"
                  style_flex_cross_place="center" style_flex_main_place="center" style_pad_hor="#space_md"
                  style_pad_ver="0" style_radius="#border_radius" style_bg_color="#elevated_bg" style_bg_opa="255"
                  style_border_width="1" style_border_color="#border" scrollable="false" clickable="true"
                  ext_click_area="#ams_edit_step_hit">
            <style name="styles.press_wash" selector="pressed"/>
            <text_heading name="weight_text"
                          bind_text="ams_edit_weight_text" style_text_font="#font_xl" clickable="false"
                          event_bubble="true"/>
            <event_cb trigger="clicked" callback="ams_edit_weight_cb"/>
          </lv_obj>
          <ui_button name="btn_remaining_plus"
                     width="#button_height" height="#button_height" icon="plus" icon_size="md" variant="secondary"
                     ext_click_area="#ams_edit_step_hit">
            <event_cb trigger="clicked" callback="ams_edit_remaining_plus_cb"/>
          </ui_button>
        </lv_obj>
        <!-- Padded by the knob's reach, which draws outside the bar. -->
        <lv_obj name="weight_slider_row"
                width="100%" height="content" style_pad_hor="#space_lg" style_pad_ver="#space_xs" style_bg_opa="0"
                style_border_width="0" scrollable="false">
          <lv_slider name="weight_slider" width="100%" min_value="0" max_value="100" bind_value="ams_edit_weight_pct">
            <event_cb trigger="value_changed" callback="ams_edit_weight_slider_cb"/>
          </lv_slider>
        </lv_obj>

        <!-- The lane's settings, only where one can change. -->
        <lv_obj name="lane_line"
                width="100%" height="content" ext_click_area="#ams_edit_bar_hit" flex_flow="row"
                style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false" clickable="true"
                hidden="true">
          <style name="nav_row"/>
          <style name="styles.press_wash" selector="pressed"/>
          <bind_flag_if cond="ams_edit_lane_visible eq 0 or ((ams_edit_tool_row_visible eq 0 or ams_edit_tool_editable eq 0) and (ams_edit_backup_row_visible eq 0 or ams_edit_backup_editable eq 0))"
                        flag="hidden"/>
          <event_cb trigger="clicked" callback="ams_edit_open_lane_cb"/>
          <text_body name="lane_line_text"
                     flex_grow="1" bind_text="ams_edit_lane_line" long_mode="dots" clickable="false" event_bubble="true"/>
          <icon src="chevron_right" size="sm" variant="muted" clickable="false" event_bubble="true"/>
        </lv_obj>

        <lv_obj width="100%"
                flex_grow="1" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
                clickable="false"/>

        <lv_obj name="summary_actions"
                width="100%" height="content" flex_flow="row" style_flex_main_place="space_between"
                style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_md" scrollable="false">
          <ui_button name="btn_clear_spool"
                     width="content" height="#button_height" text="Clear Lane" variant="outline"
                     style_border_color="#danger" style_text_color="#danger" hidden="true">
            <bind_flag_if_eq subject="ams_edit_clear_visible" flag="hidden" ref_value="0"/>
            <event_cb trigger="clicked" callback="ams_edit_clear_spool_cb"/>
          </ui_button>
          <lv_obj width="1" height="1" style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false"/>
          <ui_button name="btn_edit_save"
                     width="content" height="#button_height" text="Save" variant="primary"
                     style_min_width="#ams_edit_weight_w">
            <bind_state_if cond="ams_edit_save_disabled eq 1 or ams_lane_records_ready eq 0" state="disabled"/>
            <event_cb trigger="clicked" callback="ams_edit_save_cb"/>
          </ui_button>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- EMPTY LANE (page 1): what it last held, and what goes in.    -->
      <!-- ============================================================ -->
      <lv_obj name="empty_page"
              width="100%" height="100%" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#ams_edit_vgap" scrollable="false"
              hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_page" flag="hidden" ref_value="1"/>
        <text_heading name="empty_title" bind_text="ams_edit_empty_title" long_mode="dots"/>
        <lv_obj name="empty_last"
                width="100%" height="content" flex_flow="row" style_flex_main_place="center"
                style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#space_md" style_bg_opa="0"
                style_border_width="0" scrollable="false" hidden="true">
          <bind_flag_if_eq subject="ams_edit_has_last" flag="hidden" ref_value="0"/>
          <spool_canvas name="empty_last_spool"
                        size="#empty_spool_size" view="front" color="#text_muted" fill_level="1.0"/>
          <lv_obj width="content"
                  height="content" style_pad_all="0" style_pad_gap="0" flex_flow="column" style_bg_opa="0"
                  style_border_width="0" scrollable="false">
            <text_small text="Last held" style_text_color="#text_muted"/>
            <text_body name="empty_last_product" bind_text="ams_edit_last_product" long_mode="dots"/>
            <text_small name="empty_last_material"
                        bind_text="ams_edit_last_material" long_mode="dots" style_text_color="#text_muted"/>
          </lv_obj>
        </lv_obj>
        <ui_button name="btn_same_filament"
                   width="100%" height="#button_height" text="Same Filament, New Spool" variant="primary" hidden="true">
          <bind_flag_if_eq subject="ams_edit_has_last" flag="hidden" ref_value="0"/>
          <bind_state_if cond="ams_edit_save_state eq 1 or ams_lane_records_ready eq 0" state="disabled"/>
          <event_cb trigger="clicked" callback="ams_edit_same_filament_cb"/>
        </ui_button>
        <ui_button name="btn_choose_spool"
                   width="100%" height="#button_height" text="Choose a Different Spool" variant="secondary">
          <event_cb trigger="clicked" callback="ams_edit_choose_spool_cb"/>
        </ui_button>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- NEW SPOOL LIST (page 2): the only page that scrolls.          -->
      <!-- ============================================================ -->
      <lv_obj name="list_page"
              width="100%" height="100%" flex_flow="column" style_pad_all="0" style_pad_gap="#space_xs"
              scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_page" flag="hidden" ref_value="2"/>
        <centered_column name="picker_loading" width="100%" height="#assign_state_h" hidden="true">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="0"/>
          <spinner size="md"/>
          <text_body text="Loading spools..." style_text_align="center"/>
        </centered_column>
        <!-- The FETCH failed: tap retries it. -->
        <lv_obj name="picker_empty"
                width="100%" height="#assign_state_h" scrollable="false" hidden="true" clickable="true"
                style_radius="#border_radius">
          <style name="styles.press_wash" selector="pressed"/>
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="1"/>
          <event_cb trigger="clicked" callback="ams_edit_picker_retry_cb"/>
          <empty_state icon="spoolman" text="Couldn't load spools — tap to retry" clickable="false" event_bubble="true"/>
        </lv_obj>
        <!-- Nothing matches the search, or there are no spools yet. -->
        <lv_obj name="picker_no_match" width="100%" height="content" scrollable="false" hidden="true">
          <bind_flag_if cond="edit_picker_state ne 3 and edit_picker_state ne 4" flag="hidden"/>
          <text_small width="100%"
                      text="No spools to show. Add it as a new spool below." long_mode="wrap"
                      style_text_color="#text_muted"/>
        </lv_obj>
        <!-- Rows of spool_assign_row, built from C++. -->
        <lv_obj name="picker_spool_list"
                width="100%" flex_grow="1" style_pad_all="#space_xxs" style_radius="#border_radius"
                style_pad_gap="#space_xxs" flex_flow="column" style_bg_color="#elevated_bg" style_bg_opa="255"
                scrollable="true" scrollbar_mode="active" hidden="true">
          <bind_flag_if_not_eq subject="edit_picker_state" flag="hidden" ref_value="2"/>
        </lv_obj>
        <lv_obj width="100%"
                flex_grow="1" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
                clickable="false">
          <bind_flag_if_eq subject="edit_picker_state" flag="hidden" ref_value="2"/>
        </lv_obj>
        <lv_obj name="btn_add_new"
                width="100%" height="#button_height" style_bg_opa="0" style_border_width="1"
                style_border_color="#text_muted" style_border_opa="120" style_radius="#border_radius"
                style_pad_hor="#space_sm" style_pad_ver="0" flex_flow="row" style_flex_main_place="center"
                style_flex_cross_place="center" style_pad_gap="#space_xs" clickable="true" scrollable="false">
          <style name="styles.press_wash" selector="pressed"/>
          <event_cb trigger="clicked" callback="ams_edit_add_new_spool_cb"/>
          <icon src="plus" size="sm" variant="muted" clickable="false" event_bubble="true"/>
          <text_body text="Not Listed? Add New Spool" clickable="false" event_bubble="true"/>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- FILAMENT (page 3): what the spool is. Back keeps the edits.   -->
      <!-- ============================================================ -->
      <lv_obj name="filament_page"
              width="100%" height="100%" flex_flow="column" style_pad_all="0" style_pad_gap="#ams_edit_vgap"
              scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_page" flag="hidden" ref_value="3"/>

        <!-- The lane's tag states a different filament. -->
        <lv_obj name="tag_bar"
                width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                scrollable="false" hidden="true">
          <style name="nav_row"/>
          <bind_flag_if_eq subject="ams_edit_reset_tag_visible" flag="hidden" ref_value="0"/>
          <text_small name="tag_bar_text" flex_grow="1" bind_text="ams_edit_tag_text" long_mode="dots"/>
          <ui_button name="btn_reset_tag"
                     width="content" height="#button_height_sm" ext_click_area="#ams_edit_bar_hit" text="Use Tag"
                     variant="secondary">
            <event_cb trigger="clicked" callback="ams_edit_reset_tag_cb"/>
          </ui_button>
        </lv_obj>

        <!-- Material, Type, Brand, Product as a 2x2 grid; Product hides
             under Generic and the grid drops to three cells. Each list ends
             in "Browse catalog..." for the full catalog picker. -->
        <lv_obj name="describe_grid"
                width="100%" height="content" style_pad_all="0" flex_flow="row_wrap" style_pad_column="#space_xs"
                style_pad_row="#ams_edit_vgap" scrollable="false">
          <lv_obj width="49%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="0" scrollable="false">
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs"
                    style_flex_cross_place="center" scrollable="false">
              <text_small text="Material" style_text_color="#text_muted"/>
              <tag_badge subject="ams_edit_tag_material"/>
            </lv_obj>
            <lv_dropdown name="dropdown_material"
                         width="100%" height="#button_height_sm" style_radius="#border_radius" options="">
              <event_cb trigger="value_changed" callback="ams_edit_material_dd_cb"/>
            </lv_dropdown>
          </lv_obj>
          <lv_obj width="49%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="0" scrollable="false">
            <text_small text="Type" style_text_color="#text_muted"/>
            <lv_dropdown name="dropdown_variant"
                         width="100%" height="#button_height_sm" style_radius="#border_radius" options="">
              <event_cb trigger="value_changed" callback="ams_edit_variant_dd_cb"/>
            </lv_dropdown>
          </lv_obj>
          <lv_obj width="49%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="0" scrollable="false">
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs"
                    style_flex_cross_place="center" scrollable="false">
              <text_small text="Brand" style_text_color="#text_muted"/>
              <tag_badge subject="ams_edit_tag_brand"/>
            </lv_obj>
            <lv_dropdown name="dropdown_brand"
                         width="100%" height="#button_height_sm" style_radius="#border_radius" options="">
              <event_cb trigger="value_changed" callback="ams_edit_brand_dd_cb"/>
            </lv_dropdown>
          </lv_obj>
          <lv_obj width="49%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="0" scrollable="false">
            <bind_flag_if_eq subject="ams_edit_product_hidden" flag="hidden" ref_value="1"/>
            <lv_obj width="100%"
                    height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xxs"
                    style_flex_cross_place="center" scrollable="false">
              <text_small text="Product" style_text_color="#text_muted"/>
              <tag_badge subject="ams_edit_tag_product"/>
            </lv_obj>
            <lv_dropdown name="dropdown_product"
                         width="100%" height="#button_height_sm" style_radius="#border_radius" options="">
              <event_cb trigger="value_changed" callback="ams_edit_product_dd_cb"/>
            </lv_dropdown>
          </lv_obj>
        </lv_obj>

        <!-- A single color's name, where it fits; a multi-color spool shows
             its mode and a bar of its colors instead. -->
        <lv_obj name="color_label_row"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs"
                style_flex_cross_place="center" scrollable="false">
          <bind_flag_if cond="(ui_breakpoint eq 0 and ui_is_portrait eq 0) or ams_edit_multi eq 1 or ams_edit_color_named eq 0"
                        flag="hidden"/>
          <text_small name="color_name" bind_text="ams_edit_color_name" flex_grow="1" long_mode="dots"/>
          <tag_badge subject="ams_edit_tag_color"/>
        </lv_obj>
        <!-- A multi-color spool: how its colors run. Gradient blends them
             along the bar; Coaxial shows them as bands. -->
        <lv_obj name="colors_line"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm"
                style_flex_cross_place="center" scrollable="false" hidden="true">
          <bind_flag_if_eq subject="ams_edit_multi" flag="hidden" ref_value="0"/>
          <lv_dropdown name="dropdown_color_mode"
                       width="#ams_edit_mode_dd_w" height="#button_height_sm" style_radius="#border_radius"
                       options="Gradient&#10;Coaxial" options_tag="Gradient&#10;Coaxial"
                       bind_value="ams_edit_color_mode">
            <event_cb trigger="value_changed" callback="ams_edit_color_mode_cb"/>
          </lv_dropdown>
          <swatch_paint name="color_preview_bar"
                        height="#ams_edit_preview_h" flex_grow="1" style_radius="9999"
                        bind_colors="ams_edit_color_current_multi" blend="on">
            <bind_flag_if_eq subject="ams_edit_color_mode" flag="hidden" ref_value="1"/>
          </swatch_paint>
          <swatch_paint name="color_preview_bands"
                        height="#ams_edit_preview_h" flex_grow="1" style_radius="9999"
                        bind_colors="ams_edit_color_current_multi">
            <bind_flag_if_eq subject="ams_edit_color_mode" flag="hidden" ref_value="0"/>
          </swatch_paint>
        </lv_obj>
        <!-- The spool's color dots ("+" where the lane can store several),
             the newest filament recents, and the rainbow tile that opens the
             color page. The recents' count is measured in C++
             (size_color_row). -->
        <lv_obj name="color_row"
                width="100%" height="content" flex_flow="row_wrap" style_pad_gap="#swatch_grid_gap"
                style_flex_cross_place="center" scrollable="false">
          <style name="color_row_pad"/>
          <ams_edit_color_dots name="color_dots"/>
          <lv_obj name="color_recents"
                  width="content" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#swatch_grid_gap"
                  style_flex_cross_place="center" scrollable="false" clickable="false">
            <repeat count="ams_edit_recent_count">
              <color_swatch index="${i}"
                            color_subject="ams_edit_recent_${i}" callback="ams_edit_recent_cb" size="#swatch_grid_size"
                            hit="#swatch_grid_gap_half" reach="#swatch_grid_ring_reach" ring="styles.grid_swatch_ring"/>
            </repeat>
          </lv_obj>
          <custom_color_swatch name="btn_all_colors" icon="palette" callback="ams_edit_color_page_cb"/>
        </lv_obj>

        <!-- Adding a spool: the common ones fill the form in one tap. -->
        <lv_obj name="common_spools"
                width="100%" height="content" style_pad_all="0" flex_flow="row_wrap" style_pad_column="#space_xxs"
                style_pad_row="#space_xxs" scrollable="false" hidden="true">
          <bind_flag_if cond="ams_edit_adding eq 0 or ui_breakpoint le 1" flag="hidden"/>
          <common_spool_tile tile_name="common_spool_0" label="PLA" color_subject="ams_edit_common_color_0"/>
          <common_spool_tile tile_name="common_spool_3" label="PETG" color_subject="ams_edit_common_color_0"/>
          <common_spool_tile tile_name="common_spool_6" label="ABS" color_subject="ams_edit_common_color_0"/>
          <common_spool_tile tile_name="common_spool_9" label="ASA" color_subject="ams_edit_common_color_0"/>
          <common_spool_tile tile_name="common_spool_1" label="PLA" color_subject="ams_edit_common_color_1"/>
          <common_spool_tile tile_name="common_spool_4" label="PETG" color_subject="ams_edit_common_color_1"/>
          <common_spool_tile tile_name="common_spool_7" label="ABS" color_subject="ams_edit_common_color_1"/>
          <common_spool_tile tile_name="common_spool_10" label="ASA" color_subject="ams_edit_common_color_1"/>
          <common_spool_tile tile_name="common_spool_2" label="PLA" color_subject="ams_edit_common_color_2"/>
          <common_spool_tile tile_name="common_spool_5" label="PETG" color_subject="ams_edit_common_color_2"/>
          <common_spool_tile tile_name="common_spool_8" label="ABS" color_subject="ams_edit_common_color_2"/>
          <common_spool_tile tile_name="common_spool_11" label="ASA" color_subject="ams_edit_common_color_2"/>
        </lv_obj>

        <!-- Adding with Spoolman set up: whether the spool goes into it. -->
        <lv_checkbox name="add_to_spoolman_check"
                     text="Add to Spoolman" bind_checked="ams_edit_add_to_spoolman" hidden="true">
          <bind_flag_if cond="ams_edit_adding eq 0 or printer_has_spoolman eq 0" flag="hidden"/>
        </lv_checkbox>
        <!-- A linked spool's Spoolman-only details, on a page of their own. -->
        <lv_obj name="more_row"
                width="100%" height="content" ext_click_area="#ams_edit_bar_hit" flex_flow="row"
                style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false" clickable="true"
                hidden="true">
          <style name="nav_row"/>
          <style name="styles.press_wash" selector="pressed"/>
          <bind_flag_if_eq subject="ams_edit_is_managed" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="ams_edit_open_details_cb"/>
          <text_body text="Spoolman Details" clickable="false" event_bubble="true"/>
          <text_small text="Price, location, lot, notes"
                      flex_grow="1" long_mode="dots" style_text_color="#text_muted" clickable="false"
                      event_bubble="true"/>
          <icon src="chevron_right" size="sm" variant="muted" clickable="false" event_bubble="true"/>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- LANE SETTINGS (page 4): applied as soon as they change.       -->
      <!-- ============================================================ -->
      <lv_obj name="lane_section"
              width="100%" height="100%" flex_flow="column" style_pad_all="0" style_pad_gap="#ams_edit_vgap"
              scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_page" flag="hidden" ref_value="4"/>
        <lv_obj name="tool_dropdown_row"
                width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                scrollable="false" hidden="true">
          <style name="nav_row"/>
          <bind_flag_if_eq subject="ams_edit_tool_row_visible" flag="hidden" ref_value="0"/>
          <lv_obj height="content"
                  flex_grow="1" style_pad_all="0" style_pad_gap="0" flex_flow="column" style_bg_opa="0"
                  style_border_width="0" scrollable="false">
            <text_body name="tool_label" text="Feeds Tool"/>
            <text_small width="100%"
                        text="The toolhead this lane loads into" long_mode="wrap" style_text_color="#text_muted"/>
          </lv_obj>
          <lv_dropdown name="tool_dropdown"
                       width="#ams_edit_lane_dd_w" height="#button_height" style_radius="#border_radius" options="">
            <bind_state_if_eq subject="ams_edit_tool_editable" state="disabled" ref_value="0"/>
            <event_cb trigger="value_changed" callback="ams_edit_tool_dd_cb"/>
          </lv_dropdown>
        </lv_obj>
        <text_small name="tool_refusal"
                    width="100%" bind_text="ams_edit_tool_refusal" style_text_color="#text_muted" long_mode="wrap"
                    hidden="true">
          <bind_flag_if cond="ams_edit_tool_row_visible eq 0 or ams_edit_tool_editable eq 1" flag="hidden"/>
        </text_small>
        <lv_obj name="backup_dropdown_row"
                width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                scrollable="false" hidden="true">
          <style name="nav_row"/>
          <bind_flag_if_eq subject="ams_edit_backup_row_visible" flag="hidden" ref_value="0"/>
          <lv_obj height="content"
                  flex_grow="1" style_pad_all="0" style_pad_gap="0" flex_flow="column" style_bg_opa="0"
                  style_border_width="0" scrollable="false">
            <text_body name="backup_label" text="Runout Backup"/>
            <text_small width="100%"
                        text="The lane that takes over when this one runs out" long_mode="wrap"
                        style_text_color="#text_muted"/>
          </lv_obj>
          <lv_dropdown name="backup_dropdown"
                       width="#ams_edit_lane_dd_w" height="#button_height" style_radius="#border_radius" options="">
            <bind_state_if_eq subject="ams_edit_backup_editable" state="disabled" ref_value="0"/>
            <event_cb trigger="value_changed" callback="ams_edit_backup_dd_cb"/>
          </lv_dropdown>
        </lv_obj>
        <!-- What a runout of this lane will do, in one sentence. -->
        <lv_obj name="runout_card"
                width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm"
                scrollable="false">
          <style name="nav_row"/>
          <icon src="infinity" size="sm" variant="primary"/>
          <text_body name="runout_text" flex_grow="1" bind_text="ams_edit_runout_text" long_mode="wrap"/>
        </lv_obj>
        <!-- Why the printer will not switch spools (Off, Unknown, NeedsPlugin). -->
        <lv_obj name="endless_reason"
                width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0"
                scrollable="false" hidden="true">
          <bind_flag_if cond="ams_endless_state ne 2 and ams_endless_state ne 3 and ams_endless_state ne 4"
                        flag="hidden"/>
          <ams_endless_status name="endless_status"/>
        </lv_obj>
      </lv_obj>

      <!-- ============================================================ -->
      <!-- SPOOLMAN DETAILS (page 5): a linked spool's logistics.        -->
      <!-- ============================================================ -->
      <lv_obj name="more_section"
              width="100%" height="100%" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs"
              scrollable="false" hidden="true">
        <bind_flag_if_not_eq subject="ams_edit_page" flag="hidden" ref_value="5"/>
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row_wrap" style_pad_gap="#space_md" scrollable="false">
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Price"/>
            <text_input name="detail_field_price"
                        width="#field_w_num" keyboard_hint="numeric" placeholder="0.00" max_length="10">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Location"/>
            <text_input name="detail_field_location"
                        width="#field_w_text" placeholder="Shelf A" placeholder_tag="Shelf A" max_length="64">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
          <lv_obj width="content"
                  height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
            <text_small text="Lot/Batch Nr"/>
            <text_input name="detail_field_lot_nr" width="#field_w_text" placeholder="" max_length="32">
              <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
            </text_input>
          </lv_obj>
        </lv_obj>
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xxs" scrollable="false">
          <text_small text="Notes"/>
          <text_input name="detail_field_comment"
                      width="100%" height="#notes_height" placeholder="" max_length="256" multiline="true">
            <event_cb trigger="value_changed" callback="ams_edit_detail_field_changed_cb"/>
          </text_input>
        </lv_obj>
        <!-- Visible only when a label printer is configured. Starts hidden
             so it stays hidden wherever the binding cannot resolve. -->
        <ui_button name="btn_detail_print_label"
                   width="content" height="#button_height_sm" text="Print Label" variant="secondary" icon="printer"
                   hidden="true">
          <bind_flag_if_eq subject="label_printer_configured" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="ams_edit_print_label_cb"/>
        </ui_button>
      </lv_obj>

    </overlay_panel-overlay_content>
  </view>
</component>
