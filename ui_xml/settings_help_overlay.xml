<!-- Help & About Overlay Panel -->
<!-- Debug bundle upload, Discord, Getting Started and User Guide links, and about/version info -->
<component>
  <view name="settings_help_overlay" extends="overlay_panel" title="Help &amp; About" bg_color="#screen_bg">
    <!-- Content Area - no padding, rows handle their own -->
    <overlay_panel-overlay_content style_pad_top="0"
                                   style_pad_left="0" style_pad_right="0" style_pad_bottom="#space_lg" scrollable="true"
                                   flex_flow="column">
      <!-- All help/about actions live in a single grouped-list card (no section
           headers in this overlay); the card owns the horizontal inset. -->
      <setting_group name="group_help">
        <setting_action_row name="row_replay_tour"
                            label="Replay Welcome Tour" icon="play_circle"
                            description="See the quick tour of HelixScreen again" callback="on_replay_tour_clicked"/>
        <setting_action_row name="row_debug_bundle"
                            label="Upload Debug Bundle" icon="bug"
                            description="Collect logs and system info for support" callback="on_debug_bundle_clicked"/>
        <setting_action_row name="row_discord"
                            label="Discord Community" icon="message" description="Get help and share feedback"
                            callback="on_discord_clicked"/>
        <setting_action_row name="row_getting_started"
                            label="Getting Started" icon="lightbulb_outline"
                            description="Setup, navigation and gestures" callback="on_getting_started_clicked"/>
        <setting_action_row name="row_user_guide"
                            label="User Guide" icon="book" description="Every screen and setting explained"
                            callback="on_user_guide_clicked"/>
        <setting_action_row name="row_about"
                            label="About" icon="info" description="Version and printer info" callback="on_about_clicked"/>
      </setting_group>
    </overlay_panel-overlay_content>
  </view>
</component>
