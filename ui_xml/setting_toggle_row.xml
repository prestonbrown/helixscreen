<!-- Reusable Settings Toggle Row Component -->
<!-- Responsive: compact padding on micro breakpoint, info icon for descriptions -->
<component>
  <api>
    <prop name="label" type="string" default="Setting"/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="icon" type="string" default=""/>
    <prop name="description" type="string" default=""/>
    <prop name="description_tag" type="string" default=""/>
    <prop name="subject" type="string" default=""/>
    <prop name="callback" type="string" default=""/>
    <prop name="disabled" type="string" default=""/>
    <prop name="disabled_ref_value" type="string" default="1"/>
    <!-- "true" for a switch that commands the printer: it greys while anything
         forbids motion, like every other moves_machine control. -->
    <prop name="moves_machine" type="string" default="false"/>
    <!-- An event callback that explains the setting, usually by opening a modal. Set, it
         gives the row an (i) at every breakpoint that calls it, in place of the (i) that
         reveals the description on small screens. -->
    <prop name="info_callback" type="string" default=""/>
  </api>
  <view name="toggle_row"
        extends="setting_row" label="$label" label_tag="$label_tag" icon="$icon" description="$description"
        description_tag="$description_tag" disabled="$disabled" disabled_ref_value="$disabled_ref_value"
        info_callback="$info_callback">
    <ui_switch name="toggle" size="small" moves_machine="$moves_machine">
      <bind_state_if_eq subject="$subject" state="checked" ref_value="1"/>
      <bind_state_if_eq subject="$disabled" state="disabled" ref_value="$disabled_ref_value"/>
      <event_cb trigger="value_changed" callback="$callback"/>
    </ui_switch>
  </view>
</component>
