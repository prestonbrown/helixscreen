<!-- ESP32 firmware override of ui_xml/app_layout.xml (staged over the shared
     copy by scripts/esp32_stage_assets.py). Instantiating all six panels at
     boot costs ~19s of layout_update_core on the K-Touch (Plan 4 Task 6 HIL
     profile: subjects-up 7.6s -> home-panel-up 27.0s). This variant builds ONLY
     home + navbar at boot; the other five panels are created on first
     navigation (PanelFactory::build_deferred_panel, gated on HELIX_PLATFORM_ESP32,
     with a loading state). Desktop keeps the shared all-resident app_layout.xml.
     Keep the navbar/content_area/panel_container structure identical to the
     shared file so PanelFactory + NavigationManager find the same names. -->
<component>
  <!-- Main application layout: horizontal container with nav bar + content area -->
  <view extends="lv_obj"
        width="100%" height="100%" style_bg_opa="0%" style_border_width="0" style_pad_all="0" flex_flow="row">
    <!-- Navigation bar (left side) -->
    <navigation_bar name="navbar"/>
    <!-- Content area (right side, grows to fill remaining space) -->
    <lv_obj name="content_area" height="100%" flex_grow="1" style_bg_opa="0%" style_pad_all="0" flex_flow="column">
      <!-- Panel container. Only home is instantiated at boot; the other five
           panels are added here on first navigation (deferred build). -->
      <lv_obj name="panel_container" width="100%" flex_grow="1" style_bg_opa="0%" style_pad_all="0">
        <!-- Panel 0: Home (visible by default) -->
        <home_panel name="home_panel"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
