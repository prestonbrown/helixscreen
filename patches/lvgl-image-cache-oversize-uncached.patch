diff --git a/src/image/lv_bin_decoder.c b/src/image/lv_bin_decoder.c
index d4026dc7d..bcd1ea0e2 100644
--- a/src/image/lv_bin_decoder.c
+++ b/src/image/lv_bin_decoder.c
@@ -370,8 +370,10 @@ lv_result_t lv_bin_decoder_open(lv_image_decoder_t * decoder, lv_image_decoder_d
 
     lv_cache_entry_t * cache_entry = lv_image_decoder_add_to_cache(decoder, &search_key, dsc->decoded, dsc->user_data);
     if(cache_entry == NULL) {
-        free_decoder_data(dsc);
-        return LV_RESULT_INVALID;
+        /*Larger than the cache can ever hold. decoder_data still owns the buffer, so
+         *lv_bin_decoder_close frees it exactly as on the uncached paths above. Drawing it
+         *uncached beats discarding a successful decode and rendering nothing.*/
+        return LV_RESULT_OK;
     }
     dsc->cache_entry = cache_entry;
     decoder_data_t * decoder_data = get_decoder_data(dsc);
diff --git a/src/image/lv_lodepng.c b/src/image/lv_lodepng.c
index 4fe7948db..acdf32bd9 100644
--- a/src/image/lv_lodepng.c
+++ b/src/image/lv_lodepng.c
@@ -222,10 +222,14 @@ static lv_result_t decoder_open(lv_image_decoder_t * decoder, lv_image_decoder_d
     lv_cache_entry_t * entry = lv_image_decoder_add_to_cache(decoder, &search_key, decoded, NULL);
 
     if(entry == NULL) {
-        lv_draw_buf_destroy(decoded);
-        dsc->decoded = NULL;
+        /*An image whose decoded size exceeds the entire cache can never be stored: the
+         *reserve path reports that before it evicts anything. Draw it uncached instead of
+         *discarding a decode that succeeded, which would render the image as nothing.
+         *no_cache makes decoder_close free the buffer, as on the paths above that never
+         *attempt to cache.*/
+        dsc->args.no_cache = true;
         LV_PROFILER_DECODER_END_TAG("lv_lodepng_decoder_open");
-        return LV_RESULT_INVALID;
+        return LV_RESULT_OK;
     }
     dsc->cache_entry = entry;
 
