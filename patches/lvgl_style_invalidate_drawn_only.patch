         /*If the draw size changes invalidate the old area first*/
         lv_part_t part = lv_obj_style_get_selector_part(tr->selector);
         if(part == LV_PART_MAIN && lv_style_prop_has_flag(tr->prop, DRAW_AREA_FLAGS)) {
-            lv_obj_invalidate(tr->obj);
+            invalidate_drawn_area(tr->obj);
         }
         lv_style_set_prop((lv_style_t *)obj->styles[i].style, tr->prop, value_final);
 
@@ -1642,6 +1643,16 @@
     return LV_STYLE_RES_NOT_FOUND;
 }
 
+/**
+ * Invalidate the area a widget has drawn, before a style change moves it.
+ * A widget that has never been rendered has drawn nothing there, and a widget
+ * still being constructed has no real area yet, so it is skipped.
+ */
+static void invalidate_drawn_area(lv_obj_t * obj)
+{
+    if(obj->rendered) lv_obj_invalidate(obj);
+}
+
