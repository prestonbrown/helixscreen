+/**
+ * The widest the text may lay out, from the label's max width (HelixScreen extension).
+ * A percentage max width is a share of the parent's content width, while the raw style value
+ * is an encoded flag that never limits the text: a content-width wrapping label clamped by it
+ * would keep the height of one unwrapped line inside a narrower box. Resolved here, less the
+ * label's own padding and border, the text wraps at the width the box will have. Every other
+ * long mode keeps one line and the raw value, so a capped dots label still ends in dots.
+ */
+static int32_t helix_label_max_text_width(lv_obj_t * obj)
+{
+    int32_t max_w = lv_obj_get_style_max_width_internal(obj, LV_PART_MAIN);
+    if(!LV_COORD_IS_PCT(max_w) || ((lv_label_t *)obj)->long_mode != LV_LABEL_LONG_MODE_WRAP) return max_w;
+
+    max_w = lv_obj_calc_dynamic_width(obj, LV_STYLE_MAX_WIDTH);
+    max_w -= lv_obj_get_style_pad_left(obj, LV_PART_MAIN) + lv_obj_get_style_pad_right(obj, LV_PART_MAIN) +
+             2 * lv_obj_get_style_border_width(obj, LV_PART_MAIN);
+    /*Before the parent has a width there is nothing to wrap at yet*/
+    return max_w > 0 ? max_w : LV_COORD_MAX;
+}
+
 static void lv_label_event(const lv_obj_class_t * class_p, lv_event_t * e)
 {
     LV_ASSERT(e != NULL);
