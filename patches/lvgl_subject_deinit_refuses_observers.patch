--- a/include/lvgl/core/lv_observer.h
+++ b/include/lvgl/core/lv_observer.h
@@ -72,6 +72,10 @@ struct _lv_subject_t {
     uint32_t size                 : 24;  /**< String buffer size or group length */
     uint32_t notify_restart_query :  1;  /**< If an Observer was deleted during notification,
                                           * start notifying from the beginning. */
+    uint32_t deinitialized        :  1;  /**< Set by lv_subject_deinit(), cleared by every init
+                                          * (each one zeroes the Subject). A deinitialized
+                                          * Subject refuses new Observers: the next init would
+                                          * drop its list and orphan them. */
 };
 
