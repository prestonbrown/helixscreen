diff --git a/src/draw/lv_draw_private.h b/src/draw/lv_draw_private.h
index db6a9377b..d51c52f50 100644
--- a/src/draw/lv_draw_private.h
+++ b/src/draw/lv_draw_private.h
@@ -23,6 +23,23 @@ extern "C" {
  *      DEFINES
  *********************/
 
+/**
+ * Accessors for `lv_draw_task_t.state`. Every access to that field must go
+ * through these.
+ *
+ * `state` is written by the render threads and read by the thread that
+ * dispatches and frees draw tasks, so it is the handshake that decides when a
+ * task and its layer buffer may be released. `volatile` supplies neither
+ * atomicity nor ordering in the C memory model, and a standalone
+ * `__atomic_thread_fence` pair establishes no happens-before edge unless the
+ * flag itself is accessed atomically. Carrying the release/acquire on the flag
+ * is what actually orders the render thread's pixel writes ahead of the free,
+ * and it is the only form ThreadSanitizer can model - with bare fences the
+ * free is still reported as a race against the render thread's memcpy.
+ */
+#define LV_DRAW_TASK_STATE_GET(t)    ((lv_draw_task_state_t)__atomic_load_n(&(t)->state, __ATOMIC_ACQUIRE))
+#define LV_DRAW_TASK_STATE_SET(t, s) __atomic_store_n(&(t)->state, (int)(s), __ATOMIC_RELEASE)
+
 /**********************
  *      TYPEDEFS
  **********************/
@@ -58,7 +75,11 @@ struct _lv_draw_task_t {
     /* Reference to the draw unit for debug or draw context purposes */
     lv_draw_unit_t * draw_unit;
 
-    volatile int state;              /** int instead of lv_draw_task_state_t to be sure its atomic */
+    /** Cross-thread handshake flag. `int` rather than `lv_draw_task_state_t` so
+     *  the atomic builtins have a plain integer to work on. Read and written
+     *  ONLY through LV_DRAW_TASK_STATE_GET/SET - `volatile` is not what makes
+     *  this safe. */
+    volatile int state;
 
     void * draw_dsc;
 
