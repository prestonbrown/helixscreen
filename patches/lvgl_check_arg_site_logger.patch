+#if LV_USE_CHECK_ARG && LV_CHECK_ARG_LOG_MODE == LV_CHECK_ARG_LOG_MODE_SITE
+#if defined(__GNUC__)
+__attribute__((cold, noinline))
+#endif
+void lv_check_arg_failed_at(const char * file, int line)
+{
+    lv_log_add(LV_LOG_LEVEL_WARN, file, line, "check", "Check failed");
+}
+#endif
