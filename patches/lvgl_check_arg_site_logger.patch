+++ b/include/lvgl/config/lv_conf_internal.h
@@ -119,6 +119,7 @@
 #define LV_CHECK_ARG_LOG_MODE_NONE      0
 #define LV_CHECK_ARG_LOG_MODE_MINIMAL   1
 #define LV_CHECK_ARG_LOG_MODE_VERBOSE   2
+#define LV_CHECK_ARG_LOG_MODE_SITE      3
 
 /** Handle special Kconfig options. */
 #ifndef LV_KCONFIG_IGNORE
diff --git a/include/lvgl/debugging/lv_check_arg.h b/include/lvgl/debugging/lv_check_arg.h
index d510a4605..07dfacd04 100644
--- a/include/lvgl/debugging/lv_check_arg.h
+++ b/include/lvgl/debugging/lv_check_arg.h
@@ -65,6 +65,12 @@ extern "C" {
 #    define LV_CHECK_ARG_LOG_(cond_str, msg) LV_LOG_WARN("Check failed: %s" msg, cond_str)
 #    define LV_CHECK_ARG_LOG_FORMAT_(cond_str, format, ...) \
     LV_LOG_WARN("Check failed: %s" format, cond_str, __VA_ARGS__)
+#  elif LV_CHECK_ARG_LOG_MODE == LV_CHECK_ARG_LOG_MODE_SITE
+/* One out-of-line logger taking the check's file and line, so a check site costs a
+ * call rather than its condition text, function name and format string. */
+void lv_check_arg_failed_at(const char * file, int line);
+#    define LV_CHECK_ARG_LOG_(cond_str, msg) lv_check_arg_failed_at(__FILE__, __LINE__)
+#    define LV_CHECK_ARG_LOG_FORMAT_(cond_str, format, ...) lv_check_arg_failed_at(__FILE__, __LINE__)
 #  elif LV_CHECK_ARG_LOG_MODE == LV_CHECK_ARG_LOG_MODE_MINIMAL
 #    define LV_CHECK_ARG_LOG_(cond_str, msg) LV_LOG_WARN("Check failed")
 #    define LV_CHECK_ARG_LOG_FORMAT_(cond_str, format, ...) LV_LOG_WARN("Check failed")
diff --git a/src/logging/lv_log.c b/src/logging/lv_log.c
