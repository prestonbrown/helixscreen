+    uint32_t i;
+    for(i = 0; i < LV_DRAW_SW_DRAW_UNIT_CNT; i++) {
+        /* Acquire load: pairs with the render thread's release store of NULL, so
+         * everything it blended into the layer buffer is visible before
+         * cleanup_task() destroys that buffer. This replaced a volatile cast,
+         * which stopped the compiler caching the load but created no ordering. */
+        while(THREAD_DSC_TASK_GET(&draw_sw_unit->thread_dscs[i]) != NULL) {
+            lv_sleep_ms(1);
+        }
+    }
+
+    return 1;
+}
