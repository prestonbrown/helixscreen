+/**
+ * Accessors for the fields `lv_draw_sw_thread_dsc_t` shares between a render
+ * thread and the thread that dispatches and frees draw tasks. Every access to
+ * `task_act`, `exit_status` and `inited` must go through these.
+ *
+ * None of the three is synchronised on the field itself. `task_act` is the one
+ * that matters most: `lv_draw_sw_wait_for_finish()` spins on it to decide when
+ * no draw unit is still blending into a layer buffer, and `cleanup_task()`
+ * destroys that buffer as soon as the spin returns. A plain read establishes no
+ * happens-before edge with the render thread's write, so the guard is ordered
+ * only by luck - and by `lv_sleep_ms()` and `lv_thread_sync_wait()` happening to
+ * be opaque calls the compiler will not hoist a load across. Carrying the
+ * ordering on the field is what makes the guard mean what it says, and is the
+ * only form ThreadSanitizer can model.
+ */
+#define THREAD_DSC_TASK_GET(dsc)     __atomic_load_n(&(dsc)->task_act, __ATOMIC_ACQUIRE)
+#define THREAD_DSC_TASK_SET(dsc, t)  __atomic_store_n(&(dsc)->task_act, (t), __ATOMIC_RELEASE)
+#define THREAD_DSC_EXIT_GET(dsc)     __atomic_load_n(&(dsc)->exit_status, __ATOMIC_ACQUIRE)
+#define THREAD_DSC_EXIT_SET(dsc, v)  __atomic_store_n(&(dsc)->exit_status, (v), __ATOMIC_RELEASE)
+#define THREAD_DSC_INITED_GET(dsc)   __atomic_load_n(&(dsc)->inited, __ATOMIC_ACQUIRE)
+#define THREAD_DSC_INITED_SET(dsc, v) __atomic_store_n(&(dsc)->inited, (v), __ATOMIC_RELEASE)
