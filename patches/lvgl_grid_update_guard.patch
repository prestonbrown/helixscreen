diff --git a/src/layouts/grid/lv_grid.c b/src/layouts/grid/lv_grid.c
index bcd9d2e1c..ba4b229d5 100644
--- a/src/layouts/grid/lv_grid.c
+++ b/src/layouts/grid/lv_grid.c
@@ -15,6 +15,26 @@
 #include "../../core/lv_global.h"
 #include "../../core/lv_obj_style_internal.h"
 
+/* Telemetry hook provided by helix_lvgl_anomaly.cpp — reports LVGL anomalies
+ * with backtrace + device context for remote crash diagnostics. */
+extern void helix_lvgl_anomaly(const char * code, const char * context);
+
+/* Format a stable identifier for a validated grid container into `buf` for
+ * anomaly telemetry: widget name, pointer, and parent name. A remote bundle
+ * only gives us LVGL's generic layout_update_core recursion in the backtrace,
+ * never the offending lv_obj — this names it so the culprit grid can be found
+ * in the widget tree (bundle ET5ACW4S: unterminated row descriptor during a
+ * Change Host rebuild, container unidentifiable). `cont` is live: every caller
+ * runs under grid_update(), which layout_update_core() reaches by walking the tree. */
+static void grid_anomaly_ctx(char * buf, size_t bufsz, const char * prefix, lv_obj_t * cont)
+{
+    const char * nm = lv_obj_get_name(cont);
+    lv_obj_t * par = lv_obj_get_parent(cont);
+    const char * pnm = par ? lv_obj_get_name(par) : NULL;
+    lv_snprintf(buf, bufsz, "%s | cont=%p name=%s parent=%s",
+                prefix, (void *)cont, nm ? nm : "(unnamed)", pnm ? pnm : "(none)");
+}
+
 /*********************
  *      DEFINES
  *********************/
@@ -27,6 +47,14 @@
 #define IS_CONTENT(x)  (x == LV_COORD_MAX - 101)
 #define GET_FR(x)      (x - (LV_COORD_MAX - 100))
 
+/* Upper bound on grid tracks. count_tracks() walks the descriptor array until it
+ * hits LV_GRID_TEMPLATE_LAST; a freed or non-terminated descriptor (e.g. a reused
+ * container whose grid style still points at a move-freed std::vector buffer —
+ * #983, bundle VDJ3J9UV) has no sentinel, so an unbounded walk runs off the heap
+ * end -> SIGSEGV. Real grids in this app have a handful of tracks; cap the walk so
+ * a bad descriptor becomes a controlled bail + telemetry instead of a crash. */
+#define GRID_MAX_TRACKS 256
+
 /**********************
  *      TYPEDEFS
  **********************/
@@ -331,6 +359,30 @@ static lv_result_t calc_cols(lv_obj_t * cont, lv_grid_calc_t * c)
     int32_t cont_w = lv_obj_get_content_width(cont);
 
     c->col_num = count_tracks(col_templ);
+    /* An empty column template ({LV_GRID_TEMPLATE_LAST}) yields 0 tracks.
+     * grid_align() then evaluates `track_num - 1` as a uint32_t, underflowing to
+     * 0xFFFFFFFF, and its position loop writes ~4 billion entries past the track
+     * arrays -> SIGSEGV walking off the heap end (bundle FHWM8JVG). Bail so
+     * grid_update() skips this degenerate grid before grid_align()/item_repos(). */
+    if(c->col_num == 0) {
+        char ctxbuf[224];
+        grid_anomaly_ctx(ctxbuf, sizeof(ctxbuf), "calc_cols: empty grid template (0 tracks)", cont);
+        helix_lvgl_anomaly("grid_update_zero_cols", ctxbuf);
+        if(subgrid) lv_free((void *)col_templ);
+        return LV_RESULT_INVALID;
+    }
+    /* count_tracks() hit its GRID_MAX_TRACKS bound without finding the sentinel:
+     * the descriptor is freed/garbage/non-terminated (#983). Bail with telemetry
+     * rather than allocating against and indexing a bogus track count. */
+    if(c->col_num >= GRID_MAX_TRACKS) {
+        char ctxbuf[224];
+        grid_anomaly_ctx(ctxbuf, sizeof(ctxbuf),
+                         "calc_cols: column template missing terminator within bound "
+                         "(freed/garbage descriptor)", cont);
+        helix_lvgl_anomaly("grid_update_unterminated_cols", ctxbuf);
+        if(subgrid) lv_free((void *)col_templ);
+        return LV_RESULT_INVALID;
+    }
     c->x = lv_malloc(sizeof(int32_t) * c->col_num);
     c->w = lv_malloc(sizeof(int32_t) * c->col_num);
 
@@ -431,6 +483,28 @@ static lv_result_t calc_rows(lv_obj_t * cont, lv_grid_calc_t * c)
     }
 
     c->row_num = count_tracks(row_templ);
+    /* See calc_cols: an empty row template ({LV_GRID_TEMPLATE_LAST}) yields 0
+     * tracks, underflowing grid_align()'s `track_num - 1` and walking off the
+     * heap (bundle FHWM8JVG). calc_rows() runs before any other allocation here,
+     * so bailing now is fully clean. */
+    if(c->row_num == 0) {
+        char ctxbuf[224];
+        grid_anomaly_ctx(ctxbuf, sizeof(ctxbuf), "calc_rows: empty grid template (0 tracks)", cont);
+        helix_lvgl_anomaly("grid_update_zero_rows", ctxbuf);
+        if(subgrid) lv_free((void *)row_templ);
+        return LV_RESULT_INVALID;
+    }
+    /* See calc_cols: count_tracks() hit GRID_MAX_TRACKS without a sentinel —
+     * freed/garbage/non-terminated descriptor (#983). Bail with telemetry. */
+    if(c->row_num >= GRID_MAX_TRACKS) {
+        char ctxbuf[224];
+        grid_anomaly_ctx(ctxbuf, sizeof(ctxbuf),
+                         "calc_rows: row template missing terminator within bound "
+                         "(freed/garbage descriptor)", cont);
+        helix_lvgl_anomaly("grid_update_unterminated_rows", ctxbuf);
+        if(subgrid) lv_free((void *)row_templ);
+        return LV_RESULT_INVALID;
+    }
     c->y = lv_malloc(sizeof(int32_t) * c->row_num);
     c->h = lv_malloc(sizeof(int32_t) * c->row_num);
     /*Set sizes for CONTENT cells*/
@@ -757,9 +831,12 @@ static int32_t grid_align(int32_t cont_size,  bool auto_size, lv_grid_align_t al
 
 static uint32_t count_tracks(const int32_t * templ)
 {
+    /* Bounded walk: stop at GRID_MAX_TRACKS even if no LV_GRID_TEMPLATE_LAST is
+     * found, so a freed/garbage descriptor cannot run off the heap end. Callers
+     * (calc_cols/calc_rows) treat a return of GRID_MAX_TRACKS as invalid. */
     LV_ASSERT(templ != NULL);
     uint32_t i;
-    for(i = 0; templ[i] != LV_GRID_TEMPLATE_LAST; i++);
+    for(i = 0; i < GRID_MAX_TRACKS && templ[i] != LV_GRID_TEMPLATE_LAST; i++);
 
     return i;
 }
