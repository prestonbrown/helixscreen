@@ -15,6 +15,26 @@
 #include "../../core/lv_global.h"
 #include "../../core/lv_obj_style_internal.h"
 
+/* Telemetry hook provided by helix_lvgl_anomaly.cpp — reports LVGL anomalies
+ * with backtrace + device context for remote crash diagnostics. */
+extern void helix_lvgl_anomaly(const char * code, const char * context);
+
+/* Format a stable identifier for a validated grid container into `buf` for
+ * anomaly telemetry: widget name, pointer, and parent name. A remote bundle
+ * only gives us LVGL's generic layout_update_core recursion in the backtrace,
+ * never the offending lv_obj — this names it so the culprit grid can be found
+ * in the widget tree (bundle ET5ACW4S: unterminated row descriptor during a
+ * Change Host rebuild, container unidentifiable). `cont` MUST be a live obj —
+ * every caller here runs after grid_update()'s lv_obj_is_in_widget_tree(cont) gate. */
+static void grid_anomaly_ctx(char * buf, size_t bufsz, const char * prefix, lv_obj_t * cont)
+{
+    const char * nm = lv_obj_get_name(cont);
+    lv_obj_t * par = lv_obj_get_parent(cont);
+    const char * pnm = par ? lv_obj_get_name(par) : NULL;
+    lv_snprintf(buf, bufsz, "%s | cont=%p name=%s parent=%s",
+                prefix, (void *)cont, nm ? nm : "(unnamed)", pnm ? pnm : "(none)");
+}
+
 /*********************
  *      DEFINES
  *********************/
@@ -27,6 +47,14 @@
 #define IS_CONTENT(x)  (x == LV_COORD_MAX - 101)
 #define GET_FR(x)      (x - (LV_COORD_MAX - 100))
 
+/* Upper bound on grid tracks. count_tracks() walks the descriptor array until it
+ * hits LV_GRID_TEMPLATE_LAST; a freed or non-terminated descriptor (e.g. a reused
+ * container whose grid style still points at a move-freed std::vector buffer —
+ * #983, bundle VDJ3J9UV) has no sentinel, so an unbounded walk runs off the heap
+ * end -> SIGSEGV. Real grids in this app have a handful of tracks; cap the walk so
+ * a bad descriptor becomes a controlled bail + telemetry instead of a crash. */
+#define GRID_MAX_TRACKS 256
+
 /**********************
  *      TYPEDEFS
  **********************/
@@ -203,6 +231,18 @@ static void grid_update(lv_obj_t * cont, void * user_data)
     LV_LOG_INFO("update %p container", (void *)cont);
     LV_UNUSED(user_data);
 
+    /* Guard against a freed grid container reaching this callback when a
+     * relayout races teardown (modal close / panel rebuild during an AMS
+     * update). cont->spec_attr is then freed garbage and the child loop below
+     * reads a wild pointer -> SIGSEGV (#973). lv_obj_is_in_widget_tree()
+     * searches down from the screens comparing pointers and never reads
+     * through the one it is given (lvgl_obj_is_valid_no_deref.patch), so it is
+     * safe to call on a dangling pointer. */
+    if(cont == NULL || !lv_obj_is_in_widget_tree(cont)) {
+        helix_lvgl_anomaly("grid_update_invalid_cont", "grid_update: container freed/invalid");
+        return;
+    }
+
     lv_grid_calc_t c;
     lv_result_t res = calc(cont, &c);
     if(res != LV_RESULT_OK) {
@@ -223,6 +263,12 @@ static void grid_update(lv_obj_t * cont, void * user_data)
     uint32_t i;
     for(i = 0; i < cont->spec_attr->child_cnt; i++) {
         lv_obj_t * item = cont->spec_attr->children[i];
+        /* A child freed mid-relayout (async-deleted during teardown) can leave a
+         * dangling entry here; item_repos() would dereference it -> SIGSEGV (#973). */
+        if(item == NULL || !lv_obj_is_in_widget_tree(item)) {
+            helix_lvgl_anomaly("grid_update_invalid_item", "grid_update: child freed/invalid");
+            continue;
+        }
         item_repos(item, &c, &hint);
     }
     calc_free(&c);
@@ -331,6 +377,30 @@ static lv_result_t calc_cols(lv_obj_t * cont, lv_grid_calc_t * c)
     int32_t cont_w = lv_obj_get_content_width(cont);
 
     c->col_num = count_tracks(col_templ);
+    /* An empty column template ({LV_GRID_TEMPLATE_LAST}) yields 0 tracks.
+     * grid_align() then evaluates `track_num - 1` as a uint32_t, underflowing to
+     * 0xFFFFFFFF, and its position loop writes ~4 billion entries past the track
+     * arrays -> SIGSEGV walking off the heap end (bundle FHWM8JVG). Bail so
+     * grid_update() skips this degenerate grid before grid_align()/item_repos(). */
+    if(c->col_num == 0) {
+        char ctxbuf[224];
+        grid_anomaly_ctx(ctxbuf, sizeof(ctxbuf), "calc_cols: empty grid template (0 tracks)", cont);
+        helix_lvgl_anomaly("grid_update_zero_cols", ctxbuf);
+        if(subgrid) lv_free((void *)col_templ);
+        return LV_RESULT_INVALID;
+    }
+    /* count_tracks() hit its GRID_MAX_TRACKS bound without finding the sentinel:
+     * the descriptor is freed/garbage/non-terminated (#983). Bail with telemetry
+     * rather than allocating against and indexing a bogus track count. */
+    if(c->col_num >= GRID_MAX_TRACKS) {
+        char ctxbuf[224];
+        grid_anomaly_ctx(ctxbuf, sizeof(ctxbuf),
+                         "calc_cols: column template missing terminator within bound "
+                         "(freed/garbage descriptor)", cont);
+        helix_lvgl_anomaly("grid_update_unterminated_cols", ctxbuf);
+        if(subgrid) lv_free((void *)col_templ);
+        return LV_RESULT_INVALID;
+    }
     c->x = lv_malloc(sizeof(int32_t) * c->col_num);
     c->w = lv_malloc(sizeof(int32_t) * c->col_num);
 
@@ -343,6 +413,14 @@ static lv_result_t calc_cols(lv_obj_t * cont, lv_grid_calc_t * c)
             uint32_t ci;
             for(ci = 0; ci < lv_obj_get_child_count(cont); ci++) {
                 lv_obj_t * item = lv_obj_get_child(cont, ci);
+                /* A child freed mid-relayout (async-deleted during teardown) can leave a
+                 * dangling entry here. This calc() content-sizing pass runs before
+                 * grid_update's item_repos guard, so the deref below is otherwise
+                 * unprotected and SIGSEGVs on a page-returned object (#1001). */
+                if(item == NULL || !lv_obj_is_in_widget_tree(item)) {
+                    helix_lvgl_anomaly("grid_update_invalid_calc_item", "calc_cols: child freed/invalid");
+                    continue;
+                }
                 if((lv_obj_is_ignore_layout(item) || lv_obj_is_hidden(item) || lv_obj_is_floating(item))) continue;
                 uint32_t col_span = get_col_span(item);
                 if(col_span != 1) continue;
@@ -431,6 +509,28 @@ static lv_result_t calc_rows(lv_obj_t * cont, lv_grid_calc_t * c)
     }
 
     c->row_num = count_tracks(row_templ);
+    /* See calc_cols: an empty row template ({LV_GRID_TEMPLATE_LAST}) yields 0
+     * tracks, underflowing grid_align()'s `track_num - 1` and walking off the
+     * heap (bundle FHWM8JVG). calc_rows() runs before any other allocation here,
+     * so bailing now is fully clean. */
+    if(c->row_num == 0) {
+        char ctxbuf[224];
+        grid_anomaly_ctx(ctxbuf, sizeof(ctxbuf), "calc_rows: empty grid template (0 tracks)", cont);
+        helix_lvgl_anomaly("grid_update_zero_rows", ctxbuf);
+        if(subgrid) lv_free((void *)row_templ);
+        return LV_RESULT_INVALID;
+    }
+    /* See calc_cols: count_tracks() hit GRID_MAX_TRACKS without a sentinel —
+     * freed/garbage/non-terminated descriptor (#983). Bail with telemetry. */
+    if(c->row_num >= GRID_MAX_TRACKS) {
+        char ctxbuf[224];
+        grid_anomaly_ctx(ctxbuf, sizeof(ctxbuf),
+                         "calc_rows: row template missing terminator within bound "
+                         "(freed/garbage descriptor)", cont);
+        helix_lvgl_anomaly("grid_update_unterminated_rows", ctxbuf);
+        if(subgrid) lv_free((void *)row_templ);
+        return LV_RESULT_INVALID;
+    }
     c->y = lv_malloc(sizeof(int32_t) * c->row_num);
     c->h = lv_malloc(sizeof(int32_t) * c->row_num);
     /*Set sizes for CONTENT cells*/
@@ -442,6 +542,14 @@ static lv_result_t calc_rows(lv_obj_t * cont, lv_grid_calc_t * c)
             uint32_t ci;
             for(ci = 0; ci < lv_obj_get_child_count(cont); ci++) {
                 lv_obj_t * item = lv_obj_get_child(cont, ci);
+                /* A child freed mid-relayout (async-deleted during teardown) can leave a
+                 * dangling entry here. This calc() content-sizing pass runs before
+                 * grid_update's item_repos guard, so the deref below is otherwise
+                 * unprotected and SIGSEGVs on a page-returned object (#1001). */
+                if(item == NULL || !lv_obj_is_in_widget_tree(item)) {
+                    helix_lvgl_anomaly("grid_update_invalid_calc_item", "calc_rows: child freed/invalid");
+                    continue;
+                }
                 if((lv_obj_is_ignore_layout(item) || lv_obj_is_hidden(item) || lv_obj_is_floating(item))) continue;
                 uint32_t row_span = get_row_span(item);
                 if(row_span != 1) continue;
@@ -560,6 +668,30 @@ static void item_repos(lv_obj_t * item, lv_grid_calc_t * c, item_repos_hint_t *
     lv_grid_align_t col_align = get_cell_col_align(item);
     lv_grid_align_t row_align = get_cell_row_align(item);
 
+    /* Guard against a cell position/span that exceeds the calculated track
+     * count. calc() sizes c->x/c->w/c->y/c->h to col_num/row_num only; it never
+     * validates that each item's cell actually fits. An item can carry a stale
+     * or garbage cell position — e.g. a still-valid object whose grid-cell style
+     * was never set (read back as a huge default), or a position approved
+     * against a larger logical grid than the live descriptor — and the c->x[...]
+     * /c->y[...] reads below would then walk off the heap end -> SIGSEGV
+     * (bundle P234RYCL, AD5X). lv_obj_is_in_widget_tree() in grid_update()
+     * catches freed children; this catches valid children with out-of-range
+     * cells. */
+    if(col_pos >= c->col_num || row_pos >= c->row_num ||
+       col_pos + col_span > c->col_num || row_pos + row_span > c->row_num) {
+        /* Include the actual cell vs. track counts so the next bundle reveals
+         * which dimension overflowed and by how much — that points at the
+         * upstream producer of the bad cell (column- vs row-sizing path). */
+        char ctx[96];
+        lv_snprintf(ctx, sizeof(ctx),
+                    "item_repos: cell out of range col=%u+%u/%u row=%u+%u/%u",
+                    (unsigned)col_pos, (unsigned)col_span, (unsigned)c->col_num,
+                    (unsigned)row_pos, (unsigned)row_span, (unsigned)c->row_num);
+        helix_lvgl_anomaly("grid_update_cell_oob", ctx);
+        return;
+    }
+
     int32_t col_x1 = 0;
     int32_t col_x2 = 0;
     int32_t col_w = 0;
@@ -757,9 +889,12 @@ static int32_t grid_align(int32_t cont_size,  bool auto_size, lv_grid_align_t al
 
 static uint32_t count_tracks(const int32_t * templ)
 {
+    /* Bounded walk: stop at GRID_MAX_TRACKS even if no LV_GRID_TEMPLATE_LAST is
+     * found, so a freed/garbage descriptor cannot run off the heap end. Callers
+     * (calc_cols/calc_rows) treat a return of GRID_MAX_TRACKS as invalid. */
     LV_ASSERT(templ != NULL);
     uint32_t i;
-    for(i = 0; templ[i] != LV_GRID_TEMPLATE_LAST; i++);
+    for(i = 0; i < GRID_MAX_TRACKS && templ[i] != LV_GRID_TEMPLATE_LAST; i++);
 
     return i;
 }
