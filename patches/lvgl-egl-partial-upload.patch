+bool lv_linux_drm_egl_set_partial_upload(lv_display_t * disp, bool enable)
+{
+    if(!disp) {
+        LV_LOG_ERROR("Cannot set partial upload on a NULL display");
+        return false;
+    }
+    lv_drm_ctx_t * ctx = lv_display_get_driver_data(disp);
+    if(!ctx || !ctx->egl_ctx) {
+        LV_LOG_WARN("Display has no EGL context, partial upload left off");
+        return false;
+    }
+#if LV_USE_DRAW_OPENGLES || LV_USE_DRAW_NANOVG
+    /*The GPU draws straight into the texture, so there is no buffer to upload from*/
+    if(enable) {
+        LV_LOG_WARN("Partial upload needs software rendering, left off");
+    }
+    enable = false;
+#else
+    if(enable && !sub_image_upload_supported()) {
+        LV_LOG_WARN("GL_UNPACK_ROW_LENGTH is unsupported, partial upload left off");
+        enable = false;
+    }
+#endif
+    ctx->upload.partial = enable;
+    return enable;
+}
+
+void lv_linux_drm_egl_request_full_upload(lv_display_t * disp)
+{
+    if(!disp) {
+        LV_LOG_ERROR("Cannot request a full upload on a NULL display");
+        return;
+    }
+    lv_drm_ctx_t * ctx = lv_display_get_driver_data(disp);
+    if(!ctx) {
+        return;
+    }
+    ctx->upload.full_pending = true;
+}
