+static bool sub_image_upload_supported(void)
+{
+    /*GL_UNPACK_ROW_LENGTH is core in OpenGL ES 3 and an extension in OpenGL ES 2*/
+    static const char es_prefix[] = "OpenGL ES ";
+    const size_t major_at = sizeof(es_prefix) - 1;
+    const char * version = (const char *)glGetString(GL_VERSION);
+    if(version && strncmp(version, es_prefix, major_at) == 0 && version[major_at] >= '3' && version[major_at] <= '9') {
+        return true;
+    }
+    const char * extensions = (const char *)glGetString(GL_EXTENSIONS);
+    return extensions && strstr(extensions, "GL_EXT_unpack_subimage") != NULL;
+}
+
+static void upload_area(lv_display_t * disp, unsigned int texture_id, const uint8_t * buf, const lv_area_t * area)
+{
+    lv_color_format_t cf = lv_display_get_color_format(disp);
+    lv_opengles_gl_format_t gl_format;
+    if(lv_opengles_gl_format_from_color_format(cf, &gl_format) != LV_RESULT_OK) {
+        return;
+    }
+    uint32_t px_size = lv_color_format_get_size(cf);
+    uint32_t stride = lv_draw_buf_width_to_stride(lv_display_get_horizontal_resolution(disp), cf);
+    /*GL_UNPACK_ROW_LENGTH steps each row by the buffer's stride, so the sub-image
+     *starts at the area's first pixel inside the whole buffer*/
+    const uint8_t * first_px = buf + lv_linux_drm_egl_upload_first_byte(area, stride, px_size);
+
+    GL_CALL(glBindTexture(GL_TEXTURE_2D, texture_id));
+    GL_CALL(glPixelStorei(GL_UNPACK_ALIGNMENT, 1));
+    GL_CALL(glPixelStorei(GL_UNPACK_ROW_LENGTH, (GLint)(stride / px_size)));
+    GL_CALL(glTexSubImage2D(GL_TEXTURE_2D, 0, area->x1, area->y1, lv_area_get_width(area), lv_area_get_height(area),
+                            gl_format.format, gl_format.type, first_px));
+    GL_CALL(glPixelStorei(GL_UNPACK_ROW_LENGTH, 0));
+}
+
+static void flush_cb(lv_display_t * disp, const lv_area_t * area, uint8_t * px_map)
+{
+    LV_UNUSED(px_map);
+    lv_drm_ctx_t * ctx = lv_display_get_driver_data(disp);
+    int32_t disp_width = lv_display_get_horizontal_resolution(disp);
+    int32_t disp_height = lv_display_get_vertical_resolution(disp);
+    bool last = lv_display_flush_is_last(disp);
+
+    bool in_place = lv_linux_drm_egl_upload_in_place(lv_display_get_render_mode(disp),
+                                                     lv_display_get_matrix_rotation(disp));
+    lv_area_t clipped;
+    lv_linux_drm_egl_upload_t upload = lv_linux_drm_egl_upload_plan(&ctx->upload, ctx->texture.texture_id,
+                                                                     disp_width, disp_height, in_place, last,
+                                                                     area, &clipped);
+
+    if(upload == LV_LINUX_DRM_EGL_UPLOAD_FULL) {
+        /*Uploads the whole buffer, then presents it*/
+        lv_opengles_texture_render_display(&ctx->texture, disp);
+    }
+    else {
+        if(upload == LV_LINUX_DRM_EGL_UPLOAD_AREA) {
+            upload_area(disp, ctx->texture.texture_id, ctx->texture.fb1, &clipped);
+        }
+        if(last) {
+            lv_opengles_texture_present_display(disp);
+        }
+    }
+    lv_linux_drm_egl_upload_record(&ctx->upload, upload, ctx->texture.texture_id, disp_width, disp_height);
+
+    if(last) {
+        lv_opengles_egl_update(ctx->egl_ctx);
+    }
+    lv_display_flush_ready(disp);
+}
