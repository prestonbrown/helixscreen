 /**
+ * Hold or release the notifications of every Widget Observer: an Observer added with
+ * `lv_subject_add_observer_obj()` on a non-NULL Widget, which every `lv_*_bind_*()`
+ * binding is. Observers with no Widget are notified as usual.
+ *
+ * While held, a Subject change skips its Widget Observers and remembers each skipped one
+ * once. Releasing notifies each of them once, from the Subject's value at that moment,
+ * so they skip the intermediate values. An Observer deleted while held is forgotten.
+ * Releasing from inside a Subject notification is refused and leaves the hold on.
+ * @param hold          true: hold; false: release and deliver what was held
+ */
+void lv_subject_hold_obj_observers(bool hold);
+
+/**
+ * @return              true while Widget Observer notifications are held
+ */
+bool lv_subject_obj_observers_held(void);
+
+/**
+ * @return              how many Widget Observers wait for the release
+ */
+uint32_t lv_subject_obj_observers_held_count(void);
+
+/**
+ * @return              true while a Subject notification is running, when a release is refused
+ */
+bool lv_subject_notifying(void);
+
+/**
