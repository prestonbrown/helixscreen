         /*A NULL user_data here would match, and remove, every unrelated callback
@@ -757,16 +784,81 @@
         observer->notified = 0;
     }
 
+    notify_depth++;
     do {
         subject->notify_restart_query = 0;
         LV_LL_READ(&(subject->subs_ll), observer) {
             if(observer->cb && observer->notified == 0) {
+                if(obj_observers_held && observer->for_obj && observer->target) {
+                    observer->notified = 1;
+                    if(!observer->notify_held) {
+                        lv_observer_t ** node = lv_ll_ins_tail(&held_observer_ll);
+                        LV_ASSERT_MALLOC(node);
+                        if(node) {
+                            *node = observer;
+                            observer->notify_held = 1;
+                        }
+                        else {
+                            /* Out of memory: deliver now rather than lose the update. */
+                            observer->cb(observer, subject);
+                            if(subject->notify_restart_query) break;
+                        }
+                    }
+                    continue;
+                }
                 observer->cb(observer, subject);
                 if(subject->notify_restart_query) break;
                 observer->notified = 1;
             }
         }
     } while(subject->notify_restart_query);
+    notify_depth--;
+}
+
+void lv_subject_hold_obj_observers(bool hold)
+{
+    LV_HELIX_ASSERT_LVGL_THREAD();
+    if(hold) {
+        obj_observers_held = true;
+        return;
+    }
+    if(!obj_observers_held) return;
+    /* A release inside a notification would run Widget callbacks while that Subject's
+     * Observer list is being walked. */
+    if(notify_depth > 0) {
+        LV_LOG_WARN("lv_subject_hold_obj_observers: release inside a notification refused");
+        return;
+    }
+    obj_observers_held = false;
+
+    /* Head first, unlinked before its callback: a callback may delete other held
+     * Observers (lv_observer_delete() forgets them) or change Subjects (delivered at once,
+     * the hold being off). */
+    lv_observer_t ** node;
+    while((node = lv_ll_get_head(&held_observer_ll)) != NULL) {
+        lv_observer_t * observer = *node;
+        lv_ll_remove(&held_observer_ll, node);
+        lv_free(node);
+        observer->notify_held = 0;
+        if(observer->cb && observer->subject) {
+            observer->cb(observer, observer->subject);
+        }
+    }
+}
+
+bool lv_subject_obj_observers_held(void)
+{
+    return obj_observers_held;
+}
+
+uint32_t lv_subject_obj_observers_held_count(void)
+{
+    return lv_ll_get_len(&held_observer_ll);
+}
+
+bool lv_subject_notifying(void)
+{
+    return notify_depth > 0;
 }
 
