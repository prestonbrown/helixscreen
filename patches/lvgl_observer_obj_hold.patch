+/* Widget Observers whose notification is held (lv_subject_hold_obj_observers()). One
+ * process-wide hold: every display sleeps together. */
+static bool obj_observers_held;
+static lv_ll_t held_observer_ll;   /* lv_observer_t * per node */
+static uint32_t notify_depth;      /* > 0 while subject_notify() runs */
+
+static void held_observer_forget(lv_observer_t * observer)
+{
+    lv_observer_t ** node;
+    LV_LL_READ(&held_observer_ll, node) {
+        if(*node == observer) {
+            lv_ll_remove(&held_observer_ll, node);
+            lv_free(node);
+            return;
+        }
+    }
+}
+
 void lv_subject_global_init(void)
 {
     lv_ll_init(&subject_list, sizeof(lv_subject_t));
+    lv_ll_init(&held_observer_ll, sizeof(lv_observer_t *));
+    obj_observers_held = false;
+    notify_depth = 0;
 }
 void lv_subject_global_deinit(void)
 {
@@ -146,6 +167,8 @@
         }
     }
     lv_ll_clear(&subject_list);
+    lv_ll_clear(&held_observer_ll);
+    obj_observers_held = false;
 }
 
