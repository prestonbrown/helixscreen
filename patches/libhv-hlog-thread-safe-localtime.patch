@@ -1,3 +1,14 @@
+/* PATCH NOTE(helixscreen): libhv builds with -std=c99, which leaves glibc's
+ * POSIX declarations hidden. Without this, localtime_r() below is implicitly
+ * declared as returning int and its result is converted to a garbage pointer -
+ * the first tm->tm_year dereference then segfaults. Must precede every header.
+ */
+#ifndef _WIN32
+#  ifndef _POSIX_C_SOURCE
+#    define _POSIX_C_SOURCE 200809L
+#  endif
+#endif
+
 #include "hlog.h"
 
 #include <assert.h>
@@ -26,6 +37,22 @@
 #define hmutex_unlock       pthread_mutex_unlock
 #endif
 
+// PATCH NOTE(helixscreen): localtime() -> localtime_r() for thread safety.
+// localtime() returns a pointer into a single process-wide struct tm, so two
+// threads formatting a log line overwrite each other's result. Worse, the first
+// call per thread reaches glibc's tzset_internal(), which strdup()s and free()s
+// the TZ string - ThreadSanitizer reports both as data races inside
+// logger_print(), and libhv logs from every event-loop and HTTP worker thread.
+// localtime_r() writes into a caller-supplied buffer and, once the timezone has
+// been resolved, does not re-enter tzset_internal().
+static struct tm* hlog_localtime(const time_t* t, struct tm* buf) {
+#ifdef _WIN32
+    return localtime_s(buf, t) == 0 ? buf : NULL;
+#else
+    return localtime_r(t, buf);
+#endif
+}
+
