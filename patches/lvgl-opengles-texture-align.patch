+#if !LV_USE_DRAW_OPENGLES
+/**
+ * Allocate a draw buffer aligned the way lv_display_set_buffers() requires. malloc aligns
+ * to 8 bytes on 32-bit targets, below LV_DRAW_BUF_ALIGN, so the block is over-allocated
+ * and the returned pointer placed inside it.
+ * @param cf     the display's color format
+ * @param size   bytes the buffer must hold
+ * @param alloc  receives the block to pass to lv_free()
+ * @return       the aligned buffer, or NULL when the allocation fails
+ */
+static uint8_t * alloc_draw_buffer(lv_color_format_t cf, uint32_t size, void ** alloc)
+{
+    *alloc = lv_malloc(size + LV_DRAW_BUF_ALIGN - 1);
+    if(!*alloc) {
+        return NULL;
+    }
+    return lv_draw_buf_align(*alloc, cf);
+}
+#endif /*!LV_USE_DRAW_OPENGLES*/
