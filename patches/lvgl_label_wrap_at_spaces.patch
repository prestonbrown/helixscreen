+/** lv_label_set_wrap_at_spaces() is available (HelixScreen extension) */
+#define LV_LABEL_WRAP_AT_SPACES 1
+
+/**
+ * Wrap the text only at spaces and new lines, so `-`, `_` and the other LV_TXT_BREAK_CHARS
+ * never split a word. A word wider than the label still breaks as usual. (HelixScreen extension)
+ * @param obj           pointer to a label object
+ * @param en            true: wrap only at spaces, false: wrap at every LV_TXT_BREAK_CHARS
+ */
+void lv_label_set_wrap_at_spaces(lv_obj_t * obj, bool en);
