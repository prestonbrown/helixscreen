+void lv_label_set_wrap_at_spaces(lv_obj_t * obj, bool en)
+{
+    LV_CHECK_OBJ(obj, MY_CLASS, return);
+
+    lv_label_t * label = (lv_label_t *)obj;
+    if(label->wrap_at_spaces == en) return;
+
+    label->wrap_at_spaces = en ? 1 : 0;
+    lv_label_mark_need_refr_text(obj);
+}
