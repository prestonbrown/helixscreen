+/**
+ * HelixScreen: a history sample's share of the scroll throw vector.
+ * A sample covering more than one read period is split into period-long
+ * slices, each decayed by its own age, so a slow read cadence yields the same
+ * vector as the nominal one. At or under one period it is the plain decay.
+ * @param x     moved distance of the sample
+ * @param t     age of the sample in milliseconds
+ * @param span  time the sample covers in milliseconds
+ * @return the sample's contribution
+ */
+static int32_t indev_scroll_throw_sample(int32_t x, int32_t t, int32_t span)
+{
+    if(span <= LV_DEF_REFR_PERIOD) return indev_scroll_throw_decay(x, t);
+
+    int32_t sum = 0;
+    for(int32_t done = 0; done < span && t + done < 99; done += LV_DEF_REFR_PERIOD) {
+        int32_t slice = LV_MIN(LV_DEF_REFR_PERIOD, span - done);
+        sum += indev_scroll_throw_decay(x * slice, t + done);
+    }
+    return sum / span;
+}
