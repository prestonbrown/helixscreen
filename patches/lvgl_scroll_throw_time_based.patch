+/**
+ * HelixScreen: advance a scroll throw by `steps` of LVGL's per-call throw step:
+ * decay the vector by `scroll_throw` percent, limit it at the edges, move by it.
+ * @param vect      throw vector component in pixels per period, updated in place
+ * @param scroll_start  scroll position from the start edge before the move
+ * @param scroll_end    scroll position from the end edge before the move
+ * @return the distance to scroll by
+ */
+static int32_t throw_steps(lv_obj_t * scroll_obj, int32_t * vect, int32_t scroll_throw, uint32_t steps,
+                           int32_t scroll_start, int32_t scroll_end, lv_dir_t dir)
+{
+    int32_t v = *vect;
+    int32_t moved = 0;
+    for(; steps > 0 && v != 0; steps--) {
+        v = v * (100 - scroll_throw) / 100;
+        v = elastic_diff(scroll_obj, v, scroll_start - moved, scroll_end + moved, dir);
+        moved += v;
+    }
+    *vect = v;
+    return moved;
+}
