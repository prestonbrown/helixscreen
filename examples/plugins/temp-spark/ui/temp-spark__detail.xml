<?xml version="1.0"?>
<component>
  <!-- Detail overlay: the same window on a larger canvas with labelled
       gridlines and the target drawn as a dashed line, plus a stat row. The
       value row carries the window length; the target column hides unless the
       show_target subject is 1. -->
  <!-- A literal title on the view would ignore the creation attr, so the
       heater name rides in through a prop: overlay() supplies it and the
       default is what a bare create shows. -->
  <api>
    <prop name="title" type="string" default="Temperature"/>
  </api>
  <view extends="overlay_panel" title="$title" title_subject="temp-spark__heater_label" bg_color="#card_bg">
    <lv_obj name="temp-spark__detail_content"
            width="100%" flex_grow="1" style_pad_all="#space_md" style_pad_gap="#space_sm" flex_flow="column"
            scrollable="false">
      <lv_obj width="100%"
              height="content" flex_flow="row" style_pad_all="0" style_flex_main_place="space_between"
              style_flex_cross_place="center" scrollable="false" style_bg_opa="0" style_border_width="0">
        <lv_obj flex_flow="row"
                style_pad_all="0" style_pad_gap="#space_xxs" style_flex_cross_place="center" scrollable="false"
                style_bg_opa="0" style_border_width="0">
          <lv_label name="temp-spark__detail_value"
                    bind_text="temp-spark__value" style_text_font="#font_xl" style_text_color="#text"/>
          <lv_label name="temp-spark__detail_beside"
                    bind_text="temp-spark__target_beside" style_text_font="#font_body" style_text_color="#text_muted"/>
          <lv_label name="temp-spark__detail_unit" text="°C" style_text_font="#font_body" style_text_color="#text_muted"/>
        </lv_obj>
        <text_small name="temp-spark__window" bind_text="temp-spark__window_text"/>
      </lv_obj>
      <plugin_canvas name="temp-spark__graph" width="100%" flex_grow="1"/>
      <!-- A ui_card gives the stat row the panel chrome native readouts sit in,
           instead of bare labels on the content edge. -->
      <ui_card name="temp-spark__stats" width="100%" height="content" flex_flow="row" style_pad_gap="#space_lg">
        <lv_obj flex_flow="column" style_pad_gap="#space_xxs" flex_grow="1" style_bg_opa="0" style_border_width="0">
          <lv_label text="Min" style_text_font="#font_small" style_text_color="#text_muted"/>
          <lv_label name="temp-spark__min_value"
                    bind_text="temp-spark__min_text" style_text_font="#font_body" style_text_color="#text"/>
        </lv_obj>
        <lv_obj flex_flow="column" style_pad_gap="#space_xxs" flex_grow="1" style_bg_opa="0" style_border_width="0">
          <lv_label text="Max" style_text_font="#font_small" style_text_color="#text_muted"/>
          <lv_label name="temp-spark__max_value"
                    bind_text="temp-spark__max_text" style_text_font="#font_body" style_text_color="#text"/>
        </lv_obj>
        <lv_obj flex_flow="column" style_pad_gap="#space_xxs" flex_grow="1" style_bg_opa="0" style_border_width="0">
          <lv_label text="Avg" style_text_font="#font_small" style_text_color="#text_muted"/>
          <lv_label name="temp-spark__avg_value"
                    bind_text="temp-spark__avg_text" style_text_font="#font_body" style_text_color="#text"/>
        </lv_obj>
        <lv_obj name="temp-spark__target_stat"
                flex_flow="column" style_pad_gap="#space_xxs" flex_grow="1" style_bg_opa="0" style_border_width="0">
          <bind_flag_if_eq subject="temp-spark__show_target" flag="hidden" ref_value="0"/>
          <lv_label text="Target" style_text_font="#font_small" style_text_color="#text_muted"/>
          <lv_label name="temp-spark__target_value"
                    bind_text="temp-spark__target_text" style_text_font="#font_body" style_text_color="#text"/>
        </lv_obj>
      </ui_card>
    </lv_obj>
  </view>
</component>
