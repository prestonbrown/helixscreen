#!/bin/sh
# A clean `git merge` runs this hook and never runs pre-commit, so the claim that
# announces a merge to peers has to be taken here too.
#
# MERGE_HEAD does not exist yet at this point - git writes it only when a merge
# stops for you to resolve - so the description comes from GIT_REFLOG_ACTION
# ("merge <branch>"), which git sets for the whole operation.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT" || exit 0
_lib="$(dirname "$0")/lib/claim-tree.sh"
if [ -r "$_lib" ]; then
    # shellcheck source=lib/claim-tree.sh
    . "$_lib"
    claim_tree "${GIT_REFLOG_ACTION:-merge}" || exit 1
fi
# A clean merge runs no pre-commit, so the translation packs the merge driver
# kept from this side (merge=helix-generated in .gitattributes) are checked
# here. Stale ones stop the merge before its commit, with the fix to run.
if [ -f scripts/check_translation_packs_fresh.py ] &&
    [ -n "$(git diff --cached --name-only HEAD -- translations/ ui_xml/translations/ \
        scripts/generate_translations.py scripts/translations/ 2>/dev/null)" ]; then
    if ! python3 scripts/check_translation_packs_fresh.py; then
        echo "   The merge is staged but not committed; run the fix above to complete it."
        exit 1
    fi
fi
exit 0
