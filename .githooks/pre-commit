#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Git pre-commit hook for HelixScreen
#
# This hook runs quality checks before each commit using scripts/quality-checks.sh
# Files with formatting issues are auto-fixed and staged.
#
# --staged-only skips any gate that inspects nothing you staged, so a docs-only
# commit costs about a second instead of ~17s. The gates it skipped are not
# dropped: .githooks/pre-push runs the whole sweep, ungated, before anything
# leaves the machine.
#
# Setup (one-time):
#   git config core.hooksPath .githooks
#
# Bypass for one commit:
#   git commit --no-verify

set -e

# Change to repo root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# ---- helix-claim: announce a merge so peers need not guess (advisory) -------
# Silent unless another session holds this tree. $PPID is the git process
# itself, so the claim dies with the merge and a crash needs no cleanup.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && [ -x scripts/helix-claim ]; then
    _tree="worktree:$(basename "$(git rev-parse --show-toplevel)")"
    if ! scripts/helix-claim check "$_tree" >/dev/null 2>&1; then
        printf '\n  Another session is merging here:\n' >&2
        scripts/helix-claim check "$_tree" >&2
        printf '  Proceeding anyway (advisory). HELIX_CLAIM_STRICT=1 to refuse.\n\n' >&2
        [ "${HELIX_CLAIM_STRICT:-0}" = "1" ] && exit 1
    else
        scripts/helix-claim take "$_tree" \
            "merge $(git name-rev --name-only MERGE_HEAD 2>/dev/null || echo '?')" \
            --pid "$PPID" --note "git hook running; may take many minutes" >/dev/null 2>&1
    fi
fi
# ---------------------------------------------------------------------------

# Run quality checks with staged-only mode and auto-fix
exec ./scripts/quality-checks.sh --staged-only --auto-fix
