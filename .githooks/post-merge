#!/bin/sh
# Mirror of post-commit for the merge path, which does not run post-commit.
# Drops only the claim this merge's own git process took; a session claim
# spanning several operations carries that session's pid and must survive.
[ -x scripts/helix-claim ] || exit 0
scripts/helix-claim release-if-owned-by "$PPID" "worktree:" >/dev/null 2>&1
exit 0
