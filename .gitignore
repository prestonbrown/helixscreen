# ============================================================================
# Build Artifacts
# ============================================================================
build/
lib/sdl2/build/
*.o
*.a

# Pinned doc citations (make docs-pinned) — already under build/, named
# explicitly since its line numbers must never be committed.
build/docs-pinned/

# ============================================================================
# Dependencies
# ============================================================================
# Node.js
node_modules/
package-lock.json

# ...except the Cloudflare Worker packages, whose lockfiles CI needs. The
# Server Tests workflow runs `npm ci`, which requires a committed lockfile and
# installs the exact same tree every run. Without these, a floating transitive
# dependency can turn CI red overnight with no code change.
!server/*/package-lock.json

# Python virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# UI test harness failure diagnostics (tests/ui/test_diagnostics.py)
ui-artifacts/

# ============================================================================
# Configuration
# ============================================================================
# Local config (user-specific, use config/settings.json.template)
config/settings.json
config/settings-test.json
# Legacy names (in case old files appear during migration)
config/helixconfig.json
config/helixconfig-test.json
helixconfig.json

# Telemetry runtime state (generated by app, device-specific)
config/telemetry_*.json

# User-customized themes (track defaults/, ignore user overrides)
config/themes/*.json

# ============================================================================
# Generated Files & Logs
# ============================================================================
# NOTE: src/generated/ is tracked in git for cross-compilation support
# Regenerate with: make translations

# Auto-generated libhv logs
*.log
libhv.*.log

# Font generation timestamp
.fonts.stamp

# Render output artifacts
*.ppm

# ============================================================================
# Development Tools
# ============================================================================
# IDE/LSP
compile_commands.json
.cache/

.idea/
.vscode/

# Session notes (developer-specific)
SESSION_SUMMARY.md
IMPLEMENTATION_PLAN.md

# Claude plugin local config
.claude/*.local.md
.claude/*.lock
.claude/projects/
.claude/worktrees/

# OpenCode local state
.opencode/state/

# Cloudflare Wrangler
.wrangler/

# ============================================================================
# Platform-Specific
# ============================================================================
# macOS
.DS_Store
*.dSYM/

# Linux
*.swp
*.swo
*~

# ============================================================================
# Test Artifacts
# ============================================================================
# Unit test binaries
tests/unit/test_*
!tests/unit/test_*.cpp
!tests/unit/test_*.sh

# ============================================================================
# Asset Files (Large/Binary)
# ============================================================================
# G-Code sample files (binary, bloats repo history)
assets/gcode/*.gcode
assets/*.gcode

# ============================================================================
# Release Artifacts
# ============================================================================
# Local staging for release binaries (uploaded to GitHub Releases, not committed)
releases/
dist/
.worktrees/
# CJK source fonts (too large, download from GitHub notofonts/noto-cjk)
assets/fonts/NotoSansCJK*.otf
.bash-git-rc
config/helixconfig.json.voronv2

# ============================================================================
# Signing Material — NEVER commit any of this
# ============================================================================
# The Android upload keystore lives at ~/.android-keystore/ and reaches CI as
# the ANDROID_KEYSTORE_BASE64 secret; nothing signing-related belongs in the
# tree. Committing one means rotating the key, and for the upload key that
# means asking Google to reset it. The Play service-account JSON is worse: it
# can push arbitrary code to production.
*.jks
*.keystore
*.p12
*.pfx
# Google Play service account (PLAY_SERVICE_ACCOUNT_JSON), under the names the
# Cloud Console and the docs hand out.
service-account*.json
play-service-account*.json
play-store-credentials*.json
google-play-*.json

# ============================================================================
# Telemetry Analytics (local data pulled from R2)
# ============================================================================
.telemetry-data/
.env.telemetry
config/crash_report.txt
config/crash.txt
config/crash_*.txt
config/crash_history.json
config/tool_spools.json
config/filament_slot_overrides.json
config/.crash_restart_count
config/.helix-screen.lock
.superpowers/
docs/superpowers/
.claude/scratchpad/

# Local crash artifacts (preserved across compactions for ASAN investigation)
.crash-files/
