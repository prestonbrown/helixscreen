{
  "name": "Creality K2",
  "description": "Print start patterns for Creality K2 series (K2, K2 Pro, K2 Plus) with CFS",
  "progress_mode": "weighted",
  "adaptive_meshing": true,
  "position_signals": true,
  "signal_formats": [],
  "tag_patterns": [
    {
      "pattern": "^(?=.*(?:num:|velocity:))(?:(?!percent).)*percent[: ]*\\s*\\+?([0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]+)?|\\.[0-9]+(?:[eE][+-]?[0-9]+)?)",
      "case_sensitive": true,
      "phase": "PURGING",
      "message": "Purging",
      "progress_group": 1
    },
    {
      "pattern": "\\[box\\] cut sensor detected|\\[box\\] cut to return|BOX_LOAD_MATERIAL",
      "case_sensitive": true,
      "phase": "INITIALIZING",
      "message": "Loading Filament..."
    }
  ],
  "response_patterns": [
    {
      "pattern": "_handle_home_rails_begin|x_park = ",
      "phase": "HOMING",
      "message": "Homing...",
      "weight": 10
    },
    {
      "pattern": "\\[NOZZLE_CLEAR\\] START",
      "case_sensitive": true,
      "phase": "CLEANING",
      "message": "Cleaning Nozzle...",
      "weight": 5,
      "owns": ["PURGING"]
    },
    {
      "pattern": "NOZZLE_CLEAR|BOX_NOZZLE_CLEAN|nozzle.?clean",
      "phase": "CLEANING",
      "message": "Cleaning Nozzle...",
      "weight": 5
    },
    {
      "pattern": "M190|Heating bed|^(?!.*BED_MESH_CALIBRATE_START_PRINT).*BED_TEMP",
      "phase": "HEATING_BED",
      "message": "Heating Bed...",
      "weight": 20
    },
    {
      "pattern": "M109|TEMPERATURE_WAIT SENSOR=extruder|Heating (nozzle|hotend|extruder)|^(?!.*BED_MESH_CALIBRATE_START_PRINT).*EXTRUDER_TEMP",
      "phase": "HEATING_NOZZLE",
      "message": "Heating Nozzle...",
      "weight": 20
    },
    {
      "pattern": "Z_TILT_ADJUST|z.?tilt.?adjust|z_align",
      "phase": "Z_TILT",
      "message": "Z Tilt Adjust...",
      "weight": 10
    },
    {
      "pattern": "BED_MESH_CALIBRATE(?!_START_PRINT)|exist_points\\[|Adapted probe count",
      "phase": "BED_MESH",
      "message": "Bed Mesh...",
      "weight": 10
    },
    {
      "pattern": "BOX_MATERIAL_FLUSH|BOX_MATERIAL_CHANGE_FLUSH|BOX_GO_TO_EXTRUDE_POS|M8200.*F|flush_temp:|flush_len:|flush_volume:",
      "phase": "PURGING",
      "message": "Flushing Filament...",
      "weight": 5
    }
  ]
}
